<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ResourceDictionary.ThemeDictionaries>
    <ResourceDictionary x:Key="Light">
      <SolidColorBrush x:Key="WorkspaceBackgroundBrush" Color="#E6E7EA"/>
      <SolidColorBrush x:Key="WorkspaceSurfaceBrush" Color="#E6E7EC"/>
      <SolidColorBrush x:Key="WorkspaceSidebarBrush" Color="#E6E7EA"/>
      <SolidColorBrush x:Key="WorkspaceEdgeBrush" Color="#16000000"/>
      <SolidColorBrush x:Key="WorkspaceFolderBrush" Color="#2587D9"/>
      <SolidColorBrush x:Key="NavigationViewItemBackgroundSelected" Color="#D0D8E2"/>
      <SolidColorBrush x:Key="NavigationViewSelectionIndicatorForeground" Color="Transparent"/>
      <SolidColorBrush x:Key="AppBarToggleButtonBackgroundChecked" Color="#D0D8E2"/>
      <SolidColorBrush x:Key="ToggleButtonBackgroundChecked" Color="#D0D8E2"/>
      <SolidColorBrush x:Key="ToggleButtonForegroundChecked" Color="#0095FF"/>
      <SolidColorBrush x:Key="ToggleButtonBorderBrushChecked" Color="#99AFC6"/>
      <SolidColorBrush x:Key="ToggleButtonBackgroundCheckedPointerOver" Color="#D0D8E2"/>
      <SolidColorBrush x:Key="ToggleButtonForegroundCheckedPointerOver" Color="#0095FF"/>
      <SolidColorBrush x:Key="ToggleButtonBorderBrushCheckedPointerOver" Color="#99AFC6"/>
      <SolidColorBrush x:Key="ToggleButtonBackgroundCheckedPressed" Color="#D0D8E2"/>
      <SolidColorBrush x:Key="ToggleButtonForegroundCheckedPressed" Color="#0095FF"/>
      <SolidColorBrush x:Key="ToggleButtonBorderBrushCheckedPressed" Color="#99AFC6"/>
      <SolidColorBrush x:Key="AppBarToggleButtonForegroundChecked" Color="#0095FF"/>
      <SolidColorBrush x:Key="AppBarToggleButtonBorderBrushChecked" Color="#99AFC6"/>
      <SolidColorBrush x:Key="WorkspaceAccentBrush" Color="#0095FF"/>
      <SolidColorBrush x:Key="WorkspaceOnAccentBrush" Color="White"/>
      <SolidColorBrush x:Key="WorkspaceTileBrush" Color="#DEE1E7"/>
      <SolidColorBrush x:Key="WorkspaceIncomingMessageBrush" Color="#FFFFFF"/>
    </ResourceDictionary>
    <ResourceDictionary x:Key="Default">
      <SolidColorBrush x:Key="WorkspaceBackgroundBrush" Color="#4C4F50"/>
      <SolidColorBrush x:Key="WorkspaceSurfaceBrush" Color="#45494A"/>
      <SolidColorBrush x:Key="WorkspaceSidebarBrush" Color="#484C4D"/>
      <SolidColorBrush x:Key="WorkspaceEdgeBrush" Color="#20FFFFFF"/>
      <SolidColorBrush x:Key="WorkspaceFolderBrush" Color="#69B8FF"/>
      <SolidColorBrush x:Key="NavigationViewItemBackgroundSelected" Color="#4B5965"/>
      <SolidColorBrush x:Key="NavigationViewSelectionIndicatorForeground" Color="Transparent"/>
      <SolidColorBrush x:Key="AppBarToggleButtonBackgroundChecked" Color="#4B5965"/>
      <SolidColorBrush x:Key="ToggleButtonBackgroundChecked" Color="#4B5965"/>
      <SolidColorBrush x:Key="ToggleButtonForegroundChecked" Color="#0095FF"/>
      <SolidColorBrush x:Key="ToggleButtonBorderBrushChecked" Color="#99AFC6"/>
      <SolidColorBrush x:Key="ToggleButtonBackgroundCheckedPointerOver" Color="#4B5965"/>
      <SolidColorBrush x:Key="ToggleButtonForegroundCheckedPointerOver" Color="#0095FF"/>
      <SolidColorBrush x:Key="ToggleButtonBorderBrushCheckedPointerOver" Color="#99AFC6"/>
      <SolidColorBrush x:Key="ToggleButtonBackgroundCheckedPressed" Color="#4B5965"/>
      <SolidColorBrush x:Key="ToggleButtonForegroundCheckedPressed" Color="#0095FF"/>
      <SolidColorBrush x:Key="ToggleButtonBorderBrushCheckedPressed" Color="#99AFC6"/>
      <SolidColorBrush x:Key="AppBarToggleButtonForegroundChecked" Color="#0095FF"/>
      <SolidColorBrush x:Key="AppBarToggleButtonBorderBrushChecked" Color="#99AFC6"/>
      <SolidColorBrush x:Key="WorkspaceAccentBrush" Color="#0095FF"/>
      <SolidColorBrush x:Key="WorkspaceOnAccentBrush" Color="White"/>
      <SolidColorBrush x:Key="WorkspaceTileBrush" Color="#494F53"/>
      <SolidColorBrush x:Key="WorkspaceIncomingMessageBrush" Color="#565C60"/>
    </ResourceDictionary>
    <ResourceDictionary x:Key="HighContrast">
      <SolidColorBrush x:Key="WorkspaceBackgroundBrush" Color="{ThemeResource SystemColorWindowColor}"/>
      <SolidColorBrush x:Key="WorkspaceSurfaceBrush" Color="{ThemeResource SystemColorWindowColor}"/>
      <SolidColorBrush x:Key="WorkspaceSidebarBrush" Color="{ThemeResource SystemColorWindowColor}"/>
      <SolidColorBrush x:Key="WorkspaceEdgeBrush" Color="{ThemeResource SystemColorWindowTextColor}"/>
      <SolidColorBrush x:Key="WorkspaceFolderBrush" Color="{ThemeResource SystemColorWindowTextColor}"/>
      <SolidColorBrush x:Key="WorkspaceAccentBrush" Color="{ThemeResource SystemColorHighlightColor}"/>
      <SolidColorBrush x:Key="WorkspaceOnAccentBrush" Color="{ThemeResource SystemColorHighlightTextColor}"/>
      <SolidColorBrush x:Key="WorkspaceTileBrush" Color="{ThemeResource SystemColorWindowColor}"/>
      <SolidColorBrush x:Key="WorkspaceIncomingMessageBrush" Color="{ThemeResource SystemColorWindowColor}"/>
    </ResourceDictionary>
  </ResourceDictionary.ThemeDictionaries>
  <Style x:Key="WorkspaceIconToggleStyle" TargetType="ToggleButton" BasedOn="{StaticResource DefaultToggleButtonStyle}">
    <Setter Property="Width" Value="38"/>
    <Setter Property="Height" Value="38"/>
    <Setter Property="MinHeight" Value="38"/>
    <Setter Property="Padding" Value="0"/>
    <Setter Property="CornerRadius" Value="10"/>
    <Setter Property="HorizontalContentAlignment" Value="Center"/>
    <Setter Property="VerticalContentAlignment" Value="Center"/>
  </Style>
  <Thickness x:Key="WorkspacePagePadding">20,16,20,16</Thickness>
  <Style x:Key="WorkspaceTitleStyle" TargetType="TextBlock">
    <Setter Property="FontSize" Value="20"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
  </Style>
  <Style x:Key="WorkspaceNavigationItemStyle" TargetType="NavigationViewItem">
    <Setter Property="MinHeight" Value="42"/>
    <Setter Property="FontSize" Value="16"/>
    <Setter Property="Margin" Value="10,1"/>
    <Setter Property="CornerRadius" Value="8"/>
  </Style>
  <x:Double x:Key="NavigationViewItemOnLeftIconBoxHeight">22</x:Double>
  <x:Double x:Key="PivotHeaderItemFontSize">14</x:Double>
  <Style TargetType="PivotHeaderItem" BasedOn="{StaticResource DefaultPivotHeaderItemStyle}">
    <Setter Property="FontSize" Value="14"/>
    <Setter Property="Height" Value="52"/>
    <Setter Property="UseSystemFocusVisuals" Value="True"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="PivotHeaderItem">
          <Grid x:Name="Grid" CornerRadius="10" Margin="3,7" Padding="12,0" BorderThickness="1" BorderBrush="Transparent" Background="{ThemeResource SubtleFillColorSecondaryBrush}">
            <Grid.RenderTransform>
              <TranslateTransform x:Name="ContentPresenterTranslateTransform"/>
            </Grid.RenderTransform>
            <VisualStateManager.VisualStateGroups>
              <VisualStateGroup x:Name="SelectionStates">
                <VisualState x:Name="Unselected"/>
                <VisualState x:Name="UnselectedLocked"/>
                <VisualState x:Name="UnselectedPointerOver"/>
                <VisualState x:Name="UnselectedPressed"/>
                <VisualState x:Name="Selected">
                  <VisualState.Setters>
                    <Setter Target="Grid.Background" Value="{ThemeResource NavigationViewItemBackgroundSelected}"/>
                    <Setter Target="Grid.BorderBrush" Value="{ThemeResource WorkspaceAccentBrush}"/>
                    <Setter Target="ContentPresenter.Foreground" Value="{ThemeResource WorkspaceAccentBrush}"/>
                  </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="SelectedPointerOver">
                  <VisualState.Setters>
                    <Setter Target="Grid.Background" Value="{ThemeResource NavigationViewItemBackgroundSelected}"/>
                    <Setter Target="Grid.BorderBrush" Value="{ThemeResource WorkspaceAccentBrush}"/>
                    <Setter Target="ContentPresenter.Foreground" Value="{ThemeResource WorkspaceAccentBrush}"/>
                  </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="SelectedPressed">
                  <VisualState.Setters>
                    <Setter Target="Grid.Background" Value="{ThemeResource NavigationViewItemBackgroundSelected}"/>
                    <Setter Target="Grid.BorderBrush" Value="{ThemeResource WorkspaceAccentBrush}"/>
                    <Setter Target="ContentPresenter.Foreground" Value="{ThemeResource WorkspaceAccentBrush}"/>
                  </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Disabled">
                  <VisualState.Setters>
                    <Setter Target="ContentPresenter.Foreground" Value="{ThemeResource TextFillColorDisabledBrush}"/>
                  </VisualState.Setters>
                </VisualState>
              </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>
            <ContentPresenter x:Name="ContentPresenter" Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" Foreground="{TemplateBinding Foreground}" FontSize="{TemplateBinding FontSize}" VerticalAlignment="Center"/>
            <Rectangle x:Name="SelectedPipe" Height="0" Visibility="Collapsed"/>
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="WorkspaceIncomingBubble" TargetType="ContentControl">
    <Setter Property="Background" Value="{ThemeResource WorkspaceIncomingMessageBrush}"/>
    <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ContentControl">
          <Border Padding="12,9" CornerRadius="14" Background="{TemplateBinding Background}">
            <ContentPresenter Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" Foreground="{TemplateBinding Foreground}"/>
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="WorkspaceOutgoingBubble" TargetType="ContentControl">
    <Setter Property="Background" Value="{ThemeResource WorkspaceAccentBrush}"/>
    <Setter Property="Foreground" Value="{ThemeResource WorkspaceOnAccentBrush}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ContentControl">
          <Border Padding="12,9" CornerRadius="14" Background="{TemplateBinding Background}">
            <ContentPresenter Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" Foreground="{TemplateBinding Foreground}"/>
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="WorkspaceSuccessTextStyle" TargetType="TextBlock">
    <Setter Property="Foreground" Value="{ThemeResource SystemFillColorSuccessBrush}"/>
  </Style>
</ResourceDictionary>
