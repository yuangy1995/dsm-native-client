<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- macOS MacAppearance 的内容、玻璃与选择色；高对比使用系统色，不降低整窗透明度。 -->
    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
            <SolidColorBrush x:Key="WorkspaceCanvasBrush" Color="#F9FAFC"/>
            <SolidColorBrush x:Key="WorkspaceSidebarBrush" Color="#DCE3EEFC"/>
            <SolidColorBrush x:Key="WorkspaceCardBrush" Color="#0E5C7A9E"/>
            <SolidColorBrush x:Key="WorkspaceEdgeBrush" Color="#C7FFFFFF"/>
            <SolidColorBrush x:Key="WorkspaceSelectionBrush" Color="#295C7A9E"/>
            <SolidColorBrush x:Key="WorkspaceSelectionBorderBrush" Color="#805C7A9E"/>
            <SolidColorBrush x:Key="WorkspaceHoverBrush" Color="#09000000"/>
            <SolidColorBrush x:Key="WorkspacePreviewBrush" Color="#EBF0F7"/>
            <SolidColorBrush x:Key="WorkspaceFolderBrush" Color="#5C99F0"/>
            <SolidColorBrush x:Key="WorkspaceDividerBrush" Color="#18000000"/>
            <SolidColorBrush x:Key="ListViewItemBackgroundSelected" Color="#295C7A9E"/>
            <SolidColorBrush x:Key="ListViewItemBackgroundSelectedPointerOver" Color="#295C7A9E"/>
            <SolidColorBrush x:Key="ListViewItemBackgroundSelectedPressed" Color="#295C7A9E"/>
            <SolidColorBrush x:Key="ListViewItemBackgroundPointerOver" Color="#09000000"/>
            <SolidColorBrush x:Key="ListViewItemBackgroundPressed" Color="#09000000"/>
            <SolidColorBrush x:Key="ListViewItemSelectionIndicatorBrush" Color="#805C7A9E"/>
        </ResourceDictionary>
        <ResourceDictionary x:Key="Default">
            <SolidColorBrush x:Key="WorkspaceCanvasBrush" Color="#1B2026"/>
            <SolidColorBrush x:Key="WorkspaceSidebarBrush" Color="#DA1F2934"/>
            <SolidColorBrush x:Key="WorkspaceCardBrush" Color="#1A5C7A9E"/>
            <SolidColorBrush x:Key="WorkspaceEdgeBrush" Color="#1FFFFFFF"/>
            <SolidColorBrush x:Key="WorkspaceSelectionBrush" Color="#3D5C7A9E"/>
            <SolidColorBrush x:Key="WorkspaceSelectionBorderBrush" Color="#805C7A9E"/>
            <SolidColorBrush x:Key="WorkspaceHoverBrush" Color="#0EFFFFFF"/>
            <SolidColorBrush x:Key="WorkspacePreviewBrush" Color="#0F1318"/>
            <SolidColorBrush x:Key="WorkspaceFolderBrush" Color="#5CA3FA"/>
            <SolidColorBrush x:Key="WorkspaceDividerBrush" Color="#22FFFFFF"/>
            <SolidColorBrush x:Key="ListViewItemBackgroundSelected" Color="#3D5C7A9E"/>
            <SolidColorBrush x:Key="ListViewItemBackgroundSelectedPointerOver" Color="#3D5C7A9E"/>
            <SolidColorBrush x:Key="ListViewItemBackgroundSelectedPressed" Color="#3D5C7A9E"/>
            <SolidColorBrush x:Key="ListViewItemBackgroundPointerOver" Color="#0EFFFFFF"/>
            <SolidColorBrush x:Key="ListViewItemBackgroundPressed" Color="#0EFFFFFF"/>
            <SolidColorBrush x:Key="ListViewItemSelectionIndicatorBrush" Color="#805C7A9E"/>
        </ResourceDictionary>
        <ResourceDictionary x:Key="HighContrast">
            <SolidColorBrush x:Key="WorkspaceCanvasBrush" Color="{ThemeResource SystemColorWindowColor}"/>
            <SolidColorBrush x:Key="WorkspaceSidebarBrush" Color="{ThemeResource SystemColorWindowColor}"/>
            <SolidColorBrush x:Key="WorkspaceCardBrush" Color="{ThemeResource SystemColorWindowColor}"/>
            <SolidColorBrush x:Key="WorkspaceEdgeBrush" Color="{ThemeResource SystemColorWindowTextColor}"/>
            <SolidColorBrush x:Key="WorkspaceSelectionBrush" Color="{ThemeResource SystemColorHighlightColor}"/>
            <SolidColorBrush x:Key="WorkspaceSelectionBorderBrush" Color="{ThemeResource SystemColorHighlightTextColor}"/>
            <SolidColorBrush x:Key="WorkspaceHoverBrush" Color="{ThemeResource SystemColorHighlightColor}"/>
            <SolidColorBrush x:Key="WorkspacePreviewBrush" Color="{ThemeResource SystemColorWindowColor}"/>
            <SolidColorBrush x:Key="WorkspaceFolderBrush" Color="{ThemeResource SystemColorWindowTextColor}"/>
            <SolidColorBrush x:Key="WorkspaceDividerBrush" Color="{ThemeResource SystemColorWindowTextColor}"/>
            <SolidColorBrush x:Key="ListViewItemBackgroundSelected" Color="{ThemeResource SystemColorHighlightColor}"/>
            <SolidColorBrush x:Key="ListViewItemBackgroundSelectedPointerOver" Color="{ThemeResource SystemColorHighlightColor}"/>
            <SolidColorBrush x:Key="ListViewItemBackgroundSelectedPressed" Color="{ThemeResource SystemColorHighlightColor}"/>
            <SolidColorBrush x:Key="ListViewItemBackgroundPointerOver" Color="{ThemeResource SystemColorHighlightColor}"/>
            <SolidColorBrush x:Key="ListViewItemBackgroundPressed" Color="{ThemeResource SystemColorHighlightColor}"/>
            <SolidColorBrush x:Key="ListViewItemSelectionIndicatorBrush" Color="{ThemeResource SystemColorHighlightTextColor}"/>
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>
    <Style x:Key="WorkspaceTitleStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="20"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style x:Key="WorkspaceSectionTitleStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="16"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>
    <Style x:Key="WorkspaceIconButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
        <Setter Property="MinWidth" Value="36"/>
        <Setter Property="MinHeight" Value="36"/>
        <Setter Property="Padding" Value="8"/>
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
    </Style>
    <Style x:Key="WorkspaceSidebarItemStyle" TargetType="ListViewItem">
        <Setter Property="MinHeight" Value="42"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Margin" Value="0,1"/>
        <Setter Property="CornerRadius" Value="10"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="UseSystemFocusVisuals" Value="True"/>
    </Style>
    <Style x:Key="WorkspaceCardStyle" TargetType="Border">
        <Setter Property="Padding" Value="16"/>
        <Setter Property="CornerRadius" Value="12"/>
        <Setter Property="Background" Value="{ThemeResource WorkspaceCardBrush}"/>
        <Setter Property="BorderBrush" Value="{ThemeResource WorkspaceDividerBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
    </Style>
    <Style x:Key="WorkspaceListItemStyle" TargetType="ListViewItem">
        <Setter Property="MinHeight" Value="42"/>
        <Setter Property="Padding" Value="8,4"/>
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="UseSystemFocusVisuals" Value="True"/>
    </Style>
</ResourceDictionary>
