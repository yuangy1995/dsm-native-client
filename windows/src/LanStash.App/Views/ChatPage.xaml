<Page
    x:Class="LanStash.App.Views.ChatPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:desktop="using:LanStash.App.Presentation"
    xmlns:chat="using:LanStash.App.Features.Chat"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
    SizeChanged="Page_SizeChanged">
    <Page.KeyboardAccelerators>
        <KeyboardAccelerator Key="Left" Modifiers="Menu" Invoked="BackAccelerator_Invoked" />
        <KeyboardAccelerator Key="F" Modifiers="Control" Invoked="SearchAccelerator_Invoked" />
        <KeyboardAccelerator Key="F5" Invoked="RefreshAccelerator_Invoked" />
        <KeyboardAccelerator Key="A" Modifiers="Control,Shift" Invoked="ChooseAttachmentAccelerator_Invoked" />
        <KeyboardAccelerator Key="M" Modifiers="Control,Shift" Invoked="MembersAccelerator_Invoked" />
        <KeyboardAccelerator Key="N" Modifiers="Control,Shift" Invoked="AnnouncementsAccelerator_Invoked" />
        <KeyboardAccelerator Key="P" Modifiers="Control,Shift" Invoked="TogglePinAccelerator_Invoked" />
        <KeyboardAccelerator Key="C" Modifiers="Control,Shift" Invoked="CreateConversationAccelerator_Invoked" />
    </Page.KeyboardAccelerators>

    <Grid Padding="24,20,24,16" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Spacing="4">
                <TextBlock
                    x:Uid="ChatBrowserTitle" desktop:DesktopLocalization.Bindings="Text=ChatBrowserTitle.Text"
                    Style="{StaticResource TitleTextBlockStyle}"
                    AutomationProperties.HeadingLevel="Level1" />
                <TextBlock
                    x:Uid="ChatBrowserDescription" desktop:DesktopLocalization.Bindings="Text=ChatBrowserDescription.Text"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    TextWrapping="Wrap" />
            </StackPanel>
            <Button
                x:Name="CreateConversationButton"
                Grid.Column="1"
                MinWidth="44"
                MinHeight="44"
                Margin="0,0,8,0"
                Click="CreateConversation_Click">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE710;" FontSize="16" />
                    <TextBlock x:Name="CreateConversationButtonLabel" />
                </StackPanel>
            </Button>
            <Button
                x:Uid="ChatBrowserRefresh" desktop:DesktopLocalization.Bindings="AutomationProperties.Name=ChatBrowserRefresh.[using:Microsoft.UI.Xaml.Automation]AutomationProperties.Name"
                x:Name="RefreshButton"
                Grid.Column="2"
                MinHeight="44"
                Click="Refresh_Click">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE72C;" FontSize="16" />
                    <TextBlock x:Uid="ChatBrowserRefreshLabel" desktop:DesktopLocalization.Bindings="Text=ChatBrowserRefreshLabel.Text" />
                </StackPanel>
            </Button>
        </Grid>

        <InfoBar
            x:Uid="ChatBrowserReadOnly" desktop:DesktopLocalization.Bindings="Message=ChatBrowserReadOnly.Message;Title=ChatBrowserReadOnly.Title"
            x:Name="ReadOnlyNotice"
            Grid.Row="1"
            IsClosable="False"
            IsOpen="True"
            Severity="Informational" />

        <Grid Grid.Row="2">
            <Grid
                x:Name="ContentState"
                ColumnSpacing="12"
                AutomationProperties.LiveSetting="Polite"
                Visibility="Collapsed">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="ConversationColumn" Width="340" />
                    <ColumnDefinition x:Name="MessageColumn" Width="*" />
                </Grid.ColumnDefinitions>

                <Border
                    x:Name="ConversationPane"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8">
                    <Grid Padding="12" RowSpacing="8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <AutoSuggestBox
                            x:Uid="ChatBrowserSearch" desktop:DesktopLocalization.Bindings="PlaceholderText=ChatBrowserSearch.PlaceholderText;AutomationProperties.Name=ChatBrowserSearch.[using:Microsoft.UI.Xaml.Automation]AutomationProperties.Name"
                            x:Name="SearchBox"
                            MinHeight="44"
                            QueryIcon="Find"
                            Text="{Binding SearchQuery, Mode=TwoWay}"
                            TextChanged="SearchBox_TextChanged" />
                        <InfoBar
                            x:Uid="ChatBrowserConversationRefreshError" desktop:DesktopLocalization.Bindings="Message=ChatBrowserConversationRefreshError.Message;Title=ChatBrowserConversationRefreshError.Title"
                            x:Name="ConversationRefreshError"
                            Grid.Row="1"
                            AutomationProperties.LiveSetting="Polite"
                            IsClosable="False"
                            IsOpen="False"
                            Severity="Warning" />
                        <ListView
                            x:Uid="ChatBrowserConversationList" desktop:DesktopLocalization.Bindings="AutomationProperties.Name=ChatBrowserConversationList.[using:Microsoft.UI.Xaml.Automation]AutomationProperties.Name"
                            x:Name="ConversationList"
                            Grid.Row="2"
                            IsItemClickEnabled="True"
                            ItemClick="ConversationList_ItemClick"
                            ItemsSource="{Binding Conversations}"
                            SelectionMode="Single">
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem">
                                    <Setter Property="MinHeight" Value="64" />
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                </Style>
                            </ListView.ItemContainerStyle>
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="chat:ChatConversationItem">
                                    <Grid
                                        Padding="4,8"
                                        ColumnSpacing="12"
                                        AutomationProperties.Name="{x:Bind AutomationName}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="40" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Border
                                            Width="40"
                                            Height="40"
                                            Background="{ThemeResource AccentFillColorSecondaryBrush}"
                                            CornerRadius="20">
                                            <TextBlock
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                FontWeight="SemiBold"
                                                Text="{x:Bind Initial}" />
                                        </Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                            <Grid ColumnSpacing="4">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock
                                                    FontWeight="SemiBold"
                                                    Text="{x:Bind Title}"
                                                    TextTrimming="CharacterEllipsis" />
                                                <FontIcon
                                                    Grid.Column="1"
                                                    FontSize="12"
                                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                    Glyph="&#xE718;"
                                                    ToolTipService.ToolTip="{x:Bind PinnedStatusText}"
                                                    AutomationProperties.Name="{x:Bind PinnedStatusText}"
                                                    Visibility="{x:Bind PinnedVisibility}" />
                                            </Grid>
                                            <TextBlock
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                MaxLines="1"
                                                Text="{x:Bind Summary}"
                                                TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                        <TextBlock
                                            Grid.Column="2"
                                            VerticalAlignment="Center"
                                            FontWeight="SemiBold"
                                            Text="{x:Bind UnreadText}" />
                                        <Button
                                            Grid.Column="3"
                                            MinWidth="44"
                                            MinHeight="44"
                                            Click="ConversationPin_Click"
                                            Tag="{x:Bind}"
                                            ToolTipService.ToolTip="{x:Bind PinActionText}"
                                            AutomationProperties.Name="{x:Bind PinActionAutomationName}">
                                            <FontIcon Glyph="{x:Bind PinActionGlyph}" FontSize="16" />
                                        </Button>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                        <InfoBar
                            x:Uid="ChatBrowserPinStorageError" desktop:DesktopLocalization.Bindings="Message=ChatBrowserPinStorageError.Message;Title=ChatBrowserPinStorageError.Title"
                            x:Name="PinStorageError"
                            Grid.Row="3"
                            AutomationProperties.LiveSetting="Polite"
                            IsClosable="False"
                            IsOpen="False"
                            Severity="Warning" />
                    </Grid>
                </Border>

                <Border
                    x:Name="MessagePane"
                    Grid.Column="1"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8">
                    <Grid Padding="16" RowSpacing="8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Button
                                x:Uid="ChatBrowserBack" desktop:DesktopLocalization.Bindings="AutomationProperties.Name=ChatBrowserBack.[using:Microsoft.UI.Xaml.Automation]AutomationProperties.Name"
                                x:Name="BackButton"
                                MinWidth="44"
                                MinHeight="44"
                                Click="Back_Click"
                                Visibility="Collapsed">
                                <FontIcon Glyph="&#xE72B;" FontSize="16" />
                            </Button>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                <TextBlock
                                    x:Name="ConversationTitle"
                                    FontSize="20"
                                    FontWeight="SemiBold"
                                    TextTrimming="CharacterEllipsis" />
                                <TextBlock
                                    x:Uid="ChatBrowserConversationReadOnly" desktop:DesktopLocalization.Bindings="Text=ChatBrowserConversationReadOnly.Text"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                            <Button
                                x:Uid="ChatBrowserMembersButton" desktop:DesktopLocalization.Bindings="AutomationProperties.Name=ChatBrowserMembersButton.[using:Microsoft.UI.Xaml.Automation]AutomationProperties.Name;ToolTipService.ToolTip=ChatBrowserMembersButton.[using:Microsoft.UI.Xaml.Controls]ToolTipService.ToolTip"
                                x:Name="MembersButton"
                                Grid.Column="2"
                                MinWidth="44"
                                MinHeight="44"
                                Click="Members_Click"
                                Visibility="Collapsed">
                                <FontIcon Glyph="&#xE902;" FontSize="16" />
                            </Button>
                            <Button
                                x:Uid="ChatBrowserAnnouncementsButton" desktop:DesktopLocalization.Bindings="AutomationProperties.Name=ChatBrowserAnnouncementsButton.[using:Microsoft.UI.Xaml.Automation]AutomationProperties.Name;ToolTipService.ToolTip=ChatBrowserAnnouncementsButton.[using:Microsoft.UI.Xaml.Controls]ToolTipService.ToolTip"
                                x:Name="AnnouncementsButton"
                                Grid.Column="3"
                                MinWidth="44"
                                MinHeight="44"
                                Click="Announcements_Click"
                                Visibility="Collapsed">
                                <FontIcon Glyph="&#xE8BD;" FontSize="16" />
                            </Button>
                            <Button
                                x:Name="SelectedPinButton"
                                Grid.Column="4"
                                MinWidth="44"
                                MinHeight="44"
                                Click="SelectedPin_Click"
                                Visibility="Collapsed">
                                <FontIcon
                                    x:Name="SelectedPinIcon"
                                    Glyph="&#xE718;"
                                    FontSize="16" />
                            </Button>
                            <Button
                                x:Uid="ChatBrowserRefreshMessages" desktop:DesktopLocalization.Bindings="AutomationProperties.Name=ChatBrowserRefreshMessages.[using:Microsoft.UI.Xaml.Automation]AutomationProperties.Name"
                                x:Name="RefreshMessagesButton"
                                Grid.Column="5"
                                MinWidth="44"
                                MinHeight="44"
                                Click="RefreshMessages_Click">
                                <FontIcon Glyph="&#xE72C;" FontSize="16" />
                            </Button>
                        </Grid>

                        <StackPanel Grid.Row="1" Spacing="6">
                            <InfoBar
                                x:Uid="ChatBrowserMessageError" desktop:DesktopLocalization.Bindings="Message=ChatBrowserMessageError.Message;Title=ChatBrowserMessageError.Title"
                                x:Name="MessageError"
                                AutomationProperties.LiveSetting="Polite"
                                IsClosable="False"
                                IsOpen="False"
                                Severity="Warning" />
                            <InfoBar
                                x:Uid="ChatMessageDeleteReview" desktop:DesktopLocalization.Bindings="Message=ChatMessageDeleteReview.Message;Title=ChatMessageDeleteReview.Title"
                                x:Name="MessageDeleteReview"
                                AutomationProperties.LiveSetting="Assertive"
                                IsClosable="False"
                                IsOpen="False"
                                Severity="Warning" />
                            <InfoBar
                                x:Uid="ChatMessageDeleteError" desktop:DesktopLocalization.Bindings="Message=ChatMessageDeleteError.Message;Title=ChatMessageDeleteError.Title"
                                x:Name="MessageDeleteError"
                                AutomationProperties.LiveSetting="Polite"
                                IsClosable="True"
                                IsOpen="False"
                                Severity="Error" />
                        </StackPanel>

                        <Grid Grid.Row="2">
                            <StackPanel
                                x:Name="NoSelectionState"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                MaxWidth="420"
                                Spacing="8">
                                <FontIcon Glyph="&#xE8BD;" FontSize="40" />
                                <TextBlock
                                    x:Uid="ChatBrowserChooseConversationTitle" desktop:DesktopLocalization.Bindings="Text=ChatBrowserChooseConversationTitle.Text"
                                    FontSize="20"
                                    TextAlignment="Center" />
                                <TextBlock
                                    x:Uid="ChatBrowserChooseConversationMessage" desktop:DesktopLocalization.Bindings="Text=ChatBrowserChooseConversationMessage.Text"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    TextAlignment="Center"
                                    TextWrapping="Wrap" />
                            </StackPanel>

                            <StackPanel
                                x:Name="EncryptedState"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                MaxWidth="420"
                                Spacing="8"
                                Visibility="Collapsed">
                                <FontIcon Glyph="&#xE72E;" FontSize="40" />
                                <TextBlock
                                    x:Uid="ChatBrowserEncryptedTitle" desktop:DesktopLocalization.Bindings="Text=ChatBrowserEncryptedTitle.Text"
                                    FontSize="20"
                                    TextAlignment="Center" />
                                <TextBlock
                                    x:Uid="ChatBrowserEncryptedMessage" desktop:DesktopLocalization.Bindings="Text=ChatBrowserEncryptedMessage.Text"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    TextAlignment="Center"
                                    TextWrapping="Wrap" />
                            </StackPanel>

                            <StackPanel
                                x:Name="MessageLoadingState"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Spacing="12"
                                Visibility="Collapsed">
                                <ProgressRing Width="36" Height="36" IsActive="True" />
                                <TextBlock x:Uid="ChatBrowserMessagesLoading" desktop:DesktopLocalization.Bindings="Text=ChatBrowserMessagesLoading.Text" />
                            </StackPanel>

                            <StackPanel
                                x:Name="MessageEmptyState"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                MaxWidth="420"
                                Spacing="8"
                                Visibility="Collapsed">
                                <TextBlock x:Uid="ChatBrowserMessagesEmptyTitle" desktop:DesktopLocalization.Bindings="Text=ChatBrowserMessagesEmptyTitle.Text" FontSize="20" TextAlignment="Center" />
                                <TextBlock
                                    x:Uid="ChatBrowserMessagesEmptyMessage" desktop:DesktopLocalization.Bindings="Text=ChatBrowserMessagesEmptyMessage.Text"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    TextAlignment="Center"
                                    TextWrapping="Wrap" />
                            </StackPanel>

                            <Grid x:Name="MessagesState" Visibility="Collapsed">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <StackPanel HorizontalAlignment="Center" Spacing="6">
                                    <InfoBar
                                        x:Uid="ChatBrowserLoadEarlierError" desktop:DesktopLocalization.Bindings="Message=ChatBrowserLoadEarlierError.Message;Title=ChatBrowserLoadEarlierError.Title"
                                        x:Name="LoadEarlierError"
                                        AutomationProperties.LiveSetting="Polite"
                                        IsClosable="False"
                                        IsOpen="False"
                                        Severity="Warning" />
                                    <Button
                                        x:Uid="ChatBrowserLoadEarlier" desktop:DesktopLocalization.Bindings="Content=ChatBrowserLoadEarlier.Content;AutomationProperties.Name=ChatBrowserLoadEarlier.[using:Microsoft.UI.Xaml.Automation]AutomationProperties.Name"
                                        x:Name="LoadEarlierButton"
                                        MinHeight="44"
                                        Click="LoadEarlier_Click" />
                                    <ProgressRing
                                        x:Uid="ChatBrowserLoadEarlierProgress" desktop:DesktopLocalization.Bindings="AutomationProperties.Name=ChatBrowserLoadEarlierProgress.[using:Microsoft.UI.Xaml.Automation]AutomationProperties.Name"
                                        x:Name="LoadEarlierProgress"
                                        Width="24"
                                        Height="24"
                                        IsActive="False"
                                        Visibility="Collapsed" />
                                </StackPanel>
                                <ListView
                                    x:Uid="ChatBrowserMessageList" desktop:DesktopLocalization.Bindings="AutomationProperties.Name=ChatBrowserMessageList.[using:Microsoft.UI.Xaml.Automation]AutomationProperties.Name"
                                    x:Name="MessageList"
                                    Grid.Row="1"
                                    IsItemClickEnabled="False"
                                    ItemsSource="{Binding Messages}"
                                    SelectionMode="None">
                                    <ListView.ItemContainerStyle>
                                        <Style TargetType="ListViewItem">
                                            <Setter Property="IsTabStop" Value="False" />
                                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                        </Style>
                                    </ListView.ItemContainerStyle>
                                    <ListView.ItemTemplate>
                                        <DataTemplate x:DataType="chat:ChatMessageItem">
                                            <Border
                                                Margin="8,4"
                                                Padding="12,10"
                                                Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                                CornerRadius="8">
                                                <StackPanel Spacing="4">
                                                    <Grid ColumnSpacing="12">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock FontWeight="SemiBold" Text="{x:Bind Sender}" />
                                                        <TextBlock
                                                            Grid.Column="1"
                                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                            Text="{x:Bind SentAtText}" />
                                                        <Button
                                                            Grid.Column="2"
                                                            MinWidth="44"
                                                            MinHeight="44"
                                                            Click="DeleteMessage_Click"
                                                            Tag="{x:Bind}"
                                                            ToolTipService.ToolTip="{x:Bind DeleteActionText}"
                                                            AutomationProperties.Name="{x:Bind DeleteActionAutomationName}"
                                                            Visibility="{x:Bind DeleteVisibility}">
                                                            <FontIcon Glyph="&#xE74D;" FontSize="16" />
                                                        </Button>
                                                    </Grid>
                                                    <TextBlock Text="{x:Bind Text}" TextWrapping="WrapWholeWords" />
                                                    <ItemsControl ItemsSource="{x:Bind Attachments}">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate x:DataType="chat:ChatMessageAttachmentItem">
                                                                <Border
                                                                    Margin="0,4,0,0"
                                                                    Padding="8"
                                                                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                                                    BorderThickness="1"
                                                                    CornerRadius="6">
                                                                    <Grid ColumnSpacing="8">
                                                                        <Grid.ColumnDefinitions>
                                                                            <ColumnDefinition Width="*" />
                                                                            <ColumnDefinition Width="Auto" />
                                                                            <ColumnDefinition Width="Auto" />
                                                                        </Grid.ColumnDefinitions>
                                                                        <TextBlock
                                                                            VerticalAlignment="Center"
                                                                            Text="{x:Bind FileName}"
                                                                            TextTrimming="CharacterEllipsis" />
                                                                        <Button
                                                                            x:Uid="ChatAttachmentPreview" desktop:DesktopLocalization.Bindings="Content=ChatAttachmentPreview.Content;AutomationProperties.Name=ChatAttachmentPreview.[using:Microsoft.UI.Xaml.Automation]AutomationProperties.Name"
                                                                            Grid.Column="1"
                                                                            MinWidth="48"
                                                                            MinHeight="48"
                                                                            Click="AttachmentPreview_Click"
                                                                            Tag="{x:Bind}"
                                                                            Visibility="{x:Bind PreviewVisibility}" />
                                                                        <Button
                                                                            x:Uid="ChatAttachmentSave" desktop:DesktopLocalization.Bindings="Content=ChatAttachmentSave.Content;AutomationProperties.Name=ChatAttachmentSave.[using:Microsoft.UI.Xaml.Automation]AutomationProperties.Name"
                                                                            Grid.Column="2"
                                                                            MinWidth="48"
                                                                            MinHeight="48"
                                                                            Click="AttachmentSave_Click"
                                                                            IsEnabled="{x:Bind CanSave}"
                                                                            Tag="{x:Bind}" />
                                                                    </Grid>
                                                                </Border>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                            </Grid>
                        </Grid>
                        <Border
                            x:Name="ComposerPanel"
                            Grid.Row="3"
                            Padding="12"
                            Background="{ThemeResource LayerFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Visibility="Collapsed">
                            <Grid RowSpacing="8">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock
                                        x:Uid="ChatBrowserComposerLabel" desktop:DesktopLocalization.Bindings="Text=ChatBrowserComposerLabel.Text"
                                        VerticalAlignment="Center"
                                        FontWeight="SemiBold" />
                                    <Button
                                        x:Uid="ChatEmojiAction" desktop:DesktopLocalization.Bindings="AutomationProperties.Name=ChatEmojiAction.[using:Microsoft.UI.Xaml.Automation]AutomationProperties.Name"
                                        x:Name="EmojiButton"
                                        Grid.Column="1"
                                        MinWidth="48"
                                        MinHeight="48"
                                        Click="Emoji_Click"
                                        Visibility="Collapsed">
                                        <FontIcon Glyph="&#xE76E;" FontSize="16" />
                                    </Button>
                                    <Button
                                        x:Uid="ChatAttachmentChoose" desktop:DesktopLocalization.Bindings="Content=ChatAttachmentChoose.Content;AutomationProperties.Name=ChatAttachmentChoose.[using:Microsoft.UI.Xaml.Automation]AutomationProperties.Name"
                                        x:Name="ChooseAttachmentButton"
                                        Grid.Column="2"
                                        MinWidth="48"
                                        MinHeight="48"
                                        Click="ChooseAttachment_Click" />
                                </Grid>
                                <Border
                                    x:Name="AttachmentCard"
                                    Grid.Row="1"
                                    Padding="8"
                                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    Visibility="Collapsed">
                                    <Grid ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Spacing="2">
                                            <TextBlock
                                                x:Name="AttachmentName"
                                                FontWeight="SemiBold"
                                                TextTrimming="CharacterEllipsis" />
                                            <TextBlock
                                                x:Name="AttachmentSize"
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        </StackPanel>
                                        <Button
                                            x:Uid="ChatAttachmentRemove" desktop:DesktopLocalization.Bindings="Content=ChatAttachmentRemove.Content;AutomationProperties.Name=ChatAttachmentRemove.[using:Microsoft.UI.Xaml.Automation]AutomationProperties.Name"
                                            x:Name="RemoveAttachmentButton"
                                            Grid.Column="1"
                                            MinWidth="48"
                                            MinHeight="48"
                                            Click="RemoveAttachment_Click"
                                            Visibility="Collapsed" />
                                        <Button
                                            x:Uid="ChatAttachmentCancel" desktop:DesktopLocalization.Bindings="Content=ChatAttachmentCancel.Content;AutomationProperties.Name=ChatAttachmentCancel.[using:Microsoft.UI.Xaml.Automation]AutomationProperties.Name"
                                            x:Name="CancelAttachmentButton"
                                            Grid.Column="2"
                                            MinWidth="48"
                                            MinHeight="48"
                                            Click="CancelAttachment_Click"
                                            Visibility="Collapsed" />
                                    </Grid>
                                </Border>
                                <Grid Grid.Row="2" ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox
                                        x:Uid="ChatBrowserComposer" desktop:DesktopLocalization.Bindings="PlaceholderText=ChatBrowserComposer.PlaceholderText;AutomationProperties.Name=ChatBrowserComposer.[using:Microsoft.UI.Xaml.Automation]AutomationProperties.Name"
                                        x:Name="ComposerInput"
                                        AcceptsReturn="True"
                                        MaxHeight="120"
                                        MinHeight="48"
                                        TextChanged="ComposerInput_TextChanged"
                                        TextWrapping="Wrap" />
                                    <Button
                                        x:Uid="ChatBrowserSend" desktop:DesktopLocalization.Bindings="Content=ChatBrowserSend.Content;AutomationProperties.Name=ChatBrowserSend.[using:Microsoft.UI.Xaml.Automation]AutomationProperties.Name"
                                        x:Name="SendMessageButton"
                                        Grid.Column="1"
                                        MinWidth="72"
                                        MinHeight="48"
                                        Click="SendMessage_Click" />
                                </Grid>
                                <Grid Grid.Row="3" ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <ProgressRing
                                        x:Uid="ChatBrowserSendProgress" desktop:DesktopLocalization.Bindings="AutomationProperties.Name=ChatBrowserSendProgress.[using:Microsoft.UI.Xaml.Automation]AutomationProperties.Name"
                                        x:Name="SendMessageProgress"
                                        Width="20"
                                        Height="20"
                                        IsActive="False"
                                        Visibility="Collapsed" />
                                    <ProgressRing
                                        x:Uid="ChatAttachmentProgress" desktop:DesktopLocalization.Bindings="AutomationProperties.Name=ChatAttachmentProgress.[using:Microsoft.UI.Xaml.Automation]AutomationProperties.Name"
                                        x:Name="AttachmentProgress"
                                        Width="20"
                                        Height="20"
                                        IsActive="False"
                                        Visibility="Collapsed" />
                                    <TextBlock
                                        x:Uid="ChatBrowserSendStatus" desktop:DesktopLocalization.Bindings="AutomationProperties.Name=ChatBrowserSendStatus.[using:Microsoft.UI.Xaml.Automation]AutomationProperties.Name"
                                        x:Name="ComposerStatus"
                                        Grid.Column="1"
                                        AutomationProperties.LiveSetting="Polite"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        TextWrapping="Wrap"
                                        Visibility="Collapsed" />
                                </Grid>
                                <InfoBar
                                    x:Name="AttachmentFeedback"
                                    Grid.Row="4"
                                    AutomationProperties.LiveSetting="Polite"
                                    IsClosable="True"
                                    IsOpen="False"
                                    Severity="Informational" />
                            </Grid>
                        </Border>
                    </Grid>
                </Border>
            </Grid>

            <StackPanel x:Name="LoadingState" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12">
                <ProgressRing Width="40" Height="40" IsActive="True" />
                <TextBlock x:Uid="ChatBrowserLoading" desktop:DesktopLocalization.Bindings="Text=ChatBrowserLoading.Text" />
            </StackPanel>

            <StackPanel x:Name="EmptyState" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="440" Spacing="8" Visibility="Collapsed">
                <TextBlock x:Uid="ChatBrowserEmptyTitle" desktop:DesktopLocalization.Bindings="Text=ChatBrowserEmptyTitle.Text" FontSize="20" TextAlignment="Center" />
                <TextBlock x:Uid="ChatBrowserEmptyMessage" desktop:DesktopLocalization.Bindings="Text=ChatBrowserEmptyMessage.Text" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextAlignment="Center" TextWrapping="Wrap" />
                <Button x:Uid="ChatBrowserEmptyRefresh" desktop:DesktopLocalization.Bindings="Content=ChatBrowserEmptyRefresh.Content" MinHeight="44" HorizontalAlignment="Center" Click="Refresh_Click" />
            </StackPanel>

            <StackPanel x:Name="FilteredEmptyState" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="440" Spacing="8" Visibility="Collapsed">
                <TextBlock x:Uid="ChatBrowserFilteredEmptyTitle" desktop:DesktopLocalization.Bindings="Text=ChatBrowserFilteredEmptyTitle.Text" FontSize="20" TextAlignment="Center" />
                <TextBlock x:Uid="ChatBrowserFilteredEmptyMessage" desktop:DesktopLocalization.Bindings="Text=ChatBrowserFilteredEmptyMessage.Text" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextAlignment="Center" TextWrapping="Wrap" />
                <Button x:Uid="ChatBrowserClearSearch" desktop:DesktopLocalization.Bindings="Content=ChatBrowserClearSearch.Content" MinHeight="44" HorizontalAlignment="Center" Click="ClearSearch_Click" />
            </StackPanel>

            <StackPanel x:Name="ErrorState" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="440" Spacing="8" Visibility="Collapsed">
                <TextBlock x:Uid="ChatBrowserErrorTitle" desktop:DesktopLocalization.Bindings="Text=ChatBrowserErrorTitle.Text" FontSize="20" TextAlignment="Center" />
                <TextBlock x:Uid="ChatBrowserErrorMessage" desktop:DesktopLocalization.Bindings="Text=ChatBrowserErrorMessage.Text" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextAlignment="Center" TextWrapping="Wrap" />
                <Button x:Uid="ChatBrowserRetry" desktop:DesktopLocalization.Bindings="Content=ChatBrowserRetry.Content" MinHeight="44" HorizontalAlignment="Center" Click="Refresh_Click" />
            </StackPanel>

            <StackPanel x:Name="UnavailableState" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="440" Spacing="8" Visibility="Collapsed">
                <TextBlock x:Uid="ChatBrowserUnavailableTitle" desktop:DesktopLocalization.Bindings="Text=ChatBrowserUnavailableTitle.Text" FontSize="20" TextAlignment="Center" />
                <TextBlock x:Uid="ChatBrowserUnavailableMessage" desktop:DesktopLocalization.Bindings="Text=ChatBrowserUnavailableMessage.Text" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextAlignment="Center" TextWrapping="Wrap" />
            </StackPanel>

            <StackPanel x:Name="ValidationState" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="440" Spacing="8" Visibility="Collapsed">
                <TextBlock x:Uid="ChatBrowserValidationTitle" desktop:DesktopLocalization.Bindings="Text=ChatBrowserValidationTitle.Text" FontSize="20" TextAlignment="Center" />
                <TextBlock x:Uid="ChatBrowserValidationMessage" desktop:DesktopLocalization.Bindings="Text=ChatBrowserValidationMessage.Text" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextAlignment="Center" TextWrapping="Wrap" />
            </StackPanel>
        </Grid>
    </Grid>
</Page>
