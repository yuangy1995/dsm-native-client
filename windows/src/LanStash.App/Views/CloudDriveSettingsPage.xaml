<Page
    x:Class="LanStash.App.Views.CloudDriveSettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{ThemeResource WorkspaceSurfaceBrush}">
    <Page.Resources>
        <Style x:Key="CloudDriveMappingCard" TargetType="Border">
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
        </Style>
    </Page.Resources>
    <ScrollViewer>
        <StackPanel
            MaxWidth="720"
            Margin="32"
            HorizontalAlignment="Left"
            Spacing="16">
            <Button x:Name="BackButton" MinHeight="44" Click="BackButton_Click" />
            <TextBlock x:Name="TitleText" AutomationProperties.HeadingLevel="Level1" Style="{StaticResource TitleTextBlockStyle}" />
            <InfoBar x:Name="ValidationNotice" IsOpen="True" IsClosable="False" Severity="Informational">
                <InfoBar.ActionButton>
                    <Button x:Name="EnableTestButton" MinHeight="44" Click="EnableTestButton_Click" />
                </InfoBar.ActionButton>
            </InfoBar>
            <Border
                Padding="20"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="12">
                <StackPanel Spacing="12">
                    <TextBlock
                        x:Name="CloudDriveDescription"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        TextWrapping="Wrap" />
                    <TextBox x:Name="MappingNameTextBox" />
                    <TextBox
                        x:Name="FolderPathTextBox"
                        Header=""
                        PlaceholderText=""
                        AutomationProperties.Name="" />
                    <ComboBox
                        x:Name="CacheLimitSelector"
                        MinWidth="220"
                        DisplayMemberPath="DisplayName" />
                    <CheckBox x:Name="LaunchAtLoginChoice" MinHeight="44" IsChecked="False" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock
                            x:Name="CacheDiskText"
                            VerticalAlignment="Center" />
                        <Button
                            x:Name="ChooseCacheDiskButton"
                            Click="ChooseCacheDiskButton_Click" />
                        <Button
                            x:Name="UseDefaultCacheDiskButton"
                            Click="UseDefaultCacheDiskButton_Click"
                            Visibility="Collapsed" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button
                            x:Name="AddNasButton"
                            Click="AddNasButton_Click"
                            Style="{StaticResource AccentButtonStyle}" />
                        <Button
                            x:Name="AddFolderButton"
                            Click="AddFolderButton_Click" />
                        <ProgressRing
                            x:Name="CloudDriveProgress"
                            Width="20"
                            Height="20"
                            IsActive="False"
                            Visibility="Collapsed" />
                    </StackPanel>
                    <InfoBar
                        x:Name="CloudDriveMessage"
                        IsOpen="False"
                        IsClosable="True">
                        <InfoBar.ActionButton>
                            <Button x:Name="CancelRefreshButton" MinHeight="44" Visibility="Collapsed" Click="CancelRefresh_Click" />
                        </InfoBar.ActionButton>
                    </InfoBar>
                    <ContentControl x:Name="MappingsHost" HorizontalContentAlignment="Stretch">
                        <StackPanel x:Name="CloudDriveList" Spacing="8" />
                    </ContentControl>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
