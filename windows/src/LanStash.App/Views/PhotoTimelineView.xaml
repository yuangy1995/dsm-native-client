<UserControl
    x:Class="LanStash.App.Views.PhotoTimelineView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:timeline="using:LanStash.App.Features.Photos.Timeline">
    <UserControl.Resources>
        <CollectionViewSource x:Key="TimelineCollection" IsSourceGrouped="True" ItemsPath="Items" />
    </UserControl.Resources>
    <Grid RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <ScrollViewer
            HorizontalScrollBarVisibility="Auto"
            HorizontalScrollMode="Enabled"
            VerticalScrollBarVisibility="Disabled"
            VerticalScrollMode="Disabled">
        <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox x:Uid="PhotoTimelineSearch" x:Name="SearchBox" MinHeight="44"
                     TextChanged="SearchBox_TextChanged" />
            <ComboBox x:Uid="PhotoTimelineFilter" x:Name="FilterPicker" Grid.Column="1"
                      MinWidth="140" MinHeight="44" SelectionChanged="FilterPicker_SelectionChanged">
                <ComboBoxItem x:Uid="PhotoTimelineFilterAll" Tag="All" MinHeight="44" />
                <ComboBoxItem x:Uid="PhotoTimelineFilterImages" Tag="Images" MinHeight="44" />
                <ComboBoxItem x:Uid="PhotoTimelineFilterVideos" Tag="Videos" MinHeight="44" />
            </ComboBox>
            <Button x:Uid="PhotoTimelineRefresh" x:Name="RefreshButton" Grid.Column="2"
                    MinHeight="44" Click="Refresh_Click" />
            <Button x:Uid="PhotoTimelineOpen" x:Name="OpenButton" Grid.Column="3"
                    MinHeight="44" Click="Open_Click" />
            <Button x:Uid="PhotoTimelineSave" x:Name="SaveButton" Grid.Column="4"
                    MinHeight="44" Click="Save_Click" />
            <Button x:Uid="PhotoBrowserSaveMultiple" x:Name="SaveMultipleButton" Grid.Column="5"
                    MinHeight="44" Click="SaveMultiple_Click" Visibility="Collapsed" />
            <Button x:Uid="PhotoBrowserSaveSelected" x:Name="SaveSelectedItemsButton" Grid.Column="6"
                    MinHeight="44" Click="SaveSelectedItems_Click" Visibility="Collapsed" />
            <Button x:Uid="FileCopyMoveMove" x:Name="MoveButton" Grid.Column="7"
                    MinHeight="44" Click="Move_Click" Visibility="Collapsed" />
            <Button x:Name="RestoreButton" Grid.Column="8"
                    MinHeight="44" Click="Restore_Click" Visibility="Collapsed" />
            <Button x:Name="MoveToRecycleButton" Grid.Column="9"
                    MinHeight="44" Click="MoveToRecycle_Click" Visibility="Collapsed" />
            <Button x:Uid="FileCopyMoveCopyMultiple" x:Name="CopyMultipleButton" Grid.Column="10"
                    MinHeight="44" Click="CopyMultiple_Click" Visibility="Collapsed" />
            <Button x:Uid="FileCopyMoveCopySelected" x:Name="CopySelectedItemsButton" Grid.Column="11"
                    MinHeight="44" Click="CopySelectedItems_Click" Visibility="Collapsed" />
            <Button x:Uid="FileCopyMoveMoveMultiple" x:Name="MoveMultipleButton" Grid.Column="12"
                    MinHeight="44" Click="MoveMultiple_Click" Visibility="Collapsed" />
            <Button x:Uid="FileCopyMoveMoveSelected" x:Name="MoveSelectedItemsButton" Grid.Column="13"
                    MinHeight="44" Click="MoveSelectedItems_Click" Visibility="Collapsed" />
            <Button x:Name="MoveMultipleToRecycleButton" Grid.Column="14"
                    MinHeight="44" Click="MoveMultipleToRecycle_Click" Visibility="Collapsed" />
            <Button x:Name="MoveSelectedToRecycleButton" Grid.Column="15"
                    MinHeight="44" Click="MoveSelectedToRecycle_Click" Visibility="Collapsed" />
            <Button x:Name="CancelRecycleSelectionButton" Grid.Column="16"
                    MinHeight="44" Click="CancelBatchSelection_Click" Visibility="Collapsed" />
        </Grid>
        </ScrollViewer>

        <StackPanel Grid.Row="1" Spacing="8">
            <StackPanel Orientation="Horizontal" Spacing="12">
                <ProgressRing x:Name="RefreshProgress" Width="24" Height="24" VerticalAlignment="Center"
                              IsActive="False" Visibility="Collapsed" />
                <Button x:Uid="PhotoTimelineCancel" x:Name="RefreshCancelButton" MinHeight="44"
                        Visibility="Collapsed" Click="Cancel_Click" />
            </StackPanel>
            <InfoBar x:Uid="PhotoTimelineTruncated" x:Name="TruncatedNotice" IsClosable="False"
                     IsOpen="False" Severity="Warning" AutomationProperties.LiveSetting="Polite" />
            <InfoBar x:Uid="PhotoTimelinePartial" x:Name="PartialNotice" IsClosable="False"
                     IsOpen="False" Severity="Warning" AutomationProperties.LiveSetting="Polite" />
            <InfoBar x:Uid="PhotoTimelineRefreshFailed" x:Name="RefreshFailedNotice" IsClosable="False"
                     IsOpen="False" Severity="Warning" AutomationProperties.LiveSetting="Polite" />
            <InfoBar x:Uid="PhotoBatchStatus" x:Name="RecycleBatchStatus" IsClosable="False"
                     IsOpen="False" AutomationProperties.LiveSetting="Polite" />
        </StackPanel>

        <Grid Grid.Row="2">
            <GridView x:Uid="PhotoTimelineGrid" x:Name="TimelineGrid" Visibility="Collapsed"
                      ItemsSource="{Binding Source={StaticResource TimelineCollection}}"
                      ContainerContentChanging="TimelineGrid_ContainerContentChanging"
                      DoubleTapped="TimelineGrid_DoubleTapped"
                      SelectionChanged="TimelineGrid_SelectionChanged" SelectionMode="Single">
                <GridView.KeyboardAccelerators>
                    <KeyboardAccelerator Key="Enter" Invoked="OpenAccelerator_Invoked" />
                </GridView.KeyboardAccelerators>
                <GridView.ItemsPanel><ItemsPanelTemplate><ItemsWrapGrid Orientation="Horizontal" /></ItemsPanelTemplate></GridView.ItemsPanel>
                <GridView.GroupStyle>
                    <GroupStyle>
                        <GroupStyle.HeaderTemplate>
                            <DataTemplate x:DataType="timeline:PhotoTimelineGroup">
                                <TextBlock Text="{x:Bind Title}" Style="{ThemeResource SubtitleTextBlockStyle}"
                                           AutomationProperties.HeadingLevel="Level2" Margin="8,16,8,8" />
                            </DataTemplate>
                        </GroupStyle.HeaderTemplate>
                    </GroupStyle>
                </GridView.GroupStyle>
                <GridView.ItemTemplate>
                    <DataTemplate x:DataType="timeline:PhotoTimelineEntry">
                        <Grid Width="184" Height="184" Padding="8" RowSpacing="8">
                            <Grid.RowDefinitions><RowDefinition Height="132" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                            <Border Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}" CornerRadius="8">
                                <Grid>
                                    <FontIcon x:Name="TimelinePlaceholder" Glyph="&#xEB9F;" FontSize="38"
                                              HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    <Image x:Name="TimelineThumbnail" Tag="{Binding}" Stretch="UniformToFill"
                                           Loaded="Thumbnail_Loaded" Unloaded="Thumbnail_Unloaded" />
                                </Grid>
                            </Border>
                            <TextBlock Grid.Row="1" Text="{x:Bind Name}" MaxLines="2" TextWrapping="Wrap"
                                       TextTrimming="CharacterEllipsis" TextAlignment="Center" />
                        </Grid>
                    </DataTemplate>
                </GridView.ItemTemplate>
            </GridView>

            <StackPanel x:Name="IdleState" MaxWidth="440" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8">
                <TextBlock x:Uid="PhotoTimelineIdleTitle" Style="{ThemeResource SubtitleTextBlockStyle}"
                           TextAlignment="Center" AutomationProperties.HeadingLevel="Level1" />
                <TextBlock x:Uid="PhotoTimelineIdleMessage" TextWrapping="Wrap" TextAlignment="Center"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <Button x:Uid="PhotoTimelineScan" MinHeight="44" HorizontalAlignment="Center" Click="Refresh_Click" />
            </StackPanel>
            <StackPanel x:Name="LoadingState" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12">
                <ProgressRing Width="40" Height="40" IsActive="True" />
                <TextBlock x:Uid="PhotoTimelineLoading" AutomationProperties.LiveSetting="Polite" />
                <Button x:Uid="PhotoTimelineCancel" MinHeight="44" Click="Cancel_Click" />
            </StackPanel>
            <StackPanel x:Name="EmptyState" Visibility="Collapsed" MaxWidth="440" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8">
                <TextBlock x:Uid="PhotoTimelineEmptyTitle" Style="{ThemeResource SubtitleTextBlockStyle}" TextAlignment="Center"
                           AutomationProperties.HeadingLevel="Level1" />
                <TextBlock x:Uid="PhotoTimelineEmptyMessage" TextWrapping="Wrap" TextAlignment="Center" />
                <Button x:Uid="PhotoTimelineRefresh" MinHeight="44" Click="Refresh_Click" />
            </StackPanel>
            <StackPanel x:Name="FilteredEmptyState" Visibility="Collapsed" MaxWidth="440" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8">
                <TextBlock x:Uid="PhotoTimelineFilteredEmptyTitle" Style="{ThemeResource SubtitleTextBlockStyle}" TextAlignment="Center"
                           AutomationProperties.HeadingLevel="Level1" />
                <TextBlock x:Uid="PhotoTimelineFilteredEmptyMessage" TextWrapping="Wrap" TextAlignment="Center" />
                <Button x:Uid="PhotoTimelineClearFilters" MinHeight="44" Click="ClearFilters_Click" />
            </StackPanel>
            <StackPanel x:Name="ErrorState" Visibility="Collapsed" MaxWidth="440" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8">
                <TextBlock x:Uid="PhotoTimelineErrorTitle" Style="{ThemeResource SubtitleTextBlockStyle}" TextAlignment="Center"
                           AutomationProperties.HeadingLevel="Level1" AutomationProperties.LiveSetting="Polite" />
                <TextBlock x:Uid="PhotoTimelineErrorMessage" TextWrapping="Wrap" TextAlignment="Center" />
                <Button x:Uid="PhotoTimelineRetry" MinHeight="44" Click="Refresh_Click" />
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
