<Page
    x:Class="LanStash.App.Views.ContainerManagerPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:desktop="using:LanStash.App.Presentation"
    xmlns:containers="using:LanStash.App.Features.Containers"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
    SizeChanged="Page_SizeChanged">
    <Page.KeyboardAccelerators>
        <KeyboardAccelerator Key="Left" Modifiers="Menu" Invoked="BackAccelerator_Invoked" />
        <KeyboardAccelerator Key="F5" Invoked="RefreshAccelerator_Invoked" />
    </Page.KeyboardAccelerators>
    <Page.Resources>
        <DataTemplate x:Key="ContainerResourceTemplate" x:DataType="containers:ContainerResourceItem">
            <Grid Padding="4,10" ColumnSpacing="12" AutomationProperties.Name="{x:Bind AutomationName}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock FontWeight="SemiBold" Text="{x:Bind Name}" TextWrapping="Wrap" />
                <TextBlock Grid.Column="1" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{x:Bind StatusText}" TextWrapping="Wrap" />
            </Grid>
        </DataTemplate>
        <DataTemplate x:Key="ContainerEventTemplate" x:DataType="containers:ContainerEventItem">
            <Grid Padding="4,10" ColumnSpacing="12" AutomationProperties.Name="{x:Bind AutomationName}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock FontWeight="SemiBold" Text="{x:Bind TimeText}" TextWrapping="Wrap" />
                <TextBlock Grid.Column="1" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{x:Bind LevelText}" TextWrapping="Wrap" />
            </Grid>
        </DataTemplate>
    </Page.Resources>

    <Grid Padding="24,20,24,16" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Spacing="4">
                <TextBlock
                    x:Uid="ContainerManagerTitle" desktop:DesktopLocalization.Bindings="Text=ContainerManagerTitle.Text"
                    Style="{StaticResource TitleTextBlockStyle}"
                    AutomationProperties.HeadingLevel="Level1" />
                <TextBlock
                    x:Uid="ContainerManagerDescription" desktop:DesktopLocalization.Bindings="Text=ContainerManagerDescription.Text"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    TextWrapping="Wrap" />
            </StackPanel>
            <Button
                x:Uid="ContainerManagerRefresh" desktop:DesktopLocalization.Bindings="AutomationProperties.Name=ContainerManagerRefresh.AutomationProperties.Name"
                x:Name="RefreshButton"
                Grid.Column="1"
                MinHeight="44"
                Click="Refresh_Click">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE72C;" FontSize="16" />
                    <TextBlock x:Uid="ContainerManagerRefreshLabel" desktop:DesktopLocalization.Bindings="Text=ContainerManagerRefreshLabel.Text" />
                </StackPanel>
            </Button>
        </Grid>

        <InfoBar
            x:Uid="ContainerManagerReadOnly" desktop:DesktopLocalization.Bindings="Message=ContainerManagerReadOnly.Message;Title=ContainerManagerReadOnly.Title"
            Grid.Row="1"
            IsClosable="False"
            IsOpen="True"
            Severity="Informational" />

        <InfoBar
            x:Uid="ContainerManagerRefreshError" desktop:DesktopLocalization.Bindings="Message=ContainerManagerRefreshError.Message;Title=ContainerManagerRefreshError.Title"
            x:Name="RefreshErrorNotice"
            Grid.Row="2"
            AutomationProperties.LiveSetting="Polite"
            IsClosable="False"
            IsOpen="False"
            Severity="Warning" />

        <InfoBar
            x:Uid="ContainerManagerSessionExpired" desktop:DesktopLocalization.Bindings="Message=ContainerManagerSessionExpired.Message;Title=ContainerManagerSessionExpired.Title"
            x:Name="SessionExpiredNotice"
            Grid.Row="2"
            AutomationProperties.LiveSetting="Assertive"
            IsClosable="False"
            IsOpen="False"
            Severity="Error" />

        <Pivot x:Name="SectionPivot" Grid.Row="3">
            <PivotItem x:Uid="ContainerManagerContainersTab" desktop:DesktopLocalization.Bindings="Header=ContainerManagerContainersTab.Header">
        <Grid>
            <Grid
                x:Name="ContentState"
                ColumnSpacing="12"
                AutomationProperties.LiveSetting="Polite"
                Visibility="Collapsed">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="ListColumn" Width="360" />
                    <ColumnDefinition x:Name="DetailColumn" Width="*" />
                </Grid.ColumnDefinitions>

                <Border
                    x:Name="ListPane"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8">
                    <Grid Padding="12" RowSpacing="8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <ComboBox
                            x:Uid="ContainerManagerFilter" desktop:DesktopLocalization.Bindings="Header=ContainerManagerFilter.Header"
                            x:Name="FilterPicker"
                            MinHeight="44"
                            HorizontalAlignment="Stretch"
                            SelectedIndex="0"
                            SelectionChanged="FilterPicker_SelectionChanged">
                            <ComboBoxItem x:Uid="ContainerManagerFilterAll" desktop:DesktopLocalization.Bindings="Content=ContainerManagerFilterAll.Content" Tag="All" />
                            <ComboBoxItem x:Uid="ContainerManagerFilterRunning" desktop:DesktopLocalization.Bindings="Content=ContainerManagerFilterRunning.Content" Tag="Running" />
                            <ComboBoxItem x:Uid="ContainerManagerFilterStopped" desktop:DesktopLocalization.Bindings="Content=ContainerManagerFilterStopped.Content" Tag="Stopped" />
                            <ComboBoxItem x:Uid="ContainerManagerFilterAttention" desktop:DesktopLocalization.Bindings="Content=ContainerManagerFilterAttention.Content" Tag="Attention" />
                        </ComboBox>
                        <ListView
                            x:Uid="ContainerManagerList" desktop:DesktopLocalization.Bindings="AutomationProperties.Name=ContainerManagerList.AutomationProperties.Name"
                            x:Name="ContainerList"
                            Grid.Row="1"
                            IsItemClickEnabled="True"
                            ItemClick="ContainerList_ItemClick"
                            ItemsSource="{Binding Containers}"
                            SelectionMode="Single">
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem">
                                    <Setter Property="MinHeight" Value="72" />
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                </Style>
                            </ListView.ItemContainerStyle>
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="containers:ContainerItem">
                                    <Grid
                                        Padding="4,8"
                                        ColumnSpacing="12"
                                        AutomationProperties.Name="{x:Bind AutomationName}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Spacing="4">
                                            <TextBlock
                                                FontWeight="SemiBold"
                                                Text="{x:Bind Name}"
                                                TextTrimming="CharacterEllipsis"
                                                TextWrapping="Wrap" />
                                            <TextBlock
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                MaxLines="1"
                                                Text="{x:Bind ImageText}"
                                                TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                        <TextBlock
                                            Grid.Column="1"
                                            VerticalAlignment="Center"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            Text="{x:Bind StatusText}" />
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Grid>
                </Border>

                <Border
                    x:Name="DetailPane"
                    Grid.Column="1"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8">
                    <Grid Padding="20">
                        <StackPanel
                            x:Name="NoSelectionState"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            MaxWidth="420"
                            Spacing="8">
                            <FontIcon Glyph="&#xE7B8;" FontSize="40" />
                            <TextBlock
                                x:Uid="ContainerManagerChooseItemTitle" desktop:DesktopLocalization.Bindings="Text=ContainerManagerChooseItemTitle.Text"
                                HorizontalAlignment="Center"
                                Style="{StaticResource SubtitleTextBlockStyle}"
                                TextAlignment="Center"
                                AutomationProperties.HeadingLevel="Level2" />
                            <TextBlock
                                x:Uid="ContainerManagerChooseItemMessage" desktop:DesktopLocalization.Bindings="Text=ContainerManagerChooseItemMessage.Text"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                TextAlignment="Center"
                                TextWrapping="Wrap" />
                        </StackPanel>

                        <Grid
                            x:Name="DetailState"
                            AutomationProperties.LiveSetting="Polite"
                            Visibility="Collapsed">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Button
                                    x:Uid="ContainerManagerBack" desktop:DesktopLocalization.Bindings="AutomationProperties.Name=ContainerManagerBack.AutomationProperties.Name"
                                    x:Name="BackButton"
                                    MinWidth="44"
                                    MinHeight="44"
                                    Click="Back_Click"
                                    Visibility="Collapsed">
                                    <FontIcon Glyph="&#xE72B;" FontSize="16" />
                                </Button>
                                <TextBlock
                                    Grid.Column="1"
                                    VerticalAlignment="Center"
                                    FontSize="20"
                                    FontWeight="SemiBold"
                                    Text="{Binding SelectedContainer.Name}"
                                    TextTrimming="CharacterEllipsis"
                                    TextWrapping="Wrap"
                                    AutomationProperties.HeadingLevel="Level2" />
                            </Grid>
                            <Grid Grid.Row="1" Padding="0,20,0,0" ColumnSpacing="24" RowSpacing="14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock x:Uid="ContainerManagerDetailName" desktop:DesktopLocalization.Bindings="Text=ContainerManagerDetailName.Text" FontWeight="SemiBold" />
                                <TextBlock Grid.Column="1" Text="{Binding SelectedContainer.Name}" TextWrapping="Wrap" />
                                <TextBlock x:Uid="ContainerManagerDetailStatus" desktop:DesktopLocalization.Bindings="Text=ContainerManagerDetailStatus.Text" Grid.Row="1" FontWeight="SemiBold" />
                                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding SelectedContainer.StatusText}" TextWrapping="Wrap" />
                                <TextBlock x:Uid="ContainerManagerDetailImage" desktop:DesktopLocalization.Bindings="Text=ContainerManagerDetailImage.Text" Grid.Row="2" FontWeight="SemiBold" />
                                <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding SelectedContainer.ImageText}" TextWrapping="Wrap" />
                            </Grid>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>

            <StackPanel
                x:Name="LoadingState"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Spacing="12">
                <ProgressRing Width="40" Height="40" IsActive="True" />
                <TextBlock x:Uid="ContainerManagerLoading" desktop:DesktopLocalization.Bindings="Text=ContainerManagerLoading.Text" AutomationProperties.LiveSetting="Polite" />
            </StackPanel>

            <StackPanel x:Name="EmptyState" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="440" Spacing="8" Visibility="Collapsed">
                <TextBlock x:Uid="ContainerManagerEmptyTitle" desktop:DesktopLocalization.Bindings="Text=ContainerManagerEmptyTitle.Text" FontSize="20" FontWeight="SemiBold" TextAlignment="Center" AutomationProperties.HeadingLevel="Level2" />
                <TextBlock x:Uid="ContainerManagerEmptyMessage" desktop:DesktopLocalization.Bindings="Text=ContainerManagerEmptyMessage.Text" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextAlignment="Center" TextWrapping="Wrap" />
            </StackPanel>

            <StackPanel x:Name="FilteredEmptyState" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="440" Spacing="12" Visibility="Collapsed">
                <TextBlock x:Uid="ContainerManagerFilteredEmptyTitle" desktop:DesktopLocalization.Bindings="Text=ContainerManagerFilteredEmptyTitle.Text" FontSize="20" FontWeight="SemiBold" TextAlignment="Center" AutomationProperties.HeadingLevel="Level2" />
                <TextBlock x:Uid="ContainerManagerFilteredEmptyMessage" desktop:DesktopLocalization.Bindings="Text=ContainerManagerFilteredEmptyMessage.Text" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextAlignment="Center" TextWrapping="Wrap" />
                <Button x:Uid="ContainerManagerShowAll" desktop:DesktopLocalization.Bindings="Content=ContainerManagerShowAll.Content" MinHeight="44" HorizontalAlignment="Center" Click="ShowAll_Click" />
            </StackPanel>

            <StackPanel x:Name="ErrorState" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="440" Spacing="8" Visibility="Collapsed">
                <TextBlock x:Uid="ContainerManagerErrorTitle" desktop:DesktopLocalization.Bindings="Text=ContainerManagerErrorTitle.Text" FontSize="20" FontWeight="SemiBold" TextAlignment="Center" AutomationProperties.HeadingLevel="Level2" />
                <TextBlock x:Uid="ContainerManagerErrorMessage" desktop:DesktopLocalization.Bindings="Text=ContainerManagerErrorMessage.Text" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextAlignment="Center" TextWrapping="Wrap" />
            </StackPanel>

            <StackPanel x:Name="UnavailableState" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="440" Spacing="8" Visibility="Collapsed">
                <TextBlock x:Uid="ContainerManagerUnavailableTitle" desktop:DesktopLocalization.Bindings="Text=ContainerManagerUnavailableTitle.Text" FontSize="20" FontWeight="SemiBold" TextAlignment="Center" AutomationProperties.HeadingLevel="Level2" />
                <TextBlock x:Uid="ContainerManagerUnavailableMessage" desktop:DesktopLocalization.Bindings="Text=ContainerManagerUnavailableMessage.Text" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextAlignment="Center" TextWrapping="Wrap" />
            </StackPanel>
        </Grid>
            </PivotItem>
            <PivotItem x:Uid="ContainerManagerImagesTab" desktop:DesktopLocalization.Bindings="Header=ContainerManagerImagesTab.Header">
                <Grid AutomationProperties.LiveSetting="Polite">
                    <ListView x:Uid="ContainerManagerImagesList" desktop:DesktopLocalization.Bindings="AutomationProperties.Name=ContainerManagerImagesList.AutomationProperties.Name" x:Name="ImagesList" ItemsSource="{Binding Images}" ItemTemplate="{StaticResource ContainerResourceTemplate}" SelectionMode="None" />
                    <StackPanel x:Name="ImagesLoadingState" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8"><ProgressRing Width="30" Height="30" IsActive="True" /><TextBlock x:Uid="ContainerManagerSectionLoading" desktop:DesktopLocalization.Bindings="Text=ContainerManagerSectionLoading.Text" TextWrapping="Wrap" /></StackPanel>
                    <StackPanel x:Name="ImagesEmptyState" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="420" Spacing="8" Visibility="Collapsed"><TextBlock x:Uid="ContainerManagerSectionEmpty" desktop:DesktopLocalization.Bindings="Text=ContainerManagerSectionEmpty.Text" TextAlignment="Center" TextWrapping="Wrap" /></StackPanel>
                    <StackPanel x:Name="ImagesErrorState" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="420" Spacing="8" Visibility="Collapsed"><TextBlock x:Uid="ContainerManagerSectionError" desktop:DesktopLocalization.Bindings="Text=ContainerManagerSectionError.Text" TextAlignment="Center" TextWrapping="Wrap" /></StackPanel>
                    <StackPanel x:Name="ImagesUnavailableState" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="420" Spacing="8" Visibility="Collapsed"><TextBlock x:Uid="ContainerManagerSectionUnavailable" desktop:DesktopLocalization.Bindings="Text=ContainerManagerSectionUnavailable.Text" TextAlignment="Center" TextWrapping="Wrap" /></StackPanel>
                </Grid>
            </PivotItem>
            <PivotItem x:Uid="ContainerManagerNetworksTab" desktop:DesktopLocalization.Bindings="Header=ContainerManagerNetworksTab.Header">
                <Grid AutomationProperties.LiveSetting="Polite">
                    <ListView x:Uid="ContainerManagerNetworksList" desktop:DesktopLocalization.Bindings="AutomationProperties.Name=ContainerManagerNetworksList.AutomationProperties.Name" x:Name="NetworksList" ItemsSource="{Binding Networks}" ItemTemplate="{StaticResource ContainerResourceTemplate}" SelectionMode="None" />
                    <StackPanel x:Name="NetworksLoadingState" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8"><ProgressRing Width="30" Height="30" IsActive="True" /><TextBlock x:Uid="ContainerManagerSectionLoading" desktop:DesktopLocalization.Bindings="Text=ContainerManagerSectionLoading.Text" TextWrapping="Wrap" /></StackPanel>
                    <StackPanel x:Name="NetworksEmptyState" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="420" Spacing="8" Visibility="Collapsed"><TextBlock x:Uid="ContainerManagerSectionEmpty" desktop:DesktopLocalization.Bindings="Text=ContainerManagerSectionEmpty.Text" TextAlignment="Center" TextWrapping="Wrap" /></StackPanel>
                    <StackPanel x:Name="NetworksErrorState" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="420" Spacing="8" Visibility="Collapsed"><TextBlock x:Uid="ContainerManagerSectionError" desktop:DesktopLocalization.Bindings="Text=ContainerManagerSectionError.Text" TextAlignment="Center" TextWrapping="Wrap" /></StackPanel>
                    <StackPanel x:Name="NetworksUnavailableState" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="420" Spacing="8" Visibility="Collapsed"><TextBlock x:Uid="ContainerManagerSectionUnavailable" desktop:DesktopLocalization.Bindings="Text=ContainerManagerSectionUnavailable.Text" TextAlignment="Center" TextWrapping="Wrap" /></StackPanel>
                </Grid>
            </PivotItem>
            <PivotItem x:Uid="ContainerManagerProjectsTab" desktop:DesktopLocalization.Bindings="Header=ContainerManagerProjectsTab.Header">
                <Grid AutomationProperties.LiveSetting="Polite">
                    <ListView x:Uid="ContainerManagerProjectsList" desktop:DesktopLocalization.Bindings="AutomationProperties.Name=ContainerManagerProjectsList.AutomationProperties.Name" x:Name="ProjectsList" ItemsSource="{Binding Projects}" ItemTemplate="{StaticResource ContainerResourceTemplate}" SelectionMode="None" />
                    <StackPanel x:Name="ProjectsLoadingState" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8"><ProgressRing Width="30" Height="30" IsActive="True" /><TextBlock x:Uid="ContainerManagerSectionLoading" desktop:DesktopLocalization.Bindings="Text=ContainerManagerSectionLoading.Text" TextWrapping="Wrap" /></StackPanel>
                    <StackPanel x:Name="ProjectsEmptyState" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="420" Spacing="8" Visibility="Collapsed"><TextBlock x:Uid="ContainerManagerSectionEmpty" desktop:DesktopLocalization.Bindings="Text=ContainerManagerSectionEmpty.Text" TextAlignment="Center" TextWrapping="Wrap" /></StackPanel>
                    <StackPanel x:Name="ProjectsErrorState" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="420" Spacing="8" Visibility="Collapsed"><TextBlock x:Uid="ContainerManagerSectionError" desktop:DesktopLocalization.Bindings="Text=ContainerManagerSectionError.Text" TextAlignment="Center" TextWrapping="Wrap" /></StackPanel>
                    <StackPanel x:Name="ProjectsUnavailableState" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="420" Spacing="8" Visibility="Collapsed"><TextBlock x:Uid="ContainerManagerSectionUnavailable" desktop:DesktopLocalization.Bindings="Text=ContainerManagerSectionUnavailable.Text" TextAlignment="Center" TextWrapping="Wrap" /></StackPanel>
                </Grid>
            </PivotItem>
            <PivotItem x:Uid="ContainerManagerEventsTab" desktop:DesktopLocalization.Bindings="Header=ContainerManagerEventsTab.Header">
                <Grid AutomationProperties.LiveSetting="Polite">
                    <ListView x:Uid="ContainerManagerEventsList" desktop:DesktopLocalization.Bindings="AutomationProperties.Name=ContainerManagerEventsList.AutomationProperties.Name" x:Name="EventsList" ItemsSource="{Binding Events}" ItemTemplate="{StaticResource ContainerEventTemplate}" SelectionMode="None" />
                    <StackPanel x:Name="EventsLoadingState" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8"><ProgressRing Width="30" Height="30" IsActive="True" /><TextBlock x:Uid="ContainerManagerSectionLoading" desktop:DesktopLocalization.Bindings="Text=ContainerManagerSectionLoading.Text" TextWrapping="Wrap" /></StackPanel>
                    <StackPanel x:Name="EventsEmptyState" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="420" Spacing="8" Visibility="Collapsed"><TextBlock x:Uid="ContainerManagerSectionEmpty" desktop:DesktopLocalization.Bindings="Text=ContainerManagerSectionEmpty.Text" TextAlignment="Center" TextWrapping="Wrap" /></StackPanel>
                    <StackPanel x:Name="EventsErrorState" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="420" Spacing="8" Visibility="Collapsed"><TextBlock x:Uid="ContainerManagerSectionError" desktop:DesktopLocalization.Bindings="Text=ContainerManagerSectionError.Text" TextAlignment="Center" TextWrapping="Wrap" /></StackPanel>
                    <StackPanel x:Name="EventsUnavailableState" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="420" Spacing="8" Visibility="Collapsed"><TextBlock x:Uid="ContainerManagerSectionUnavailable" desktop:DesktopLocalization.Bindings="Text=ContainerManagerSectionUnavailable.Text" TextAlignment="Center" TextWrapping="Wrap" /></StackPanel>
                </Grid>
            </PivotItem>
        </Pivot>
    </Grid>
</Page>
