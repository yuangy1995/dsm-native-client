<?xml version="1.0" encoding="utf-8"?>
<Page xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:containers="using:LanStash.App.Features.Containers" x:Class="LanStash.App.Views.ContainerManagerPage" Background="{ThemeResource WorkspaceCanvasBrush}" SizeChanged="Page_SizeChanged">
    <Page.KeyboardAccelerators>
        <KeyboardAccelerator Key="Left" Modifiers="Menu" Invoked="BackAccelerator_Invoked"/>
        <KeyboardAccelerator Key="F5" Invoked="RefreshAccelerator_Invoked"/>
    </Page.KeyboardAccelerators>
    <Page.Resources>
        <DataTemplate x:Key="ContainerResourceTemplate" x:DataType="containers:ContainerResourceItem">
            <Grid Padding="4,10" ColumnSpacing="8" AutomationProperties.Name="{x:Bind AutomationName}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock FontWeight="SemiBold" Text="{x:Bind Name}" TextWrapping="Wrap"/>
                <TextBlock Grid.Column="1" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{x:Bind StatusText}" TextWrapping="Wrap"/>
            </Grid>
        </DataTemplate>
        <DataTemplate x:Key="ContainerEventTemplate" x:DataType="containers:ContainerEventItem">
            <Grid Padding="4,10" ColumnSpacing="8" AutomationProperties.Name="{x:Bind AutomationName}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock FontWeight="SemiBold" Text="{x:Bind TimeText}" TextWrapping="Wrap"/>
                <TextBlock Grid.Column="1" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{x:Bind LevelText}" TextWrapping="Wrap"/>
            </Grid>
        </DataTemplate>
    </Page.Resources>
    <Grid Padding="16" RowSpacing="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Spacing="4">
                <TextBlock x:Uid="ContainerManagerTitle" Style="{StaticResource WorkspaceTitleStyle}" AutomationProperties.HeadingLevel="Level1"/>
                <TextBlock x:Uid="ContainerManagerDescription" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/>
            </StackPanel>
            <Button x:Uid="ContainerManagerRefresh" x:Name="RefreshButton" Grid.Column="1" MinHeight="36" Click="Refresh_Click">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="" FontSize="16"/>
                    <TextBlock x:Uid="ContainerManagerRefreshLabel"/>
                </StackPanel>
            </Button>
        </Grid>
        <InfoBar x:Uid="ContainerManagerReadOnly" Grid.Row="1" IsClosable="False" IsOpen="True" Severity="Informational"/>
        <InfoBar x:Uid="ContainerManagerRefreshError" x:Name="RefreshErrorNotice" Grid.Row="2" AutomationProperties.LiveSetting="Polite" IsClosable="False" IsOpen="False" Severity="Warning"/>
        <InfoBar x:Uid="ContainerManagerSessionExpired" x:Name="SessionExpiredNotice" Grid.Row="2" AutomationProperties.LiveSetting="Assertive" IsClosable="False" IsOpen="False" Severity="Error"/>
        <Grid x:Name="ContainerSections" Grid.Row="3">
            <Grid x:Name="ContainersSection" Visibility="Collapsed">
                <Grid x:Name="ContentState" ColumnSpacing="8" AutomationProperties.LiveSetting="Polite" Visibility="Collapsed">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition x:Name="ListColumn" Width="360"/>
                        <ColumnDefinition x:Name="DetailColumn" Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border x:Name="ListPane" Background="{ThemeResource WorkspaceCardBrush}" BorderBrush="{ThemeResource WorkspaceDividerBrush}" BorderThickness="1" CornerRadius="8">
                        <Grid Padding="12" RowSpacing="8">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <ComboBox x:Uid="ContainerManagerFilter" x:Name="FilterPicker" MinHeight="36" HorizontalAlignment="Stretch" SelectedIndex="0" SelectionChanged="FilterPicker_SelectionChanged">
                                <ComboBoxItem x:Uid="ContainerManagerFilterAll" Tag="All"/>
                                <ComboBoxItem x:Uid="ContainerManagerFilterRunning" Tag="Running"/>
                                <ComboBoxItem x:Uid="ContainerManagerFilterStopped" Tag="Stopped"/>
                                <ComboBoxItem x:Uid="ContainerManagerFilterAttention" Tag="Attention"/>
                            </ComboBox>
                            <ListView x:Uid="ContainerManagerList" x:Name="ContainerList" Grid.Row="1" IsItemClickEnabled="True" ItemClick="ContainerList_ItemClick" ItemsSource="{Binding Containers}" SelectionMode="Single">
                                <ListView.ItemContainerStyle>
                                    <Style TargetType="ListViewItem">
                                        <Setter Property="MinHeight" Value="72"/>
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                    </Style>
                                </ListView.ItemContainerStyle>
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="containers:ContainerItem">
                                        <Grid Padding="4,8" ColumnSpacing="8" AutomationProperties.Name="{x:Bind AutomationName}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Spacing="4">
                                                <TextBlock FontWeight="SemiBold" Text="{x:Bind Name}" TextTrimming="CharacterEllipsis" TextWrapping="Wrap"/>
                                                <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" MaxLines="1" Text="{x:Bind ImageText}" TextTrimming="CharacterEllipsis"/>
                                            </StackPanel>
                                            <TextBlock Grid.Column="1" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{x:Bind StatusText}"/>
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </Grid>
                    </Border>
                    <Border x:Name="DetailPane" Grid.Column="1" Background="{ThemeResource WorkspaceCardBrush}" BorderBrush="{ThemeResource WorkspaceDividerBrush}" BorderThickness="1" CornerRadius="8">
                        <Grid Padding="16">
                            <StackPanel x:Name="NoSelectionState" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="420" Spacing="8">
                                <FontIcon Glyph="" FontSize="40"/>
                                <TextBlock x:Uid="ContainerManagerChooseItemTitle" HorizontalAlignment="Center" Style="{StaticResource WorkspaceSectionTitleStyle}" TextAlignment="Center" AutomationProperties.HeadingLevel="Level2"/>
                                <TextBlock x:Uid="ContainerManagerChooseItemMessage" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextAlignment="Center" TextWrapping="Wrap"/>
                            </StackPanel>
                            <Grid x:Name="DetailState" AutomationProperties.LiveSetting="Polite" Visibility="Collapsed">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Button x:Uid="ContainerManagerBack" x:Name="BackButton" MinWidth="36" MinHeight="36" Click="Back_Click" Visibility="Collapsed">
                                        <FontIcon Glyph="" FontSize="16"/>
                                    </Button>
                                    <TextBlock Grid.Column="1" VerticalAlignment="Center" FontSize="20" FontWeight="SemiBold" Text="{Binding SelectedContainer.Name}" TextTrimming="CharacterEllipsis" TextWrapping="Wrap" AutomationProperties.HeadingLevel="Level2"/>
                                </Grid>
                                <Grid Grid.Row="1" Padding="0,20,0,0" ColumnSpacing="24" RowSpacing="14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <TextBlock x:Uid="ContainerManagerDetailName" FontWeight="SemiBold"/>
                                    <TextBlock Grid.Column="1" Text="{Binding SelectedContainer.Name}" TextWrapping="Wrap"/>
                                    <TextBlock x:Uid="ContainerManagerDetailStatus" Grid.Row="1" FontWeight="SemiBold"/>
                                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding SelectedContainer.StatusText}" TextWrapping="Wrap"/>
                                    <TextBlock x:Uid="ContainerManagerDetailImage" Grid.Row="2" FontWeight="SemiBold"/>
                                    <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding SelectedContainer.ImageText}" TextWrapping="Wrap"/>
                                </Grid>
                            </Grid>
                        </Grid>
                    </Border>
                </Grid>
                <StackPanel x:Name="LoadingState" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12">
                    <ProgressRing Width="40" Height="40" IsActive="True"/>
                    <TextBlock x:Uid="ContainerManagerLoading" AutomationProperties.LiveSetting="Polite"/>
                </StackPanel>
                <StackPanel x:Name="EmptyState" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="440" Spacing="8" Visibility="Collapsed">
                    <TextBlock x:Uid="ContainerManagerEmptyTitle" FontSize="20" FontWeight="SemiBold" TextAlignment="Center" AutomationProperties.HeadingLevel="Level2"/>
                    <TextBlock x:Uid="ContainerManagerEmptyMessage" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextAlignment="Center" TextWrapping="Wrap"/>
                </StackPanel>
                <StackPanel x:Name="FilteredEmptyState" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="440" Spacing="12" Visibility="Collapsed">
                    <TextBlock x:Uid="ContainerManagerFilteredEmptyTitle" FontSize="20" FontWeight="SemiBold" TextAlignment="Center" AutomationProperties.HeadingLevel="Level2"/>
                    <TextBlock x:Uid="ContainerManagerFilteredEmptyMessage" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextAlignment="Center" TextWrapping="Wrap"/>
                    <Button x:Uid="ContainerManagerShowAll" MinHeight="36" HorizontalAlignment="Center" Click="ShowAll_Click"/>
                </StackPanel>
                <StackPanel x:Name="ErrorState" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="440" Spacing="8" Visibility="Collapsed">
                    <TextBlock x:Uid="ContainerManagerErrorTitle" FontSize="20" FontWeight="SemiBold" TextAlignment="Center" AutomationProperties.HeadingLevel="Level2"/>
                    <TextBlock x:Uid="ContainerManagerErrorMessage" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextAlignment="Center" TextWrapping="Wrap"/>
                </StackPanel>
                <StackPanel x:Name="UnavailableState" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="440" Spacing="8" Visibility="Collapsed">
                    <TextBlock x:Uid="ContainerManagerUnavailableTitle" FontSize="20" FontWeight="SemiBold" TextAlignment="Center" AutomationProperties.HeadingLevel="Level2"/>
                    <TextBlock x:Uid="ContainerManagerUnavailableMessage" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextAlignment="Center" TextWrapping="Wrap"/>
                </StackPanel>
            </Grid>
            <Grid AutomationProperties.LiveSetting="Polite" x:Name="ImagesSection" Visibility="Collapsed">
                <ListView x:Uid="ContainerManagerImagesList" x:Name="ImagesList" ItemsSource="{Binding Images}" ItemTemplate="{StaticResource ContainerResourceTemplate}" SelectionMode="None" ItemContainerStyle="{StaticResource WorkspaceListItemStyle}"/>
                <StackPanel x:Name="ImagesLoadingState" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8">
                    <ProgressRing Width="30" Height="30" IsActive="True"/>
                    <TextBlock x:Uid="ContainerManagerSectionLoading" TextWrapping="Wrap"/>
                </StackPanel>
                <StackPanel x:Name="ImagesEmptyState" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="420" Spacing="8" Visibility="Collapsed">
                    <TextBlock x:Uid="ContainerManagerSectionEmpty" TextAlignment="Center" TextWrapping="Wrap"/>
                </StackPanel>
                <StackPanel x:Name="ImagesErrorState" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="420" Spacing="8" Visibility="Collapsed">
                    <TextBlock x:Uid="ContainerManagerSectionError" TextAlignment="Center" TextWrapping="Wrap"/>
                </StackPanel>
                <StackPanel x:Name="ImagesUnavailableState" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="420" Spacing="8" Visibility="Collapsed">
                    <TextBlock x:Uid="ContainerManagerSectionUnavailable" TextAlignment="Center" TextWrapping="Wrap"/>
                </StackPanel>
            </Grid>
            <Grid AutomationProperties.LiveSetting="Polite" x:Name="NetworksSection" Visibility="Collapsed">
                <ListView x:Uid="ContainerManagerNetworksList" x:Name="NetworksList" ItemsSource="{Binding Networks}" ItemTemplate="{StaticResource ContainerResourceTemplate}" SelectionMode="None" ItemContainerStyle="{StaticResource WorkspaceListItemStyle}"/>
                <StackPanel x:Name="NetworksLoadingState" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8">
                    <ProgressRing Width="30" Height="30" IsActive="True"/>
                    <TextBlock x:Uid="ContainerManagerSectionLoading" TextWrapping="Wrap"/>
                </StackPanel>
                <StackPanel x:Name="NetworksEmptyState" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="420" Spacing="8" Visibility="Collapsed">
                    <TextBlock x:Uid="ContainerManagerSectionEmpty" TextAlignment="Center" TextWrapping="Wrap"/>
                </StackPanel>
                <StackPanel x:Name="NetworksErrorState" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="420" Spacing="8" Visibility="Collapsed">
                    <TextBlock x:Uid="ContainerManagerSectionError" TextAlignment="Center" TextWrapping="Wrap"/>
                </StackPanel>
                <StackPanel x:Name="NetworksUnavailableState" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="420" Spacing="8" Visibility="Collapsed">
                    <TextBlock x:Uid="ContainerManagerSectionUnavailable" TextAlignment="Center" TextWrapping="Wrap"/>
                </StackPanel>
            </Grid>
            <Grid AutomationProperties.LiveSetting="Polite" x:Name="ProjectsSection" Visibility="Collapsed">
                <ListView x:Uid="ContainerManagerProjectsList" x:Name="ProjectsList" ItemsSource="{Binding Projects}" ItemTemplate="{StaticResource ContainerResourceTemplate}" SelectionMode="None" ItemContainerStyle="{StaticResource WorkspaceListItemStyle}"/>
                <StackPanel x:Name="ProjectsLoadingState" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8">
                    <ProgressRing Width="30" Height="30" IsActive="True"/>
                    <TextBlock x:Uid="ContainerManagerSectionLoading" TextWrapping="Wrap"/>
                </StackPanel>
                <StackPanel x:Name="ProjectsEmptyState" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="420" Spacing="8" Visibility="Collapsed">
                    <TextBlock x:Uid="ContainerManagerSectionEmpty" TextAlignment="Center" TextWrapping="Wrap"/>
                </StackPanel>
                <StackPanel x:Name="ProjectsErrorState" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="420" Spacing="8" Visibility="Collapsed">
                    <TextBlock x:Uid="ContainerManagerSectionError" TextAlignment="Center" TextWrapping="Wrap"/>
                </StackPanel>
                <StackPanel x:Name="ProjectsUnavailableState" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="420" Spacing="8" Visibility="Collapsed">
                    <TextBlock x:Uid="ContainerManagerSectionUnavailable" TextAlignment="Center" TextWrapping="Wrap"/>
                </StackPanel>
            </Grid>
            <Grid AutomationProperties.LiveSetting="Polite" x:Name="EventsSection" Visibility="Collapsed">
                <ListView x:Uid="ContainerManagerEventsList" x:Name="EventsList" ItemsSource="{Binding Events}" ItemTemplate="{StaticResource ContainerEventTemplate}" SelectionMode="None" ItemContainerStyle="{StaticResource WorkspaceListItemStyle}"/>
                <StackPanel x:Name="EventsLoadingState" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8">
                    <ProgressRing Width="30" Height="30" IsActive="True"/>
                    <TextBlock x:Uid="ContainerManagerSectionLoading" TextWrapping="Wrap"/>
                </StackPanel>
                <StackPanel x:Name="EventsEmptyState" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="420" Spacing="8" Visibility="Collapsed">
                    <TextBlock x:Uid="ContainerManagerSectionEmpty" TextAlignment="Center" TextWrapping="Wrap"/>
                </StackPanel>
                <StackPanel x:Name="EventsErrorState" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="420" Spacing="8" Visibility="Collapsed">
                    <TextBlock x:Uid="ContainerManagerSectionError" TextAlignment="Center" TextWrapping="Wrap"/>
                </StackPanel>
                <StackPanel x:Name="EventsUnavailableState" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="420" Spacing="8" Visibility="Collapsed">
                    <TextBlock x:Uid="ContainerManagerSectionUnavailable" TextAlignment="Center" TextWrapping="Wrap"/>
                </StackPanel>
            </Grid>
        </Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto" x:Name="OverviewSection" Grid.Row="3">
            <StackPanel Spacing="12" Padding="0,8">
                <TextBlock Style="{StaticResource WorkspaceTitleStyle}" x:Uid="NativeContainerOverview"/>
                <Grid ColumnSpacing="12" RowSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Padding="16" CornerRadius="12" Background="{ThemeResource WorkspaceCardBrush}" BorderBrush="{ThemeResource WorkspaceDividerBrush}" Click="OverviewSection_Click" Tag="ContainerList" Grid.Column="0" Grid.Row="0">
                        <StackPanel Spacing="10">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <FontIcon Glyph="" FontSize="19"/>
                                <TextBlock FontWeight="SemiBold" x:Name="ContainerListHeading"/>
                            </StackPanel>
                            <TextBlock FontSize="28" x:Name="ContainerListCount"/>
                        </StackPanel>
                    </Button>
                    <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Padding="16" CornerRadius="12" Background="{ThemeResource WorkspaceCardBrush}" BorderBrush="{ThemeResource WorkspaceDividerBrush}" Click="OverviewSection_Click" Tag="ContainerImages" Grid.Column="1" Grid.Row="0">
                        <StackPanel Spacing="10">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <FontIcon Glyph="" FontSize="19"/>
                                <TextBlock FontWeight="SemiBold" x:Name="ContainerImagesHeading"/>
                            </StackPanel>
                            <TextBlock FontSize="28" x:Name="ContainerImagesCount"/>
                        </StackPanel>
                    </Button>
                    <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Padding="16" CornerRadius="12" Background="{ThemeResource WorkspaceCardBrush}" BorderBrush="{ThemeResource WorkspaceDividerBrush}" Click="OverviewSection_Click" Tag="ContainerNetworks" Grid.Column="0" Grid.Row="1">
                        <StackPanel Spacing="10">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <FontIcon Glyph="" FontSize="19"/>
                                <TextBlock FontWeight="SemiBold" x:Name="ContainerNetworksHeading"/>
                            </StackPanel>
                            <TextBlock FontSize="28" x:Name="ContainerNetworksCount"/>
                        </StackPanel>
                    </Button>
                    <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Padding="16" CornerRadius="12" Background="{ThemeResource WorkspaceCardBrush}" BorderBrush="{ThemeResource WorkspaceDividerBrush}" Click="OverviewSection_Click" Tag="ContainerProjects" Grid.Column="1" Grid.Row="1">
                        <StackPanel Spacing="10">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <FontIcon Glyph="" FontSize="19"/>
                                <TextBlock FontWeight="SemiBold" x:Name="ContainerProjectsHeading"/>
                            </StackPanel>
                            <TextBlock FontSize="28" x:Name="ContainerProjectsCount"/>
                        </StackPanel>
                    </Button>
                    <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Padding="16" CornerRadius="12" Background="{ThemeResource WorkspaceCardBrush}" BorderBrush="{ThemeResource WorkspaceDividerBrush}" Click="OverviewSection_Click" Tag="ContainerEvents" Grid.Column="0" Grid.Row="2">
                        <StackPanel Spacing="10">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <FontIcon Glyph="" FontSize="19"/>
                                <TextBlock FontWeight="SemiBold" x:Name="ContainerEventsHeading"/>
                            </StackPanel>
                            <TextBlock FontSize="28" x:Name="ContainerEventsCount"/>
                        </StackPanel>
                    </Button>
                </Grid>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
