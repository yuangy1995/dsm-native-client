<Page xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:containers="using:LanStash.App.Features.Containers" x:Class="LanStash.App.Views.ContainerManagerPage" Background="{ThemeResource WorkspaceSurfaceBrush}" SizeChanged="Page_SizeChanged">
  <Page.KeyboardAccelerators>
    <KeyboardAccelerator Key="Left" Modifiers="Menu" Invoked="BackAccelerator_Invoked"/>
    <KeyboardAccelerator Key="F5" Invoked="RefreshAccelerator_Invoked"/>
  </Page.KeyboardAccelerators>
  <Page.Resources>
    <DataTemplate x:Key="ContainerNetworkTemplate" x:DataType="containers:ContainerResourceItem">
      <Expander HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Margin="0,4" AutomationProperties.Name="{x:Bind NetworkAutomationName}">
        <Expander.Header>
          <StackPanel Spacing="4">
            <TextBlock Text="{x:Bind Name}" FontWeight="SemiBold" TextWrapping="Wrap"/>
            <TextBlock Text="{x:Bind NetworkSummary}" TextWrapping="Wrap"/>
          </StackPanel>
        </Expander.Header>
        <StackPanel Spacing="10">
          <TextBlock x:Uid="ContainerNetworkSubnet" FontWeight="SemiBold"/>
          <TextBlock Text="{x:Bind SubnetText}" IsTextSelectionEnabled="True" TextWrapping="Wrap"/>
          <TextBlock x:Uid="ContainerNetworkGateway" FontWeight="SemiBold"/>
          <TextBlock Text="{x:Bind GatewayText}" IsTextSelectionEnabled="True" TextWrapping="Wrap"/>
          <TextBlock x:Uid="ContainerNetworkIpRange" FontWeight="SemiBold"/>
          <TextBlock Text="{x:Bind IpRangeText}" IsTextSelectionEnabled="True" TextWrapping="Wrap"/>
          <TextBlock x:Uid="ContainerNetworkIpv6" FontWeight="SemiBold"/>
          <TextBlock Text="{x:Bind Ipv6Text}" TextWrapping="Wrap"/>
          <TextBlock x:Uid="ContainerNetworkConnections" FontWeight="SemiBold"/>
          <TextBlock Text="{x:Bind ConnectionsText}" IsTextSelectionEnabled="True" TextWrapping="Wrap"/>
        </StackPanel>
      </Expander>
    </DataTemplate>
    <DataTemplate x:Key="ContainerResourceTemplate" x:DataType="containers:ContainerResourceItem">
      <Grid Padding="4,10" ColumnSpacing="12" AutomationProperties.Name="{x:Bind AutomationName}">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <TextBlock FontWeight="SemiBold" Text="{x:Bind Name}" TextWrapping="Wrap"/>
        <TextBlock Grid.Column="1" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{x:Bind StatusText}" TextWrapping="Wrap"/>
      </Grid>
    </DataTemplate>
    <DataTemplate x:Key="ContainerEventTemplate" x:DataType="containers:ContainerEventItem">
      <Grid Padding="4,10" ColumnSpacing="12" AutomationProperties.Name="{x:Bind AutomationName}">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <TextBlock FontWeight="SemiBold" Text="{x:Bind TimeText}" TextWrapping="Wrap"/>
        <TextBlock Grid.Column="1" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{x:Bind LevelText}" TextWrapping="Wrap"/>
      </Grid>
    </DataTemplate>
  </Page.Resources>
  <Grid Padding="0" RowSpacing="0">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>
    <Grid ColumnSpacing="12" Padding="18,8" MinHeight="60" BorderBrush="{ThemeResource WorkspaceEdgeBrush}" BorderThickness="0,0,0,1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="Auto"/>
      </Grid.ColumnDefinitions>
      <StackPanel Spacing="4">
        <TextBlock x:Uid="ContainerManagerTitle" Style="{StaticResource WorkspaceTitleStyle}" AutomationProperties.HeadingLevel="Level1" FontSize="16"/>
        <TextBlock x:Uid="ContainerManagerDescription" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" Visibility="Collapsed"/>
      </StackPanel>
      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
      <Button x:Name="ManageContainersButton" x:Uid="ContainerOpsOpen" MinHeight="44" Click="ManageContainers_Click"/>
      <Button x:Uid="ContainerManagerRefresh" x:Name="RefreshButton" MinHeight="44" Click="Refresh_Click" HorizontalAlignment="Right" Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="10">
        <StackPanel Orientation="Horizontal" Spacing="8">
          <FontIcon Glyph="" FontSize="16"/>
          <TextBlock x:Uid="ContainerManagerRefreshLabel"/>
        </StackPanel>
      </Button>
      </StackPanel>
    </Grid>
    <InfoBar x:Uid="ContainerManagerReadOnly" Grid.Row="1" IsClosable="False" IsOpen="False" Severity="Informational" Margin="12,6"/>
    <InfoBar x:Uid="ContainerManagerRefreshError" x:Name="RefreshErrorNotice" Grid.Row="2" AutomationProperties.LiveSetting="Polite" IsClosable="False" IsOpen="False" Severity="Warning" Margin="12,6"/>
    <InfoBar x:Uid="ContainerManagerSessionExpired" x:Name="SessionExpiredNotice" Grid.Row="2" AutomationProperties.LiveSetting="Assertive" IsClosable="False" IsOpen="False" Severity="Error" Margin="12,6"/>
    <Pivot x:Name="SectionPivot" Grid.Row="3" Margin="12,0,12,12">
      <PivotItem x:Uid="WorkspaceContainerOverview">
        <Grid>
          <ItemsControl HorizontalAlignment="Left" VerticalAlignment="Top" Margin="6,20">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <ItemsWrapGrid Orientation="Horizontal"/>
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <Button Tag="1" Click="OverviewCard_Click" Width="188" Height="78" Margin="6" Padding="14" CornerRadius="12" Background="{ThemeResource WorkspaceTileBrush}" HorizontalContentAlignment="Stretch">
              <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="40"/>
                  <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border Width="38" Height="38" CornerRadius="10" Background="{ThemeResource NavigationViewItemBackgroundSelected}">
                  <PathIcon Foreground="{ThemeResource WorkspaceAccentBrush}" Data="F0 M12,0 L23,6 L23,18 L12,24 L1,18 L1,6 Z M3,7 L3,17 L11,21.5 L11,11.5 Z M13,11.5 L13,21.5 L21,17 L21,7 Z M4,5.5 L12,10 L20,5.5 L12,2 Z" Width="22" Height="22"/>
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="3">
                  <TextBlock x:Name="OverviewContainersCount" FontSize="22" FontWeight="SemiBold"/>
                  <TextBlock x:Uid="WorkspaceContainerCount" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12"/>
                </StackPanel>
              </Grid>
            </Button>
            <Button Tag="2" Click="OverviewCard_Click" Width="188" Height="78" Margin="6" Padding="14" CornerRadius="12" Background="{ThemeResource WorkspaceTileBrush}" HorizontalContentAlignment="Stretch">
              <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="40"/>
                  <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border Width="38" Height="38" CornerRadius="10" Background="{ThemeResource NavigationViewItemBackgroundSelected}">
                  <PathIcon Foreground="{ThemeResource WorkspaceAccentBrush}" Data="M12,0 L24,6 L12,12 L0,6 Z M0,10 L12,16 L24,10 L24,13 L12,19 L0,13 Z M0,17 L12,23 L24,17 L24,20 L12,26 L0,20 Z" Width="22" Height="22"/>
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="3">
                  <TextBlock x:Name="OverviewImagesCount" FontSize="22" FontWeight="SemiBold"/>
                  <TextBlock x:Uid="WorkspaceImageCount" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12"/>
                </StackPanel>
              </Grid>
            </Button>
            <Button Tag="3" Click="OverviewCard_Click" Width="188" Height="78" Margin="6" Padding="14" CornerRadius="12" Background="{ThemeResource WorkspaceTileBrush}" HorizontalContentAlignment="Stretch">
              <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="40"/>
                  <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border Width="38" Height="38" CornerRadius="10" Background="{ThemeResource NavigationViewItemBackgroundSelected}">
                  <FontIcon Glyph="" Foreground="{ThemeResource WorkspaceAccentBrush}" FontSize="22"/>
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="3">
                  <TextBlock x:Name="OverviewNetworksCount" FontSize="22" FontWeight="SemiBold"/>
                  <TextBlock x:Uid="WorkspaceNetworkCount" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12"/>
                </StackPanel>
              </Grid>
            </Button>
            <Button Tag="4" Click="OverviewCard_Click" Width="188" Height="78" Margin="6" Padding="14" CornerRadius="12" Background="{ThemeResource WorkspaceTileBrush}" HorizontalContentAlignment="Stretch">
              <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="40"/>
                  <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border Width="38" Height="38" CornerRadius="10" Background="{ThemeResource NavigationViewItemBackgroundSelected}">
                  <PathIcon Foreground="{ThemeResource WorkspaceAccentBrush}" Data="M0,0 L8,0 L8,8 L0,8 Z M12,0 L20,0 L20,8 L12,8 Z M0,12 L8,12 L8,20 L0,20 Z M12,12 L20,12 L20,20 L12,20 Z" Width="22" Height="22"/>
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="3">
                  <TextBlock x:Name="OverviewProjectsCount" FontSize="22" FontWeight="SemiBold"/>
                  <TextBlock x:Uid="WorkspaceProjectCount" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12"/>
                </StackPanel>
              </Grid>
            </Button>
          </ItemsControl>
        </Grid>
      </PivotItem>
      <PivotItem x:Uid="ContainerManagerContainersTab">
        <Grid>
          <Grid x:Name="ContentState" ColumnSpacing="12" AutomationProperties.LiveSetting="Polite" Visibility="Collapsed">
            <Grid.ColumnDefinitions>
              <ColumnDefinition x:Name="ListColumn" Width="360"/>
              <ColumnDefinition x:Name="DetailColumn" Width="*"/>
            </Grid.ColumnDefinitions>
            <Border x:Name="ListPane" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8">
              <Grid Padding="12" RowSpacing="8">
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto"/>
                  <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <ComboBox x:Uid="ContainerManagerFilter" x:Name="FilterPicker" MinHeight="44" HorizontalAlignment="Stretch" SelectedIndex="0" SelectionChanged="FilterPicker_SelectionChanged">
                  <ComboBoxItem x:Uid="ContainerManagerFilterAll" Tag="All"/>
                  <ComboBoxItem x:Uid="ContainerManagerFilterRunning" Tag="Running"/>
                  <ComboBoxItem x:Uid="ContainerManagerFilterStopped" Tag="Stopped"/>
                  <ComboBoxItem x:Uid="ContainerManagerFilterAttention" Tag="Attention"/>
                </ComboBox>
                <ListView x:Uid="ContainerManagerList" x:Name="ContainerList" Grid.Row="1" IsItemClickEnabled="True" ItemClick="ContainerList_ItemClick" ItemsSource="{Binding Containers}" SelectionMode="Single">
                  <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                      <Setter Property="MinHeight" Value="72"/>
                      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                    </Style>
                  </ListView.ItemContainerStyle>
                  <ListView.ItemTemplate>
                    <DataTemplate x:DataType="containers:ContainerItem">
                      <Grid Padding="4,8" ColumnSpacing="12" AutomationProperties.Name="{x:Bind AutomationName}">
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="*"/>
                          <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="4">
                          <TextBlock FontWeight="SemiBold" Text="{x:Bind Name}" TextTrimming="CharacterEllipsis" TextWrapping="Wrap"/>
                          <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" MaxLines="1" Text="{x:Bind ImageText}" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                        <TextBlock Grid.Column="1" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{x:Bind StatusText}"/>
                      </Grid>
                    </DataTemplate>
                  </ListView.ItemTemplate>
                </ListView>
              </Grid>
            </Border>
            <Border x:Name="DetailPane" Grid.Column="1" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8">
              <Grid Padding="20">
                <StackPanel x:Name="NoSelectionState" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="420" Spacing="8">
                  <FontIcon Glyph="" FontSize="40"/>
                  <TextBlock x:Uid="ContainerManagerChooseItemTitle" HorizontalAlignment="Center" Style="{StaticResource SubtitleTextBlockStyle}" TextAlignment="Center" AutomationProperties.HeadingLevel="Level2"/>
                  <TextBlock x:Uid="ContainerManagerChooseItemMessage" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextAlignment="Center" TextWrapping="Wrap"/>
                </StackPanel>
                <Grid x:Name="DetailState" AutomationProperties.LiveSetting="Polite" Visibility="Collapsed">
                  <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                  </Grid.RowDefinitions>
                  <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="Auto"/>
                      <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Button x:Uid="ContainerManagerBack" x:Name="BackButton" MinWidth="44" MinHeight="44" Click="Back_Click" Visibility="Collapsed">
                      <FontIcon Glyph="" FontSize="16"/>
                    </Button>
                    <TextBlock Grid.Column="1" VerticalAlignment="Center" FontSize="20" FontWeight="SemiBold" Text="{Binding SelectedContainer.Name}" TextTrimming="CharacterEllipsis" TextWrapping="Wrap" AutomationProperties.HeadingLevel="Level2"/>
                  </Grid>
                  <Grid Grid.Row="1" Padding="0,20,0,0" ColumnSpacing="24" RowSpacing="14">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="Auto"/>
                      <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                      <RowDefinition Height="Auto"/>
                      <RowDefinition Height="Auto"/>
                      <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock x:Uid="ContainerManagerDetailName" FontWeight="SemiBold"/>
                    <TextBlock Grid.Column="1" Text="{Binding SelectedContainer.Name}" TextWrapping="Wrap"/>
                    <TextBlock x:Uid="ContainerManagerDetailStatus" Grid.Row="1" FontWeight="SemiBold"/>
                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding SelectedContainer.StatusText}" TextWrapping="Wrap"/>
                    <TextBlock x:Uid="ContainerManagerDetailImage" Grid.Row="2" FontWeight="SemiBold"/>
                    <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding SelectedContainer.ImageText}" TextWrapping="Wrap"/>
                  </Grid>
                </Grid>
              </Grid>
            </Border>
          </Grid>
          <StackPanel x:Name="LoadingState" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12">
            <ProgressRing Width="40" Height="40" IsActive="True"/>
            <TextBlock x:Uid="ContainerManagerLoading" AutomationProperties.LiveSetting="Polite"/>
          </StackPanel>
          <StackPanel x:Name="EmptyState" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="440" Spacing="8" Visibility="Collapsed">
            <TextBlock x:Uid="ContainerManagerEmptyTitle" FontSize="20" FontWeight="SemiBold" TextAlignment="Center" AutomationProperties.HeadingLevel="Level2"/>
            <TextBlock x:Uid="ContainerManagerEmptyMessage" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextAlignment="Center" TextWrapping="Wrap"/>
          </StackPanel>
          <StackPanel x:Name="FilteredEmptyState" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="440" Spacing="12" Visibility="Collapsed">
            <TextBlock x:Uid="ContainerManagerFilteredEmptyTitle" FontSize="20" FontWeight="SemiBold" TextAlignment="Center" AutomationProperties.HeadingLevel="Level2"/>
            <TextBlock x:Uid="ContainerManagerFilteredEmptyMessage" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextAlignment="Center" TextWrapping="Wrap"/>
            <Button x:Uid="ContainerManagerShowAll" MinHeight="44" HorizontalAlignment="Center" Click="ShowAll_Click"/>
          </StackPanel>
          <StackPanel x:Name="ErrorState" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="440" Spacing="8" Visibility="Collapsed">
            <TextBlock x:Uid="ContainerManagerErrorTitle" FontSize="20" FontWeight="SemiBold" TextAlignment="Center" AutomationProperties.HeadingLevel="Level2"/>
            <TextBlock x:Uid="ContainerManagerErrorMessage" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextAlignment="Center" TextWrapping="Wrap"/>
          </StackPanel>
          <StackPanel x:Name="UnavailableState" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="440" Spacing="8" Visibility="Collapsed">
            <TextBlock x:Uid="ContainerManagerUnavailableTitle" FontSize="20" FontWeight="SemiBold" TextAlignment="Center" AutomationProperties.HeadingLevel="Level2"/>
            <TextBlock x:Uid="ContainerManagerUnavailableMessage" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextAlignment="Center" TextWrapping="Wrap"/>
          </StackPanel>
        </Grid>
      </PivotItem>
      <PivotItem x:Uid="ContainerManagerImagesTab">
        <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,6,0,10">
          <Button x:Name="DeleteImagesButton" x:Uid="ContainerImageDeleteOpen" Click="DeleteImages_Click"/>
          <Button x:Name="BrowseRegistryButton" x:Uid="ContainerRegistryOpen" Click="BrowseRegistry_Click"/>
        </StackPanel>
        <Grid Grid.Row="1" AutomationProperties.LiveSetting="Polite">
          <ListView x:Uid="ContainerManagerImagesList" x:Name="ImagesList" ItemsSource="{Binding Images}" ItemTemplate="{StaticResource ContainerResourceTemplate}" SelectionMode="None"/>
          <StackPanel x:Name="ImagesLoadingState" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8">
            <ProgressRing Width="30" Height="30" IsActive="True"/>
            <TextBlock x:Uid="ContainerManagerSectionLoading" TextWrapping="Wrap"/>
          </StackPanel>
          <StackPanel x:Name="ImagesEmptyState" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="420" Spacing="8" Visibility="Collapsed">
            <TextBlock x:Uid="ContainerManagerSectionEmpty" TextAlignment="Center" TextWrapping="Wrap"/>
          </StackPanel>
          <StackPanel x:Name="ImagesErrorState" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="420" Spacing="8" Visibility="Collapsed">
            <TextBlock x:Uid="ContainerManagerSectionError" TextAlignment="Center" TextWrapping="Wrap"/>
          </StackPanel>
          <StackPanel x:Name="ImagesUnavailableState" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="420" Spacing="8" Visibility="Collapsed">
            <TextBlock x:Uid="ContainerManagerSectionUnavailable" TextAlignment="Center" TextWrapping="Wrap"/>
          </StackPanel>
        </Grid>
        </Grid>
      </PivotItem>
      <PivotItem x:Uid="ContainerManagerNetworksTab">
        <Grid AutomationProperties.LiveSetting="Polite">
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,6,0,10">
            <Button x:Name="CreateNetworkButton" x:Uid="ContainerCreateOpen" Click="CreateNetwork_Click"/>
            <Button x:Name="DeleteNetworksButton" x:Uid="ContainerDeleteOpen" Click="DeleteNetworks_Click"/>
          </StackPanel>
          <Grid Grid.Row="1">
          <ListView x:Uid="ContainerManagerNetworksList" x:Name="NetworksList" ItemsSource="{Binding Networks}" ItemTemplate="{StaticResource ContainerNetworkTemplate}" SelectionMode="None">
            <ListView.ItemContainerStyle><Style TargetType="ListViewItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/></Style></ListView.ItemContainerStyle>
          </ListView>
          <StackPanel x:Name="NetworksLoadingState" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8">
            <ProgressRing Width="30" Height="30" IsActive="True"/>
            <TextBlock x:Uid="ContainerManagerSectionLoading" TextWrapping="Wrap"/>
          </StackPanel>
          <StackPanel x:Name="NetworksEmptyState" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="420" Spacing="8" Visibility="Collapsed">
            <TextBlock x:Uid="ContainerManagerSectionEmpty" TextAlignment="Center" TextWrapping="Wrap"/>
          </StackPanel>
          <StackPanel x:Name="NetworksErrorState" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="420" Spacing="8" Visibility="Collapsed">
            <TextBlock x:Uid="ContainerManagerSectionError" TextAlignment="Center" TextWrapping="Wrap"/>
          </StackPanel>
          <StackPanel x:Name="NetworksUnavailableState" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="420" Spacing="8" Visibility="Collapsed">
            <TextBlock x:Uid="ContainerManagerSectionUnavailable" TextAlignment="Center" TextWrapping="Wrap"/>
          </StackPanel>
          </Grid>
        </Grid>
      </PivotItem>
      <PivotItem x:Uid="ContainerManagerProjectsTab">
        <Grid AutomationProperties.LiveSetting="Polite">
          <ListView x:Uid="ContainerManagerProjectsList" x:Name="ProjectsList" ItemsSource="{Binding Projects}" ItemTemplate="{StaticResource ContainerResourceTemplate}" SelectionMode="None"/>
          <StackPanel x:Name="ProjectsLoadingState" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8">
            <ProgressRing Width="30" Height="30" IsActive="True"/>
            <TextBlock x:Uid="ContainerManagerSectionLoading" TextWrapping="Wrap"/>
          </StackPanel>
          <StackPanel x:Name="ProjectsEmptyState" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="420" Spacing="8" Visibility="Collapsed">
            <TextBlock x:Uid="ContainerManagerSectionEmpty" TextAlignment="Center" TextWrapping="Wrap"/>
          </StackPanel>
          <StackPanel x:Name="ProjectsErrorState" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="420" Spacing="8" Visibility="Collapsed">
            <TextBlock x:Uid="ContainerManagerSectionError" TextAlignment="Center" TextWrapping="Wrap"/>
          </StackPanel>
          <StackPanel x:Name="ProjectsUnavailableState" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="420" Spacing="8" Visibility="Collapsed">
            <TextBlock x:Uid="ContainerManagerSectionUnavailable" TextAlignment="Center" TextWrapping="Wrap"/>
          </StackPanel>
        </Grid>
      </PivotItem>
      <PivotItem x:Uid="ContainerManagerEventsTab">
        <Grid AutomationProperties.LiveSetting="Polite">
          <ListView x:Uid="ContainerManagerEventsList" x:Name="EventsList" ItemsSource="{Binding Events}" ItemTemplate="{StaticResource ContainerEventTemplate}" SelectionMode="None"/>
          <StackPanel x:Name="EventsLoadingState" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8">
            <ProgressRing Width="30" Height="30" IsActive="True"/>
            <TextBlock x:Uid="ContainerManagerSectionLoading" TextWrapping="Wrap"/>
          </StackPanel>
          <StackPanel x:Name="EventsEmptyState" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="420" Spacing="8" Visibility="Collapsed">
            <TextBlock x:Uid="ContainerManagerSectionEmpty" TextAlignment="Center" TextWrapping="Wrap"/>
          </StackPanel>
          <StackPanel x:Name="EventsErrorState" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="420" Spacing="8" Visibility="Collapsed">
            <TextBlock x:Uid="ContainerManagerSectionError" TextAlignment="Center" TextWrapping="Wrap"/>
          </StackPanel>
          <StackPanel x:Name="EventsUnavailableState" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="420" Spacing="8" Visibility="Collapsed">
            <TextBlock x:Uid="ContainerManagerSectionUnavailable" TextAlignment="Center" TextWrapping="Wrap"/>
          </StackPanel>
        </Grid>
      </PivotItem>
    </Pivot>
  </Grid>
</Page>
