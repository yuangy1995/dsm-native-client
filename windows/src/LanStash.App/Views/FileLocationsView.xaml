<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:desktop="using:LanStash.App.Presentation" xmlns:domain="using:LanStash.Domain" xmlns:locations="using:LanStash.App.Features.Files.Locations" xmlns:views="using:LanStash.App.Views" x:Class="LanStash.App.Views.FileLocationsView" x:Name="Root">
    <UserControl.Resources>
        <views:FileLocationsBooleanToVisibilityConverter x:Key="FileLocationsBooleanToVisibilityConverter"/>
    </UserControl.Resources>
    <Grid Padding="16,12,12,16" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock x:Uid="FileLocationsTitle" desktop:DesktopLocalization.Bindings="Text=FileLocationsTitle.Text" Style="{StaticResource SubtitleTextBlockStyle}" VerticalAlignment="Center" AutomationProperties.HeadingLevel="Level1"/>
            <Button x:Uid="FileLocationsRefresh" desktop:DesktopLocalization.Bindings="AutomationProperties.Name=FileLocationsRefresh.[using:Microsoft.UI.Xaml.Automation]AutomationProperties.Name" x:Name="RefreshButton" Grid.Column="1" Click="Refresh_Click" MinWidth="48" MinHeight="48">
                <FontIcon Glyph=""/>
            </Button>
        </Grid>

        <InfoBar x:Uid="FileLocationsOpenError" desktop:DesktopLocalization.Bindings="Message=FileLocationsOpenError.Message;Title=FileLocationsOpenError.Title" x:Name="OpenErrorBar" Grid.Row="1" IsClosable="True" IsOpen="False" Severity="Error" AutomationProperties.LiveSetting="Polite"/>

        <ScrollViewer x:Name="LocationsScroller" Grid.Row="2" HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="16">
                <StackPanel Spacing="4" x:Name="SharesSection">
                    <TextBlock x:Uid="FileLocationsSharesHeading" desktop:DesktopLocalization.Bindings="Text=FileLocationsSharesHeading.Text" Style="{StaticResource BodyStrongTextBlockStyle}" AutomationProperties.HeadingLevel="Level2"/>
                    <Button x:Uid="FileLocationsShares" desktop:DesktopLocalization.Bindings="AutomationProperties.Name=FileLocationsShares.[using:Microsoft.UI.Xaml.Automation]AutomationProperties.Name" x:Name="SharesButton" Click="Shares_Click" HorizontalContentAlignment="Stretch" MinHeight="48">
                        <Grid ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="28"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <FontIcon Glyph=""/>
                            <TextBlock x:Uid="FileLocationsSharesLabel" desktop:DesktopLocalization.Bindings="Text=FileLocationsSharesLabel.Text" Grid.Column="1" VerticalAlignment="Center"/>
                        </Grid>
                    </Button>
                </StackPanel>

                <StackPanel x:Name="FavoritesSection" Spacing="6">
                    <TextBlock x:Uid="FileLocationsFavoritesHeading" desktop:DesktopLocalization.Bindings="Text=FileLocationsFavoritesHeading.Text" Style="{StaticResource BodyStrongTextBlockStyle}" AutomationProperties.HeadingLevel="Level2"/>
                    <ProgressRing x:Name="FavoritesProgress" Width="24" Height="24" IsActive="False" Visibility="Collapsed"/>
                    <TextBlock x:Uid="FileLocationsFavoritesLoading" desktop:DesktopLocalization.Bindings="Text=FileLocationsFavoritesLoading.Text" x:Name="FavoritesLoading" Visibility="Collapsed" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/>
                    <TextBlock x:Uid="FileLocationsFavoritesEmpty" desktop:DesktopLocalization.Bindings="Text=FileLocationsFavoritesEmpty.Text" x:Name="FavoritesEmpty" Visibility="Collapsed" TextWrapping="Wrap"/>
                    <InfoBar x:Uid="FileLocationsFavoritesError" desktop:DesktopLocalization.Bindings="Message=FileLocationsFavoritesError.Message;Title=FileLocationsFavoritesError.Title" x:Name="FavoritesError" IsClosable="False" IsOpen="False" Severity="Warning"/>
                    <InfoBar x:Uid="FileLocationsFavoritesTruncated" desktop:DesktopLocalization.Bindings="Message=FileLocationsFavoritesTruncated.Message;Title=FileLocationsFavoritesTruncated.Title" x:Name="FavoritesTruncated" IsClosable="False" IsOpen="False" Severity="Informational"/>
                    <ItemsControl x:Name="FavoritesItems" HorizontalContentAlignment="Stretch">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="domain:FileFavoriteLocation">
                                <Button Click="Favorite_Click" HorizontalContentAlignment="Stretch" MinHeight="48" AutomationProperties.Name="{x:Bind Name}" AutomationProperties.HelpText="{x:Bind Path}">
                                    <StackPanel>
                                        <TextBlock Text="{x:Bind Name}" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" Text="{x:Bind Path}" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <StackPanel x:Name="RecentSection" Spacing="6">
                    <TextBlock x:Uid="FileLocationsRecentHeading" desktop:DesktopLocalization.Bindings="Text=FileLocationsRecentHeading.Text" Style="{StaticResource BodyStrongTextBlockStyle}" AutomationProperties.HeadingLevel="Level2"/>
                    <TextBlock x:Uid="FileLocationsRecentEmpty" desktop:DesktopLocalization.Bindings="Text=FileLocationsRecentEmpty.Text" x:Name="RecentEmpty" Visibility="Collapsed" TextWrapping="Wrap"/>
                    <ItemsControl x:Name="RecentItems" HorizontalContentAlignment="Stretch">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="locations:RecentFileLocation">
                                <Button Click="Recent_Click" HorizontalContentAlignment="Stretch" MinHeight="48" AutomationProperties.Name="{x:Bind Name}" AutomationProperties.HelpText="{x:Bind Path}">
                                    <StackPanel>
                                        <TextBlock Text="{x:Bind Name}" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" Text="{x:Bind Path}" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <StackPanel x:Name="RecycleSection" Spacing="6">
                    <TextBlock x:Uid="FileLocationsRecycleHeading" desktop:DesktopLocalization.Bindings="Text=FileLocationsRecycleHeading.Text" Style="{StaticResource BodyStrongTextBlockStyle}" AutomationProperties.HeadingLevel="Level2"/>
                    <ProgressRing x:Name="RecycleProgress" Width="24" Height="24" IsActive="False" Visibility="Collapsed"/>
                    <TextBlock x:Uid="FileLocationsRecycleLoading" desktop:DesktopLocalization.Bindings="Text=FileLocationsRecycleLoading.Text" x:Name="RecycleLoading" Visibility="Collapsed" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/>
                    <TextBlock x:Uid="FileLocationsRecycleEmpty" desktop:DesktopLocalization.Bindings="Text=FileLocationsRecycleEmpty.Text" x:Name="RecycleEmpty" Visibility="Collapsed" TextWrapping="Wrap"/>
                    <InfoBar x:Uid="FileLocationsRecycleError" desktop:DesktopLocalization.Bindings="Message=FileLocationsRecycleError.Message;Title=FileLocationsRecycleError.Title" x:Name="RecycleError" IsClosable="False" IsOpen="False" Severity="Warning"/>
                    <InfoBar x:Uid="FileLocationsRecyclePartial" desktop:DesktopLocalization.Bindings="Message=FileLocationsRecyclePartial.Message;Title=FileLocationsRecyclePartial.Title" x:Name="RecyclePartial" IsClosable="False" IsOpen="False" Severity="Informational"/>
                    <InfoBar x:Uid="FileLocationsRecycleTruncated" desktop:DesktopLocalization.Bindings="Message=FileLocationsRecycleTruncated.Message;Title=FileLocationsRecycleTruncated.Title" x:Name="RecycleTruncated" IsClosable="False" IsOpen="False" Severity="Informational"/>
                    <ItemsControl x:Name="RecycleItems" HorizontalContentAlignment="Stretch">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="domain:FileRecycleLocation">
                                <Button Click="Recycle_Click" HorizontalContentAlignment="Stretch" MinHeight="48" AutomationProperties.Name="{x:Bind ShareName}" AutomationProperties.HelpText="{x:Bind RecyclePath}">
                                    <StackPanel>
                                        <TextBlock Text="{x:Bind ShareName}" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" Text="{x:Bind RecyclePath}" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <StackPanel x:Name="RemoteSection" Spacing="6">
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Uid="FileLocationsRemoteHeading" desktop:DesktopLocalization.Bindings="Text=FileLocationsRemoteHeading.Text" Style="{StaticResource BodyStrongTextBlockStyle}" VerticalAlignment="Center" AutomationProperties.HeadingLevel="Level2"/>
                        <Button x:Uid="FileLocationsRemoteCreate" desktop:DesktopLocalization.Bindings="AutomationProperties.Name=FileLocationsRemoteCreate.[using:Microsoft.UI.Xaml.Automation]AutomationProperties.Name" x:Name="RemoteCreateButton" Grid.Column="1" Click="RemoteCreate_Click" MinWidth="48" MinHeight="48" Visibility="Collapsed">
                            <FontIcon Glyph=""/>
                        </Button>
                    </Grid>
                    <ProgressRing x:Name="RemoteProgress" Width="24" Height="24" IsActive="False" Visibility="Collapsed"/>
                    <TextBlock x:Uid="FileLocationsRemoteLoading" desktop:DesktopLocalization.Bindings="Text=FileLocationsRemoteLoading.Text" x:Name="RemoteLoading" Visibility="Collapsed" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/>
                    <TextBlock x:Uid="FileLocationsRemoteEmpty" desktop:DesktopLocalization.Bindings="Text=FileLocationsRemoteEmpty.Text" x:Name="RemoteEmpty" Visibility="Collapsed" TextWrapping="Wrap"/>
                    <InfoBar x:Uid="FileLocationsRemoteError" desktop:DesktopLocalization.Bindings="Message=FileLocationsRemoteError.Message;Title=FileLocationsRemoteError.Title" x:Name="RemoteError" IsClosable="False" IsOpen="False" Severity="Warning"/>
                    <InfoBar x:Uid="FileLocationsRemotePartial" desktop:DesktopLocalization.Bindings="Message=FileLocationsRemotePartial.Message;Title=FileLocationsRemotePartial.Title" x:Name="RemotePartial" IsClosable="False" IsOpen="False" Severity="Informational"/>
                    <InfoBar x:Uid="FileLocationsRemoteTruncated" desktop:DesktopLocalization.Bindings="Message=FileLocationsRemoteTruncated.Message;Title=FileLocationsRemoteTruncated.Title" x:Name="RemoteTruncated" IsClosable="False" IsOpen="False" Severity="Informational"/>
                    <ItemsControl x:Name="RemoteItems" HorizontalContentAlignment="Stretch">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="domain:FileRemoteLocation">
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Button Click="Remote_Click" HorizontalContentAlignment="Stretch" MinHeight="48" AutomationProperties.Name="{x:Bind Name}" AutomationProperties.HelpText="{x:Bind Path}">
                                        <StackPanel>
                                            <TextBlock Text="{x:Bind Name}" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" Text="{x:Bind Path}" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                    </Button>
                                    <Button x:Uid="FileLocationsRemoteEdit" desktop:DesktopLocalization.Bindings="AutomationProperties.Name=FileLocationsRemoteEdit.[using:Microsoft.UI.Xaml.Automation]AutomationProperties.Name" Grid.Column="1" Click="RemoteEdit_Click" MinWidth="48" MinHeight="48" Visibility="{Binding DataContext.AllowsRemoteMountManagement, ElementName=Root, Converter={StaticResource FileLocationsBooleanToVisibilityConverter}}">
                                        <FontIcon Glyph=""/>
                                    </Button>
                                    <Button x:Uid="FileLocationsRemoteDelete" desktop:DesktopLocalization.Bindings="AutomationProperties.Name=FileLocationsRemoteDelete.[using:Microsoft.UI.Xaml.Automation]AutomationProperties.Name" Grid.Column="2" Click="RemoteDelete_Click" MinWidth="48" MinHeight="48" Visibility="{Binding DataContext.AllowsRemoteMountManagement, ElementName=Root, Converter={StaticResource FileLocationsBooleanToVisibilityConverter}}">
                                        <FontIcon Glyph=""/>
                                    </Button>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
