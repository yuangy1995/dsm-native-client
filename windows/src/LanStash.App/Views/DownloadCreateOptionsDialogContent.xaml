<UserControl x:Class="LanStash.App.Views.DownloadCreateOptionsDialogContent" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:files="using:LanStash.App.Features.Files.CopyMove">
  <UserControl.Resources><Style x:Key="CreateOptionButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}"><Setter Property="MinHeight" Value="44"/></Style></UserControl.Resources>
  <ScrollViewer MaxHeight="580" VerticalScrollBarVisibility="Auto">
    <StackPanel Spacing="12" MinWidth="280" MaxWidth="540">
      <TextBlock x:Name="FileNameText" TextWrapping="Wrap"/>
      <TextBlock x:Name="DestinationText" TextWrapping="Wrap"/>
      <StackPanel Orientation="Horizontal" Spacing="8"><Button x:Name="BrowseButton" Click="Browse_Click" MinHeight="44"/><Button x:Name="DefaultButton" Click="Default_Click" MinHeight="44"/></StackPanel>
      <StackPanel x:Name="FolderPanel" Spacing="8" Visibility="Collapsed">
        <TextBlock x:Name="FolderPathText" TextWrapping="Wrap"/>
        <Button x:Name="UpButton" Click="Up_Click" MinHeight="44"/>
        <ProgressRing x:Name="FolderLoading" Width="24" Height="24"/>
        <TextBlock x:Name="ErrorText" TextWrapping="Wrap" Visibility="Collapsed"/>
        <TextBlock x:Name="EmptyText" TextWrapping="Wrap" Visibility="Collapsed"/>
        <ListView x:Name="FolderList" SelectionMode="Single" MaxHeight="220" SelectionChanged="Selection_Changed">
          <ListView.ItemTemplate><DataTemplate x:DataType="files:FileCopyMoveFolder"><TextBlock Text="{x:Bind Name}" Margin="4,12" TextWrapping="Wrap"/></DataTemplate></ListView.ItemTemplate>
        </ListView>
        <StackPanel Orientation="Horizontal" Spacing="8"><Button x:Name="OpenButton" Click="Open_Click" MinHeight="44"/><Button x:Name="ChooseButton" Click="Choose_Click" MinHeight="44"/><Button x:Name="CancelBrowseButton" Click="CloseBrowser_Click" MinHeight="44"/></StackPanel>
      </StackPanel>
      <PasswordBox x:Name="ArchivePassword" MinHeight="44" PasswordRevealMode="Peek"/>
      <TextBlock x:Name="PasswordHint" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
      <ProgressRing x:Name="SendingProgress" Width="28" Height="28" Visibility="Collapsed"/>
    </StackPanel>
  </ScrollViewer>
</UserControl>
