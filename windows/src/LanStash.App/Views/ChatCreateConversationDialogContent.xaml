<UserControl
    x:Class="LanStash.App.Views.ChatCreateConversationDialogContent"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:domain="using:LanStash.Domain">
    <Grid
        MinWidth="320"
        MaxWidth="600"
        MinHeight="420"
        RowSpacing="12"
        AutomationProperties.LiveSetting="Polite">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Spacing="8">
            <TextBlock
                x:Name="ConversationTypeLabel"
                FontWeight="SemiBold"
                AutomationProperties.HeadingLevel="Level2" />
            <StackPanel Orientation="Horizontal" Spacing="20">
                <RadioButton
                    x:Name="DirectModeButton"
                    GroupName="ConversationType"
                    IsChecked="True"
                    Checked="Mode_Checked" />
                <RadioButton
                    x:Name="GroupModeButton"
                    GroupName="ConversationType"
                    Checked="Mode_Checked" />
            </StackPanel>
        </StackPanel>

        <StackPanel x:Name="GroupTitlePanel" Grid.Row="1" Spacing="6" Visibility="Collapsed">
            <TextBlock x:Name="GroupTitleLabel" FontWeight="SemiBold" />
            <TextBox
                x:Name="GroupTitleInput"
                MinHeight="44"
                MaxLength="200"
                TextChanged="GroupTitleInput_TextChanged" />
        </StackPanel>

        <Grid Grid.Row="2" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock
                x:Name="MemberSelectionLabel"
                VerticalAlignment="Center"
                FontWeight="SemiBold"
                AutomationProperties.HeadingLevel="Level2" />
            <Button
                x:Name="RetryButton"
                Grid.Column="1"
                MinWidth="44"
                MinHeight="44"
                Click="Retry_Click"
                Visibility="Collapsed">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE72C;" FontSize="16" />
                    <TextBlock x:Name="RetryLabel" />
                </StackPanel>
            </Button>
        </Grid>

        <Grid Grid.Row="3">
            <StackPanel
                x:Name="LoadingState"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Spacing="12">
                <ProgressRing Width="36" Height="36" IsActive="True" />
                <TextBlock x:Name="LoadingText" TextAlignment="Center" TextWrapping="Wrap" />
            </StackPanel>
            <StackPanel
                x:Name="EmptyState"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                MaxWidth="440"
                Spacing="8"
                Visibility="Collapsed">
                <TextBlock x:Name="EmptyTitle" FontSize="20" TextAlignment="Center" />
                <TextBlock
                    x:Name="EmptyMessage"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    TextAlignment="Center"
                    TextWrapping="Wrap" />
            </StackPanel>
            <StackPanel
                x:Name="ErrorState"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                MaxWidth="440"
                Spacing="8"
                Visibility="Collapsed">
                <TextBlock x:Name="ErrorTitle" FontSize="20" TextAlignment="Center" />
                <TextBlock
                    x:Name="ErrorMessage"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    TextAlignment="Center"
                    TextWrapping="Wrap" />
            </StackPanel>
            <ListView
                x:Name="UserList"
                ItemsSource="{x:Bind ViewModel.Users}"
                SelectionChanged="UserList_SelectionChanged"
                SelectionMode="Single"
                Visibility="Collapsed">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="MinHeight" Value="56" />
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="domain:ChatUser">
                        <TextBlock
                            Padding="8"
                            FontWeight="SemiBold"
                            Text="{x:Bind DisplayName}"
                            TextWrapping="WrapWholeWords"
                            AutomationProperties.Name="{x:Bind DisplayName}" />
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>

        <InfoBar
            x:Name="FeedbackBar"
            Grid.Row="4"
            IsClosable="False"
            IsOpen="False"
            AutomationProperties.LiveSetting="Assertive" />
    </Grid>
</UserControl>
