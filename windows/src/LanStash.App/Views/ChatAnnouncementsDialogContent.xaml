<UserControl
    x:Class="LanStash.App.Views.ChatAnnouncementsDialogContent"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:chat="using:LanStash.App.Features.Chat">
    <Grid
        MinWidth="300"
        MaxWidth="640"
        MinHeight="360"
        RowSpacing="12"
        AutomationProperties.LiveSetting="Polite">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock
                x:Name="AnnouncementsCountText"
                VerticalAlignment="Center"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            <Button
                x:Name="AnnouncementsRefreshButton"
                Grid.Column="1"
                MinWidth="44"
                MinHeight="44"
                Click="Refresh_Click">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE72C;" FontSize="16" />
                    <TextBlock x:Name="AnnouncementsRefreshText" />
                </StackPanel>
            </Button>
        </Grid>

        <Grid Grid.Row="1">
            <StackPanel
                x:Name="AnnouncementsLoadingState"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Spacing="12"
                Visibility="Collapsed">
                <ProgressRing Width="36" Height="36" IsActive="True" />
                <TextBlock x:Name="AnnouncementsLoadingText" TextAlignment="Center" TextWrapping="Wrap" />
            </StackPanel>

            <StackPanel
                x:Name="AnnouncementsEmptyState"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                MaxWidth="440"
                Spacing="8"
                Visibility="Collapsed">
                <TextBlock x:Name="AnnouncementsEmptyTitle" FontSize="20" TextAlignment="Center" />
                <TextBlock
                    x:Name="AnnouncementsEmptyMessage"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    TextAlignment="Center"
                    TextWrapping="Wrap" />
            </StackPanel>

            <StackPanel
                x:Name="AnnouncementsErrorState"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                MaxWidth="440"
                Spacing="8"
                Visibility="Collapsed">
                <TextBlock x:Name="AnnouncementsErrorTitle" FontSize="20" TextAlignment="Center" />
                <TextBlock
                    x:Name="AnnouncementsErrorMessage"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    TextAlignment="Center"
                    TextWrapping="Wrap" />
                <Button
                    x:Name="AnnouncementsRetryButton"
                    MinHeight="44"
                    HorizontalAlignment="Center"
                    Click="Retry_Click" />
            </StackPanel>

            <ListView
                x:Uid="ChatAnnouncementsList"
                x:Name="AnnouncementsContentState"
                ItemsSource="{x:Bind ViewModel.ConversationAnnouncements}"
                SelectionMode="None"
                Visibility="Collapsed">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="MinHeight" Value="88" />
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="chat:ChatAnnouncementItem">
                        <StackPanel
                            Padding="8"
                            Spacing="4"
                            AutomationProperties.Name="{x:Bind AutomationName}">
                            <TextBlock FontWeight="SemiBold" Text="{x:Bind Sender}" TextWrapping="Wrap" />
                            <TextBlock
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="{x:Bind PinnedAtText}"
                                TextWrapping="Wrap" />
                            <TextBlock Text="{x:Bind Text}" TextWrapping="WrapWholeWords" />
                            <TextBlock
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="{x:Bind SentAtText}"
                                TextWrapping="Wrap" />
                        </StackPanel>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>
    </Grid>
</UserControl>
