<Page xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:vm="using:LanStash.App.Features.VirtualMachines" xmlns:views="using:LanStash.App.Views" x:Class="LanStash.App.Views.VirtualMachineManagerPage" Background="{ThemeResource WorkspaceSurfaceBrush}" SizeChanged="Page_SizeChanged">
  <Page.KeyboardAccelerators>
    <KeyboardAccelerator Key="Left" Modifiers="Menu" Invoked="BackAccelerator_Invoked"/>
    <KeyboardAccelerator Key="F5" Invoked="RefreshAccelerator_Invoked"/>
  </Page.KeyboardAccelerators>
  <Page.Resources>
    <DataTemplate x:Key="VirtualizationResourceTemplate" x:DataType="vm:VirtualizationResourceItem">
      <Grid Padding="4,8" ColumnSpacing="12" AutomationProperties.Name="{x:Bind AutomationName}">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <StackPanel Spacing="3">
          <TextBlock FontWeight="SemiBold" Text="{x:Bind Name}" TextTrimming="CharacterEllipsis" TextWrapping="Wrap"/>
          <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{x:Bind UsageText}" TextWrapping="Wrap"/>
        </StackPanel>
        <TextBlock Grid.Column="1" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{x:Bind HealthText}"/>
      </Grid>
    </DataTemplate>
    <DataTemplate x:Key="VirtualizationProtectionTemplate" x:DataType="vm:VirtualizationResourceItem">
      <Grid Padding="4,8" ColumnSpacing="12" AutomationProperties.Name="{x:Bind AutomationName}">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <StackPanel Spacing="3">
          <TextBlock FontWeight="SemiBold" Text="{x:Bind Name}" TextWrapping="Wrap"/>
          <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{x:Bind KindText}" TextWrapping="Wrap"/>
        </StackPanel>
        <TextBlock Grid.Column="1" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{x:Bind HealthText}" TextWrapping="Wrap"/>
      </Grid>
    </DataTemplate>
    <DataTemplate x:Key="VirtualMachineEventTemplate" x:DataType="vm:VirtualMachineEventItem">
      <Grid Padding="4,8" ColumnSpacing="12" AutomationProperties.Name="{x:Bind AutomationName}">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <TextBlock FontWeight="SemiBold" Text="{x:Bind TimeText}" TextWrapping="Wrap"/>
        <TextBlock Grid.Column="1" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{x:Bind LevelText}" TextWrapping="Wrap"/>
      </Grid>
    </DataTemplate>
  </Page.Resources>
  <Grid Padding="0" RowSpacing="0">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>
    <Grid ColumnSpacing="12" Padding="18,8" MinHeight="60" BorderBrush="{ThemeResource WorkspaceEdgeBrush}" BorderThickness="0,0,0,1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="Auto"/>
      </Grid.ColumnDefinitions>
      <StackPanel Spacing="4">
        <TextBlock x:Uid="VirtualMachineManagerTitle" Style="{StaticResource WorkspaceTitleStyle}" AutomationProperties.HeadingLevel="Level1" FontSize="16"/>
        <TextBlock x:Uid="VirtualMachineManagerDescription" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" Visibility="Collapsed"/>
      </StackPanel>
      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
      <Button x:Name="CreateMachineButton" x:Uid="VmCreateOpen" MinHeight="44" Click="CreateMachine_Click"/>
      <Button x:Name="BatchPowerButton" x:Uid="VmBatchOpen" MinHeight="44" Click="BatchPower_Click"/>
      <Button x:Name="DeleteMachinesButton" x:Uid="VmDeleteOpen" MinHeight="44" Click="DeleteMachines_Click"/>
      <Button x:Uid="VirtualMachineManagerRefresh" x:Name="RefreshButton" MinHeight="44" Click="Refresh_Click" HorizontalAlignment="Right" Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="10">
        <StackPanel Orientation="Horizontal" Spacing="8">
          <FontIcon Glyph="" FontSize="16"/>
          <TextBlock x:Uid="VirtualMachineManagerRefreshLabel"/>
        </StackPanel>
      </Button>
      </StackPanel>
    </Grid>
    <InfoBar x:Uid="VirtualMachineManagerReadOnly" Grid.Row="1" IsClosable="False" IsOpen="False" Severity="Informational" Margin="12,6"/>
    <InfoBar x:Uid="VirtualMachineManagerRefreshError" x:Name="RefreshErrorNotice" Grid.Row="2" AutomationProperties.LiveSetting="Polite" IsClosable="False" IsOpen="False" Severity="Warning" Margin="12,6"/>
    <InfoBar x:Uid="VirtualMachineManagerSessionExpired" x:Name="SessionExpiredNotice" Grid.Row="2" AutomationProperties.LiveSetting="Assertive" IsClosable="False" IsOpen="False" Severity="Error" Margin="12,6"/>
    <Pivot x:Name="ResourcePivot" Grid.Row="3" Margin="12,0,12,12" SelectionChanged="ResourcePivot_SelectionChanged">
      <PivotItem x:Uid="WorkspaceMachinesTab">
        <Grid ColumnSpacing="12" Margin="6,16,6,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="MachineColumn" Width="360"/>
            <ColumnDefinition x:Name="DetailColumn" Width="*"/>
          </Grid.ColumnDefinitions>
          <Border x:Name="MachinePane" Background="Transparent" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0" CornerRadius="0">
            <Grid Padding="12" RowSpacing="8">
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
              </Grid.RowDefinitions>
              <TextBlock x:Uid="VirtualMachineManagerMachinesHeading" FontWeight="SemiBold" AutomationProperties.HeadingLevel="Level2" Visibility="Collapsed"/>
              <Grid Grid.Row="1">
                <ListView x:Uid="VirtualMachineManagerMachineList" x:Name="MachineList" IsItemClickEnabled="True" ItemClick="MachineList_ItemClick" ItemsSource="{Binding Machines}" SelectionMode="Single">
                  <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                      <Setter Property="MinHeight" Value="68"/>
                      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                    </Style>
                  </ListView.ItemContainerStyle>
                  <ListView.ItemTemplate>
                    <DataTemplate x:DataType="vm:VirtualMachineItem">
                      <Border Padding="14" Margin="0,4" CornerRadius="12" Background="{ThemeResource WorkspaceTileBrush}" BorderBrush="{ThemeResource WorkspaceEdgeBrush}" BorderThickness="1">
                        <Grid ColumnSpacing="14">
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="42"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                          </Grid.ColumnDefinitions>
                          <FontIcon Glyph="" FontSize="26" Foreground="{ThemeResource WorkspaceAccentBrush}"/>
                          <StackPanel Grid.Column="1" Spacing="4">
                            <TextBlock Text="{x:Bind Name}" FontWeight="SemiBold" FontSize="15"/>
                            <TextBlock Text="{x:Bind HostText}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                          </StackPanel>
                          <TextBlock Grid.Column="2" Text="{x:Bind CpuText}" VerticalAlignment="Center"/>
                          <TextBlock Grid.Column="3" Text="{x:Bind MemoryText}" VerticalAlignment="Center"/>
                          <TextBlock Grid.Column="4" Text="{x:Bind StatusText}" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        </Grid>
                      </Border>
                    </DataTemplate>
                  </ListView.ItemTemplate>
                </ListView>
                <StackPanel x:Name="MachinesLoadingState" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10">
                  <ProgressRing Width="36" Height="36" IsActive="True"/>
                  <TextBlock x:Uid="VirtualMachineManagerMachinesLoading" AutomationProperties.LiveSetting="Polite"/>
                </StackPanel>
                <StackPanel x:Name="MachinesEmptyState" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="300" Spacing="8" Visibility="Collapsed">
                  <TextBlock x:Uid="VirtualMachineManagerMachinesEmptyTitle" FontWeight="SemiBold" TextAlignment="Center"/>
                  <TextBlock x:Uid="VirtualMachineManagerMachinesEmptyMessage" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextAlignment="Center" TextWrapping="Wrap"/>
                </StackPanel>
                <StackPanel x:Name="MachinesErrorState" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="300" Spacing="8" Visibility="Collapsed">
                  <TextBlock x:Uid="VirtualMachineManagerMachinesErrorTitle" FontWeight="SemiBold" TextAlignment="Center"/>
                  <TextBlock x:Uid="VirtualMachineManagerMachinesErrorMessage" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextAlignment="Center" TextWrapping="Wrap"/>
                </StackPanel>
                <StackPanel x:Name="MachinesUnavailableState" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="300" Spacing="8" Visibility="Collapsed">
                  <TextBlock x:Uid="VirtualMachineManagerUnavailableTitle" FontWeight="SemiBold" TextAlignment="Center"/>
                  <TextBlock x:Uid="VirtualMachineManagerUnavailableMessage" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextAlignment="Center" TextWrapping="Wrap"/>
                </StackPanel>
              </Grid>
              <Button x:Uid="VirtualMachineManagerViewResources" x:Name="ResourcesButton" Grid.Row="2" MinHeight="44" HorizontalAlignment="Stretch" Click="Resources_Click" Visibility="Collapsed"/>
            </Grid>
          </Border>
          <Border x:Name="DetailPane" Grid.Column="1" Background="Transparent" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0" CornerRadius="0">
            <Grid Padding="20" RowSpacing="12">
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
              </Grid.RowDefinitions>
              <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto"/>
                  <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Button x:Uid="VirtualMachineManagerBack" x:Name="BackButton" MinWidth="44" MinHeight="44" Click="Back_Click" Visibility="Collapsed">
                  <FontIcon Glyph="" FontSize="16"/>
                </Button>
                <TextBlock x:Uid="VirtualMachineManagerDetailsHeading" Grid.Column="1" VerticalAlignment="Center" FontSize="20" FontWeight="SemiBold" AutomationProperties.HeadingLevel="Level2"/>
              </Grid>
              <Grid x:Name="MachineDetailState" Grid.Row="1" ColumnSpacing="20" RowSpacing="10" Visibility="Collapsed" AutomationProperties.LiveSetting="Polite">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto"/>
                  <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto"/>
                  <RowDefinition Height="Auto"/>
                  <RowDefinition Height="Auto"/>
                  <RowDefinition Height="Auto"/>
                  <RowDefinition Height="Auto"/>
                  <RowDefinition Height="Auto"/>
                  <RowDefinition Height="Auto"/>
                  <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock x:Uid="VirtualMachineManagerDetailName" FontWeight="SemiBold"/>
                <TextBlock Grid.Column="1" Text="{Binding SelectedMachine.Name}" TextWrapping="Wrap"/>
                <TextBlock x:Uid="VirtualMachineManagerDetailStatus" Grid.Row="1" FontWeight="SemiBold"/>
                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding SelectedMachine.StatusText}"/>
                <TextBlock x:Uid="VirtualMachineManagerDetailCpu" Grid.Row="2" FontWeight="SemiBold"/>
                <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding SelectedMachine.CpuText}"/>
                <TextBlock x:Uid="VirtualMachineManagerDetailMemory" Grid.Row="3" FontWeight="SemiBold"/>
                <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding SelectedMachine.MemoryText}"/>
                <TextBlock x:Uid="VirtualMachineManagerDetailStorage" Grid.Row="4" FontWeight="SemiBold"/>
                <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding SelectedMachine.StorageText}"/>
                <TextBlock x:Uid="VirtualMachineManagerDetailHost" Grid.Row="5" FontWeight="SemiBold"/>
                <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding SelectedMachine.HostText}" TextWrapping="Wrap"/>
                <StackPanel Grid.Row="6" Grid.ColumnSpan="2" Orientation="Horizontal" Spacing="8" Margin="0,10,0,0">
                  <Button x:Name="PowerOnButton" x:Uid="VmPowerOn" MinHeight="44" Click="PowerOn_Click"/>
                  <Button x:Name="ShutdownButton" x:Uid="VmShutdown" MinHeight="44" Click="Shutdown_Click"/>
                  <Button x:Name="PowerOffButton" x:Uid="VmPowerOff" MinHeight="44" Click="PowerOff_Click"/>
                </StackPanel>
                <StackPanel Grid.Row="7" Grid.ColumnSpan="2" Spacing="8">
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button x:Name="EditSettingsButton" x:Uid="VmSettingsEdit" MinHeight="44" Click="EditSettings_Click"/>
                    <Button x:Name="ConsoleButton" x:Uid="VmConsoleOpen" MinHeight="44" Click="OpenConsole_Click"/>
                  </StackPanel>
                  <TextBlock x:Name="ConsoleAvailabilityNotice" TextWrapping="Wrap"/>
                </StackPanel>
              </Grid>
              <TextBlock x:Uid="VirtualMachineManagerChooseMachineMessage" x:Name="NoSelectionState" Grid.Row="1" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/>
            </Grid>
          </Border>
        </Grid>
      </PivotItem>
      <PivotItem x:Uid="VirtualMachineManagerHostsTab">
        <Grid>
          <ListView x:Name="HostsList" ItemsSource="{Binding Hosts}" ItemTemplate="{StaticResource VirtualizationResourceTemplate}" SelectionMode="None"/>
          <StackPanel x:Name="HostsLoadingState" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8">
            <ProgressRing Width="30" Height="30" IsActive="True"/>
            <TextBlock x:Uid="VirtualMachineManagerSectionLoading" AutomationProperties.LiveSetting="Polite"/>
          </StackPanel>
          <StackPanel x:Name="HostsEmptyState" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8" Visibility="Collapsed">
            <TextBlock x:Uid="VirtualMachineManagerSectionEmpty" TextAlignment="Center" TextWrapping="Wrap"/>
          </StackPanel>
          <StackPanel x:Name="HostsErrorState" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8" Visibility="Collapsed">
            <TextBlock x:Uid="VirtualMachineManagerSectionError" TextAlignment="Center" TextWrapping="Wrap"/>
          </StackPanel>
          <StackPanel x:Name="HostsUnavailableState" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8" Visibility="Collapsed">
            <TextBlock x:Uid="VirtualMachineManagerSectionUnavailable" TextAlignment="Center" TextWrapping="Wrap"/>
          </StackPanel>
        </Grid>
      </PivotItem>
      <PivotItem x:Uid="VirtualMachineManagerStoragesTab">
        <Grid>
          <ListView x:Name="StoragesList" ItemsSource="{Binding Storages}" ItemTemplate="{StaticResource VirtualizationResourceTemplate}" SelectionMode="None"/>
          <StackPanel x:Name="StoragesLoadingState" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8">
            <ProgressRing Width="30" Height="30" IsActive="True"/>
            <TextBlock x:Uid="VirtualMachineManagerSectionLoading" AutomationProperties.LiveSetting="Polite"/>
          </StackPanel>
          <StackPanel x:Name="StoragesEmptyState" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8" Visibility="Collapsed">
            <TextBlock x:Uid="VirtualMachineManagerSectionEmpty" TextAlignment="Center" TextWrapping="Wrap"/>
          </StackPanel>
          <StackPanel x:Name="StoragesErrorState" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8" Visibility="Collapsed">
            <TextBlock x:Uid="VirtualMachineManagerSectionError" TextAlignment="Center" TextWrapping="Wrap"/>
          </StackPanel>
          <StackPanel x:Name="StoragesUnavailableState" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8" Visibility="Collapsed">
            <TextBlock x:Uid="VirtualMachineManagerSectionUnavailable" TextAlignment="Center" TextWrapping="Wrap"/>
          </StackPanel>
        </Grid>
      </PivotItem>
      <PivotItem x:Uid="VirtualMachineManagerNetworksTab">
        <Grid RowSpacing="12">
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
          <Button x:Name="ManageNetworksButton" x:Uid="VmNetworkOpen" HorizontalAlignment="Right" MinHeight="44" Click="ManageNetworks_Click"/>
          <ListView x:Name="NetworksList" Grid.Row="1" ItemsSource="{Binding Networks}" ItemTemplate="{StaticResource VirtualizationResourceTemplate}" SelectionMode="None"/>
          <StackPanel x:Name="NetworksLoadingState" Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8">
            <ProgressRing Width="30" Height="30" IsActive="True"/>
            <TextBlock x:Uid="VirtualMachineManagerSectionLoading" AutomationProperties.LiveSetting="Polite"/>
          </StackPanel>
          <StackPanel x:Name="NetworksEmptyState" Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8" Visibility="Collapsed">
            <TextBlock x:Uid="VirtualMachineManagerSectionEmpty" TextAlignment="Center" TextWrapping="Wrap"/>
          </StackPanel>
          <StackPanel x:Name="NetworksErrorState" Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8" Visibility="Collapsed">
            <TextBlock x:Uid="VirtualMachineManagerSectionError" TextAlignment="Center" TextWrapping="Wrap"/>
          </StackPanel>
          <StackPanel x:Name="NetworksUnavailableState" Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8" Visibility="Collapsed">
            <TextBlock x:Uid="VirtualMachineManagerSectionUnavailable" TextAlignment="Center" TextWrapping="Wrap"/>
          </StackPanel>
        </Grid>
      </PivotItem>
      <PivotItem x:Name="ImagesTab" x:Uid="VirtualMachineManagerImagesTab">
        <Grid RowSpacing="12">
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
            <Button x:Name="ImportImageButton" x:Uid="VmImageImportOpen" MinHeight="44" Click="ImportImage_Click"/>
            <Button x:Name="DeleteImagesButton" x:Uid="VmImageDeleteOpen" MinHeight="44" Click="DeleteImages_Click"/>
          </StackPanel>
          <ListView x:Name="ImagesList" Grid.Row="1" ItemsSource="{Binding Images}" ItemTemplate="{StaticResource VirtualizationResourceTemplate}" SelectionMode="None"/>
          <StackPanel x:Name="ImagesLoadingState" Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8">
            <ProgressRing Width="30" Height="30" IsActive="True"/>
            <TextBlock x:Uid="VirtualMachineManagerSectionLoading" AutomationProperties.LiveSetting="Polite"/>
          </StackPanel>
          <StackPanel x:Name="ImagesEmptyState" Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8" Visibility="Collapsed">
            <TextBlock x:Uid="VirtualMachineManagerSectionEmpty" TextAlignment="Center" TextWrapping="Wrap"/>
          </StackPanel>
          <StackPanel x:Name="ImagesErrorState" Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8" Visibility="Collapsed">
            <TextBlock x:Uid="VirtualMachineManagerSectionError" TextAlignment="Center" TextWrapping="Wrap"/>
          </StackPanel>
          <StackPanel x:Name="ImagesUnavailableState" Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8" Visibility="Collapsed">
            <TextBlock x:Uid="VirtualMachineManagerSectionUnavailable" TextAlignment="Center" TextWrapping="Wrap"/>
          </StackPanel>
        </Grid>
      </PivotItem>
      <PivotItem x:Uid="VirtualMachineManagerProtectionTab">
        <Grid AutomationProperties.LiveSetting="Polite">
          <ListView x:Uid="VirtualMachineManagerProtectionList" x:Name="ProtectionList" ItemsSource="{Binding Protection}" ItemTemplate="{StaticResource VirtualizationProtectionTemplate}" SelectionMode="None"/>
          <StackPanel x:Name="ProtectionLoadingState" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8">
            <ProgressRing Width="30" Height="30" IsActive="True"/>
            <TextBlock x:Uid="VirtualMachineManagerSectionLoading" TextWrapping="Wrap"/>
          </StackPanel>
          <StackPanel x:Name="ProtectionEmptyState" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="360" Spacing="8" Visibility="Collapsed">
            <TextBlock x:Uid="VirtualMachineManagerSectionEmpty" TextAlignment="Center" TextWrapping="Wrap"/>
          </StackPanel>
          <StackPanel x:Name="ProtectionErrorState" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="360" Spacing="8" Visibility="Collapsed">
            <TextBlock x:Uid="VirtualMachineManagerSectionError" TextAlignment="Center" TextWrapping="Wrap"/>
          </StackPanel>
          <StackPanel x:Name="ProtectionUnavailableState" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="360" Spacing="8" Visibility="Collapsed">
            <TextBlock x:Uid="VirtualMachineManagerSectionUnavailable" TextAlignment="Center" TextWrapping="Wrap"/>
          </StackPanel>
        </Grid>
      </PivotItem>
      <PivotItem x:Uid="VirtualMachineManagerEventsTab">
        <Grid AutomationProperties.LiveSetting="Polite">
          <ListView x:Uid="VirtualMachineManagerEventsList" x:Name="EventsList" ItemsSource="{Binding Events}" ItemTemplate="{StaticResource VirtualMachineEventTemplate}" SelectionMode="None"/>
          <StackPanel x:Name="EventsLoadingState" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8">
            <ProgressRing Width="30" Height="30" IsActive="True"/>
            <TextBlock x:Uid="VirtualMachineManagerSectionLoading" TextWrapping="Wrap"/>
          </StackPanel>
          <StackPanel x:Name="EventsEmptyState" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="360" Spacing="8" Visibility="Collapsed">
            <TextBlock x:Uid="VirtualMachineManagerSectionEmpty" TextAlignment="Center" TextWrapping="Wrap"/>
          </StackPanel>
          <StackPanel x:Name="EventsErrorState" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="360" Spacing="8" Visibility="Collapsed">
            <TextBlock x:Uid="VirtualMachineManagerSectionError" TextAlignment="Center" TextWrapping="Wrap"/>
          </StackPanel>
          <StackPanel x:Name="EventsUnavailableState" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="360" Spacing="8" Visibility="Collapsed">
            <TextBlock x:Uid="VirtualMachineManagerSectionUnavailable" TextAlignment="Center" TextWrapping="Wrap"/>
          </StackPanel>
        </Grid>
      </PivotItem>
      <PivotItem x:Name="TasksTab" x:Uid="VmTasksTab"><views:VirtualMachineTasksControl x:Name="TasksPane"/></PivotItem>
    </Pivot>
  </Grid>
</Page>
