<UserControl x:Class="LanStash.App.Views.NasRemoteAccessDialogContent"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <ScrollViewer MaxHeight="550" HorizontalScrollBarVisibility="Disabled">
  <StackPanel MinWidth="340" MaxWidth="520" Spacing="14">
   <ProgressRing x:Name="LoadingIndicator" Width="32" Height="32" Visibility="Collapsed"/>
   <InfoBar x:Name="ErrorNotice" IsOpen="False" IsClosable="False" Severity="Error" AutomationProperties.LiveSetting="Polite"/>
   <InfoBar x:Name="FeedbackNotice" IsOpen="False" IsClosable="False" AutomationProperties.LiveSetting="Polite"/>
   <InfoBar x:Name="PendingNotice" x:Uid="NasRemotePending" IsOpen="False" IsClosable="False" Severity="Warning"/>
   <TextBlock x:Name="ReadOnlyNotice" x:Uid="NasServiceReadOnly" Visibility="Collapsed" TextWrapping="Wrap"/>
   <TextBlock x:Name="EmptyNotice" x:Uid="NasRemoteEmpty" Visibility="Collapsed" TextWrapping="Wrap"/>
   <StackPanel x:Name="SettingsPanel" Spacing="14" Visibility="Collapsed">
    <TextBlock x:Uid="NasRemoteRelayTitle" FontWeight="SemiBold"/>
    <ToggleSwitch x:Name="RelayToggle" x:Uid="NasRemoteRelay" Toggled="Fields_Changed"/>
    <TextBlock x:Name="RelayUnavailable" TextWrapping="Wrap"/>
    <TextBlock x:Name="RelayProtection" x:Uid="NasRemoteRelayProtection" Visibility="Collapsed" TextWrapping="Wrap"/>
    <TextBlock x:Uid="NasRemoteRouterTitle" FontWeight="SemiBold"/>
    <ToggleSwitch x:Name="RouterToggle" x:Uid="NasRemoteRouter" Toggled="Fields_Changed"/>
    <TextBlock x:Name="RouterUnavailable" TextWrapping="Wrap"/>
    <TextBlock x:Name="RiskNotice" x:Uid="NasRemoteRisk" Visibility="Collapsed" TextWrapping="Wrap"/>
    <CheckBox x:Name="RiskAcknowledgement" x:Uid="NasRemoteConfirm" Checked="Confirm_Changed" Unchecked="Confirm_Changed">
     <CheckBox.ContentTemplate><DataTemplate><TextBlock Text="{Binding}" TextWrapping="Wrap"/></DataTemplate></CheckBox.ContentTemplate>
    </CheckBox>
   </StackPanel>
  </StackPanel>
 </ScrollViewer>
</UserControl>
