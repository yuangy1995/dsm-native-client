                <TextBlock x:Uid="FileBrowserStorageUnavailable" desktop:DesktopLocalization.Bindings="Text=FileBrowserStorageUnavailable.Text" x:Name="StorageUnavailableState" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" Visibility="Collapsed"/>
            </StackPanel>
