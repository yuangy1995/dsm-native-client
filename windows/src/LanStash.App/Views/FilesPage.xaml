<Page xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:files="using:LanStash.App.Features.Files" xmlns:views="using:LanStash.App.Views" x:Class="LanStash.App.Views.FilesPage" SizeChanged="FilesPage_SizeChanged" Background="{ThemeResource WorkspaceSurfaceBrush}">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="72"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>
    <Grid x:Name="FileToolbar" Grid.Row="0" Padding="18,12" BorderBrush="{ThemeResource WorkspaceEdgeBrush}" BorderThickness="0,0,0,1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="Auto"/>
      </Grid.ColumnDefinitions>
      <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
        <Button x:Uid="WorkspaceSidebarToggle" Click="Sidebar_Click" Width="38" Height="38" MinHeight="38" Padding="0" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" CornerRadius="10">
          <Button.Content>
            <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="" FontSize="20"/>
          </Button.Content>
        </Button>
        <Button x:Uid="FileBrowserBack" x:Name="BackButton" Click="Back_Click" Width="38" Height="38" MinHeight="38" Padding="0" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" CornerRadius="10" Background="{ThemeResource SubtleFillColorSecondaryBrush}">
          <Button.KeyboardAccelerators>
            <KeyboardAccelerator Key="Left" Modifiers="Menu" Invoked="BackAccelerator_Invoked"/>
          </Button.KeyboardAccelerators>
          <Button.Content>
            <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="" FontSize="20"/>
          </Button.Content>
        </Button>
        <Button x:Uid="FileBrowserUp" x:Name="UpButton" Click="Up_Click" Width="38" Height="38" MinHeight="38" Padding="0" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" CornerRadius="10" Background="{ThemeResource SubtleFillColorSecondaryBrush}">
          <Button.Content>
            <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="" FontSize="20"/>
          </Button.Content>
        </Button>
        <Button x:Uid="FileBrowserRefresh" x:Name="RefreshButton" Click="Refresh_Click" Width="38" Height="38" MinHeight="38" Padding="0" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" CornerRadius="10" Background="{ThemeResource SubtleFillColorSecondaryBrush}">
          <Button.Content>
            <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="" FontSize="20"/>
          </Button.Content>
        </Button>
      </StackPanel>
      <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
        <Button x:Uid="WorkspaceUpload" x:Name="UploadButton" Click="Upload_Click" MinHeight="38" Width="90" Height="38" Background="{ThemeResource WorkspaceAccentBrush}" Foreground="{ThemeResource WorkspaceOnAccentBrush}" CornerRadius="10">
          <Button.KeyboardAccelerators>
            <KeyboardAccelerator Key="U" Modifiers="Control" Invoked="UploadAccelerator_Invoked"/>
          </Button.KeyboardAccelerators>
          <StackPanel Orientation="Horizontal" Spacing="8">
            <SymbolIcon Symbol="Upload"/>
            <TextBlock x:Uid="WorkspaceUploadLabel"/>
          </StackPanel>
        </Button>
        <AutoSuggestBox x:Uid="FileBrowserFilter" x:Name="FilterBox" QueryIcon="Find" TextChanged="FilterBox_TextChanged" Width="240" Height="36" CornerRadius="10"/>
        <ToggleButton x:Uid="FileBrowserGridLayout" x:Name="GridLayoutButton" Click="GridLayout_Click" Style="{StaticResource WorkspaceIconToggleStyle}">
          <ToggleButton.Content>
            <PathIcon Width="20" Height="20" Data="M0,0 L8,0 L8,8 L0,8 Z M12,0 L20,0 L20,8 L12,8 Z M0,12 L8,12 L8,20 L0,20 Z M12,12 L20,12 L20,20 L12,20 Z"/>
          </ToggleButton.Content>
        </ToggleButton>
        <ToggleButton x:Uid="FileBrowserListLayout" x:Name="ListLayoutButton" Click="ListLayout_Click" Style="{StaticResource WorkspaceIconToggleStyle}">
          <ToggleButton.Content>
            <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="" FontSize="20"/>
          </ToggleButton.Content>
        </ToggleButton>
        <ToggleButton x:Name="InspectorButton" x:Uid="WorkspaceInspectorToggle" IsChecked="True" Style="{StaticResource WorkspaceIconToggleStyle}" Click="Inspector_Click">
          <ToggleButton.Content>
            <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="" FontSize="20"/>
          </ToggleButton.Content>
        </ToggleButton>
      </StackPanel>
    </Grid>
    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition x:Name="MainContentColumn" Width="*"/>
        <ColumnDefinition x:Name="InspectorColumn" Width="210"/>
      </Grid.ColumnDefinitions>
      <Grid.RowDefinitions>
        <RowDefinition Height="64"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
        <RowDefinition Height="40"/>
      </Grid.RowDefinitions>
      <Grid Padding="18,10" BorderBrush="{ThemeResource WorkspaceEdgeBrush}" BorderThickness="0,0,0,1">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <BreadcrumbBar x:Uid="FileBrowserBreadcrumbs" x:Name="PathBreadcrumbs" ItemsSource="{Binding Breadcrumbs}" ItemClicked="PathBreadcrumbs_ItemClicked"/>
        <CommandBar Grid.Row="0" Background="Transparent" DefaultLabelPosition="Right" Grid.Column="1" HorizontalAlignment="Right" IsDynamicOverflowEnabled="False">
          <AppBarButton x:Uid="FileBrowserSort" x:Name="SortButton" Icon="Sort" MinHeight="36">
            <AppBarButton.Flyout>
              <MenuFlyout>
                <RadioMenuFlyoutItem x:Uid="FileBrowserSortName" x:Name="SortNameItem" Click="SortName_Click" GroupName="FileSortField" MinHeight="44"/>
                <RadioMenuFlyoutItem x:Uid="FileBrowserSortModified" x:Name="SortModifiedItem" Click="SortModified_Click" GroupName="FileSortField" MinHeight="44"/>
                <RadioMenuFlyoutItem x:Uid="FileBrowserSortSize" x:Name="SortSizeItem" Click="SortSize_Click" GroupName="FileSortField" MinHeight="44"/>
                <MenuFlyoutSeparator/>
                <RadioMenuFlyoutItem x:Uid="FileBrowserSortAscending" x:Name="SortAscendingItem" Click="SortAscending_Click" GroupName="FileSortDirection" MinHeight="44"/>
                <RadioMenuFlyoutItem x:Uid="FileBrowserSortDescending" x:Name="SortDescendingItem" Click="SortDescending_Click" GroupName="FileSortDirection" MinHeight="44"/>
              </MenuFlyout>
            </AppBarButton.Flyout>
          </AppBarButton>
          <CommandBar.SecondaryCommands>
            <AppBarButton x:Uid="FileLocationsOpen" x:Name="LocationsButton" Click="Locations_Click" AccessKey="L" CornerRadius="10" MinHeight="44">
              <AppBarButton.Icon>
                <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="" FontSize="20"/>
              </AppBarButton.Icon>
            </AppBarButton>
            <AppBarButton x:Uid="FileBrowserCancelDownloadSelection" x:Name="CancelDownloadSelectionButton" Click="CancelDownloadSelection_Click" Icon="Cancel" MinHeight="44" Visibility="Collapsed"/>
            <AppBarButton x:Uid="FileArchiveCompressionSelected" x:Name="CreateArchiveSelectedButton" Click="CreateArchiveSelected_Click" Icon="Accept" MinHeight="48" Visibility="Collapsed"/>
            <AppBarButton x:Uid="FileRestoreBatchSelected" x:Name="RestoreSelectedItemsButton" Click="RestoreSelectedItems_Click" Icon="Undo" MinHeight="48" Visibility="Collapsed"/>
            <AppBarButton x:Uid="FileRecycleBatchMoveSelected" x:Name="MoveSelectedToRecycleButton" Click="MoveSelectedToRecycle_Click" Icon="Delete" MinHeight="48" Visibility="Collapsed"/>
            <AppBarButton x:Uid="FileCopyMoveMoveSelected" x:Name="MoveSelectedItemsButton" Click="MoveSelectedItems_Click" Icon="MoveToFolder" MinHeight="48" Visibility="Collapsed"/>
            <AppBarButton x:Uid="FileCopyMoveCopySelected" x:Name="CopySelectedItemsButton" Click="CopySelectedItems_Click" Icon="Copy" MinHeight="48" Visibility="Collapsed"/>
            <AppBarButton x:Uid="FileBrowserDownloadSelected" x:Name="DownloadSelectedFilesButton" Click="DownloadSelectedFiles_Click" Icon="Accept" MinHeight="44" Visibility="Collapsed"/>
            <AppBarButton x:Uid="FileBrowserDownload" x:Name="DownloadButton" Click="Download_Click" Icon="Download" MinHeight="44">
              <AppBarButton.KeyboardAccelerators>
                <KeyboardAccelerator Key="S" Modifiers="Control" Invoked="DownloadAccelerator_Invoked"/>
              </AppBarButton.KeyboardAccelerators>
            </AppBarButton>
            <AppBarButton x:Uid="FileMutationCreateFolder" x:Name="CreateFolderButton" Click="CreateFolder_Click" Icon="NewFolder" MinHeight="48">
              <AppBarButton.KeyboardAccelerators>
                <KeyboardAccelerator Key="N" Modifiers="Control,Shift" Invoked="CreateFolderAccelerator_Invoked"/>
              </AppBarButton.KeyboardAccelerators>
            </AppBarButton>
            <AppBarButton x:Uid="FileMutationRename" x:Name="RenameButton" Click="RenameItem_Click" Icon="Rename" MinHeight="48">
              <AppBarButton.KeyboardAccelerators>
                <KeyboardAccelerator Key="F2" Invoked="RenameAccelerator_Invoked"/>
              </AppBarButton.KeyboardAccelerators>
            </AppBarButton>
            <AppBarButton x:Uid="FileCopyMoveCopy" x:Name="CopyFileButton" Click="CopyFile_Click" Icon="Copy" AccessKey="C" MinHeight="48"/>
            <AppBarButton x:Uid="FileCopyMoveMove" x:Name="MoveFileButton" Click="MoveFile_Click" Icon="MoveToFolder" AccessKey="M" MinHeight="48"/>
            <AppBarButton x:Uid="FileRecycleMoveToRecycle" x:Name="MoveToRecycleButton" Click="MoveToRecycle_Click" Icon="Delete" MinHeight="48"/>
            <AppBarButton x:Uid="FileRecycleRestore" x:Name="RestoreFromRecycleButton" Click="RestoreFromRecycle_Click" Icon="Undo" MinHeight="48"/>
            <AppBarButton x:Uid="FolderUpload" x:Name="UploadFolderButton" Click="UploadFolder_Click" Icon="OpenFile" MinHeight="44"/>
            <AppBarToggleButton x:Uid="FileBrowserUploadOverwrite" x:Name="UploadOverwriteToggle" Icon="Switch" MinHeight="44"/>
            <AppBarButton x:Uid="FileBrowserDownloadMultiple" x:Name="DownloadMultipleButton" Click="DownloadMultiple_Click" MinHeight="44">
              <AppBarButton.Icon>
                <FontIcon Glyph=""/>
              </AppBarButton.Icon>
            </AppBarButton>
            <AppBarButton x:Uid="FilePreviewOpen" x:Name="PreviewButton" Click="Preview_Click" Icon="View" MinHeight="44"/>
            <AppBarButton x:Uid="FileFavoriteAction" x:Name="ToggleFavoriteButton" Click="ToggleFavorite_Click" Icon="Favorite" MinHeight="44"/>
            <AppBarButton x:Uid="FileShareLink" x:Name="ShareLinkButton" Click="ShareLink_Click" Icon="Link" MinHeight="44">
              <AppBarButton.KeyboardAccelerators>
                <KeyboardAccelerator Key="L" Modifiers="Control,Shift" Invoked="ShareLinkAccelerator_Invoked"/>
              </AppBarButton.KeyboardAccelerators>
            </AppBarButton>
            <AppBarButton x:Uid="FileCopyMoveCopyMultiple" x:Name="CopyMultipleButton" Click="CopyMultiple_Click" Icon="Copy" MinHeight="48"/>
            <AppBarButton x:Uid="FileCopyMoveMoveMultiple" x:Name="MoveMultipleButton" Click="MoveMultiple_Click" Icon="MoveToFolder" MinHeight="48"/>
            <AppBarButton x:Uid="FileOperationReviewAction" x:Name="CopyMoveRecoveryButton" Click="CopyMoveRecovery_Click" Icon="Refresh" MinHeight="48"/>
            <AppBarButton x:Uid="FileRecycleReviewAction" x:Name="RecycleRecoveryButton" Click="RecycleRecovery_Click" Icon="Refresh" MinHeight="48"/>
            <AppBarButton x:Uid="FileRecycleBatchMoveMultiple" x:Name="MoveMultipleToRecycleButton" Click="MoveMultipleToRecycle_Click" Icon="Delete" MinHeight="48"/>
            <AppBarButton x:Uid="FileRestoreBatchMultiple" x:Name="RestoreMultipleItemsButton" Click="RestoreMultipleItems_Click" Icon="Undo" MinHeight="48"/>
            <AppBarButton x:Uid="FileArchiveCompressionCreate" x:Name="CreateArchiveButton" Click="CreateArchive_Click" MinHeight="48">
              <AppBarButton.Icon>
                <FontIcon Glyph=""/>
              </AppBarButton.Icon>
            </AppBarButton>
            <AppBarButton x:Uid="FileArchiveExtractionExtract" x:Name="ExtractArchiveButton" Click="ExtractArchive_Click" Icon="OpenFile" MinHeight="48">
              <AppBarButton.KeyboardAccelerators>
                <KeyboardAccelerator Key="E" Modifiers="Control,Shift" Invoked="ExtractArchiveAccelerator_Invoked"/>
              </AppBarButton.KeyboardAccelerators>
            </AppBarButton>
            <AppBarButton x:Uid="FileShareLinkManage" x:Name="ManageShareLinksButton" Click="ManageShareLinks_Click" Icon="Link" MinHeight="44"/>
            <AppBarButton x:Uid="FileDirectorySizeAction" x:Name="DirectorySizeButton" Click="DirectorySize_Click" Icon="Folder" MinHeight="44">
              <AppBarButton.KeyboardAccelerators>
                <KeyboardAccelerator Key="Enter" Modifiers="Menu" Invoked="DirectorySizeAccelerator_Invoked"/>
              </AppBarButton.KeyboardAccelerators>
            </AppBarButton>
            <AppBarSeparator/>
            <AppBarButton x:Uid="CrossNasCopyAction" x:Name="CrossNasCopyButton" Click="CrossNasCopy_Click" MinHeight="44">
              <AppBarButton.Icon>
                <FontIcon Glyph=""/>
              </AppBarButton.Icon>
            </AppBarButton>
            <AppBarButton x:Uid="CrossNasMoveAction" x:Name="CrossNasMoveButton" Click="CrossNasMove_Click" MinHeight="44">
              <AppBarButton.Icon>
                <FontIcon Glyph=""/>
              </AppBarButton.Icon>
            </AppBarButton>
            <AppBarButton x:Uid="FileBrowserTypeFilter" x:Name="TypeFilterButton" Icon="Filter" MinHeight="44">
              <AppBarButton.Flyout>
                <MenuFlyout>
                  <RadioMenuFlyoutItem x:Uid="FileBrowserTypeAll" x:Name="TypeAllItem" Click="TypeAll_Click" GroupName="FileTypeFilter" MinHeight="44"/>
                  <RadioMenuFlyoutItem x:Uid="FileBrowserTypeFiles" x:Name="TypeFilesItem" Click="TypeFiles_Click" GroupName="FileTypeFilter" MinHeight="44"/>
                  <RadioMenuFlyoutItem x:Uid="FileBrowserTypeFolders" x:Name="TypeFoldersItem" Click="TypeFolders_Click" GroupName="FileTypeFilter" MinHeight="44"/>
                </MenuFlyout>
              </AppBarButton.Flyout>
            </AppBarButton>
          </CommandBar.SecondaryCommands>
        </CommandBar>
      </Grid>
      <StackPanel Grid.Row="1">
        <ToggleSwitch x:Uid="FileBrowserSearchSubfolders" x:Name="SearchSubfoldersToggle" Toggled="SearchSubfolders_Toggled" IsOn="False" Visibility="Collapsed"/>
        <StackPanel x:Name="SearchProgressState" Orientation="Horizontal" Spacing="8" Visibility="Collapsed">
          <ProgressRing Width="18" Height="18" IsActive="True"/>
          <TextBlock x:Uid="FileBrowserSearchInProgress" VerticalAlignment="Center" TextWrapping="Wrap"/>
        </StackPanel>
        <InfoBar x:Name="SearchStatus" AutomationProperties.LiveSetting="Polite" IsClosable="False" IsOpen="False" Visibility="Collapsed">
          <InfoBar.ActionButton>
            <Button x:Uid="FileBrowserSearchRetry" Click="SearchRetry_Click" MinHeight="44"/>
          </InfoBar.ActionButton>
        </InfoBar>
        <InfoBar x:Uid="FileBrowserUploadNeedsReview" x:Name="UploadNeedsReview" IsClosable="True" IsOpen="False" Severity="Warning"/>
      </StackPanel>
      <SplitView x:Name="LocationsSplitView" Grid.Row="2" CompactPaneLength="0" DisplayMode="Inline" IsPaneOpen="False" OpenPaneLength="224" PaneClosed="LocationsSplitView_PaneClosed" PanePlacement="Left">
        <SplitView.Pane>
          <views:FileLocationsView x:Name="LocationsPane"/>
        </SplitView.Pane>
        <SplitView.Content>
          <Grid ColumnSpacing="0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition x:Name="BrowserColumn" Width="*"/>
              <ColumnDefinition x:Name="PreviewColumn" Width="0"/>
            </Grid.ColumnDefinitions>
            <Grid x:Name="BrowserSurface" AllowDrop="True" DragOver="FileUpload_DragOver" DragLeave="FileUpload_DragLeave" Drop="FileUpload_Drop" Margin="16,12">
              <Grid x:Name="ContentState" Visibility="Collapsed">
                <Grid.RowDefinitions>
                  <RowDefinition Height="*"/>
                  <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <ListView x:Uid="FileBrowserList" x:Name="FileList" ContextRequested="Files_ContextRequested" AllowDrop="True" CanDragItems="True" DragItemsStarting="FileList_DragItemsStarting" DragItemsCompleted="FileList_DragItemsCompleted" DragOver="FileList_DragOver" Drop="FileList_Drop" DoubleTapped="Files_DoubleTapped" ItemsSource="{Binding Items}" SelectionChanged="Files_SelectionChanged" SelectedItem="{Binding SelectedItem, Mode=TwoWay}" SelectionMode="Single">
                  <ListView.KeyboardAccelerators>
                    <KeyboardAccelerator Key="Enter" Invoked="OpenSelectedAccelerator_Invoked"/>
                  </ListView.KeyboardAccelerators>
                  <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                      <Setter Property="MinHeight" Value="44"/>
                    </Style>
                  </ListView.ItemContainerStyle>
                  <ListView.Header>
                    <Grid Padding="12,8" ColumnSpacing="14" Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="32"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="160"/>
                        <ColumnDefinition Width="90"/>
                      </Grid.ColumnDefinitions>
                      <TextBlock Grid.Column="1" x:Uid="WorkspaceFileName" FontSize="12"/>
                      <TextBlock Grid.Column="2" x:Uid="WorkspaceFileModified" FontSize="12"/>
                      <TextBlock Grid.Column="3" x:Uid="WorkspaceFileSize" FontSize="12" HorizontalAlignment="Right"/>
                    </Grid>
                  </ListView.Header>
                  <ListView.ItemTemplate>
                    <DataTemplate x:DataType="files:FileBrowserEntry">
                      <Grid MinHeight="44" Padding="8" ColumnSpacing="14">
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="32"/>
                          <ColumnDefinition Width="*"/>
                          <ColumnDefinition Width="160"/>
                          <ColumnDefinition Width="90"/>
                        </Grid.ColumnDefinitions>
                        <views:FileEntryIcon IsDirectory="{x:Bind IsDirectory}" Width="28" Height="28" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1" Text="{x:Bind Name}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="2" Text="{x:Bind ModifiedText}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="3" Text="{x:Bind SizeText}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                      </Grid>
                    </DataTemplate>
                  </ListView.ItemTemplate>
                </ListView>
                <GridView x:Uid="FileBrowserGrid" x:Name="FileGrid" ContextRequested="Files_ContextRequested" AllowDrop="True" CanDragItems="True" DragItemsStarting="FileList_DragItemsStarting" DragItemsCompleted="FileList_DragItemsCompleted" DragOver="FileList_DragOver" Drop="FileList_Drop" DoubleTapped="Files_DoubleTapped" ItemsSource="{Binding Items}" SelectionChanged="Files_SelectionChanged" SelectedItem="{Binding SelectedItem, Mode=TwoWay}" SelectionMode="Single" Visibility="Collapsed">
                  <GridView.KeyboardAccelerators>
                    <KeyboardAccelerator Key="Enter" Invoked="OpenSelectedAccelerator_Invoked"/>
                  </GridView.KeyboardAccelerators>
                  <GridView.ItemTemplate>
                    <DataTemplate x:DataType="files:FileBrowserEntry">
                      <StackPanel Width="120" MinHeight="144" Padding="8,22" Spacing="12">
                        <views:FileEntryIcon IsDirectory="{x:Bind IsDirectory}" Width="60" Height="60" VerticalAlignment="Center"/>
                        <TextBlock HorizontalAlignment="Center" FontWeight="Normal" MaxLines="2" Text="{x:Bind Name}" TextAlignment="Center" TextTrimming="CharacterEllipsis" TextWrapping="Wrap"/>
                      </StackPanel>
                    </DataTemplate>
                  </GridView.ItemTemplate>
                </GridView>
                <StackPanel Grid.Row="1" HorizontalAlignment="Center" Spacing="8">
                  <InfoBar x:Uid="FileBrowserLoadMoreError" x:Name="LoadMoreError" IsClosable="False" IsOpen="False" Severity="Warning"/>
                  <Button x:Uid="FileBrowserLoadMore" x:Name="LoadMoreButton" Click="LoadMore_Click" MinHeight="44"/>
                  <ProgressRing x:Name="LoadMoreProgress" Width="24" Height="24" IsActive="False" Visibility="Collapsed"/>
                </StackPanel>
              </Grid>
              <StackPanel x:Name="LoadingState" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12">
                <ProgressRing Width="36" Height="36" IsActive="True"/>
                <TextBlock x:Uid="FileBrowserLoading" TextAlignment="Center"/>
              </StackPanel>
              <StackPanel x:Name="EmptyState" MaxWidth="420" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10" Visibility="Collapsed">
                <FontIcon FontSize="38" Glyph=""/>
                <TextBlock x:Uid="FileBrowserEmptyTitle" Style="{StaticResource SubtitleTextBlockStyle}" TextAlignment="Center"/>
                <TextBlock x:Uid="FileBrowserEmptyMessage" TextAlignment="Center" TextWrapping="Wrap"/>
                <Button x:Uid="FileBrowserRefreshEmpty" Click="Refresh_Click" HorizontalAlignment="Center" MinHeight="44"/>
              </StackPanel>
              <StackPanel x:Name="FilteredEmptyState" MaxWidth="420" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10" Visibility="Collapsed">
                <FontIcon FontSize="38" Glyph=""/>
                <TextBlock x:Uid="FileBrowserFilteredEmptyTitle" Style="{StaticResource SubtitleTextBlockStyle}" TextAlignment="Center"/>
                <TextBlock x:Uid="FileBrowserFilteredEmptyMessage" TextAlignment="Center" TextWrapping="Wrap"/>
                <Button x:Uid="FileBrowserClearFilter" Click="ClearFilter_Click" HorizontalAlignment="Center" MinHeight="44"/>
              </StackPanel>
              <StackPanel x:Name="ErrorState" MaxWidth="420" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10" Visibility="Collapsed">
                <FontIcon FontSize="38" Glyph=""/>
                <TextBlock x:Uid="FileBrowserErrorTitle" Style="{StaticResource SubtitleTextBlockStyle}" TextAlignment="Center"/>
                <TextBlock x:Uid="FileBrowserErrorMessage" TextAlignment="Center" TextWrapping="Wrap"/>
                <Button x:Uid="FileBrowserRetry" Click="Refresh_Click" HorizontalAlignment="Center" MinHeight="44"/>
              </StackPanel>
              <Border x:Uid="FileUploadDropTarget" x:Name="FileUploadDropOverlay" Margin="12" Padding="24" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Background="{ThemeResource WorkspaceSurfaceBrush}" BorderBrush="{ThemeResource AccentFillColorDefaultBrush}" BorderThickness="2" CornerRadius="8" IsHitTestVisible="False" Visibility="Collapsed">
                <StackPanel MaxWidth="440" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12">
                  <FontIcon HorizontalAlignment="Center" FontSize="40" Glyph=""/>
                  <TextBlock x:Uid="FileUploadDropTargetMessage" Style="{ThemeResource SubtitleTextBlockStyle}" TextAlignment="Center" TextWrapping="Wrap"/>
                </StackPanel>
              </Border>
              <StackPanel Margin="12" HorizontalAlignment="Stretch" VerticalAlignment="Top" Spacing="8">
                <InfoBar x:Uid="FileUploadDropStatus" x:Name="FileUploadDropStatus" IsClosable="True" IsOpen="False" AutomationProperties.LiveSetting="Polite" Severity="Informational"/>
                <InfoBar x:Uid="FileDownloadBatchStatus" x:Name="FileDownloadBatchStatus" IsClosable="True" IsOpen="False" AutomationProperties.LiveSetting="Polite" Severity="Informational"/>
                <InfoBar x:Uid="FileCopyMoveBatchStatus" x:Name="FileCopyMoveBatchStatus" IsClosable="True" IsOpen="False" AutomationProperties.LiveSetting="Polite" Severity="Informational"/>
                <InfoBar x:Uid="FileRecycleBatchStatus" x:Name="FileRecycleBatchStatus" IsClosable="True" IsOpen="False" AutomationProperties.LiveSetting="Polite" Severity="Informational"/>
                <InfoBar x:Uid="FileArchiveCompressionStatus" x:Name="FileArchiveCompressionStatus" IsClosable="True" IsOpen="False" AutomationProperties.LiveSetting="Polite" Severity="Informational"/>
                <InfoBar x:Uid="FileFavoriteStatus" x:Name="FileFavoriteStatus" IsClosable="True" IsOpen="False" AutomationProperties.LiveSetting="Polite"/>
                <InfoBar x:Uid="FileMoveUndoStatus" x:Name="FileMoveUndoStatus" IsClosable="True" IsOpen="False" AutomationProperties.LiveSetting="Assertive" Severity="Success"/>
              </StackPanel>
            </Grid>
            <views:FilePreviewPane x:Name="PreviewPane" Grid.Column="1" Visibility="Collapsed"/>
          </Grid>
        </SplitView.Content>
      </SplitView>
      <Grid Grid.Row="3" Padding="22,8" BorderThickness="0,1,0,0" BorderBrush="{ThemeResource WorkspaceEdgeBrush}">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <TextBlock x:Name="FileCountText" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center"/>
        </Grid>
      <Grid x:Name="InspectorSurface" Grid.Column="1" Grid.RowSpan="4" Padding="16,18" BorderThickness="1,0,0,0" BorderBrush="{ThemeResource WorkspaceEdgeBrush}">
        <TextBlock x:Uid="WorkspaceInspectorTitle" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
        <StackPanel x:Name="InspectorEmpty" VerticalAlignment="Center" Spacing="10">
          <FontIcon Glyph="" FontFamily="Segoe MDL2 Assets" FontSize="36" Opacity="0.35" Margin="0,0,0,18"/>
          <TextBlock x:Uid="WorkspaceInspectorEmptyTitle" FontWeight="SemiBold" TextWrapping="Wrap" TextAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
          <TextBlock x:Uid="WorkspaceInspectorEmptyMessage" TextWrapping="Wrap" TextAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
        </StackPanel>
        <StackPanel x:Name="InspectorDetails" Visibility="Collapsed" Margin="0,48,0,0" Spacing="18">
          <views:FileEntryIcon x:Name="InspectorIcon" Width="72" Height="72"/>
          <TextBlock x:Name="InspectorName" FontSize="17" FontWeight="SemiBold" TextWrapping="Wrap"/>
          <TextBlock x:Name="InspectorKind" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
          <TextBlock x:Name="InspectorSize"/>
          <TextBlock x:Name="InspectorModified" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
        </StackPanel>
      </Grid>
    </Grid>
  </Grid>
</Page>
