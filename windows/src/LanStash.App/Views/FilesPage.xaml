<StackPanel x:Name="MetadataDetails" Spacing="14" Visibility="Collapsed">
<FontIcon x:Name="MetadataIcon" FontSize="56" Margin="0,8" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
<TextBlock x:Name="MetadataName" FontWeight="SemiBold" FontSize="16" TextAlignment="Center" TextWrapping="Wrap" IsTextSelectionEnabled="True"/>
<StackPanel Spacing="4"><TextBlock x:Uid="DesktopFileKind" desktop:DesktopLocalization.Bindings="Text=DesktopFileKind.Text" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/><TextBlock x:Name="MetadataKind" TextWrapping="Wrap"/></StackPanel>
<StackPanel Spacing="4"><TextBlock x:Uid="DesktopFileSize" desktop:DesktopLocalization.Bindings="Text=DesktopFileSize.Text" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/><TextBlock x:Name="MetadataSize" TextWrapping="Wrap"/></StackPanel>
<StackPanel Spacing="4"><TextBlock x:Uid="DesktopFileModified" desktop:DesktopLocalization.Bindings="Text=DesktopFileModified.Text" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/><TextBlock x:Name="MetadataModified" TextWrapping="Wrap"/></StackPanel>
<StackPanel Spacing="4"><TextBlock x:Uid="DesktopFilePath" desktop:DesktopLocalization.Bindings="Text=DesktopFilePath.Text" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/><TextBlock x:Name="MetadataPath" TextWrapping="Wrap" IsTextSelectionEnabled="True"/></StackPanel>
<Button x:Name="MetadataPreviewButton" x:Uid="DesktopOpenPreview" desktop:DesktopLocalization.Bindings="Content=DesktopOpenPreview.Content" Click="Preview_Click" HorizontalAlignment="Stretch" MinHeight="40"/>
<Button x:Name="MetadataDownloadButton" x:Uid="DesktopSaveFile" desktop:DesktopLocalization.Bindings="Content=DesktopSaveFile.Content" Click="Download_Click" HorizontalAlignment="Stretch" MinHeight="40"/>
</StackPanel></StackPanel></ScrollViewer></Border></Grid>
