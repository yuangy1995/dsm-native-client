                <InfoBar x:Uid="FileRecycleBatchStatus" desktop:DesktopLocalization.Bindings="Title=FileRecycleBatchStatus.Title" x:Name="FileRecycleBatchStatus" IsClosable="True" IsOpen="False" AutomationProperties.LiveSetting="Polite" Severity="Informational"/>
                <InfoBar x:Uid="FileArchiveCompressionStatus" desktop:DesktopLocalization.Bindings="Title=FileArchiveCompressionStatus.Title" x:Name="FileArchiveCompressionStatus" IsClosable="True" IsOpen="False" AutomationProperties.LiveSetting="Polite" Severity="Informational"/>
                <InfoBar x:Uid="FileMoveUndoStatus" desktop:DesktopLocalization.Bindings="AutomationProperties.Name=FileMoveUndoStatus.[using:Microsoft.UI.Xaml.Automation]AutomationProperties.Name" x:Name="FileMoveUndoStatus" IsClosable="True" IsOpen="False" AutomationProperties.LiveSetting="Assertive" Severity="Success"/>
