<UserControl x:Class="LanStash.App.Views.NasDirectorySettingsDialogContent"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:local="using:LanStash.App.Views">
  <ScrollViewer MaxHeight="550">
    <StackPanel MinWidth="340" MaxWidth="560" Spacing="10">
      <ProgressRing x:Name="LoadingIndicator" Width="32" Height="32" IsActive="False" Visibility="Collapsed"/>
      <InfoBar x:Name="ErrorNotice" IsOpen="False" IsClosable="False" Severity="Error" AutomationProperties.LiveSetting="Polite"/>
      <InfoBar x:Name="FeedbackNotice" IsOpen="False" IsClosable="False" AutomationProperties.LiveSetting="Polite"/>
      <InfoBar x:Name="PendingNotice" IsOpen="False" IsClosable="False" Severity="Warning"/>
      <TextBlock x:Name="ReadOnlyNotice" x:Uid="NasServiceReadOnly" TextWrapping="Wrap"/>
      <ComboBox x:Name="KindChoice" x:Uid="NasDirectoryKind" SelectedIndex="0" SelectionChanged="Kind_Changed">
        <ComboBoxItem x:Uid="NasDirectoryUsers"/><ComboBoxItem x:Uid="NasDirectoryGroups"/>
      </ComboBox>
      <TextBox x:Name="SearchInput" x:Uid="NasDirectorySearch" TextChanged="Search_Changed"/>
      <TextBlock x:Name="EmptyNotice" Visibility="Collapsed" TextWrapping="Wrap"/>
      <ListView x:Name="EntryList" MaxHeight="150" SelectionMode="Single" SelectionChanged="Entry_Changed">
        <ListView.ItemContainerStyle><Style TargetType="ListViewItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/></Style></ListView.ItemContainerStyle>
        <ListView.ItemTemplate><DataTemplate x:DataType="local:NasDirectorySettingsRow">
          <StackPanel Padding="0,6" Spacing="4" AutomationProperties.Name="{x:Bind AutomationName}">
            <TextBlock Text="{x:Bind Entry.Name}" FontWeight="SemiBold" TextWrapping="Wrap"/>
            <TextBlock Text="{x:Bind Detail}" TextWrapping="Wrap"/><TextBlock Text="{x:Bind Status}" TextWrapping="Wrap"/>
          </StackPanel>
        </DataTemplate></ListView.ItemTemplate>
      </ListView>
      <StackPanel Orientation="Horizontal" Spacing="8">
        <Button x:Name="CreateButton" x:Uid="NasDirectoryCreate" Click="Create_Click"/>
        <Button x:Name="EditButton" x:Uid="NasDirectoryEdit" Click="Edit_Click"/>
        <Button x:Name="DeleteButton" x:Uid="NasDirectoryDelete" Click="Delete_Click"/>
      </StackPanel>
      <StackPanel x:Name="EditorPanel" Visibility="Collapsed" Spacing="8">
        <TextBox x:Name="NameInput" x:Uid="NasDirectoryName" TextChanged="Fields_Changed"/>
        <TextBox x:Name="DescriptionInput" x:Uid="NasDirectoryDescription" TextChanged="Fields_Changed"/>
        <StackPanel x:Name="UserFields" Spacing="8">
          <TextBox x:Name="EmailInput" x:Uid="NasDirectoryEmail" TextChanged="Fields_Changed"/>
          <CheckBox x:Name="ExpiredInput" x:Uid="NasDirectoryExpired" Checked="Checks_Changed" Unchecked="Checks_Changed"/>
          <PasswordBox x:Name="PasswordInput" x:Uid="NasDirectoryPassword" PasswordChanged="Checks_Changed"/>
          <PasswordBox x:Name="PasswordConfirmationInput" x:Uid="NasDirectoryPasswordConfirmation" PasswordChanged="Checks_Changed"/>
          <TextBlock x:Name="PasswordNote" x:Uid="NasDirectoryPasswordNote" TextWrapping="Wrap"/>
          <CheckBox x:Name="ModifyGroupsInput" x:Uid="NasDirectoryModifyGroups" Checked="Checks_Changed" Unchecked="Checks_Changed"/>
          <TextBlock x:Name="GroupsUnavailableNotice" x:Uid="NasDirectoryGroupsUnavailableNotice" TextWrapping="Wrap" Visibility="Collapsed"/>
          <ListView x:Name="GroupChoices" MaxHeight="130" SelectionMode="Multiple" DisplayMemberPath="Name" SelectionChanged="Groups_Changed"/>
        </StackPanel>
        <Button x:Uid="NasDirectoryCancelEdit" x:Name="CancelEditButton" Click="CancelEdit_Click"/>
      </StackPanel>
      <StackPanel x:Name="ConfirmationPanel" Spacing="8" Visibility="Collapsed">
        <TextBlock x:Name="ConfirmationText" TextWrapping="Wrap"/>
        <TextBlock x:Name="ValidationNotice" x:Uid="NasDirectoryValidation" Visibility="Collapsed" TextWrapping="Wrap"/>
        <CheckBox x:Name="RiskAcknowledgement" x:Uid="NasDirectoryConfirm" Checked="Risk_Changed" Unchecked="Risk_Changed"/>
        <Button x:Name="DeleteConfirmedButton" x:Uid="NasDirectoryDelete" Click="DeleteConfirmed_Click" Visibility="Collapsed"/>
      </StackPanel>
    </StackPanel>
  </ScrollViewer>
</UserControl>
