<UserControl x:Class="LanStash.App.Views.ContainerMutationDialogContent"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <ScrollViewer MaxHeight="560" HorizontalScrollBarVisibility="Disabled">
  <StackPanel MinWidth="340" MaxWidth="560" Spacing="12">
   <ProgressRing x:Name="LoadingIndicator" Width="32" Height="32" Visibility="Collapsed"/>
   <InfoBar x:Name="ErrorNotice" IsOpen="False" IsClosable="False" Severity="Error" AutomationProperties.LiveSetting="Polite"/>
   <InfoBar x:Name="FeedbackNotice" IsOpen="False" IsClosable="False" AutomationProperties.LiveSetting="Polite"/>
   <TextBlock x:Name="ReadOnlyNotice" TextWrapping="Wrap"/>
   <TextBlock x:Name="PendingNotice" TextWrapping="Wrap" Visibility="Collapsed"/>
   <ComboBox x:Name="ActionPicker" DisplayMemberPath="Title" HorizontalAlignment="Stretch" SelectionChanged="Action_Changed"/>
   <TextBox x:Name="SearchBox" TextChanged="Search_Changed"/>
   <ListView x:Name="TargetsList" SelectionMode="Multiple" DisplayMemberPath="Name" MaxHeight="200" SelectionChanged="Selection_Changed"/>
   <TextBlock x:Name="EmptyNotice" TextWrapping="Wrap" Visibility="Collapsed"/>
   <TextBlock x:Name="SelectionNotice" TextWrapping="Wrap" Visibility="Collapsed"/>
   <TextBlock x:Name="RiskNotice" TextWrapping="Wrap"/>
   <CheckBox x:Name="RiskAcknowledgement" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Checked="Confirm_Changed" Unchecked="Confirm_Changed"/>
   <ListView x:Name="ResultsList" SelectionMode="None" MaxHeight="200">
    <ListView.ItemTemplate><DataTemplate><StackPanel Margin="0,4" Spacing="3">
     <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextWrapping="Wrap"/>
     <TextBlock Text="{Binding StatusText}" TextWrapping="Wrap"/>
    </StackPanel></DataTemplate></ListView.ItemTemplate>
   </ListView>
  </StackPanel>
 </ScrollViewer>
</UserControl>
