<UserControl
    x:Class="LanStash.App.Views.VirtualMachineNetworksDialogContent"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid MinWidth="540" MaxWidth="800" RowSpacing="12">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel Spacing="8">
            <ComboBox x:Name="ActionSelector" x:Uid="VmNetworkAction" SelectedIndex="0" MinHeight="44" SelectionChanged="Action_Changed">
                <ComboBoxItem x:Uid="VmNetworkRename"/>
                <ComboBoxItem x:Uid="VmNetworkDelete"/>
            </ComboBox>
            <TextBox x:Name="NewNameBox" x:Uid="VmNetworkName" MaxLength="127" MinHeight="44" TextChanged="Name_Changed"/>
            <InfoBar x:Name="Feedback" IsClosable="False" Severity="Informational" AutomationProperties.LiveSetting="Polite"/>
        </StackPanel>
        <Grid Grid.Row="1" MinHeight="140" MaxHeight="240">
            <ListView x:Name="NetworkList" x:Uid="VmNetworkList" SelectionMode="Multiple" SelectionChanged="Selection_Changed">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="4" Spacing="4">
                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                            <TextBlock Text="{Binding Details}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/>
                        </StackPanel>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
            <StackPanel x:Name="LoadingOverlay" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8" Visibility="Collapsed">
                <ProgressRing x:Name="BusyRing" Width="32" Height="32" IsActive="False"/>
                <TextBlock x:Uid="VirtualMachineManagerSectionLoading" AutomationProperties.LiveSetting="Polite"/>
            </StackPanel>
        </Grid>
        <StackPanel Grid.Row="2" Spacing="8">
            <TextBlock x:Name="RiskText" TextWrapping="Wrap"/>
            <CheckBox x:Name="ConfirmBox" x:Uid="VmNetworkConfirm" MinHeight="44" Checked="Confirmation_Changed" Unchecked="Confirmation_Changed"/>
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button x:Name="ReloadButton" x:Uid="VmNetworkReload" MinHeight="44" Click="Reload_Click"/>
                <Button x:Name="CancelButton" MinHeight="44" Click="Cancel_Click"/>
            </StackPanel>
        </StackPanel>
        <StackPanel Grid.Row="3" Spacing="6">
            <TextBlock x:Name="SummaryText" AutomationProperties.LiveSetting="Polite" TextWrapping="Wrap"/>
            <ListView x:Name="ResultList" MaxHeight="150" SelectionMode="None">
                <ListView.ItemTemplate><DataTemplate><TextBlock Text="{Binding Text}" TextWrapping="Wrap"/></DataTemplate></ListView.ItemTemplate>
            </ListView>
        </StackPanel>
    </Grid>
</UserControl>
