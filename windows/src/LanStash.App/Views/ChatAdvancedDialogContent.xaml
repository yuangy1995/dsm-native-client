<UserControl x:Class="LanStash.App.Views.ChatAdvancedDialogContent" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:chat="using:LanStash.App.Features.Chat">
  <UserControl.Resources>
    <Style x:Key="ChatAdvancedActionButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
      <Setter Property="MinHeight" Value="44"/>
    </Style>
  </UserControl.Resources>
  <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="650" HorizontalScrollBarVisibility="Disabled">
    <StackPanel Spacing="12" MinWidth="280" MaxWidth="560">
      <ComboBox x:Name="SectionPicker" MinHeight="44" HorizontalAlignment="Stretch" SelectionChanged="Section_Changed"/>
      <InfoBar x:Name="Feedback" IsClosable="False" IsOpen="False" Severity="Informational"/>
      <StackPanel x:Name="BatchResults" Spacing="6" Visibility="Collapsed">
        <TextBlock x:Name="BatchSummary" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/>
        <ListView x:Name="BatchResultList" SelectionMode="None" MaxHeight="180">
          <ListView.ItemTemplate><DataTemplate x:DataType="chat:ChatBatchEntry"><StackPanel Margin="4,8" Spacing="4">
            <TextBlock Text="{x:Bind Title}" TextWrapping="Wrap"/><TextBlock Text="{x:Bind StateText}" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
          </StackPanel></DataTemplate></ListView.ItemTemplate>
        </ListView>
        <CheckBox x:Name="ContinueConfirmation" MinHeight="44" Checked="Confirmation_Changed" Unchecked="Confirmation_Changed" Visibility="Collapsed"/>
        <Button x:Name="StopRemainingButton" Click="StopRemaining_Click" MinHeight="44" Visibility="Collapsed"/>
      </StackPanel>
      <ProgressRing x:Name="LoadingRing" Width="32" Height="32"/>
      <StackPanel x:Name="ErrorPanel" Spacing="8" Visibility="Collapsed">
        <TextBlock x:Name="ErrorText" TextWrapping="Wrap"/>
        <Button x:Name="RetryButton" Click="Refresh_Click" MinHeight="44"/>
      </StackPanel>
      <StackPanel x:Name="ContentPanel" Spacing="12">
        <TextBox x:Name="FilterBox" MinHeight="44" TextChanged="Filter_Changed"/>
        <TextBlock x:Name="EmptyText" TextWrapping="Wrap" Visibility="Collapsed"/>
        <ListView x:Name="EntryList" MaxHeight="180" SelectionMode="None">
          <ListView.ItemTemplate><DataTemplate x:DataType="chat:ChatAdvancedEntry">
            <Grid Padding="4,8" ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <StackPanel Spacing="4"><TextBlock Text="{x:Bind Title}" TextWrapping="Wrap"/><TextBlock Text="{x:Bind Detail}" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/></StackPanel>
              <Button Grid.Column="1" Content="{x:Bind DeleteText}" Tag="{x:Bind}" Click="CancelEntry_Click" Visibility="{x:Bind DeleteVisibility}" IsEnabled="{x:Bind CanCancel}" MinHeight="44"/>
            </Grid>
          </DataTemplate></ListView.ItemTemplate>
        </ListView>
        <Button x:Name="RefreshButton" Click="Refresh_Click" MinHeight="44"/>
        <TextBlock x:Name="ReadOnlyText" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
        <StackPanel x:Name="Editor" Spacing="10">
          <ComboBox x:Name="MessagePicker" MinHeight="44" HorizontalAlignment="Stretch" DisplayMemberPath="Title" SelectionChanged="Input_Changed"/>
          <TextBlock x:Name="SourceLabel" TextWrapping="Wrap"/>
          <TextBlock x:Name="SourceEmptyText" TextWrapping="Wrap" Visibility="Collapsed"/>
          <ListView x:Name="SourceList" SelectionMode="Multiple" MaxHeight="160" DisplayMemberPath="Title" SelectionChanged="Input_Changed">
            <ListView.ItemContainerStyle><Style TargetType="ListViewItem"><Setter Property="MinHeight" Value="44"/></Style></ListView.ItemContainerStyle>
          </ListView>
          <TextBlock x:Name="TargetLabel" TextWrapping="Wrap"/>
          <ListView x:Name="TargetList" SelectionMode="Multiple" MaxHeight="180" SelectionChanged="Input_Changed">
            <ListView.ItemContainerStyle><Style TargetType="ListViewItem"><Setter Property="MinHeight" Value="44"/></Style></ListView.ItemContainerStyle>
            <ListView.ItemTemplate><DataTemplate x:DataType="chat:ChatAdvancedTarget"><StackPanel Margin="4,8" Spacing="4">
              <TextBlock Text="{x:Bind Title}" TextWrapping="Wrap"/><TextBlock Text="{x:Bind Detail}" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
            </StackPanel></DataTemplate></ListView.ItemTemplate>
          </ListView>
          <TextBlock x:Name="DirectUserLabel" TextWrapping="Wrap"/>
          <ListView x:Name="DirectUserList" SelectionMode="Multiple" MaxHeight="160" SelectionChanged="Input_Changed">
            <ListView.ItemContainerStyle><Style TargetType="ListViewItem"><Setter Property="MinHeight" Value="44"/></Style></ListView.ItemContainerStyle>
            <ListView.ItemTemplate><DataTemplate x:DataType="chat:ChatAdvancedTarget"><StackPanel Margin="4,8" Spacing="4">
              <TextBlock Text="{x:Bind Title}" TextWrapping="Wrap"/><TextBlock Text="{x:Bind Detail}" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
            </StackPanel></DataTemplate></ListView.ItemTemplate>
          </ListView>
          <TextBox x:Name="MessageText" AcceptsReturn="True" MinHeight="80" MaxHeight="160" TextWrapping="Wrap" TextChanged="Text_Changed"/>
          <TextBox x:Name="PollChoices" AcceptsReturn="True" MinHeight="80" MaxHeight="180" TextWrapping="Wrap" TextChanged="Text_Changed"/>
          <CheckBox x:Name="MultipleBox" MinHeight="44"/><CheckBox x:Name="AnonymousBox" MinHeight="44"/>
          <CalendarDatePicker x:Name="DatePicker" MinHeight="44" DateChanged="Date_Changed"/>
          <TimePicker x:Name="TimePicker" MinHeight="44" TimeChanged="Time_Changed"/>
          <TextBlock x:Name="TimeHint" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
          <TextBlock x:Name="ActionHint" TextWrapping="Wrap"/>
          <CheckBox x:Name="ActionConfirmation" MinHeight="44" Checked="Confirmation_Changed" Unchecked="Confirmation_Changed"/>
        </StackPanel>
        <StackPanel x:Name="ConfirmationPanel" Spacing="8" Visibility="Collapsed">
          <TextBlock x:Name="ConfirmationText" TextWrapping="Wrap"/>
          <Button x:Name="BackButton" Click="Back_Click" MinHeight="44"/>
        </StackPanel>
      </StackPanel>
    </StackPanel>
  </ScrollViewer>
</UserControl>
