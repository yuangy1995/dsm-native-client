<Page
    x:Class="LanStash.App.Views.NasDetailsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:nas="using:LanStash.App.Features.NasAdmin"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
    <Page.KeyboardAccelerators>
        <KeyboardAccelerator Key="F5" Invoked="RefreshAccelerator_Invoked" />
    </Page.KeyboardAccelerators>

    <Grid Padding="24,20,24,16" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid ColumnSpacing="12" RowSpacing="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <VisualStateManager.VisualStateGroups>
                <VisualStateGroup>
                    <VisualState x:Name="NarrowHeaderLayout">
                        <VisualState.StateTriggers>
                            <AdaptiveTrigger MinWindowWidth="0" />
                        </VisualState.StateTriggers>
                    </VisualState>
                    <VisualState x:Name="WideHeaderLayout">
                        <VisualState.StateTriggers>
                            <AdaptiveTrigger MinWindowWidth="1060" />
                        </VisualState.StateTriggers>
                        <VisualState.Setters>
                            <Setter Target="HeaderTextPanel.(Grid.ColumnSpan)" Value="1" />
                            <Setter Target="HeaderActions.(Grid.Row)" Value="0" />
                            <Setter Target="HeaderActions.(Grid.Column)" Value="1" />
                            <Setter Target="HeaderActions.(Grid.ColumnSpan)" Value="1" />
                            <Setter Target="HeaderActions.HorizontalAlignment" Value="Right" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>
            <StackPanel
                x:Name="HeaderTextPanel"
                Grid.ColumnSpan="2"
                Spacing="4">
                <TextBlock
                    x:Uid="NasDetailsTitle"
                    Style="{StaticResource TitleTextBlockStyle}"
                    AutomationProperties.HeadingLevel="Level1" />
                <TextBlock
                    x:Uid="NasDetailsDescription"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    TextWrapping="Wrap" />
            </StackPanel>
            <ItemsControl
                x:Name="HeaderActions"
                Grid.Row="1"
                Grid.ColumnSpan="2"
                HorizontalAlignment="Stretch">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <ItemsWrapGrid Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <Button
                    x:Uid="NasDetailsRefresh"
                    x:Name="RefreshButton"
                    Margin="0,0,8,8"
                    MinHeight="44"
                    Click="Refresh_Click">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE72C;" FontSize="16" />
                        <TextBlock x:Uid="NasDetailsRefreshLabel" />
                    </StackPanel>
                </Button>
                <Button
                    x:Uid="NasDetailsRunStorageAnalysis"
                    x:Name="RunStorageAnalysisButton"
                    Margin="0,0,8,8"
                    MinHeight="44"
                    Click="RunStorageAnalysis_Click">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE9D9;" FontSize="16" />
                        <TextBlock x:Uid="NasDetailsRunStorageAnalysisLabel" />
                    </StackPanel>
                </Button>
                <Button
                    x:Uid="NasDetailsRunDeepStorageAnalysis"
                    x:Name="RunDeepStorageAnalysisButton"
                    Margin="0,0,8,8"
                    MinHeight="44"
                    Click="RunDeepStorageAnalysis_Click">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE721;" FontSize="16" />
                        <TextBlock x:Uid="NasDetailsRunDeepStorageAnalysisLabel" />
                    </StackPanel>
                </Button>
                <Button
                    x:Uid="NasDetailsCancelStorageAnalysis"
                    x:Name="CancelStorageAnalysisButton"
                    Margin="0,0,0,8"
                    MinHeight="44"
                    Click="CancelStorageAnalysis_Click"
                    Visibility="Collapsed">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE711;" FontSize="16" />
                        <TextBlock x:Uid="NasDetailsCancelStorageAnalysisLabel" />
                    </StackPanel>
                </Button>
            </ItemsControl>
        </Grid>

        <InfoBar
            x:Uid="NasDetailsReadOnly"
            x:Name="ReadOnlyInfoBar"
            Grid.Row="1"
            IsClosable="False"
            IsOpen="True"
            Severity="Informational" />

        <InfoBar
            x:Uid="NasDetailsReadWrite"
            x:Name="ReadWriteInfoBar"
            Grid.Row="1"
            IsClosable="False"
            IsOpen="False"
            Severity="Informational"
            Visibility="Collapsed" />

        <InfoBar
            x:Uid="NasDetailsRefreshError"
            x:Name="RefreshErrorNotice"
            Grid.Row="2"
            AutomationProperties.LiveSetting="Polite"
            IsClosable="False"
            IsOpen="False"
            Severity="Warning" />

        <InfoBar
            x:Name="SectionNotice"
            Grid.Row="3"
            AutomationProperties.LiveSetting="Polite"
            IsClosable="False"
            IsOpen="{Binding SectionNoticeIsOpen}"
            Message="{Binding SectionNoticeMessage}"
            Severity="Informational"
            Title="{Binding SectionNoticeTitle}" />

        <Grid Grid.Row="4">
            <Grid
                x:Name="ContentState"
                RowSpacing="12"
                AutomationProperties.LiveSetting="Polite"
                Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <ListView
                    x:Uid="NasDetailsSectionList"
                    x:Name="SectionList"
                    HorizontalAlignment="Left"
                    ItemsSource="{Binding Sections}"
                    ScrollViewer.HorizontalScrollBarVisibility="Auto"
                    ScrollViewer.HorizontalScrollMode="Enabled"
                    ScrollViewer.VerticalScrollMode="Disabled"
                    SelectionChanged="SectionList_SelectionChanged"
                    SelectionMode="Single">
                    <ListView.ItemsPanel>
                        <ItemsPanelTemplate>
                            <ItemsStackPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ListView.ItemsPanel>
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="MinHeight" Value="56" />
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="nas:NasDetailsSectionOption">
                            <Grid
                                MinWidth="160"
                                Padding="8,6"
                                AutomationProperties.Name="{x:Bind AutomationName}">
                                <StackPanel Spacing="2">
                                    <TextBlock
                                        FontWeight="SemiBold"
                                        Text="{x:Bind Title}"
                                        TextWrapping="Wrap" />
                                    <TextBlock
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Text="{x:Bind Status}"
                                        TextWrapping="Wrap" />
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <Border
                    Grid.Row="1"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8">
                    <ListView
                        x:Uid="NasDetailsItemList"
                        x:Name="DetailsList"
                        ItemsSource="{Binding Rows}"
                        SelectionMode="None">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="MinHeight" Value="72" />
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="nas:NasDetailsRow">
                                <Grid
                                    Padding="12,8"
                                    ColumnSpacing="12"
                                    AutomationProperties.Name="{x:Bind AutomationName}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="36" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <FontIcon
                                        VerticalAlignment="Center"
                                        FontSize="20"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Glyph="{x:Bind Glyph}" />
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="3">
                                        <TextBlock
                                            FontWeight="SemiBold"
                                            Text="{x:Bind Title}"
                                            TextTrimming="CharacterEllipsis"
                                            TextWrapping="Wrap" />
                                        <TextBlock
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            Text="{x:Bind Detail}"
                                            TextTrimming="CharacterEllipsis"
                                            TextWrapping="Wrap" />
                                        <TextBlock
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            Text="{x:Bind Status}"
                                            TextWrapping="Wrap" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Border>
            </Grid>

            <StackPanel
                x:Name="LoadingState"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Spacing="12">
                <ProgressRing Width="40" Height="40" IsActive="True" />
                <TextBlock x:Uid="NasDetailsLoading" AutomationProperties.LiveSetting="Polite" />
            </StackPanel>

            <StackPanel
                x:Name="EmptyState"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                MaxWidth="440"
                Spacing="8"
                Visibility="Collapsed">
                <TextBlock
                    FontSize="20"
                    FontWeight="SemiBold"
                    Text="{Binding EmptyTitle}"
                    TextAlignment="Center"
                    AutomationProperties.HeadingLevel="Level2" />
                <TextBlock
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="{Binding EmptyMessage}"
                    TextAlignment="Center"
                    TextWrapping="Wrap" />
            </StackPanel>

            <StackPanel
                x:Name="ErrorState"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                MaxWidth="440"
                Spacing="12"
                Visibility="Collapsed">
                <TextBlock
                    x:Uid="NasDetailsErrorTitle"
                    FontSize="20"
                    FontWeight="SemiBold"
                    TextAlignment="Center"
                    AutomationProperties.HeadingLevel="Level2" />
                <TextBlock
                    x:Uid="NasDetailsErrorMessage"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    TextAlignment="Center"
                    TextWrapping="Wrap" />
                <Button
                    x:Uid="NasDetailsTryAgain"
                    MinHeight="44"
                    HorizontalAlignment="Center"
                    Click="Refresh_Click" />
            </StackPanel>

            <StackPanel
                x:Name="UnavailableState"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                MaxWidth="440"
                Spacing="8"
                Visibility="Collapsed">
                <TextBlock
                    x:Uid="NasDetailsUnavailableTitle"
                    FontSize="20"
                    FontWeight="SemiBold"
                    TextAlignment="Center"
                    AutomationProperties.HeadingLevel="Level2" />
                <TextBlock
                    x:Uid="NasDetailsUnavailableMessage"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    TextAlignment="Center"
                    TextWrapping="Wrap" />
            </StackPanel>
        </Grid>
    </Grid>
</Page>
