<Page
    x:Class="LanStash.App.Views.ShellPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <NavigationView
        x:Name="Navigation"
        IsBackButtonVisible="Collapsed"
        IsSettingsVisible="True"
        PaneDisplayMode="Auto"
        SelectionChanged="Navigation_SelectionChanged">
        <NavigationView.PaneHeader>
            <StackPanel Margin="4,8,4,12" Spacing="4">
                <TextBlock x:Name="AppNameText" FontSize="20" FontWeight="SemiBold" />
                <Button
                    x:Name="ProfileMenuButton"
                    MinHeight="44"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Stretch">
                    <Button.Flyout>
                        <MenuFlyout x:Name="ProfileMenu" Opening="ProfileMenu_Opening" />
                    </Button.Flyout>
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            x:Name="ProfileName"
                            VerticalAlignment="Center"
                            FontWeight="SemiBold"
                            TextTrimming="CharacterEllipsis" />
                        <FontIcon
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            FontSize="12"
                            Glyph="&#xE70D;" />
                    </Grid>
                </Button>
            </StackPanel>
        </NavigationView.PaneHeader>
        <NavigationView.FooterMenuItems>
            <NavigationViewItem x:Name="LogoutItem" Icon="Account" />
        </NavigationView.FooterMenuItems>
        <Frame x:Name="ContentFrame" />
    </NavigationView>
</Page>
