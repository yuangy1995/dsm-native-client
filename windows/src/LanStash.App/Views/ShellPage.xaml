<?xml version="1.0" encoding="utf-8"?>
<Page xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:views="using:LanStash.App.Views" x:Class="LanStash.App.Views.ShellPage" SizeChanged="Shell_SizeChanged">
    <Page.Resources>
        <DataTemplate x:Key="WorkspaceNavigationTemplate" x:DataType="views:WorkspaceNavigationItem">
            <Grid MinHeight="42" Padding="10,0,4,0" ColumnSpacing="12" Margin="{x:Bind Indent}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="23"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="28"/>
                </Grid.ColumnDefinitions>
                <FontIcon Glyph="{x:Bind Glyph}" FontSize="19" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1" Text="{x:Bind Title}" FontSize="15" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                <Button Grid.Column="2" Visibility="{x:Bind ExpandVisibility}" Tag="{x:Bind Route.Module}" AutomationProperties.Name="{x:Bind ExpandTitle}" Click="ExpandModule_Click" Width="28" Height="36" MinWidth="0" MinHeight="0" Padding="0" Background="Transparent" BorderThickness="0">
                    <FontIcon Glyph="{x:Bind ExpandGlyph}" FontSize="10"/>
                </Button>
            </Grid>
        </DataTemplate>
    </Page.Resources>
    <Grid x:Name="WorkspaceRoot" Background="{ThemeResource WorkspaceSidebarBrush}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="SidebarColumn" Width="241"/>
            <ColumnDefinition x:Name="SidebarHandleColumn" Width="4"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid x:Name="Sidebar" Padding="14,10,10,12" RowSpacing="10" Canvas.ZIndex="10" Background="{ThemeResource WorkspaceSidebarBrush}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Button x:Name="ProfileMenuButton" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Padding="12,16" Background="Transparent" BorderThickness="0" CornerRadius="12">
                <Button.Flyout>
                    <MenuFlyout x:Name="ProfileMenu" Opening="ProfileMenu_Opening"/>
                </Button.Flyout>
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="48"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                    </Grid.ColumnDefinitions>
                    <Border Height="50" CornerRadius="12" Background="{ThemeResource WorkspaceCardBrush}" BorderBrush="{ThemeResource WorkspaceEdgeBrush}" BorderThickness="1">
                        <FontIcon Glyph="" FontSize="28"/>
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="5">
                        <TextBlock x:Name="ProfileName" FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                        <TextBlock x:Uid="NativeConnected" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    </StackPanel>
                    <FontIcon Grid.Column="2" Glyph="" FontSize="10"/>
                </Grid>
            </Button>
            <Button Grid.Row="1" x:Uid="NativeAddNas" Click="AddProfile_Click" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" MinHeight="44" Padding="12,4" Background="Transparent" BorderThickness="0">
                <StackPanel Orientation="Horizontal" Spacing="14">
                    <FontIcon Glyph="" FontSize="19"/>
                    <TextBlock x:Uid="NativeAddNasLabel" FontSize="15"/>
                </StackPanel>
            </Button>
            <ListView x:Name="NavigationList" Grid.Row="2" SelectionMode="Single" IsItemClickEnabled="True" ItemClick="Navigation_ItemClick" ItemTemplate="{StaticResource WorkspaceNavigationTemplate}" ItemContainerStyle="{StaticResource WorkspaceSidebarItemStyle}" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto" x:Uid="NativeNavigation"/>
            <ListView x:Name="FooterNavigationList" Grid.Row="3" SelectionMode="Single" IsItemClickEnabled="True" ItemClick="Navigation_ItemClick" ItemTemplate="{StaticResource WorkspaceNavigationTemplate}" ItemContainerStyle="{StaticResource WorkspaceSidebarItemStyle}" x:Uid="NativeUtilityNavigation"/>
            <Border Grid.Row="4" BorderBrush="{ThemeResource WorkspaceDividerBrush}" BorderThickness="0,1,0,0" Padding="10,12,2,0">
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="36"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="ConnectionRouteText" VerticalAlignment="Center" FontSize="12" TextTrimming="CharacterEllipsis" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    <Button Grid.Column="1" x:Uid="NativeSignOut" Click="Logout_Click" Style="{StaticResource WorkspaceIconButtonStyle}">
                        <FontIcon Glyph="" FontSize="16"/>
                    </Button>
                </Grid>
            </Border>
        </Grid>
        <Thumb x:Name="SidebarResizeHandle" Grid.Column="1" DragDelta="SidebarResize_DragDelta" x:Uid="NativeResizeSidebar" HorizontalAlignment="Stretch" Background="Transparent" MinWidth="4"/>
        <Border Grid.Column="2" Margin="0,0,12,12" CornerRadius="16" BorderBrush="{ThemeResource WorkspaceEdgeBrush}" BorderThickness="1" Background="{ThemeResource WorkspaceCanvasBrush}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Grid x:Name="WorkspaceToolbar" Height="36" Padding="12,0,16,0" ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="36"/>
                        <ColumnDefinition Width="36"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Button x:Uid="NativeToggleSidebar" Click="ToggleSidebar_Click" Style="{StaticResource WorkspaceIconButtonStyle}">
                        <FontIcon Glyph="" FontSize="17"/>
                    </Button>
                    <Button x:Uid="NativeWorkspaceBack" x:Name="WorkspaceBackButton" Grid.Column="1" Click="WorkspaceBack_Click" Style="{StaticResource WorkspaceIconButtonStyle}">
                        <FontIcon Glyph="" FontSize="16"/>
                    </Button>
                    <TextBlock x:Name="DestinationTitle" Grid.Column="2" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                    <TextBlock x:Name="TransferCountText" Grid.Column="3" VerticalAlignment="Center" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                </Grid>
                <Grid Grid.Row="1">
                    <Frame x:Name="ContentFrame"/>
                    <InfoBar x:Name="NavigationError" VerticalAlignment="Top" Margin="12" IsOpen="False" IsClosable="True" Severity="Error" AutomationProperties.LiveSetting="Polite"/>
                </Grid>
            </Grid>
        </Border>
        <Button x:Name="CompactSidebarDismiss" Grid.ColumnSpan="3" Canvas.ZIndex="5" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Background="#60000000" BorderThickness="0" Visibility="Collapsed" Click="CompactSidebarDismiss_Click" x:Uid="NativeCloseSidebar"/>
    </Grid>
</Page>
