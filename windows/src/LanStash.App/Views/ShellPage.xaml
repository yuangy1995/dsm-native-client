<Page xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="LanStash.App.Views.ShellPage" Background="{ThemeResource WorkspaceBackgroundBrush}">
  <NavigationView x:Name="Navigation" IsBackButtonVisible="Collapsed" IsSettingsVisible="False" IsPaneToggleButtonVisible="True" IsTitleBarAutoPaddingEnabled="False" PaneDisplayMode="Auto" OpenPaneLength="241" CompactPaneLength="64" ExpandedModeThresholdWidth="1000" CompactModeThresholdWidth="640" SelectionChanged="Navigation_SelectionChanged">
    <NavigationView.Resources>
      <ResourceDictionary>
        <ResourceDictionary.ThemeDictionaries>
          <ResourceDictionary x:Key="Light">
            <SolidColorBrush x:Key="NavigationViewDefaultPaneBackground" Color="#E6E7EA"/>
            <SolidColorBrush x:Key="NavigationViewContentBackground" Color="#E6E7EA"/>
          </ResourceDictionary>
          <ResourceDictionary x:Key="Default">
            <SolidColorBrush x:Key="NavigationViewDefaultPaneBackground" Color="#484C4D"/>
            <SolidColorBrush x:Key="NavigationViewContentBackground" Color="#4C4F50"/>
          </ResourceDictionary>
          <ResourceDictionary x:Key="HighContrast">
            <SolidColorBrush x:Key="NavigationViewDefaultPaneBackground" Color="{ThemeResource SystemColorWindowColor}"/>
            <SolidColorBrush x:Key="NavigationViewContentBackground" Color="{ThemeResource SystemColorWindowColor}"/>
          </ResourceDictionary>
        </ResourceDictionary.ThemeDictionaries>
      </ResourceDictionary>
    </NavigationView.Resources>
    <NavigationView.PaneCustomContent>
      <StackPanel x:Name="ExpandedPaneHeader" Margin="10,0,10,8" Spacing="6">
        <TextBlock x:Name="AppNameText" Visibility="Collapsed" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Margin="8,0"/>
        <Button x:Name="ProfileMenuButton" MinHeight="64" Padding="12" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Background="Transparent" BorderThickness="0">
          <Button.Flyout>
            <MenuFlyout x:Name="ProfileMenu" Opening="ProfileMenu_Opening"/>
          </Button.Flyout>
          <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="48"/>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Border Width="48" Height="50" CornerRadius="13" Background="{ThemeResource SubtleFillColorSecondaryBrush}">
              <Grid Width="25" Height="31" Background="#394349" CornerRadius="5">
                <StackPanel Orientation="Horizontal" Spacing="5" HorizontalAlignment="Center" Margin="0,8,0,0">
                  <Ellipse Width="3" Height="3" Fill="#2BCB58"/>
                  <Ellipse Width="3" Height="3" Fill="#2BCB58"/>
                </StackPanel>
                <Border Width="8" Height="2" Background="#849096" VerticalAlignment="Bottom" Margin="0,0,0,8"/>
              </Grid>
            </Border>
            <StackPanel Grid.Column="1" Spacing="6" VerticalAlignment="Center">
              <TextBlock x:Name="ProfileName" FontSize="16" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
              <StackPanel Orientation="Horizontal" Spacing="6">
                <Ellipse Width="6" Height="6" Fill="{ThemeResource SystemFillColorSuccessBrush}"/>
                <TextBlock x:Uid="WorkspaceConnected" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
              </StackPanel>
            </StackPanel>
            <FontIcon Grid.Column="2" VerticalAlignment="Center" FontSize="10" Glyph=""/>
          </Grid>
        </Button>
        <Button x:Uid="WorkspaceAddDevice" Click="AddProfile_Click" MinHeight="48" FontSize="16" Background="Transparent" BorderThickness="0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"/>
        <Border Height="1" Background="{ThemeResource WorkspaceEdgeBrush}"/>
      </StackPanel>
    </NavigationView.PaneCustomContent>
    <NavigationView.FooterMenuItems>
      <NavigationViewItem x:Name="ActivityItem" Icon="Switch" Style="{StaticResource WorkspaceNavigationItemStyle}"/>
      <NavigationViewItem x:Name="SettingsItem" Icon="Setting" Style="{StaticResource WorkspaceNavigationItemStyle}"/>
    </NavigationView.FooterMenuItems>
    <NavigationView.PaneFooter>
      <Border x:Name="StorageFooterItem">
        <StackPanel Margin="14,10,14,0" Spacing="16">
          <Border Height="1" Background="{ThemeResource WorkspaceEdgeBrush}"/>
          <StackPanel x:Name="SidebarStorage" Spacing="10" Margin="14,0">
            <TextBlock x:Uid="FileBrowserStorageTitle" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
            <StackPanel x:Name="StorageLoadingState" Orientation="Horizontal" Spacing="8">
              <ProgressRing Width="18" Height="18" IsActive="True"/>
              <TextBlock x:Uid="FileBrowserStorageLoading" TextWrapping="Wrap"/>
            </StackPanel>
            <StackPanel x:Name="StorageAvailableState" Spacing="4" Visibility="Collapsed">
              <TextBlock x:Name="SidebarStorageText" FontSize="13" TextWrapping="Wrap"/>
              <ProgressBar x:Uid="FileBrowserStorageProgress" x:Name="SidebarStorageProgress" Height="5" Maximum="100" Foreground="{ThemeResource WorkspaceAccentBrush}"/>
            </StackPanel>
            <TextBlock x:Uid="FileBrowserStorageUnavailable" x:Name="StorageUnavailableState" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" Visibility="Collapsed"/>
          </StackPanel>
          <Border Height="1" Background="{ThemeResource WorkspaceEdgeBrush}"/>
          <Grid Margin="8,0,0,10">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="28"/>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="32"/>
            </Grid.ColumnDefinitions>
            <FontIcon Glyph="" FontFamily="Segoe MDL2 Assets" FontSize="18"/>
            <TextBlock x:Uid="WorkspaceConnection" Grid.Column="1" FontSize="12" VerticalAlignment="Center"/>
            <Button x:Name="SignOutButton" Grid.Column="2" Click="SignOut_Click" Background="Transparent" BorderThickness="0" Padding="4">
              <FontIcon Glyph="" FontFamily="Segoe MDL2 Assets" FontSize="16"/>
            </Button>
          </Grid>
        </StackPanel>
      </Border>
    </NavigationView.PaneFooter>
    <Border Margin="0,0,12,12" Background="{ThemeResource WorkspaceSurfaceBrush}" BorderBrush="{ThemeResource WorkspaceEdgeBrush}" BorderThickness="1" CornerRadius="16">
      <Frame x:Name="ContentFrame"/>
    </Border>
  </NavigationView>
</Page>
