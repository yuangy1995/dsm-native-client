<Page
    x:Class="LanStash.App.Views.DownloadStationPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:desktop="using:LanStash.App.Presentation"
    xmlns:downloads="using:LanStash.App.Features.Downloads"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
    SizeChanged="Page_SizeChanged">
    <Page.KeyboardAccelerators>
        <KeyboardAccelerator Key="Left" Modifiers="Menu" Invoked="BackAccelerator_Invoked" />
        <KeyboardAccelerator Key="F" Modifiers="Control" Invoked="SearchAccelerator_Invoked" />
        <KeyboardAccelerator Key="F5" Invoked="RefreshAccelerator_Invoked" />
        <KeyboardAccelerator Key="N" Modifiers="Control" Invoked="CreateTaskAccelerator_Invoked" />
        <KeyboardAccelerator Key="B" Modifiers="Control" Invoked="BtSearchAccelerator_Invoked" />
    </Page.KeyboardAccelerators>

    <Grid Padding="24,20,24,16" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid ColumnSpacing="12" RowSpacing="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <VisualStateManager.VisualStateGroups>
                <VisualStateGroup>
                    <VisualState x:Name="NarrowHeaderLayout">
                        <VisualState.StateTriggers>
                            <AdaptiveTrigger MinWindowWidth="0" />
                        </VisualState.StateTriggers>
                    </VisualState>
                    <VisualState x:Name="WideHeaderLayout">
                        <VisualState.StateTriggers>
                            <AdaptiveTrigger MinWindowWidth="1120" />
                        </VisualState.StateTriggers>
                        <VisualState.Setters>
                            <Setter Target="HeaderTextPanel.(Grid.ColumnSpan)" Value="1" />
                            <Setter Target="HeaderActions.(Grid.Row)" Value="0" />
                            <Setter Target="HeaderActions.(Grid.Column)" Value="1" />
                            <Setter Target="HeaderActions.(Grid.ColumnSpan)" Value="1" />
                            <Setter Target="HeaderActions.HorizontalAlignment" Value="Right" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>
            <StackPanel
                x:Name="HeaderTextPanel"
                Grid.ColumnSpan="2"
                Spacing="4">
                <TextBlock
                    x:Uid="DownloadStationTitle" desktop:DesktopLocalization.Bindings="Text=DownloadStationTitle.Text"
                    Style="{StaticResource TitleTextBlockStyle}"
                    AutomationProperties.HeadingLevel="Level1" />
                <TextBlock
                    x:Uid="DownloadStationDescription" desktop:DesktopLocalization.Bindings="Text=DownloadStationDescription.Text"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    TextWrapping="Wrap" />
            </StackPanel>
            <ItemsControl
                x:Name="HeaderActions"
                Grid.Row="1"
                Grid.ColumnSpan="2"
                HorizontalAlignment="Stretch">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <ItemsWrapGrid Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <Button
                    x:Uid="DownloadStationCreateTask" desktop:DesktopLocalization.Bindings="AutomationProperties.Name=DownloadStationCreateTask.[using:Microsoft.UI.Xaml.Automation]AutomationProperties.Name"
                    x:Name="CreateTaskButton"
                    Margin="0,0,8,8"
                    MinHeight="44"
                    Click="CreateTask_Click">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE710;" FontSize="16" />
                        <TextBlock x:Uid="DownloadStationCreateTaskLabel" desktop:DesktopLocalization.Bindings="Text=DownloadStationCreateTaskLabel.Text" />
                    </StackPanel>
                </Button>
                <Button
                    x:Uid="DownloadStationCreateFileTask" desktop:DesktopLocalization.Bindings="AutomationProperties.Name=DownloadStationCreateFileTask.[using:Microsoft.UI.Xaml.Automation]AutomationProperties.Name"
                    x:Name="CreateFileTaskButton"
                    Margin="0,0,8,8"
                    MinHeight="44"
                    Click="CreateFileTask_Click">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE8E5;" FontSize="16" />
                        <TextBlock x:Uid="DownloadStationCreateFileTaskLabel" desktop:DesktopLocalization.Bindings="Text=DownloadStationCreateFileTaskLabel.Text" />
                    </StackPanel>
                </Button>
                <Button
                    x:Uid="DownloadStationBtSearchButton" desktop:DesktopLocalization.Bindings="AutomationProperties.Name=DownloadStationBtSearchButton.[using:Microsoft.UI.Xaml.Automation]AutomationProperties.Name"
                    x:Name="BtSearchButton"
                    AccessKey="B"
                    Margin="0,0,8,8"
                    MinHeight="48"
                    Click="BtSearch_Click"
                    Visibility="Collapsed">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE721;" FontSize="16" />
                        <TextBlock x:Uid="DownloadStationBtSearchButtonLabel" desktop:DesktopLocalization.Bindings="Text=DownloadStationBtSearchButtonLabel.Text" />
                    </StackPanel>
                </Button>
                <Button
                    x:Uid="DownloadStationRefresh" desktop:DesktopLocalization.Bindings="AutomationProperties.Name=DownloadStationRefresh.[using:Microsoft.UI.Xaml.Automation]AutomationProperties.Name"
                    x:Name="RefreshButton"
                    Margin="0,0,0,8"
                    MinHeight="44"
                    Click="Refresh_Click">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE72C;" FontSize="16" />
                        <TextBlock x:Uid="DownloadStationRefreshLabel" desktop:DesktopLocalization.Bindings="Text=DownloadStationRefreshLabel.Text" />
                    </StackPanel>
                </Button>
            </ItemsControl>
        </Grid>

        <InfoBar
            x:Uid="DownloadStationReadOnly" desktop:DesktopLocalization.Bindings="Message=DownloadStationReadOnly.Message;Title=DownloadStationReadOnly.Title"
            Grid.Row="1"
            IsClosable="False"
            IsOpen="True"
            Severity="Informational" />

        <InfoBar
            x:Uid="DownloadStationActivityError" desktop:DesktopLocalization.Bindings="Message=DownloadStationActivityError.Message;Title=DownloadStationActivityError.Title"
            x:Name="ActivityErrorNotice"
            Grid.Row="3"
            AutomationProperties.LiveSetting="Polite"
            IsClosable="False"
            IsOpen="False"
            Severity="Warning" />

        <InfoBar
            x:Name="DownloadCreateNotice"
            Grid.Row="2"
            AutomationProperties.LiveSetting="Polite"
            IsClosable="False"
            IsOpen="False"
            Message="{Binding CreateNoticeMessage}"
            Title="{Binding CreateNoticeTitle}" />

        <Border
            x:Name="ActivitySummary"
            Grid.Row="3"
            Padding="16,12"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="8"
            AutomationProperties.LiveSetting="Polite"
            Visibility="Collapsed">
            <StackPanel Spacing="8">
                <TextBlock
                    x:Uid="DownloadStationActivityTitle" desktop:DesktopLocalization.Bindings="Text=DownloadStationActivityTitle.Text"
                    FontWeight="SemiBold"
                    AutomationProperties.HeadingLevel="Level2" />
                <Grid ColumnSpacing="24" RowSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <StackPanel Spacing="2">
                        <TextBlock
                            x:Uid="DownloadStationActivityDownload" desktop:DesktopLocalization.Bindings="Text=DownloadStationActivityDownload.Text"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock Text="{Binding ActivityDownloadSpeedText}" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Spacing="2">
                        <TextBlock
                            x:Uid="DownloadStationActivityUpload" desktop:DesktopLocalization.Bindings="Text=DownloadStationActivityUpload.Text"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock Text="{Binding ActivityUploadSpeedText}" />
                    </StackPanel>
                    <StackPanel Grid.Row="1" Spacing="2">
                        <TextBlock
                            x:Uid="DownloadStationActivityEmuleDownload" desktop:DesktopLocalization.Bindings="Text=DownloadStationActivityEmuleDownload.Text"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock Text="{Binding ActivityEmuleDownloadSpeedText}" />
                    </StackPanel>
                    <StackPanel Grid.Row="1" Grid.Column="1" Spacing="2">
                        <TextBlock
                            x:Uid="DownloadStationActivityEmuleUpload" desktop:DesktopLocalization.Bindings="Text=DownloadStationActivityEmuleUpload.Text"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock Text="{Binding ActivityEmuleUploadSpeedText}" />
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Border>

        <Border
            x:Name="AdvancedSummary"
            Grid.Row="4"
            Padding="16,12"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="8"
            AutomationProperties.LiveSetting="Polite"
            Visibility="Collapsed">
            <StackPanel Spacing="10">
                <InfoBar
                    x:Uid="DownloadStationAdvancedSummaryError" desktop:DesktopLocalization.Bindings="Message=DownloadStationAdvancedSummaryError.Message;Title=DownloadStationAdvancedSummaryError.Title"
                    x:Name="AdvancedSummaryErrorNotice"
                    AutomationProperties.LiveSetting="Polite"
                    IsClosable="False"
                    IsOpen="False"
                    Severity="Warning" />
                <Grid ColumnSpacing="28" RowSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel
                        x:Name="StationSettingsSummary"
                        Spacing="8"
                        Visibility="Collapsed">
                        <TextBlock
                            x:Uid="DownloadStationSettingsSummaryTitle" desktop:DesktopLocalization.Bindings="Text=DownloadStationSettingsSummaryTitle.Text"
                            FontWeight="SemiBold"
                            AutomationProperties.HeadingLevel="Level2" />
                        <Grid ColumnSpacing="12" RowSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock x:Uid="DownloadStationSettingsDefaultDestination" desktop:DesktopLocalization.Bindings="Text=DownloadStationSettingsDefaultDestination.Text" FontWeight="SemiBold" />
                            <TextBlock Grid.Column="1" Text="{Binding SettingsDefaultDestinationText}" TextWrapping="Wrap" />
                            <TextBlock x:Uid="DownloadStationSettingsAutoExtract" desktop:DesktopLocalization.Bindings="Text=DownloadStationSettingsAutoExtract.Text" Grid.Row="1" FontWeight="SemiBold" />
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding SettingsAutoExtractText}" TextWrapping="Wrap" />
                            <TextBlock x:Uid="DownloadStationSettingsSchedule" desktop:DesktopLocalization.Bindings="Text=DownloadStationSettingsSchedule.Text" Grid.Row="2" FontWeight="SemiBold" />
                            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding SettingsScheduleText}" TextWrapping="Wrap" />
                            <TextBlock x:Uid="DownloadStationSettingsSpeedLimits" desktop:DesktopLocalization.Bindings="Text=DownloadStationSettingsSpeedLimits.Text" Grid.Row="3" FontWeight="SemiBold" />
                            <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding SettingsSpeedLimitText}" TextWrapping="Wrap" />
                            <TextBlock x:Uid="DownloadStationSettingsEmule" desktop:DesktopLocalization.Bindings="Text=DownloadStationSettingsEmule.Text" Grid.Row="4" FontWeight="SemiBold" />
                            <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding SettingsEmuleText}" TextWrapping="Wrap" />
                        </Grid>
                    </StackPanel>
                    <StackPanel
                        x:Name="DownloadRssSummary"
                        Grid.Column="1"
                        Spacing="8"
                        Visibility="Collapsed">
                        <TextBlock
                            x:Uid="DownloadStationRssSummaryTitle" desktop:DesktopLocalization.Bindings="Text=DownloadStationRssSummaryTitle.Text"
                            FontWeight="SemiBold"
                            AutomationProperties.HeadingLevel="Level2" />
                        <Grid ColumnSpacing="12" RowSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock x:Uid="DownloadStationRssSites" desktop:DesktopLocalization.Bindings="Text=DownloadStationRssSites.Text" FontWeight="SemiBold" />
                            <TextBlock Grid.Column="1" Text="{Binding RssSitesText}" TextWrapping="Wrap" />
                            <TextBlock x:Uid="DownloadStationRssFeeds" desktop:DesktopLocalization.Bindings="Text=DownloadStationRssFeeds.Text" Grid.Row="1" FontWeight="SemiBold" />
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding RssFeedsText}" TextWrapping="Wrap" />
                        </Grid>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Border>

        <InfoBar
            x:Uid="DownloadStationRefreshError" desktop:DesktopLocalization.Bindings="Message=DownloadStationRefreshError.Message;Title=DownloadStationRefreshError.Title"
            x:Name="RefreshErrorNotice"
            Grid.Row="5"
            AutomationProperties.LiveSetting="Polite"
            IsClosable="False"
            IsOpen="False"
            Severity="Warning" />

        <Grid Grid.Row="6">
            <Grid
                x:Name="ContentState"
                ColumnSpacing="12"
                AutomationProperties.LiveSetting="Polite"
                Visibility="Collapsed">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="TaskColumn" Width="360" />
                    <ColumnDefinition x:Name="DetailColumn" Width="*" />
                </Grid.ColumnDefinitions>

                <Border
                    x:Name="TaskPane"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8">
                    <Grid Padding="12" RowSpacing="8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <AutoSuggestBox
                                x:Uid="DownloadStationSearch" desktop:DesktopLocalization.Bindings="PlaceholderText=DownloadStationSearch.PlaceholderText;AutomationProperties.Name=DownloadStationSearch.[using:Microsoft.UI.Xaml.Automation]AutomationProperties.Name"
                                x:Name="SearchBox"
                                MinHeight="44"
                                QueryIcon="Find"
                                Text="{Binding SearchText, Mode=OneWay}"
                                TextChanged="SearchBox_TextChanged" />
                            <ComboBox
                                x:Uid="DownloadStationFilter" desktop:DesktopLocalization.Bindings="AutomationProperties.Name=DownloadStationFilter.[using:Microsoft.UI.Xaml.Automation]AutomationProperties.Name"
                                x:Name="FilterPicker"
                                Grid.Column="1"
                                MinWidth="144"
                                MinHeight="44"
                                SelectedIndex="0"
                                SelectionChanged="FilterPicker_SelectionChanged">
                                <ComboBoxItem x:Uid="DownloadStationFilterAll" desktop:DesktopLocalization.Bindings="Content=DownloadStationFilterAll.Content" Tag="All" />
                                <ComboBoxItem x:Uid="DownloadStationFilterActive" desktop:DesktopLocalization.Bindings="Content=DownloadStationFilterActive.Content" Tag="Active" />
                                <ComboBoxItem x:Uid="DownloadStationFilterFinished" desktop:DesktopLocalization.Bindings="Content=DownloadStationFilterFinished.Content" Tag="Finished" />
                                <ComboBoxItem x:Uid="DownloadStationFilterPaused" desktop:DesktopLocalization.Bindings="Content=DownloadStationFilterPaused.Content" Tag="Paused" />
                            </ComboBox>
                        </Grid>

                        <ListView
                            x:Uid="DownloadStationTaskList" desktop:DesktopLocalization.Bindings="AutomationProperties.Name=DownloadStationTaskList.[using:Microsoft.UI.Xaml.Automation]AutomationProperties.Name"
                            x:Name="TaskList"
                            Grid.Row="1"
                            IsItemClickEnabled="True"
                            ItemClick="TaskList_ItemClick"
                            ItemsSource="{Binding Tasks}"
                            SelectionMode="Single">
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem">
                                    <Setter Property="MinHeight" Value="72" />
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                </Style>
                            </ListView.ItemContainerStyle>
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="downloads:DownloadTaskItem">
                                    <Grid
                                        Padding="4,8"
                                        RowSpacing="6"
                                        AutomationProperties.Name="{x:Bind AutomationName}">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <Grid ColumnSpacing="8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock
                                                FontWeight="SemiBold"
                                                MaxLines="2"
                                                Text="{x:Bind Title}"
                                                TextTrimming="CharacterEllipsis"
                                                TextWrapping="Wrap" />
                                            <TextBlock
                                                Grid.Column="1"
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                Text="{x:Bind StatusText}" />
                                        </Grid>
                                        <ProgressBar
                                            Grid.Row="1"
                                            IsIndeterminate="{x:Bind IsProgressUnknown}"
                                            MinHeight="4"
                                            Maximum="100"
                                            Value="{x:Bind ProgressPercent}" />
                                        <TextBlock
                                            Grid.Row="2"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            Text="{x:Bind ProgressText}" />
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>

                        <StackPanel Grid.Row="2" HorizontalAlignment="Center" Spacing="8">
                            <InfoBar
                                x:Uid="DownloadStationLoadMoreError" desktop:DesktopLocalization.Bindings="Message=DownloadStationLoadMoreError.Message;Title=DownloadStationLoadMoreError.Title"
                                x:Name="LoadMoreErrorNotice"
                                AutomationProperties.LiveSetting="Polite"
                                IsClosable="False"
                                IsOpen="False"
                                Severity="Warning" />
                            <Button
                                x:Uid="DownloadStationLoadMore" desktop:DesktopLocalization.Bindings="Content=DownloadStationLoadMore.Content"
                                x:Name="LoadMoreButton"
                                MinHeight="44"
                                Click="LoadMore_Click" />
                            <ProgressRing
                                x:Uid="DownloadStationLoadingMore" desktop:DesktopLocalization.Bindings="AutomationProperties.Name=DownloadStationLoadingMore.[using:Microsoft.UI.Xaml.Automation]AutomationProperties.Name"
                                x:Name="LoadMoreProgress"
                                Width="24"
                                Height="24"
                                IsActive="False"
                                Visibility="Collapsed" />
                        </StackPanel>
                    </Grid>
                </Border>

                <Border
                    x:Name="DetailPane"
                    Grid.Column="1"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8">
                    <Grid Padding="20">
                        <StackPanel
                            x:Name="NoSelectionState"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            MaxWidth="420"
                            Spacing="8">
                            <FontIcon Glyph="&#xE9D9;" FontSize="40" />
                            <TextBlock
                                x:Uid="DownloadStationChooseTaskTitle" desktop:DesktopLocalization.Bindings="Text=DownloadStationChooseTaskTitle.Text"
                                AutomationProperties.HeadingLevel="Level2"
                                HorizontalAlignment="Center"
                                Style="{ThemeResource SubtitleTextBlockStyle}"
                                TextAlignment="Center" />
                            <TextBlock
                                x:Uid="DownloadStationChooseTaskMessage" desktop:DesktopLocalization.Bindings="Text=DownloadStationChooseTaskMessage.Text"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                TextAlignment="Center"
                                TextWrapping="Wrap" />
                        </StackPanel>

                        <Grid
                            x:Name="TaskDetailState"
                            AutomationProperties.LiveSetting="Polite"
                            Visibility="Collapsed">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Button
                                    x:Uid="DownloadStationBack" desktop:DesktopLocalization.Bindings="AutomationProperties.Name=DownloadStationBack.[using:Microsoft.UI.Xaml.Automation]AutomationProperties.Name"
                                    x:Name="BackButton"
                                    MinWidth="44"
                                    MinHeight="44"
                                    Click="Back_Click"
                                    Visibility="Collapsed">
                                    <FontIcon Glyph="&#xE72B;" FontSize="16" />
                                </Button>
                                <TextBlock
                                    Grid.Column="1"
                                    VerticalAlignment="Center"
                                    AutomationProperties.HeadingLevel="Level2"
                                    FontSize="20"
                                    FontWeight="SemiBold"
                                    Text="{Binding SelectedTask.Title}"
                                    TextTrimming="CharacterEllipsis" />
                            </Grid>
                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                <StackPanel Padding="0,16,0,0" Spacing="16">
                                    <InfoBar
                                        x:Name="DownloadControlNotice"
                                        AutomationProperties.LiveSetting="Polite"
                                        IsClosable="False"
                                        IsOpen="False"
                                        Message="{Binding ControlNoticeMessage}"
                                        Title="{Binding ControlNoticeTitle}" />
                                    <InfoBar
                                        x:Name="DownloadDeleteNotice"
                                        AutomationProperties.LiveSetting="Polite"
                                        IsClosable="False"
                                        IsOpen="False"
                                        Message="{Binding DeleteNoticeMessage}"
                                        Title="{Binding DeleteNoticeTitle}" />
                                    <Grid ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Button
                                            x:Uid="DownloadStationPause" desktop:DesktopLocalization.Bindings="Content=DownloadStationPause.Content;AutomationProperties.Name=DownloadStationPause.[using:Microsoft.UI.Xaml.Automation]AutomationProperties.Name"
                                            x:Name="PauseButton"
                                            MinHeight="44"
                                            Click="Pause_Click" />
                                        <Button
                                            x:Uid="DownloadStationResume" desktop:DesktopLocalization.Bindings="Content=DownloadStationResume.Content;AutomationProperties.Name=DownloadStationResume.[using:Microsoft.UI.Xaml.Automation]AutomationProperties.Name"
                                            x:Name="ResumeButton"
                                            Grid.Column="1"
                                            MinHeight="44"
                                            Click="Resume_Click" />
                                        <Button
                                            x:Uid="DownloadStationDelete" desktop:DesktopLocalization.Bindings="Content=DownloadStationDelete.Content;AutomationProperties.Name=DownloadStationDelete.[using:Microsoft.UI.Xaml.Automation]AutomationProperties.Name"
                                            x:Name="DeleteButton"
                                            Grid.Column="2"
                                            MinHeight="44"
                                            Click="Delete_Click" />
                                        <ProgressRing
                                            x:Uid="DownloadStationControlProgress" desktop:DesktopLocalization.Bindings="AutomationProperties.Name=DownloadStationControlProgress.[using:Microsoft.UI.Xaml.Automation]AutomationProperties.Name"
                                            x:Name="ControlProgress"
                                            Grid.Column="3"
                                            Width="28"
                                            Height="28"
                                            IsActive="False"
                                            Visibility="Collapsed" />
                                    </Grid>
                                    <ProgressBar
                                        IsIndeterminate="{Binding SelectedTask.IsProgressUnknown}"
                                        MinHeight="4"
                                        Maximum="100"
                                        Value="{Binding SelectedTask.ProgressPercent}" />
                                    <Grid ColumnSpacing="24" RowSpacing="14">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <TextBlock x:Uid="DownloadStationDetailStatus" desktop:DesktopLocalization.Bindings="Text=DownloadStationDetailStatus.Text" FontWeight="SemiBold" />
                                        <TextBlock Grid.Column="1" Text="{Binding SelectedTask.StatusText}" TextWrapping="Wrap" />
                                        <TextBlock x:Uid="DownloadStationDetailProgress" desktop:DesktopLocalization.Bindings="Text=DownloadStationDetailProgress.Text" Grid.Row="1" FontWeight="SemiBold" />
                                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding SelectedTask.ProgressText}" />
                                        <TextBlock x:Uid="DownloadStationDetailSize" desktop:DesktopLocalization.Bindings="Text=DownloadStationDetailSize.Text" Grid.Row="2" FontWeight="SemiBold" />
                                        <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding SelectedTask.SizeText}" />
                                        <TextBlock x:Uid="DownloadStationDetailDownloaded" desktop:DesktopLocalization.Bindings="Text=DownloadStationDetailDownloaded.Text" Grid.Row="3" FontWeight="SemiBold" />
                                        <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding SelectedTask.DownloadedText}" />
                                        <TextBlock x:Uid="DownloadStationDetailUploaded" desktop:DesktopLocalization.Bindings="Text=DownloadStationDetailUploaded.Text" Grid.Row="4" FontWeight="SemiBold" />
                                        <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding SelectedTask.UploadedText}" />
                                        <TextBlock x:Uid="DownloadStationDetailDownloadSpeed" desktop:DesktopLocalization.Bindings="Text=DownloadStationDetailDownloadSpeed.Text" Grid.Row="5" FontWeight="SemiBold" />
                                        <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding SelectedTask.DownloadSpeedText}" />
                                        <TextBlock x:Uid="DownloadStationDetailUploadSpeed" desktop:DesktopLocalization.Bindings="Text=DownloadStationDetailUploadSpeed.Text" Grid.Row="6" FontWeight="SemiBold" />
                                        <TextBlock Grid.Row="6" Grid.Column="1" Text="{Binding SelectedTask.UploadSpeedText}" />
                                        <TextBlock x:Uid="DownloadStationDetailDestination" desktop:DesktopLocalization.Bindings="Text=DownloadStationDetailDestination.Text" Grid.Row="7" FontWeight="SemiBold" />
                                        <TextBlock Grid.Row="7" Grid.Column="1" Text="{Binding SelectedTask.DestinationText}" TextWrapping="Wrap" />
                                        <TextBlock x:Uid="DownloadStationDetailError" desktop:DesktopLocalization.Bindings="Text=DownloadStationDetailError.Text" Grid.Row="8" FontWeight="SemiBold" />
                                        <TextBlock Grid.Row="8" Grid.Column="1" Text="{Binding SelectedTask.ErrorText}" TextWrapping="Wrap" />
                                        <TextBlock x:Uid="DownloadStationDetailPriority" desktop:DesktopLocalization.Bindings="Text=DownloadStationDetailPriority.Text" Grid.Row="9" FontWeight="SemiBold" />
                                        <TextBlock Grid.Row="9" Grid.Column="1" Text="{Binding SelectedTask.PriorityText}" TextWrapping="Wrap" />
                                        <TextBlock x:Uid="DownloadStationDetailFiles" desktop:DesktopLocalization.Bindings="Text=DownloadStationDetailFiles.Text" Grid.Row="10" FontWeight="SemiBold" />
                                        <TextBlock Grid.Row="10" Grid.Column="1" Text="{Binding SelectedTask.FileCountText}" TextWrapping="Wrap" />
                                        <TextBlock x:Uid="DownloadStationDetailTrackers" desktop:DesktopLocalization.Bindings="Text=DownloadStationDetailTrackers.Text" Grid.Row="11" FontWeight="SemiBold" />
                                        <TextBlock Grid.Row="11" Grid.Column="1" Text="{Binding SelectedTask.TrackerCountText}" TextWrapping="Wrap" />
                                        <TextBlock x:Uid="DownloadStationDetailPeers" desktop:DesktopLocalization.Bindings="Text=DownloadStationDetailPeers.Text" Grid.Row="12" FontWeight="SemiBold" />
                                        <TextBlock Grid.Row="12" Grid.Column="1" Text="{Binding SelectedTask.PeerCountText}" TextWrapping="Wrap" />
                                        <TextBlock x:Uid="DownloadStationDetailSeeds" desktop:DesktopLocalization.Bindings="Text=DownloadStationDetailSeeds.Text" Grid.Row="13" FontWeight="SemiBold" />
                                        <TextBlock Grid.Row="13" Grid.Column="1" Text="{Binding SelectedTask.SeedsText}" TextWrapping="Wrap" />
                                        <TextBlock x:Uid="DownloadStationDetailLeeches" desktop:DesktopLocalization.Bindings="Text=DownloadStationDetailLeeches.Text" Grid.Row="14" FontWeight="SemiBold" />
                                        <TextBlock Grid.Row="14" Grid.Column="1" Text="{Binding SelectedTask.LeechesText}" TextWrapping="Wrap" />
                                    </Grid>
                                </StackPanel>
                            </ScrollViewer>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>

            <StackPanel
                x:Name="LoadingState"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Spacing="12">
                <ProgressRing Width="40" Height="40" IsActive="True" />
                <TextBlock x:Uid="DownloadStationLoading" desktop:DesktopLocalization.Bindings="Text=DownloadStationLoading.Text" AutomationProperties.LiveSetting="Polite" />
            </StackPanel>

            <StackPanel x:Name="EmptyState" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="440" Spacing="8">
                <TextBlock x:Uid="DownloadStationEmptyTitle" desktop:DesktopLocalization.Bindings="Text=DownloadStationEmptyTitle.Text" AutomationProperties.LiveSetting="Polite" Style="{ThemeResource SubtitleTextBlockStyle}" TextAlignment="Center" />
                <TextBlock x:Uid="DownloadStationEmptyMessage" desktop:DesktopLocalization.Bindings="Text=DownloadStationEmptyMessage.Text" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextAlignment="Center" TextWrapping="Wrap" />
                <Button x:Uid="DownloadStationRefreshEmpty" desktop:DesktopLocalization.Bindings="Content=DownloadStationRefreshEmpty.Content" MinHeight="44" Click="Refresh_Click" />
            </StackPanel>

            <StackPanel x:Name="FilteredEmptyState" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="440" Spacing="8">
                <TextBlock x:Uid="DownloadStationFilteredEmptyTitle" desktop:DesktopLocalization.Bindings="Text=DownloadStationFilteredEmptyTitle.Text" AutomationProperties.LiveSetting="Polite" Style="{ThemeResource SubtitleTextBlockStyle}" TextAlignment="Center" />
                <TextBlock x:Uid="DownloadStationFilteredEmptyMessage" desktop:DesktopLocalization.Bindings="Text=DownloadStationFilteredEmptyMessage.Text" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextAlignment="Center" TextWrapping="Wrap" />
                <Button x:Uid="DownloadStationShowAll" desktop:DesktopLocalization.Bindings="Content=DownloadStationShowAll.Content" MinHeight="44" Click="ShowAll_Click" />
            </StackPanel>

            <StackPanel x:Name="ErrorState" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="440" Spacing="8">
                <TextBlock x:Uid="DownloadStationErrorTitle" desktop:DesktopLocalization.Bindings="Text=DownloadStationErrorTitle.Text" AutomationProperties.LiveSetting="Polite" Style="{ThemeResource SubtitleTextBlockStyle}" TextAlignment="Center" />
                <TextBlock x:Uid="DownloadStationErrorMessage" desktop:DesktopLocalization.Bindings="Text=DownloadStationErrorMessage.Text" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextAlignment="Center" TextWrapping="Wrap" />
                <Button x:Uid="DownloadStationRetry" desktop:DesktopLocalization.Bindings="Content=DownloadStationRetry.Content" MinHeight="44" Click="Refresh_Click" />
            </StackPanel>

            <StackPanel x:Name="UnavailableState" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="440" Spacing="8">
                <FontIcon Glyph="&#xE783;" FontSize="40" />
                <TextBlock x:Uid="DownloadStationUnavailableTitle" desktop:DesktopLocalization.Bindings="Text=DownloadStationUnavailableTitle.Text" AutomationProperties.LiveSetting="Polite" Style="{ThemeResource SubtitleTextBlockStyle}" TextAlignment="Center" />
                <TextBlock x:Uid="DownloadStationUnavailableMessage" desktop:DesktopLocalization.Bindings="Text=DownloadStationUnavailableMessage.Text" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextAlignment="Center" TextWrapping="Wrap" />
            </StackPanel>
        </Grid>
    </Grid>
</Page>
