<Page xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:downloads="using:LanStash.App.Features.Downloads" x:Class="LanStash.App.Views.DownloadStationPage" Background="{ThemeResource WorkspaceSurfaceBrush}" SizeChanged="Page_SizeChanged">
  <Page.KeyboardAccelerators>
    <KeyboardAccelerator Key="Left" Modifiers="Menu" Invoked="BackAccelerator_Invoked"/>
    <KeyboardAccelerator Key="F" Modifiers="Control" Invoked="SearchAccelerator_Invoked"/>
    <KeyboardAccelerator Key="F5" Invoked="RefreshAccelerator_Invoked"/>
    <KeyboardAccelerator Key="N" Modifiers="Control" Invoked="CreateTaskAccelerator_Invoked"/>
    <KeyboardAccelerator Key="B" Modifiers="Control" Invoked="BtSearchAccelerator_Invoked"/>
  </Page.KeyboardAccelerators>
  <Grid Padding="0" RowSpacing="0">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>
    <Grid ColumnSpacing="12" RowSpacing="4" Padding="18,8" MinHeight="60" BorderBrush="{ThemeResource WorkspaceEdgeBrush}" BorderThickness="0,0,0,1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="Auto"/>
      </Grid.ColumnDefinitions>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>
      <StackPanel x:Name="HeaderTextPanel" Grid.ColumnSpan="1" Spacing="4">
        <TextBlock x:Uid="DownloadStationTitle" Style="{StaticResource WorkspaceTitleStyle}" AutomationProperties.HeadingLevel="Level1" FontSize="16"/>
        <TextBlock x:Uid="DownloadStationDescription" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" Visibility="Collapsed"/>
        <Border x:Name="ActivitySummary" Padding="0" Background="Transparent" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0" CornerRadius="8" AutomationProperties.LiveSetting="Polite" Visibility="Collapsed">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <TextBlock x:Uid="DownloadStationActivityDownload" FontSize="12"/>
            <TextBlock Text="{Binding ActivityDownloadSpeedText}" FontSize="12"/>
            <TextBlock x:Uid="DownloadStationActivityUpload" FontSize="12"/>
            <TextBlock Text="{Binding ActivityUploadSpeedText}" FontSize="12"/>
          </StackPanel>
        </Border>
      </StackPanel>
      <StackPanel x:Name="HeaderActions" Orientation="Horizontal" Grid.Row="0" Grid.ColumnSpan="1" HorizontalAlignment="Right" Grid.Column="1">
        <Button x:Uid="DownloadBatchEntry" x:Name="BatchButton" Margin="0,0,8,8" MinHeight="44" Click="Batch_Click"/>
        <Button x:Uid="DownloadSettingsAction" x:Name="SettingsButton" Margin="0,0,8,8" MinHeight="44" Click="Settings_Click"/>
        <Button x:Uid="DownloadStationRefresh" x:Name="RefreshButton" Margin="0,0,0,8" MinHeight="44" Click="Refresh_Click" HorizontalAlignment="Right" Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="10">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <FontIcon Glyph="" FontSize="16"/>
            <TextBlock x:Uid="DownloadStationRefreshLabel"/>
          </StackPanel>
        </Button>
      </StackPanel>
    </Grid>
    <Grid Grid.Row="1" Padding="14,2" BorderBrush="{ThemeResource WorkspaceEdgeBrush}" BorderThickness="0,0,0,1" ColumnSpacing="10">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="Auto"/>
      </Grid.ColumnDefinitions>
      <VisualStateManager.VisualStateGroups>
        <VisualStateGroup>
          <VisualState x:Name="NarrowHeaderLayout">
            <VisualState.StateTriggers>
              <AdaptiveTrigger MinWindowWidth="0"/>
            </VisualState.StateTriggers>
            <VisualState.Setters>
              <Setter Target="SearchBox.Width" Value="100"/>
            </VisualState.Setters>
          </VisualState>
          <VisualState x:Name="WideHeaderLayout">
            <VisualState.StateTriggers>
              <AdaptiveTrigger MinWindowWidth="1120"/>
            </VisualState.StateTriggers>
            <VisualState.Setters>
              <Setter Target="SearchBox.Width" Value="150"/>
            </VisualState.Setters>
          </VisualState>
        </VisualStateGroup>
      </VisualStateManager.VisualStateGroups>
      <Pivot x:Name="FilterPicker" Grid.Column="0" SelectedIndex="0" SelectionChanged="FilterPicker_SelectionChanged" Height="54" Width="300">
        <PivotItem x:Uid="WorkspaceFilterAll" Tag="All"/>
        <PivotItem x:Uid="WorkspaceFilterActive" Tag="Active"/>
        <PivotItem x:Uid="WorkspaceFilterFinished" Tag="Finished"/>
        <PivotItem x:Uid="WorkspaceFilterPaused" Tag="Paused"/>
      </Pivot>
      <AutoSuggestBox x:Uid="DownloadStationSearch" x:Name="SearchBox" MinHeight="44" QueryIcon="Find" Text="{Binding SearchText, Mode=OneWay}" TextChanged="SearchBox_TextChanged" Grid.Column="1" Width="150" HorizontalAlignment="Right" VerticalAlignment="Center"/>
      <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
        <Button x:Uid="DownloadStationResume" x:Name="ResumeButton" MinHeight="44" Click="Resume_Click" Margin="0"/>
        <Button x:Uid="DownloadStationPause" x:Name="PauseButton" MinHeight="44" Click="Pause_Click" Margin="0"/>
        <Button x:Uid="DownloadStationDelete" x:Name="DeleteButton" MinHeight="44" Click="Delete_Click" Margin="0"/>
        <Button x:Uid="DownloadStationCreateTask" x:Name="CreateTaskButton" Margin="0" MinHeight="44" Click="CreateTask_Click" Background="{ThemeResource WorkspaceAccentBrush}" Foreground="{ThemeResource WorkspaceOnAccentBrush}" CornerRadius="10">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <FontIcon Glyph="" FontSize="16"/>
            <TextBlock x:Uid="DownloadStationCreateTaskLabel"/>
          </StackPanel>
        </Button>
        <Button MinWidth="44" Height="44" x:Uid="WorkspaceDownloadMore">
          <SymbolIcon Symbol="More"/>
          <Button.Flyout>
            <Flyout>
              <StackPanel Spacing="8">
                <StackPanel Spacing="4">
                  <TextBlock x:Uid="DownloadStationActivityEmuleDownload"/>
                  <TextBlock Text="{Binding ActivityEmuleDownloadSpeedText}"/>
                  <TextBlock x:Uid="DownloadStationActivityEmuleUpload"/>
                  <TextBlock Text="{Binding ActivityEmuleUploadSpeedText}"/>
                </StackPanel>
                <Button x:Uid="DownloadStationCreateFileTask" x:Name="CreateFileTaskButton" Margin="0" MinHeight="44" Click="CreateFileTask_Click">
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="" FontSize="16"/>
                    <TextBlock x:Uid="DownloadStationCreateFileTaskLabel"/>
                  </StackPanel>
                </Button>
                <Button x:Uid="DownloadStationBtSearchButton" x:Name="BtSearchButton" AccessKey="B" Margin="0" MinHeight="44" Click="BtSearch_Click" Visibility="Collapsed">
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="" FontSize="16"/>
                    <TextBlock x:Uid="DownloadStationBtSearchButtonLabel"/>
                  </StackPanel>
                </Button>
                <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="420">
                  <Border x:Name="AdvancedSummary" Padding="16,12" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" AutomationProperties.LiveSetting="Polite" Visibility="Collapsed" MaxWidth="560" MaxHeight="420">
                    <StackPanel Spacing="10">
                      <InfoBar x:Uid="DownloadStationAdvancedSummaryError" x:Name="AdvancedSummaryErrorNotice" AutomationProperties.LiveSetting="Polite" IsClosable="False" IsOpen="False" Severity="Warning"/>
                      <Grid ColumnSpacing="28" RowSpacing="12">
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="*"/>
                          <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel x:Name="StationSettingsSummary" Spacing="8" Visibility="Collapsed">
                          <TextBlock x:Uid="DownloadStationSettingsSummaryTitle" FontWeight="SemiBold" AutomationProperties.HeadingLevel="Level2"/>
                          <Grid ColumnSpacing="12" RowSpacing="8">
                            <Grid.ColumnDefinitions>
                              <ColumnDefinition Width="Auto"/>
                              <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                              <RowDefinition Height="Auto"/>
                              <RowDefinition Height="Auto"/>
                              <RowDefinition Height="Auto"/>
                              <RowDefinition Height="Auto"/>
                              <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock x:Uid="DownloadStationSettingsDefaultDestination" FontWeight="SemiBold"/>
                            <TextBlock Grid.Column="1" Text="{Binding SettingsDefaultDestinationText}" TextWrapping="Wrap"/>
                            <TextBlock x:Uid="DownloadStationSettingsAutoExtract" Grid.Row="1" FontWeight="SemiBold"/>
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding SettingsAutoExtractText}" TextWrapping="Wrap"/>
                            <TextBlock x:Uid="DownloadStationSettingsSchedule" Grid.Row="2" FontWeight="SemiBold"/>
                            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding SettingsScheduleText}" TextWrapping="Wrap"/>
                            <TextBlock x:Uid="DownloadStationSettingsSpeedLimits" Grid.Row="3" FontWeight="SemiBold"/>
                            <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding SettingsSpeedLimitText}" TextWrapping="Wrap"/>
                            <TextBlock x:Uid="DownloadStationSettingsEmule" Grid.Row="4" FontWeight="SemiBold"/>
                            <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding SettingsEmuleText}" TextWrapping="Wrap"/>
                          </Grid>
                        </StackPanel>
                        <StackPanel x:Name="DownloadRssSummary" Grid.Column="1" Spacing="8" Visibility="Collapsed">
                          <TextBlock x:Uid="DownloadStationRssSummaryTitle" FontWeight="SemiBold" AutomationProperties.HeadingLevel="Level2"/>
                          <Grid ColumnSpacing="12" RowSpacing="8">
                            <Grid.ColumnDefinitions>
                              <ColumnDefinition Width="Auto"/>
                              <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                              <RowDefinition Height="Auto"/>
                              <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock x:Uid="DownloadStationRssSites" FontWeight="SemiBold"/>
                            <TextBlock Grid.Column="1" Text="{Binding RssSitesText}" TextWrapping="Wrap"/>
                            <TextBlock x:Uid="DownloadStationRssFeeds" Grid.Row="1" FontWeight="SemiBold"/>
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding RssFeedsText}" TextWrapping="Wrap"/>
                          </Grid>
                        </StackPanel>
                      </Grid>
                    </StackPanel>
                  </Border>
                </ScrollViewer>
              </StackPanel>
            </Flyout>
          </Button.Flyout>
        </Button>
      </StackPanel>
    </Grid>
    <InfoBar x:Uid="DownloadStationReadOnly" Grid.Row="2" IsClosable="False" IsOpen="False" Severity="Informational" Margin="12,6"/>
    <InfoBar x:Uid="DownloadStationActivityError" x:Name="ActivityErrorNotice" Grid.Row="4" AutomationProperties.LiveSetting="Polite" IsClosable="False" IsOpen="False" Severity="Warning" Margin="12,6"/>
    <InfoBar x:Name="DownloadCreateNotice" Grid.Row="3" AutomationProperties.LiveSetting="Polite" IsClosable="False" IsOpen="False" Message="{Binding CreateNoticeMessage}" Title="{Binding CreateNoticeTitle}" Margin="12,6"/>
    <InfoBar x:Uid="DownloadStationRefreshError" x:Name="RefreshErrorNotice" Grid.Row="6" AutomationProperties.LiveSetting="Polite" IsClosable="False" IsOpen="False" Severity="Warning" Margin="12,6"/>
    <InfoBar x:Uid="DownloadBatchPending" x:Name="BatchPendingNotice" Grid.Row="5" AutomationProperties.LiveSetting="Polite" IsClosable="False" IsOpen="False" Severity="Warning" Margin="12,6">
      <InfoBar.ActionButton><Button x:Uid="DownloadBatchEntry" Click="Batch_Click" MinHeight="44"/></InfoBar.ActionButton>
    </InfoBar>
    <Grid Grid.Row="7" Margin="16,10,16,12">
      <Grid x:Name="ContentState" ColumnSpacing="12" AutomationProperties.LiveSetting="Polite" Visibility="Collapsed">
        <Grid.ColumnDefinitions>
          <ColumnDefinition x:Name="TaskColumn" Width="*"/>
          <ColumnDefinition x:Name="DetailColumn" Width="*"/>
        </Grid.ColumnDefinitions>
        <Border x:Name="TaskPane" Background="Transparent" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0" CornerRadius="8">
          <Grid Padding="0" RowSpacing="8">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="*"/>
              <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid ColumnSpacing="8">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
            </Grid>
            <ListView x:Uid="DownloadStationTaskList" x:Name="TaskList" Grid.Row="1" IsItemClickEnabled="True" ItemClick="TaskList_ItemClick" ItemsSource="{Binding Tasks}" SelectionMode="Single">
              <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                  <Setter Property="MinHeight" Value="72"/>
                  <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                </Style>
              </ListView.ItemContainerStyle>
              <ListView.ItemTemplate>
                <DataTemplate x:DataType="downloads:DownloadTaskItem">
                  <Border Padding="14,12" Margin="0,4" CornerRadius="12" Background="{ThemeResource WorkspaceTileBrush}" BorderBrush="{ThemeResource WorkspaceEdgeBrush}" BorderThickness="1">
                    <Grid Padding="0" RowSpacing="6" AutomationProperties.Name="{x:Bind AutomationName}">
                      <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                      </Grid.RowDefinitions>
                      <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="*"/>
                          <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock FontWeight="SemiBold" MaxLines="2" Text="{x:Bind Title}" TextTrimming="CharacterEllipsis" TextWrapping="Wrap" FontSize="15"/>
                        <TextBlock Grid.Column="1" Text="{x:Bind StatusText}" Loaded="TaskStatus_Loaded"/>
                      </Grid>
                      <ProgressBar Grid.Row="1" IsIndeterminate="{x:Bind IsProgressUnknown}" MinHeight="4" Maximum="100" Value="{x:Bind ProgressPercent}" Height="3" Visibility="{x:Bind ProgressVisibility}"/>
                      <Grid Grid.Row="2" ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="*"/>
                          <ColumnDefinition Width="Auto"/>
                          <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{x:Bind TransferSizeText}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12"/>
                        <TextBlock Grid.Column="1" Text="{x:Bind DownloadSpeedText}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12"/>
                        <TextBlock Grid.Column="2" Text="{x:Bind UploadSpeedText}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12"/>
                      </Grid>
                    </Grid>
                  </Border>
                </DataTemplate>
              </ListView.ItemTemplate>
            </ListView>
            <StackPanel Grid.Row="2" HorizontalAlignment="Center" Spacing="8">
              <InfoBar x:Uid="DownloadStationLoadMoreError" x:Name="LoadMoreErrorNotice" AutomationProperties.LiveSetting="Polite" IsClosable="False" IsOpen="False" Severity="Warning"/>
              <Button x:Uid="DownloadStationLoadMore" x:Name="LoadMoreButton" MinHeight="44" Click="LoadMore_Click"/>
              <ProgressRing x:Uid="DownloadStationLoadingMore" x:Name="LoadMoreProgress" Width="24" Height="24" IsActive="False" Visibility="Collapsed"/>
            </StackPanel>
          </Grid>
        </Border>
        <Border x:Name="DetailPane" Grid.Column="1" Background="Transparent" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0" CornerRadius="8">
          <Grid Padding="20">
            <StackPanel x:Name="NoSelectionState" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="420" Spacing="8">
              <FontIcon Glyph="" FontSize="40"/>
              <TextBlock x:Uid="DownloadStationChooseTaskTitle" AutomationProperties.HeadingLevel="Level2" HorizontalAlignment="Center" Style="{ThemeResource SubtitleTextBlockStyle}" TextAlignment="Center"/>
              <TextBlock x:Uid="DownloadStationChooseTaskMessage" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextAlignment="Center" TextWrapping="Wrap"/>
            </StackPanel>
            <Grid x:Name="TaskDetailState" AutomationProperties.LiveSetting="Polite" Visibility="Collapsed">
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
              </Grid.RowDefinitions>
              <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto"/>
                  <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Button x:Uid="DownloadStationBack" x:Name="BackButton" MinWidth="44" MinHeight="44" Click="Back_Click" Visibility="Collapsed">
                  <FontIcon Glyph="" FontSize="16"/>
                </Button>
                <TextBlock Grid.Column="1" VerticalAlignment="Center" AutomationProperties.HeadingLevel="Level2" FontSize="20" FontWeight="SemiBold" Text="{Binding SelectedTask.Title}" TextTrimming="CharacterEllipsis"/>
              </Grid>
              <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <StackPanel Padding="0,16,0,0" Spacing="16">
                  <InfoBar x:Name="DownloadControlNotice" AutomationProperties.LiveSetting="Polite" IsClosable="False" IsOpen="False" Message="{Binding ControlNoticeMessage}" Title="{Binding ControlNoticeTitle}"/>
                  <InfoBar x:Name="DownloadDeleteNotice" AutomationProperties.LiveSetting="Polite" IsClosable="False" IsOpen="False" Message="{Binding DeleteNoticeMessage}" Title="{Binding DeleteNoticeTitle}"/>
                  <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="Auto"/>
                      <ColumnDefinition Width="Auto"/>
                      <ColumnDefinition Width="Auto"/>
                      <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <ProgressRing x:Uid="DownloadStationControlProgress" x:Name="ControlProgress" Grid.Column="3" Width="28" Height="28" IsActive="False" Visibility="Collapsed"/>
                  </Grid>
                  <ProgressBar IsIndeterminate="{Binding SelectedTask.IsProgressUnknown}" MinHeight="4" Maximum="100" Value="{Binding SelectedTask.ProgressPercent}"/>
                  <Grid ColumnSpacing="24" RowSpacing="14">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="Auto"/>
                      <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                      <RowDefinition Height="Auto"/>
                      <RowDefinition Height="Auto"/>
                      <RowDefinition Height="Auto"/>
                      <RowDefinition Height="Auto"/>
                      <RowDefinition Height="Auto"/>
                      <RowDefinition Height="Auto"/>
                      <RowDefinition Height="Auto"/>
                      <RowDefinition Height="Auto"/>
                      <RowDefinition Height="Auto"/>
                      <RowDefinition Height="Auto"/>
                      <RowDefinition Height="Auto"/>
                      <RowDefinition Height="Auto"/>
                      <RowDefinition Height="Auto"/>
                      <RowDefinition Height="Auto"/>
                      <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock x:Uid="DownloadStationDetailStatus" FontWeight="SemiBold"/>
                    <TextBlock Grid.Column="1" Text="{Binding SelectedTask.StatusText}" TextWrapping="Wrap"/>
                    <TextBlock x:Uid="DownloadStationDetailProgress" Grid.Row="1" FontWeight="SemiBold"/>
                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding SelectedTask.ProgressText}"/>
                    <TextBlock x:Uid="DownloadStationDetailSize" Grid.Row="2" FontWeight="SemiBold"/>
                    <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding SelectedTask.SizeText}"/>
                    <TextBlock x:Uid="DownloadStationDetailDownloaded" Grid.Row="3" FontWeight="SemiBold"/>
                    <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding SelectedTask.DownloadedText}"/>
                    <TextBlock x:Uid="DownloadStationDetailUploaded" Grid.Row="4" FontWeight="SemiBold"/>
                    <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding SelectedTask.UploadedText}"/>
                    <TextBlock x:Uid="DownloadStationDetailDownloadSpeed" Grid.Row="5" FontWeight="SemiBold"/>
                    <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding SelectedTask.DownloadSpeedText}"/>
                    <TextBlock x:Uid="DownloadStationDetailUploadSpeed" Grid.Row="6" FontWeight="SemiBold"/>
                    <TextBlock Grid.Row="6" Grid.Column="1" Text="{Binding SelectedTask.UploadSpeedText}"/>
                    <TextBlock x:Uid="DownloadStationDetailDestination" Grid.Row="7" FontWeight="SemiBold"/>
                    <TextBlock Grid.Row="7" Grid.Column="1" Text="{Binding SelectedTask.DestinationText}" TextWrapping="Wrap"/>
                    <TextBlock x:Uid="DownloadStationDetailError" Grid.Row="8" FontWeight="SemiBold"/>
                    <TextBlock Grid.Row="8" Grid.Column="1" Text="{Binding SelectedTask.ErrorText}" TextWrapping="Wrap"/>
                    <TextBlock x:Uid="DownloadStationDetailPriority" Grid.Row="9" FontWeight="SemiBold"/>
                    <TextBlock Grid.Row="9" Grid.Column="1" Text="{Binding SelectedTask.PriorityText}" TextWrapping="Wrap"/>
                    <TextBlock x:Uid="DownloadStationDetailFiles" Grid.Row="10" FontWeight="SemiBold"/>
                    <TextBlock Grid.Row="10" Grid.Column="1" Text="{Binding SelectedTask.FileCountText}" TextWrapping="Wrap"/>
                    <TextBlock x:Uid="DownloadStationDetailTrackers" Grid.Row="11" FontWeight="SemiBold"/>
                    <TextBlock Grid.Row="11" Grid.Column="1" Text="{Binding SelectedTask.TrackerCountText}" TextWrapping="Wrap"/>
                    <TextBlock x:Uid="DownloadStationDetailPeers" Grid.Row="12" FontWeight="SemiBold"/>
                    <TextBlock Grid.Row="12" Grid.Column="1" Text="{Binding SelectedTask.PeerCountText}" TextWrapping="Wrap"/>
                    <TextBlock x:Uid="DownloadStationDetailSeeds" Grid.Row="13" FontWeight="SemiBold"/>
                    <TextBlock Grid.Row="13" Grid.Column="1" Text="{Binding SelectedTask.SeedsText}" TextWrapping="Wrap"/>
                    <TextBlock x:Uid="DownloadStationDetailLeeches" Grid.Row="14" FontWeight="SemiBold"/>
                    <TextBlock Grid.Row="14" Grid.Column="1" Text="{Binding SelectedTask.LeechesText}" TextWrapping="Wrap"/>
                  </Grid>
                </StackPanel>
              </ScrollViewer>
            </Grid>
          </Grid>
        </Border>
      </Grid>
      <StackPanel x:Name="LoadingState" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12">
        <ProgressRing Width="40" Height="40" IsActive="True"/>
        <TextBlock x:Uid="DownloadStationLoading" AutomationProperties.LiveSetting="Polite"/>
      </StackPanel>
      <StackPanel x:Name="EmptyState" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="440" Spacing="8">
        <TextBlock x:Uid="DownloadStationEmptyTitle" AutomationProperties.LiveSetting="Polite" Style="{ThemeResource SubtitleTextBlockStyle}" TextAlignment="Center"/>
        <TextBlock x:Uid="DownloadStationEmptyMessage" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextAlignment="Center" TextWrapping="Wrap"/>
        <Button x:Uid="DownloadStationRefreshEmpty" MinHeight="44" Click="Refresh_Click"/>
      </StackPanel>
      <StackPanel x:Name="FilteredEmptyState" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="440" Spacing="8">
        <TextBlock x:Uid="DownloadStationFilteredEmptyTitle" AutomationProperties.LiveSetting="Polite" Style="{ThemeResource SubtitleTextBlockStyle}" TextAlignment="Center"/>
        <TextBlock x:Uid="DownloadStationFilteredEmptyMessage" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextAlignment="Center" TextWrapping="Wrap"/>
        <Button x:Uid="DownloadStationShowAll" MinHeight="44" Click="ShowAll_Click"/>
      </StackPanel>
      <StackPanel x:Name="ErrorState" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="440" Spacing="8">
        <TextBlock x:Uid="DownloadStationErrorTitle" AutomationProperties.LiveSetting="Polite" Style="{ThemeResource SubtitleTextBlockStyle}" TextAlignment="Center"/>
        <TextBlock x:Uid="DownloadStationErrorMessage" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextAlignment="Center" TextWrapping="Wrap"/>
        <Button x:Uid="DownloadStationRetry" MinHeight="44" Click="Refresh_Click"/>
      </StackPanel>
      <StackPanel x:Name="UnavailableState" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="440" Spacing="8">
        <FontIcon Glyph="" FontSize="40"/>
        <TextBlock x:Uid="DownloadStationUnavailableTitle" AutomationProperties.LiveSetting="Polite" Style="{ThemeResource SubtitleTextBlockStyle}" TextAlignment="Center"/>
        <TextBlock x:Uid="DownloadStationUnavailableMessage" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextAlignment="Center" TextWrapping="Wrap"/>
      </StackPanel>
    </Grid>
  </Grid>
</Page>
