<Page
    x:Class="LanStash.App.Views.DownloadStationPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:downloads="using:LanStash.App.Features.Downloads"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
    SizeChanged="Page_SizeChanged">
    <Page.KeyboardAccelerators>
        <KeyboardAccelerator Key="Left" Modifiers="Menu" Invoked="BackAccelerator_Invoked" />
        <KeyboardAccelerator Key="F" Modifiers="Control" Invoked="SearchAccelerator_Invoked" />
        <KeyboardAccelerator Key="F5" Invoked="RefreshAccelerator_Invoked" />
    </Page.KeyboardAccelerators>

    <Grid Padding="24,20,24,16" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Spacing="4">
                <TextBlock
                    x:Uid="DownloadStationTitle"
                    Style="{StaticResource TitleTextBlockStyle}"
                    AutomationProperties.HeadingLevel="Level1" />
                <TextBlock
                    x:Uid="DownloadStationDescription"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    TextWrapping="Wrap" />
            </StackPanel>
            <Button
                x:Uid="DownloadStationRefresh"
                x:Name="RefreshButton"
                Grid.Column="1"
                MinHeight="44"
                Click="Refresh_Click">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE72C;" FontSize="16" />
                    <TextBlock x:Uid="DownloadStationRefreshLabel" />
                </StackPanel>
            </Button>
        </Grid>

        <InfoBar
            x:Uid="DownloadStationReadOnly"
            Grid.Row="1"
            IsClosable="False"
            IsOpen="True"
            Severity="Informational" />

        <InfoBar
            x:Uid="DownloadStationActivityError"
            x:Name="ActivityErrorNotice"
            Grid.Row="2"
            AutomationProperties.LiveSetting="Polite"
            IsClosable="False"
            IsOpen="False"
            Severity="Warning" />

        <Border
            x:Name="ActivitySummary"
            Grid.Row="2"
            Padding="16,12"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="8"
            AutomationProperties.LiveSetting="Polite"
            Visibility="Collapsed">
            <StackPanel Spacing="8">
                <TextBlock
                    x:Uid="DownloadStationActivityTitle"
                    FontWeight="SemiBold"
                    AutomationProperties.HeadingLevel="Level2" />
                <Grid ColumnSpacing="24">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="2">
                        <TextBlock
                            x:Uid="DownloadStationActivityDownload"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock Text="{Binding ActivityDownloadSpeedText}" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Spacing="2">
                        <TextBlock
                            x:Uid="DownloadStationActivityUpload"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock Text="{Binding ActivityUploadSpeedText}" />
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Border>

        <InfoBar
            x:Uid="DownloadStationRefreshError"
            x:Name="RefreshErrorNotice"
            Grid.Row="3"
            AutomationProperties.LiveSetting="Polite"
            IsClosable="False"
            IsOpen="False"
            Severity="Warning" />

        <Grid Grid.Row="4">
            <Grid
                x:Name="ContentState"
                ColumnSpacing="12"
                AutomationProperties.LiveSetting="Polite"
                Visibility="Collapsed">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="TaskColumn" Width="360" />
                    <ColumnDefinition x:Name="DetailColumn" Width="*" />
                </Grid.ColumnDefinitions>

                <Border
                    x:Name="TaskPane"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8">
                    <Grid Padding="12" RowSpacing="8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <AutoSuggestBox
                                x:Uid="DownloadStationSearch"
                                x:Name="SearchBox"
                                MinHeight="44"
                                QueryIcon="Find"
                                Text="{Binding SearchText, Mode=OneWay}"
                                TextChanged="SearchBox_TextChanged" />
                            <ComboBox
                                x:Uid="DownloadStationFilter"
                                x:Name="FilterPicker"
                                Grid.Column="1"
                                MinWidth="144"
                                MinHeight="44"
                                SelectedIndex="0"
                                SelectionChanged="FilterPicker_SelectionChanged">
                                <ComboBoxItem x:Uid="DownloadStationFilterAll" Tag="All" />
                                <ComboBoxItem x:Uid="DownloadStationFilterActive" Tag="Active" />
                                <ComboBoxItem x:Uid="DownloadStationFilterFinished" Tag="Finished" />
                                <ComboBoxItem x:Uid="DownloadStationFilterPaused" Tag="Paused" />
                            </ComboBox>
                        </Grid>

                        <ListView
                            x:Uid="DownloadStationTaskList"
                            x:Name="TaskList"
                            Grid.Row="1"
                            IsItemClickEnabled="True"
                            ItemClick="TaskList_ItemClick"
                            ItemsSource="{Binding Tasks}"
                            SelectionMode="Single">
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem">
                                    <Setter Property="MinHeight" Value="72" />
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                </Style>
                            </ListView.ItemContainerStyle>
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="downloads:DownloadTaskItem">
                                    <Grid
                                        Padding="4,8"
                                        RowSpacing="6"
                                        AutomationProperties.Name="{x:Bind AutomationName}">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <Grid ColumnSpacing="8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock
                                                FontWeight="SemiBold"
                                                MaxLines="2"
                                                Text="{x:Bind Title}"
                                                TextTrimming="CharacterEllipsis"
                                                TextWrapping="Wrap" />
                                            <TextBlock
                                                Grid.Column="1"
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                Text="{x:Bind StatusText}" />
                                        </Grid>
                                        <ProgressBar
                                            Grid.Row="1"
                                            IsIndeterminate="{x:Bind IsProgressUnknown}"
                                            MinHeight="4"
                                            Maximum="100"
                                            Value="{x:Bind ProgressPercent}" />
                                        <TextBlock
                                            Grid.Row="2"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            Text="{x:Bind ProgressText}" />
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>

                        <StackPanel Grid.Row="2" HorizontalAlignment="Center" Spacing="8">
                            <InfoBar
                                x:Uid="DownloadStationLoadMoreError"
                                x:Name="LoadMoreErrorNotice"
                                AutomationProperties.LiveSetting="Polite"
                                IsClosable="False"
                                IsOpen="False"
                                Severity="Warning" />
                            <Button
                                x:Uid="DownloadStationLoadMore"
                                x:Name="LoadMoreButton"
                                MinHeight="44"
                                Click="LoadMore_Click" />
                            <ProgressRing
                                x:Uid="DownloadStationLoadingMore"
                                x:Name="LoadMoreProgress"
                                Width="24"
                                Height="24"
                                IsActive="False"
                                Visibility="Collapsed" />
                        </StackPanel>
                    </Grid>
                </Border>

                <Border
                    x:Name="DetailPane"
                    Grid.Column="1"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8">
                    <Grid Padding="20">
                        <StackPanel
                            x:Name="NoSelectionState"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            MaxWidth="420"
                            Spacing="8">
                            <FontIcon Glyph="&#xE9D9;" FontSize="40" />
                            <TextBlock
                                x:Uid="DownloadStationChooseTaskTitle"
                                AutomationProperties.HeadingLevel="Level2"
                                HorizontalAlignment="Center"
                                Style="{ThemeResource SubtitleTextBlockStyle}"
                                TextAlignment="Center" />
                            <TextBlock
                                x:Uid="DownloadStationChooseTaskMessage"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                TextAlignment="Center"
                                TextWrapping="Wrap" />
                        </StackPanel>

                        <Grid
                            x:Name="TaskDetailState"
                            AutomationProperties.LiveSetting="Polite"
                            Visibility="Collapsed">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Button
                                    x:Uid="DownloadStationBack"
                                    x:Name="BackButton"
                                    MinWidth="44"
                                    MinHeight="44"
                                    Click="Back_Click"
                                    Visibility="Collapsed">
                                    <FontIcon Glyph="&#xE72B;" FontSize="16" />
                                </Button>
                                <TextBlock
                                    Grid.Column="1"
                                    VerticalAlignment="Center"
                                    AutomationProperties.HeadingLevel="Level2"
                                    FontSize="20"
                                    FontWeight="SemiBold"
                                    Text="{Binding SelectedTask.Title}"
                                    TextTrimming="CharacterEllipsis" />
                            </Grid>
                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                <StackPanel Padding="0,16,0,0" Spacing="16">
                                    <ProgressBar
                                        IsIndeterminate="{Binding SelectedTask.IsProgressUnknown}"
                                        MinHeight="4"
                                        Maximum="100"
                                        Value="{Binding SelectedTask.ProgressPercent}" />
                                    <Grid ColumnSpacing="24" RowSpacing="14">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <TextBlock x:Uid="DownloadStationDetailStatus" FontWeight="SemiBold" />
                                        <TextBlock Grid.Column="1" Text="{Binding SelectedTask.StatusText}" TextWrapping="Wrap" />
                                        <TextBlock x:Uid="DownloadStationDetailProgress" Grid.Row="1" FontWeight="SemiBold" />
                                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding SelectedTask.ProgressText}" />
                                        <TextBlock x:Uid="DownloadStationDetailSize" Grid.Row="2" FontWeight="SemiBold" />
                                        <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding SelectedTask.SizeText}" />
                                        <TextBlock x:Uid="DownloadStationDetailDownloaded" Grid.Row="3" FontWeight="SemiBold" />
                                        <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding SelectedTask.DownloadedText}" />
                                        <TextBlock x:Uid="DownloadStationDetailUploaded" Grid.Row="4" FontWeight="SemiBold" />
                                        <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding SelectedTask.UploadedText}" />
                                        <TextBlock x:Uid="DownloadStationDetailDownloadSpeed" Grid.Row="5" FontWeight="SemiBold" />
                                        <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding SelectedTask.DownloadSpeedText}" />
                                        <TextBlock x:Uid="DownloadStationDetailUploadSpeed" Grid.Row="6" FontWeight="SemiBold" />
                                        <TextBlock Grid.Row="6" Grid.Column="1" Text="{Binding SelectedTask.UploadSpeedText}" />
                                        <TextBlock x:Uid="DownloadStationDetailDestination" Grid.Row="7" FontWeight="SemiBold" />
                                        <TextBlock Grid.Row="7" Grid.Column="1" Text="{Binding SelectedTask.DestinationText}" TextWrapping="Wrap" />
                                        <TextBlock x:Uid="DownloadStationDetailError" Grid.Row="8" FontWeight="SemiBold" />
                                        <TextBlock Grid.Row="8" Grid.Column="1" Text="{Binding SelectedTask.ErrorText}" TextWrapping="Wrap" />
                                    </Grid>
                                </StackPanel>
                            </ScrollViewer>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>

            <StackPanel
                x:Name="LoadingState"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Spacing="12">
                <ProgressRing Width="40" Height="40" IsActive="True" />
                <TextBlock x:Uid="DownloadStationLoading" AutomationProperties.LiveSetting="Polite" />
            </StackPanel>

            <StackPanel x:Name="EmptyState" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="440" Spacing="8">
                <TextBlock x:Uid="DownloadStationEmptyTitle" AutomationProperties.LiveSetting="Polite" Style="{ThemeResource SubtitleTextBlockStyle}" TextAlignment="Center" />
                <TextBlock x:Uid="DownloadStationEmptyMessage" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextAlignment="Center" TextWrapping="Wrap" />
                <Button x:Uid="DownloadStationRefreshEmpty" MinHeight="44" Click="Refresh_Click" />
            </StackPanel>

            <StackPanel x:Name="FilteredEmptyState" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="440" Spacing="8">
                <TextBlock x:Uid="DownloadStationFilteredEmptyTitle" AutomationProperties.LiveSetting="Polite" Style="{ThemeResource SubtitleTextBlockStyle}" TextAlignment="Center" />
                <TextBlock x:Uid="DownloadStationFilteredEmptyMessage" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextAlignment="Center" TextWrapping="Wrap" />
                <Button x:Uid="DownloadStationShowAll" MinHeight="44" Click="ShowAll_Click" />
            </StackPanel>

            <StackPanel x:Name="ErrorState" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="440" Spacing="8">
                <TextBlock x:Uid="DownloadStationErrorTitle" AutomationProperties.LiveSetting="Polite" Style="{ThemeResource SubtitleTextBlockStyle}" TextAlignment="Center" />
                <TextBlock x:Uid="DownloadStationErrorMessage" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextAlignment="Center" TextWrapping="Wrap" />
                <Button x:Uid="DownloadStationRetry" MinHeight="44" Click="Refresh_Click" />
            </StackPanel>

            <StackPanel x:Name="UnavailableState" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="440" Spacing="8">
                <FontIcon Glyph="&#xE783;" FontSize="40" />
                <TextBlock x:Uid="DownloadStationUnavailableTitle" AutomationProperties.LiveSetting="Polite" Style="{ThemeResource SubtitleTextBlockStyle}" TextAlignment="Center" />
                <TextBlock x:Uid="DownloadStationUnavailableMessage" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextAlignment="Center" TextWrapping="Wrap" />
            </StackPanel>
        </Grid>
    </Grid>
</Page>
