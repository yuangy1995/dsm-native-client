<UserControl x:Class="LanStash.App.Views.VirtualMachineImageImportDialogContent" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <ScrollViewer MaxHeight="550" HorizontalScrollBarVisibility="Disabled">
  <StackPanel MinWidth="340" MaxWidth="540" Spacing="12" Margin="0,0,8,0">
   <ProgressRing x:Name="BusyIndicator" Width="30" Height="30" Visibility="Collapsed"/>
   <InfoBar x:Name="ErrorNotice" IsOpen="False" IsClosable="False" Severity="Error" AutomationProperties.LiveSetting="Polite"/>
   <InfoBar x:Name="FeedbackNotice" IsOpen="False" IsClosable="False" AutomationProperties.LiveSetting="Polite"/>
   <ProgressBar x:Name="TaskProgress" Minimum="0" Maximum="100" Visibility="Collapsed"/>
   <TextBlock x:Name="ReadOnlyNotice" x:Uid="VmImageImportReadOnly" TextWrapping="Wrap"/>
   <ComboBox x:Name="RecoveryInput" x:Uid="VmImageImportRecovery" HorizontalAlignment="Stretch" DisplayMemberPath="Name" SelectionChanged="Recovery_Changed"/>
   <TextBox x:Name="NameInput" x:Uid="VmImageImportName" BeforeTextChanging="Fields_Changing" TextChanged="Fields_Changed"/>
   <TextBox x:Name="PathInput" x:Uid="VmImageImportPath" BeforeTextChanging="Fields_Changing" TextChanged="Fields_Changed"/>
   <TextBlock x:Uid="VmImageImportSourceHint" TextWrapping="Wrap"/>
   <ComboBox x:Name="TypeInput" x:Uid="VmImageImportType" HorizontalAlignment="Stretch" SelectedIndex="0" SelectionChanged="Choice_Changed">
    <ComboBoxItem x:Uid="VmImageImportDisk"/><ComboBoxItem x:Uid="VmImageImportIso"/><ComboBoxItem x:Uid="VmImageImportVdsm"/>
   </ComboBox>
   <TextBlock x:Uid="VmImageImportStorages" FontWeight="SemiBold"/>
   <ListView x:Name="StorageInput" x:Uid="VmImageImportStorageList" MaxHeight="170" SelectionMode="Multiple" SelectionChanged="Choice_Changed">
    <ListView.ItemTemplate><DataTemplate><TextBlock Text="{Binding Name}" TextWrapping="Wrap"/></DataTemplate></ListView.ItemTemplate>
   </ListView>
   <TextBlock x:Name="ConfirmationSummary" TextWrapping="Wrap"/>
   <TextBlock x:Name="ValidationNotice" TextWrapping="Wrap" Visibility="Collapsed"/>
   <CheckBox x:Name="RiskAcknowledgement" HorizontalContentAlignment="Stretch" Checked="Confirm_Changed" Unchecked="Confirm_Changed">
    <TextBlock x:Uid="VmImageImportAcknowledgement" TextWrapping="Wrap"/>
   </CheckBox>
   <TextBlock x:Uid="VmImageImportCloseHint" TextWrapping="Wrap"/>
   <Button x:Name="NewButton" x:Uid="VmImageImportNew" MinHeight="44" Click="New_Click" Visibility="Collapsed"/>
  </StackPanel>
 </ScrollViewer>
</UserControl>
