<UserControl x:Class="LanStash.App.Views.ContainerNetworkCreateDialogContent"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <ScrollViewer MaxHeight="550" HorizontalScrollBarVisibility="Disabled">
  <StackPanel MinWidth="340" MaxWidth="560" Spacing="12">
   <ProgressRing x:Name="LoadingIndicator" Width="32" Height="32" Visibility="Collapsed"/>
   <InfoBar x:Name="ErrorNotice" IsOpen="False" IsClosable="False" Severity="Error" AutomationProperties.LiveSetting="Polite"/>
   <InfoBar x:Name="FeedbackNotice" IsOpen="False" IsClosable="False" AutomationProperties.LiveSetting="Polite"/>
   <TextBlock x:Name="ReadOnlyNotice" x:Uid="ContainerCreateReadOnly" TextWrapping="Wrap"/>
   <TextBlock x:Name="PendingNotice" Visibility="Collapsed" TextWrapping="Wrap"/>
   <TextBox x:Name="NameInput" x:Uid="ContainerCreateName" TextChanged="Fields_Changed"/>
   <ComboBox x:Name="Ipv4Mode" x:Uid="ContainerCreateIpv4Mode" SelectedIndex="0" SelectionChanged="Modes_Changed" HorizontalAlignment="Stretch">
    <ComboBoxItem x:Uid="ContainerCreateAutomatic"/><ComboBoxItem x:Uid="ContainerCreateManual"/>
   </ComboBox>
   <StackPanel x:Name="Ipv4Fields" Visibility="Collapsed" Spacing="8">
    <TextBox x:Name="SubnetInput" x:Uid="ContainerCreateIpv4Subnet" TextChanged="Fields_Changed"/>
    <TextBox x:Name="RangeInput" x:Uid="ContainerCreateIpv4Range" TextChanged="Fields_Changed"/>
    <TextBox x:Name="GatewayInput" x:Uid="ContainerCreateIpv4Gateway" TextChanged="Fields_Changed"/>
   </StackPanel>
   <ComboBox x:Name="Ipv6Mode" x:Uid="ContainerCreateIpv6Mode" SelectedIndex="0" SelectionChanged="Modes_Changed" HorizontalAlignment="Stretch">
    <ComboBoxItem x:Uid="ContainerCreateIpv6Off"/><ComboBoxItem x:Uid="ContainerCreateManual"/>
   </ComboBox>
   <StackPanel x:Name="Ipv6Fields" Visibility="Collapsed" Spacing="8">
    <TextBox x:Name="Ipv6SubnetInput" x:Uid="ContainerCreateIpv6Subnet" TextChanged="Fields_Changed"/>
    <TextBox x:Name="Ipv6RangeInput" x:Uid="ContainerCreateIpv6Range" TextChanged="Fields_Changed"/>
    <TextBox x:Name="Ipv6GatewayInput" x:Uid="ContainerCreateIpv6Gateway" TextChanged="Fields_Changed"/>
   </StackPanel>
   <CheckBox x:Name="MasqueradeInput" x:Uid="ContainerCreateMasquerade" Checked="Checks_Changed" Unchecked="Checks_Changed"/>
   <TextBlock x:Name="AdvancedNotice" x:Uid="ContainerCreateAdvancedNotice" Visibility="Collapsed" TextWrapping="Wrap"/>
   <TextBlock x:Name="ValidationNotice" Visibility="Collapsed" TextWrapping="Wrap"/>
   <TextBlock x:Name="BlockedNameNotice" x:Uid="ContainerCreateBlockedName" Visibility="Collapsed" TextWrapping="Wrap"/>
   <TextBlock x:Uid="ContainerCreateRisk" TextWrapping="Wrap"/>
   <CheckBox x:Name="RiskAcknowledgement" x:Uid="ContainerCreateConfirm" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Checked="Confirm_Changed" Unchecked="Confirm_Changed">
    <CheckBox.ContentTemplate><DataTemplate><TextBlock Text="{Binding}" TextWrapping="Wrap"/></DataTemplate></CheckBox.ContentTemplate>
   </CheckBox>
  </StackPanel>
 </ScrollViewer>
</UserControl>
