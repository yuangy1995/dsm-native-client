<UserControl x:Class="LanStash.App.Views.ContainerImageDeleteDialogContent"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <ScrollViewer MaxHeight="550" HorizontalScrollBarVisibility="Disabled">
  <StackPanel MinWidth="340" MaxWidth="560" Spacing="12">
   <ProgressRing x:Name="LoadingIndicator" Width="32" Height="32" Visibility="Collapsed"/>
   <InfoBar x:Name="ErrorNotice" IsOpen="False" IsClosable="False" Severity="Error" AutomationProperties.LiveSetting="Polite"/>
   <InfoBar x:Name="FeedbackNotice" IsOpen="False" IsClosable="False" AutomationProperties.LiveSetting="Polite"/>
   <TextBlock x:Name="ReadOnlyNotice" x:Uid="ContainerImageDeleteReadOnly" TextWrapping="Wrap"/>
   <TextBlock x:Uid="ContainerImageDeleteEligible" TextWrapping="Wrap"/>
   <TextBlock x:Name="PendingNotice" Visibility="Collapsed" TextWrapping="Wrap"/>
   <ListView x:Name="TargetsList" x:Uid="ContainerImageDeleteTargets" SelectionMode="Multiple" DisplayMemberPath="Name" MaxHeight="220" SelectionChanged="Selection_Changed"/>
   <TextBlock x:Name="EmptyNotice" x:Uid="ContainerImageDeleteEmpty" TextWrapping="Wrap" Visibility="Collapsed"/>
   <TextBlock x:Name="SelectionNotice" TextWrapping="Wrap" Visibility="Collapsed"/>
   <TextBlock x:Uid="ContainerImageDeleteRisk" TextWrapping="Wrap"/>
   <CheckBox x:Name="RiskAcknowledgement" x:Uid="ContainerImageDeleteAcknowledgement" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Checked="Confirm_Changed" Unchecked="Confirm_Changed"/>
  </StackPanel>
 </ScrollViewer>
</UserControl>
