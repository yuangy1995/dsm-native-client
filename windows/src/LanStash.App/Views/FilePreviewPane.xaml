<UserControl
    x:Class="LanStash.App.Views.FilePreviewPane"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    MinWidth="320">
    <UserControl.KeyboardAccelerators>
        <KeyboardAccelerator Key="Escape" Invoked="CloseAccelerator_Invoked" />
        <KeyboardAccelerator Key="Left" Modifiers="Menu" Invoked="CloseAccelerator_Invoked" />
        <KeyboardAccelerator Key="Add" Modifiers="Control" Invoked="ZoomInAccelerator_Invoked" />
        <KeyboardAccelerator Key="Subtract" Modifiers="Control" Invoked="ZoomOutAccelerator_Invoked" />
        <KeyboardAccelerator Key="Number0" Modifiers="Control" Invoked="FitImageAccelerator_Invoked" />
        <KeyboardAccelerator Key="L" Modifiers="Control" Invoked="RotateLeftAccelerator_Invoked" />
        <KeyboardAccelerator Key="R" Modifiers="Control" Invoked="RotateRightAccelerator_Invoked" />
    </UserControl.KeyboardAccelerators>
    <Grid
        x:Name="PreviewRoot"
        Padding="20,12,4,4"
        Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Button
                x:Uid="FilePreviewBack"
                x:Name="BackButton"
                Click="Close_Click"
                MinWidth="44"
                MinHeight="44">
                <FontIcon Glyph="&#xE72B;" />
            </Button>
            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                <TextBlock
                    x:Uid="FilePreviewTitle"
                    Style="{StaticResource CaptionTextBlockStyle}" />
                <TextBlock
                    x:Name="FileNameText"
                    AutomationProperties.HeadingLevel="Level2"
                    FontWeight="SemiBold"
                    TextTrimming="CharacterEllipsis" />
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Button
                        x:Uid="FileMd5Calculate"
                        x:Name="MD5Button"
                        Click="MD5_Click"
                        MinHeight="44"
                        Visibility="Collapsed" />
                    <TextBlock
                        x:Uid="FileMd5Result"
                        x:Name="MD5ResultText"
                        Grid.Column="1"
                        AutomationProperties.LiveSetting="Polite"
                        IsTextSelectionEnabled="True"
                        VerticalAlignment="Center"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        TextWrapping="Wrap" />
                </Grid>
            </StackPanel>
            <Button
                x:Uid="FilePreviewClose"
                Grid.Column="2"
                Click="Close_Click"
                MinWidth="44"
                MinHeight="44">
                <FontIcon Glyph="&#xE711;" />
            </Button>
        </Grid>

        <InfoBar
            x:Uid="FilePreviewReadOnly"
            x:Name="PreviewReadOnlyNotice"
            Grid.Row="1"
            IsClosable="False"
            IsOpen="True"
            Severity="Informational" />

        <StackPanel x:Name="OfficeActions" Grid.Row="1" Spacing="6" Visibility="Collapsed">
            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <SplitButton x:Uid="OfficeOpenCopyControl" x:Name="OfficeOpenCopyButton" Click="OfficeOpenCopy_Click" MinHeight="56" HorizontalAlignment="Stretch">
                    <SplitButton.Content><TextBlock x:Uid="OfficeOpenCopyLabel" TextWrapping="Wrap" TextAlignment="Center" MaxWidth="110"/></SplitButton.Content>
                    <SplitButton.Flyout><MenuFlyout><MenuFlyoutItem x:Uid="OfficeOpenWithMenu" Click="OfficeOpenWith_Click"/></MenuFlyout></SplitButton.Flyout>
                </SplitButton>
                <SplitButton x:Uid="OfficeAutoEditControl" x:Name="OfficeAutoEditButton" Grid.Column="1" Click="OfficeAutoEdit_Click" MinHeight="56" HorizontalAlignment="Stretch">
                    <SplitButton.Content><TextBlock x:Uid="OfficeAutoEditLabel" TextWrapping="Wrap" TextAlignment="Center" MaxWidth="110"/></SplitButton.Content>
                    <SplitButton.Flyout><MenuFlyout><MenuFlyoutItem x:Uid="OfficeEditWithMenu" Click="OfficeEditWith_Click"/></MenuFlyout></SplitButton.Flyout>
                </SplitButton>
                <Button x:Uid="OfficeSessionsCompact" x:Name="OfficeSessionsPreviewButton" Grid.Column="2" Click="OfficeSessions_Click" MinWidth="44" MinHeight="56"><FontIcon Glyph="&#xE8A5;"/></Button>
            </Grid>
            <TextBlock x:Uid="OfficeAutoUnavailableNotice" x:Name="OfficeAutoUnavailableText" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
            <HyperlinkButton x:Uid="OfficeSessionStatusControl" x:Name="OfficeSessionStatusButton" Click="OfficeSessions_Click"
                MinHeight="44" HorizontalAlignment="Left" Visibility="Collapsed" AutomationProperties.LiveSetting="Polite">
                <TextBlock x:Name="OfficeSessionStatusText" TextWrapping="Wrap"/>
            </HyperlinkButton>
        </StackPanel>

        <Grid Grid.Row="2" Margin="0,12,0,0">
            <StackPanel
                x:Name="PreparingState"
                MaxWidth="420"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Spacing="12"
                Visibility="Collapsed"
                AutomationProperties.LiveSetting="Polite">
                <ProgressRing Width="36" Height="36" IsActive="True" />
                <TextBlock
                    x:Uid="FilePreviewPreparingTitle"
                    Style="{StaticResource SubtitleTextBlockStyle}"
                    TextAlignment="Center" />
                <TextBlock
                    x:Name="ProgressText"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    TextAlignment="Center" />
                <Button
                    x:Uid="FilePreviewCancel"
                    Click="Cancel_Click"
                    HorizontalAlignment="Center"
                    MinHeight="44" />
            </StackPanel>

            <StackPanel
                x:Name="DetailsOnlyState"
                MaxWidth="440"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Spacing="12"
                Visibility="Collapsed"
                AutomationProperties.LiveSetting="Polite">
                <FontIcon FontSize="40" Glyph="&#xE8A5;" />
                <TextBlock
                    x:Name="UnavailableTitle"
                    Style="{StaticResource SubtitleTextBlockStyle}"
                    TextAlignment="Center"
                    TextWrapping="Wrap" />
                <TextBlock
                    x:Name="UnavailableMessage"
                    TextAlignment="Center"
                    TextWrapping="Wrap" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="8">
                    <Button
                        x:Uid="FilePreviewRetry"
                        x:Name="RetryDetailsButton"
                        Click="Retry_Click"
                        MinHeight="44"
                        Visibility="Collapsed" />
                    <Button
                        x:Uid="FilePreviewSaveCopy"
                        x:Name="DetailsSaveCopyButton"
                        Click="SaveCopy_Click"
                        MinHeight="44" />
                </StackPanel>
            </StackPanel>

            <StackPanel
                x:Name="FailedState"
                MaxWidth="440"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Spacing="12"
                Visibility="Collapsed"
                AutomationProperties.LiveSetting="Polite">
                <FontIcon FontSize="40" Glyph="&#xEA39;" />
                <TextBlock
                    x:Uid="FilePreviewFailedTitle"
                    Style="{StaticResource SubtitleTextBlockStyle}"
                    TextAlignment="Center" />
                <TextBlock
                    x:Uid="FilePreviewFailedMessage"
                    TextAlignment="Center"
                    TextWrapping="Wrap" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="8">
                    <Button x:Uid="FilePreviewRetry" Click="Retry_Click" MinHeight="44" />
                    <Button
                        x:Uid="FilePreviewSaveCopy"
                        x:Name="FailedSaveCopyButton"
                        Click="SaveCopy_Click"
                        MinHeight="44" />
                </StackPanel>
            </StackPanel>

            <Grid x:Name="ReadyState" Visibility="Collapsed">
                <Grid x:Name="OfficePreviewPanel" Visibility="Collapsed" RowSpacing="8">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <Button x:Uid="OfficeFocusPreviewButton" x:Name="OfficeFocusPreviewButton" Click="OfficeFocusPreview_Click" MinHeight="44" Visibility="Collapsed"/>
                    <Grid x:Name="OfficePreviewSurface" Grid.Row="1" MinHeight="200">
                        <StackPanel x:Name="OfficePreviewFallback" Spacing="12" MaxWidth="420" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <FontIcon Glyph="&#xE8A5;" FontSize="40"/>
                            <TextBlock x:Name="OfficePreviewFallbackTitle" Style="{StaticResource SubtitleTextBlockStyle}" TextWrapping="Wrap" TextAlignment="Center"/>
                            <TextBlock x:Name="OfficePreviewFallbackMessage" TextWrapping="Wrap" TextAlignment="Center"/>
                            <Button x:Uid="FilePreviewRetry" Click="Retry_Click" MinHeight="44" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Grid>
                </Grid>
                <Grid x:Name="TextScroller" Visibility="Collapsed" RowSpacing="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <InfoBar
                        x:Uid="FilePreviewTextTruncated"
                        x:Name="TextTruncatedNotice"
                        IsClosable="False"
                        IsOpen="False"
                        Severity="Informational" />
                    <!-- 查看模式的文本预览。 -->
                    <StackPanel
                        x:Name="TextEditButtonBar"
                        Grid.Row="1"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Spacing="8"
                        Visibility="Collapsed">
                        <Button
                            x:Uid="FileTextEdit_EditButton"
                            x:Name="TextEditButton"
                            Click="TextEdit_Click"
                            MinHeight="44" />
                    </StackPanel>
                    <ScrollViewer x:Name="TextPreviewScroller" Grid.Row="2"
                        HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                        <TextBlock
                            x:Name="TextPreview"
                            AutomationProperties.Name=""
                            FontFamily="Consolas"
                            IsTextSelectionEnabled="True"
                            TextWrapping="NoWrap" />
                    </ScrollViewer>
                    <!-- 编辑模式的文本输入。 -->
                    <TextBox
                        x:Name="TextEditBox"
                        Grid.Row="2"
                        x:Uid="FileTextEdit_Editor"
                        TextChanged="TextEditBox_TextChanged"
                        AcceptsReturn="True"
                        AutomationProperties.Name=""
                        FontFamily="Consolas"
                        HorizontalAlignment="Stretch"
                        MinHeight="200"
                        ScrollViewer.HorizontalScrollBarVisibility="Auto"
                        ScrollViewer.VerticalScrollBarVisibility="Auto"
                        TextWrapping="NoWrap"
                        Visibility="Collapsed" />
                    <!-- 编辑工具栏。 -->
                    <StackPanel
                        x:Name="TextEditToolbar"
                        Grid.Row="3"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Spacing="8"
                        Visibility="Collapsed">
                        <Button x:Uid="FileTextEdit_Refresh" x:Name="TextEditReviewButton"
                            Click="TextEditReview_Click" MinHeight="44" Visibility="Collapsed" />
                        <Button
                            x:Uid="FileTextEdit_FormatButton"
                            x:Name="TextEditFormatButton"
                            Click="TextEditFormat_Click"
                            MinHeight="44" />
                        <Button
                            x:Uid="FileTextEdit_CancelButton"
                            x:Name="TextEditCancelButton"
                            Click="TextEditCancel_Click"
                            MinHeight="44" />
                        <Button
                            x:Uid="FileTextEdit_SaveButton"
                            x:Name="TextEditSaveButton"
                            Click="TextEditSave_Click"
                            MinHeight="44" />
                    </StackPanel>
                    <!-- 保存状态。 -->
                    <InfoBar
                        x:Name="TextEditSaveStatus"
                        Grid.Row="4"
                        IsClosable="True"
                        IsOpen="False"
                        Severity="Informational"
                        Visibility="Collapsed">
                        <InfoBar.ActionButton>
                            <Button x:Uid="FileTextEdit_DismissStatus" Click="TextEditDismissStatus_Click" />
                        </InfoBar.ActionButton>
                    </InfoBar>
                </Grid>

                <Grid x:Name="ImagePreviewSurface" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <ScrollViewer
                        x:Name="ImageScroller"
                        HorizontalScrollBarVisibility="Auto"
                        VerticalScrollBarVisibility="Auto"
                        ZoomMode="Enabled"
                        MinZoomFactor="0.25"
                        MaxZoomFactor="4"
                        ViewChanged="ImageScroller_ViewChanged">
                        <Image
                            x:Name="ImagePreview"
                            RenderTransformOrigin="0.5,0.5"
                            SizeChanged="ImagePreview_SizeChanged"
                            Stretch="Uniform"
                            AutomationProperties.Name="">
                            <Image.RenderTransform>
                                <CompositeTransform x:Name="ImageRotationTransform" />
                            </Image.RenderTransform>
                        </Image>
                    </ScrollViewer>
                    <CommandBar
                        Grid.Row="1"
                        HorizontalAlignment="Center"
                        DefaultLabelPosition="Collapsed">
                        <CommandBar.Content>
                            <TextBlock
                                x:Name="ImageTransformStatus"
                                Margin="8,0"
                                VerticalAlignment="Center"
                                AutomationProperties.LiveSetting="Polite" />
                        </CommandBar.Content>
                        <AppBarButton
                            x:Uid="FilePreviewImageZoomOut"
                            x:Name="ImageZoomOutButton"
                            Click="ImageZoomOut_Click">
                            <FontIcon Glyph="&#xE71F;" />
                        </AppBarButton>
                        <AppBarButton
                            x:Uid="FilePreviewImageZoomIn"
                            x:Name="ImageZoomInButton"
                            Click="ImageZoomIn_Click">
                            <FontIcon Glyph="&#xE8A3;" />
                        </AppBarButton>
                        <AppBarButton x:Uid="FilePreviewImageFit" Click="ImageFit_Click">
                            <FontIcon Glyph="&#xE91B;" />
                        </AppBarButton>
                        <AppBarSeparator />
                        <AppBarButton x:Uid="FilePreviewImageRotateLeft" Click="ImageRotateLeft_Click">
                            <FontIcon Glyph="&#xE7AD;" />
                        </AppBarButton>
                        <AppBarButton x:Uid="FilePreviewImageRotateRight" Click="ImageRotateRight_Click">
                            <FontIcon Glyph="&#xE7AD;" RenderTransformOrigin="0.5,0.5">
                                <FontIcon.RenderTransform>
                                    <ScaleTransform ScaleX="-1" />
                                </FontIcon.RenderTransform>
                            </FontIcon>
                        </AppBarButton>
                    </CommandBar>
                </Grid>

                <Grid x:Name="PdfPreview" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <ScrollViewer ZoomMode="Enabled" MinZoomFactor="0.5" MaxZoomFactor="4">
                        <Image x:Name="PdfPageImage" Stretch="Uniform" />
                    </ScrollViewer>
                    <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" Spacing="8">
                        <Button
                            x:Uid="FilePreviewPdfPrevious"
                            x:Name="PreviousPdfPage"
                            Click="PreviousPdfPage_Click"
                            MinWidth="44"
                            MinHeight="44" />
                        <TextBlock x:Name="PdfPageText" VerticalAlignment="Center" />
                        <Button
                            x:Uid="FilePreviewPdfNext"
                            x:Name="NextPdfPage"
                            Click="NextPdfPage_Click"
                            MinWidth="44"
                            MinHeight="44" />
                    </StackPanel>
                </Grid>

                <MediaPlayerElement
                    x:Name="MediaPreview"
                    AreTransportControlsEnabled="True"
                    AutoPlay="False"
                    Stretch="Uniform"
                    Visibility="Collapsed" />
            </Grid>
        </Grid>
    </Grid>
</UserControl>
