<UserControl
    x:Class="LanStash.App.Views.FilePreviewPane"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:desktop="using:LanStash.App.Presentation"
    MinWidth="320">
    <UserControl.KeyboardAccelerators>
        <KeyboardAccelerator Key="Escape" Invoked="CloseAccelerator_Invoked" />
        <KeyboardAccelerator Key="Left" Modifiers="Menu" Invoked="CloseAccelerator_Invoked" />
        <KeyboardAccelerator Key="Add" Modifiers="Control" Invoked="ZoomInAccelerator_Invoked" />
        <KeyboardAccelerator Key="Subtract" Modifiers="Control" Invoked="ZoomOutAccelerator_Invoked" />
        <KeyboardAccelerator Key="Number0" Modifiers="Control" Invoked="FitImageAccelerator_Invoked" />
        <KeyboardAccelerator Key="L" Modifiers="Control" Invoked="RotateLeftAccelerator_Invoked" />
        <KeyboardAccelerator Key="R" Modifiers="Control" Invoked="RotateRightAccelerator_Invoked" />
    </UserControl.KeyboardAccelerators>
    <Grid
        x:Name="PreviewRoot"
        Padding="20,12,4,4"
        Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Button
                x:Uid="FilePreviewBack" desktop:DesktopLocalization.Bindings="AutomationProperties.Name=FilePreviewBack.AutomationProperties.Name"
                x:Name="BackButton"
                Click="Close_Click"
                MinWidth="44"
                MinHeight="44">
                <FontIcon Glyph="&#xE72B;" />
            </Button>
            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                <TextBlock
                    x:Uid="FilePreviewTitle" desktop:DesktopLocalization.Bindings="Text=FilePreviewTitle.Text"
                    Style="{StaticResource CaptionTextBlockStyle}" />
                <TextBlock
                    x:Name="FileNameText"
                    AutomationProperties.HeadingLevel="Level2"
                    FontWeight="SemiBold"
                    TextTrimming="CharacterEllipsis" />
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Button
                        x:Uid="FileMd5Calculate" desktop:DesktopLocalization.Bindings="Content=FileMd5Calculate.Content;AutomationProperties.Name=FileMd5Calculate.[using:Microsoft.UI.Xaml.Automation]AutomationProperties.Name"
                        x:Name="MD5Button"
                        Click="MD5_Click"
                        MinHeight="44"
                        Visibility="Collapsed" />
                    <TextBlock
                        x:Uid="FileMd5Result" desktop:DesktopLocalization.Bindings="AutomationProperties.Name=FileMd5Result.[using:Microsoft.UI.Xaml.Automation]AutomationProperties.Name"
                        x:Name="MD5ResultText"
                        Grid.Column="1"
                        AutomationProperties.LiveSetting="Polite"
                        IsTextSelectionEnabled="True"
                        VerticalAlignment="Center"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        TextWrapping="Wrap" />
                </Grid>
            </StackPanel>
            <Button
                x:Uid="FilePreviewClose" desktop:DesktopLocalization.Bindings="AutomationProperties.Name=FilePreviewClose.AutomationProperties.Name"
                Grid.Column="2"
                Click="Close_Click"
                MinWidth="44"
                MinHeight="44">
                <FontIcon Glyph="&#xE711;" />
            </Button>
        </Grid>

        <InfoBar
            x:Uid="FilePreviewReadOnly" desktop:DesktopLocalization.Bindings="Message=FilePreviewReadOnly.Message;Title=FilePreviewReadOnly.Title"
            Grid.Row="1"
            IsClosable="False"
            IsOpen="True"
            Severity="Informational" />

        <Grid Grid.Row="2" Margin="0,12,0,0">
            <StackPanel
                x:Name="PreparingState"
                MaxWidth="420"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Spacing="12"
                Visibility="Collapsed"
                AutomationProperties.LiveSetting="Polite">
                <ProgressRing Width="36" Height="36" IsActive="True" />
                <TextBlock
                    x:Uid="FilePreviewPreparingTitle" desktop:DesktopLocalization.Bindings="Text=FilePreviewPreparingTitle.Text"
                    Style="{StaticResource SubtitleTextBlockStyle}"
                    TextAlignment="Center" />
                <TextBlock
                    x:Name="ProgressText"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    TextAlignment="Center" />
                <Button
                    x:Uid="FilePreviewCancel" desktop:DesktopLocalization.Bindings="AutomationProperties.Name=FilePreviewCancel.AutomationProperties.Name;Content=FilePreviewCancel.Content"
                    Click="Cancel_Click"
                    HorizontalAlignment="Center"
                    MinHeight="44" />
            </StackPanel>

            <StackPanel
                x:Name="DetailsOnlyState"
                MaxWidth="440"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Spacing="12"
                Visibility="Collapsed"
                AutomationProperties.LiveSetting="Polite">
                <FontIcon FontSize="40" Glyph="&#xE8A5;" />
                <TextBlock
                    x:Name="UnavailableTitle"
                    Style="{StaticResource SubtitleTextBlockStyle}"
                    TextAlignment="Center"
                    TextWrapping="Wrap" />
                <TextBlock
                    x:Name="UnavailableMessage"
                    TextAlignment="Center"
                    TextWrapping="Wrap" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="8">
                    <Button
                        x:Uid="FilePreviewRetry" desktop:DesktopLocalization.Bindings="AutomationProperties.Name=FilePreviewRetry.AutomationProperties.Name;Content=FilePreviewRetry.Content"
                        x:Name="RetryDetailsButton"
                        Click="Retry_Click"
                        MinHeight="44"
                        Visibility="Collapsed" />
                    <Button
                        x:Uid="FilePreviewSaveCopy" desktop:DesktopLocalization.Bindings="AutomationProperties.Name=FilePreviewSaveCopy.AutomationProperties.Name;Content=FilePreviewSaveCopy.Content"
                        x:Name="DetailsSaveCopyButton"
                        Click="SaveCopy_Click"
                        MinHeight="44" />
                </StackPanel>
            </StackPanel>

            <StackPanel
                x:Name="FailedState"
                MaxWidth="440"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Spacing="12"
                Visibility="Collapsed"
                AutomationProperties.LiveSetting="Polite">
                <FontIcon FontSize="40" Glyph="&#xEA39;" />
                <TextBlock
                    x:Uid="FilePreviewFailedTitle" desktop:DesktopLocalization.Bindings="Text=FilePreviewFailedTitle.Text"
                    Style="{StaticResource SubtitleTextBlockStyle}"
                    TextAlignment="Center" />
                <TextBlock
                    x:Uid="FilePreviewFailedMessage" desktop:DesktopLocalization.Bindings="Text=FilePreviewFailedMessage.Text"
                    TextAlignment="Center"
                    TextWrapping="Wrap" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="8">
                    <Button x:Uid="FilePreviewRetry" desktop:DesktopLocalization.Bindings="AutomationProperties.Name=FilePreviewRetry.AutomationProperties.Name;Content=FilePreviewRetry.Content" Click="Retry_Click" MinHeight="44" />
                    <Button
                        x:Uid="FilePreviewSaveCopy" desktop:DesktopLocalization.Bindings="AutomationProperties.Name=FilePreviewSaveCopy.AutomationProperties.Name;Content=FilePreviewSaveCopy.Content"
                        x:Name="FailedSaveCopyButton"
                        Click="SaveCopy_Click"
                        MinHeight="44" />
                </StackPanel>
            </StackPanel>

            <Grid x:Name="ReadyState" Visibility="Collapsed">
                <ScrollViewer
                    x:Name="TextScroller"
                    HorizontalScrollBarVisibility="Auto"
                    VerticalScrollBarVisibility="Auto"
                    Visibility="Collapsed">
                    <StackPanel Spacing="8">
                        <InfoBar
                            x:Uid="FilePreviewTextTruncated" desktop:DesktopLocalization.Bindings="Message=FilePreviewTextTruncated.Message;Title=FilePreviewTextTruncated.Title"
                            x:Name="TextTruncatedNotice"
                            IsClosable="False"
                            IsOpen="False"
                            Severity="Informational" />
                        <!-- Read-only text preview (viewing mode). -->
                        <StackPanel
                            x:Name="TextEditButtonBar"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            Spacing="8"
                            Visibility="Collapsed">
                            <Button
                                x:Uid="FileTextEdit_EditButton" desktop:DesktopLocalization.Bindings="Content=FileTextEdit_EditButton.Content;AutomationProperties.Name=FileTextEdit_EditButton.[using:Microsoft.UI.Xaml.Automation]AutomationProperties.Name"
                                x:Name="TextEditButton"
                                Click="TextEdit_Click"
                                MinHeight="44" />
                        </StackPanel>
                        <TextBlock
                            x:Name="TextPreview"
                            AutomationProperties.Name=""
                            FontFamily="Consolas"
                            IsTextSelectionEnabled="True"
                            TextWrapping="NoWrap" />
                        <!-- Editable text box (edit mode). -->
                        <TextBox
                            x:Name="TextEditBox"
                            AcceptsReturn="True"
                            AutomationProperties.Name=""
                            FontFamily="Consolas"
                            HorizontalAlignment="Stretch"
                            MinHeight="200"
                            ScrollViewer.HorizontalScrollBarVisibility="Auto"
                            ScrollViewer.VerticalScrollBarVisibility="Auto"
                            TextWrapping="NoWrap"
                            Visibility="Collapsed" />
                        <!-- Edit mode toolbar. -->
                        <StackPanel
                            x:Name="TextEditToolbar"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            Spacing="8"
                            Visibility="Collapsed">
                            <Button
                                x:Uid="FileTextEdit_FormatButton" desktop:DesktopLocalization.Bindings="Content=FileTextEdit_FormatButton.Content;AutomationProperties.Name=FileTextEdit_FormatButton.[using:Microsoft.UI.Xaml.Automation]AutomationProperties.Name"
                                x:Name="TextEditFormatButton"
                                Click="TextEditFormat_Click"
                                MinHeight="44" />
                            <Button
                                x:Uid="FileTextEdit_CancelButton" desktop:DesktopLocalization.Bindings="Content=FileTextEdit_CancelButton.Content;AutomationProperties.Name=FileTextEdit_CancelButton.[using:Microsoft.UI.Xaml.Automation]AutomationProperties.Name"
                                x:Name="TextEditCancelButton"
                                Click="TextEditCancel_Click"
                                MinHeight="44" />
                            <Button
                                x:Uid="FileTextEdit_SaveButton" desktop:DesktopLocalization.Bindings="Content=FileTextEdit_SaveButton.Content;AutomationProperties.Name=FileTextEdit_SaveButton.[using:Microsoft.UI.Xaml.Automation]AutomationProperties.Name"
                                x:Name="TextEditSaveButton"
                                Click="TextEditSave_Click"
                                MinHeight="44" />
                        </StackPanel>
                        <!-- Save status indicator. -->
                        <InfoBar
                            x:Name="TextEditSaveStatus"
                            IsClosable="True"
                            IsOpen="False"
                            Severity="Informational"
                            Visibility="Collapsed">
                            <InfoBar.ActionButton>
                                <Button x:Uid="FileTextEdit_DismissStatus" desktop:DesktopLocalization.Bindings="Content=FileTextEdit_DismissStatus.Content" Click="TextEditDismissStatus_Click" />
                            </InfoBar.ActionButton>
                        </InfoBar>
                    </StackPanel>
                </ScrollViewer>

                <Grid x:Name="ImagePreviewSurface" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <ScrollViewer
                        x:Name="ImageScroller"
                        HorizontalScrollBarVisibility="Auto"
                        VerticalScrollBarVisibility="Auto"
                        ZoomMode="Enabled"
                        MinZoomFactor="0.25"
                        MaxZoomFactor="4"
                        ViewChanged="ImageScroller_ViewChanged">
                        <Image
                            x:Name="ImagePreview"
                            RenderTransformOrigin="0.5,0.5"
                            SizeChanged="ImagePreview_SizeChanged"
                            Stretch="Uniform"
                            AutomationProperties.Name="">
                            <Image.RenderTransform>
                                <CompositeTransform x:Name="ImageRotationTransform" />
                            </Image.RenderTransform>
                        </Image>
                    </ScrollViewer>
                    <CommandBar
                        Grid.Row="1"
                        HorizontalAlignment="Center"
                        DefaultLabelPosition="Collapsed">
                        <CommandBar.Content>
                            <TextBlock
                                x:Name="ImageTransformStatus"
                                Margin="8,0"
                                VerticalAlignment="Center"
                                AutomationProperties.LiveSetting="Polite" />
                        </CommandBar.Content>
                        <AppBarButton
                            x:Uid="FilePreviewImageZoomOut" desktop:DesktopLocalization.Bindings="AutomationProperties.Name=FilePreviewImageZoomOut.[using:Microsoft.UI.Xaml.Automation]AutomationProperties.Name;ToolTipService.ToolTip=FilePreviewImageZoomOut.[using:Microsoft.UI.Xaml.Controls]ToolTipService.ToolTip"
                            x:Name="ImageZoomOutButton"
                            Click="ImageZoomOut_Click">
                            <FontIcon Glyph="&#xE71F;" />
                        </AppBarButton>
                        <AppBarButton
                            x:Uid="FilePreviewImageZoomIn" desktop:DesktopLocalization.Bindings="AutomationProperties.Name=FilePreviewImageZoomIn.[using:Microsoft.UI.Xaml.Automation]AutomationProperties.Name;ToolTipService.ToolTip=FilePreviewImageZoomIn.[using:Microsoft.UI.Xaml.Controls]ToolTipService.ToolTip"
                            x:Name="ImageZoomInButton"
                            Click="ImageZoomIn_Click">
                            <FontIcon Glyph="&#xE8A3;" />
                        </AppBarButton>
                        <AppBarButton x:Uid="FilePreviewImageFit" desktop:DesktopLocalization.Bindings="AutomationProperties.Name=FilePreviewImageFit.[using:Microsoft.UI.Xaml.Automation]AutomationProperties.Name;ToolTipService.ToolTip=FilePreviewImageFit.[using:Microsoft.UI.Xaml.Controls]ToolTipService.ToolTip" Click="ImageFit_Click">
                            <FontIcon Glyph="&#xE91B;" />
                        </AppBarButton>
                        <AppBarSeparator />
                        <AppBarButton x:Uid="FilePreviewImageRotateLeft" desktop:DesktopLocalization.Bindings="AutomationProperties.Name=FilePreviewImageRotateLeft.[using:Microsoft.UI.Xaml.Automation]AutomationProperties.Name;ToolTipService.ToolTip=FilePreviewImageRotateLeft.[using:Microsoft.UI.Xaml.Controls]ToolTipService.ToolTip" Click="ImageRotateLeft_Click">
                            <FontIcon Glyph="&#xE7AD;" />
                        </AppBarButton>
                        <AppBarButton x:Uid="FilePreviewImageRotateRight" desktop:DesktopLocalization.Bindings="AutomationProperties.Name=FilePreviewImageRotateRight.[using:Microsoft.UI.Xaml.Automation]AutomationProperties.Name;ToolTipService.ToolTip=FilePreviewImageRotateRight.[using:Microsoft.UI.Xaml.Controls]ToolTipService.ToolTip" Click="ImageRotateRight_Click">
                            <FontIcon Glyph="&#xE7AD;" RenderTransformOrigin="0.5,0.5">
                                <FontIcon.RenderTransform>
                                    <ScaleTransform ScaleX="-1" />
                                </FontIcon.RenderTransform>
                            </FontIcon>
                        </AppBarButton>
                    </CommandBar>
                </Grid>

                <Grid x:Name="PdfPreview" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <ScrollViewer ZoomMode="Enabled" MinZoomFactor="0.5" MaxZoomFactor="4">
                        <Image x:Name="PdfPageImage" Stretch="Uniform" />
                    </ScrollViewer>
                    <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" Spacing="8">
                        <Button
                            x:Uid="FilePreviewPdfPrevious" desktop:DesktopLocalization.Bindings="AutomationProperties.Name=FilePreviewPdfPrevious.AutomationProperties.Name;Content=FilePreviewPdfPrevious.Content"
                            x:Name="PreviousPdfPage"
                            Click="PreviousPdfPage_Click"
                            MinWidth="44"
                            MinHeight="44" />
                        <TextBlock x:Name="PdfPageText" VerticalAlignment="Center" />
                        <Button
                            x:Uid="FilePreviewPdfNext" desktop:DesktopLocalization.Bindings="AutomationProperties.Name=FilePreviewPdfNext.AutomationProperties.Name;Content=FilePreviewPdfNext.Content"
                            x:Name="NextPdfPage"
                            Click="NextPdfPage_Click"
                            MinWidth="44"
                            MinHeight="44" />
                    </StackPanel>
                </Grid>

                <MediaPlayerElement
                    x:Name="MediaPreview"
                    AreTransportControlsEnabled="True"
                    AutoPlay="False"
                    Stretch="Uniform"
                    Visibility="Collapsed" />
            </Grid>
        </Grid>
    </Grid>
</UserControl>
