<UserControl x:Class="LanStash.App.Views.NasDiskTestsDialogContent"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:local="using:LanStash.App.Views">
 <ScrollViewer MaxHeight="550" HorizontalScrollBarVisibility="Disabled">
  <StackPanel MinWidth="340" MaxWidth="560" Spacing="12">
   <ProgressRing x:Name="LoadingIndicator" Width="32" Height="32" Visibility="Collapsed"/>
   <InfoBar x:Name="ErrorNotice" IsOpen="False" IsClosable="False" Severity="Error" AutomationProperties.LiveSetting="Polite"/>
   <InfoBar x:Name="FeedbackNotice" IsOpen="False" IsClosable="False" AutomationProperties.LiveSetting="Polite"/>
   <InfoBar x:Name="PendingNotice" IsOpen="False" IsClosable="False" Severity="Warning"/>
   <TextBlock x:Name="ReadOnlyNotice" x:Uid="NasServiceReadOnly" TextWrapping="Wrap"/>
   <TextBox x:Name="SearchInput" x:Uid="NasDiskSearch" TextChanged="Search_Changed"/>
   <TextBlock x:Name="EmptyNotice" TextWrapping="Wrap" Visibility="Collapsed"/>
   <ListView x:Name="DiskList" x:Uid="NasDiskList" MaxHeight="170" SelectionMode="Single" SelectionChanged="Selection_Changed">
    <ListView.ItemTemplate><DataTemplate x:DataType="local:NasDiskRow">
     <StackPanel Padding="0,6" Spacing="3"><TextBlock Text="{x:Bind Name}" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock Text="{x:Bind Detail}" TextWrapping="Wrap"/></StackPanel>
    </DataTemplate></ListView.ItemTemplate>
   </ListView>
   <TextBlock x:Name="UnsupportedNotice" x:Uid="NasDiskNoSupport" Visibility="Collapsed" TextWrapping="Wrap"/>
   <StackPanel x:Name="StatePanel" Visibility="Collapsed" Spacing="6">
    <TextBlock x:Name="StateText" FontWeight="SemiBold" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/>
    <TextBlock x:Name="ProgressText" TextWrapping="Wrap"/>
    <TextBlock x:Name="ResultText" TextWrapping="Wrap"/>
   </StackPanel>
   <ItemsControl><ItemsControl.ItemsPanel><ItemsPanelTemplate><ItemsWrapGrid Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
    <Button x:Name="RefreshButton" x:Uid="NasDiskRefresh" Click="Refresh_Click" Margin="0,0,8,8"/>
    <Button x:Name="HistoryButton" x:Uid="NasDiskHistory" Click="History_Click" Margin="0,0,8,8"/>
    <Button x:Name="QuickButton" x:Uid="NasDiskQuick" Click="Quick_Click" Margin="0,0,8,8"/>
    <Button x:Name="ExtendedButton" x:Uid="NasDiskExtended" Click="Extended_Click" Margin="0,0,8,8"/>
    <Button x:Name="StopButton" x:Uid="NasDiskStop" Click="Stop_Click" Margin="0,0,8,8"/>
   </ItemsControl>
   <StackPanel x:Name="ConfirmationPanel" Visibility="Collapsed" Spacing="10">
    <TextBlock x:Name="ConfirmationText" TextWrapping="Wrap"/>
    <CheckBox x:Name="RiskAcknowledgement" x:Uid="NasDiskConfirm" Checked="Confirm_Changed" Unchecked="Confirm_Changed">
     <CheckBox.ContentTemplate><DataTemplate><TextBlock Text="{Binding}" TextWrapping="Wrap"/></DataTemplate></CheckBox.ContentTemplate>
    </CheckBox>
    <Button x:Name="ExecuteButton" Click="Execute_Click"/>
   </StackPanel>
   <InfoBar x:Name="HistoryErrorNotice" IsOpen="False" IsClosable="False" Severity="Warning"/>
   <StackPanel x:Name="HistoryPanel" Visibility="Collapsed" Spacing="8">
    <TextBlock x:Uid="NasDiskHistoryTitle" FontWeight="SemiBold"/>
    <TextBlock x:Name="EmptyHistory" x:Uid="NasDiskNoHistory" TextWrapping="Wrap" Visibility="Collapsed"/>
    <TextBlock x:Name="TruncatedHistory" x:Uid="NasDiskTruncated" TextWrapping="Wrap" Visibility="Collapsed"/>
    <ItemsControl x:Name="HistoryList">
     <ItemsControl.ItemTemplate><DataTemplate x:DataType="local:NasDiskHistoryRow"><TextBlock Text="{x:Bind Text}" TextWrapping="Wrap" Margin="0,6"/></DataTemplate></ItemsControl.ItemTemplate>
    </ItemsControl>
   </StackPanel>
  </StackPanel>
 </ScrollViewer>
</UserControl>
