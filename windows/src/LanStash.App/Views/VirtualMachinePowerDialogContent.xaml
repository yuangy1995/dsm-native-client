<UserControl x:Class="LanStash.App.Views.VirtualMachinePowerDialogContent"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <ScrollViewer MaxHeight="520" HorizontalScrollBarVisibility="Disabled">
  <StackPanel MinWidth="340" MaxWidth="520" Spacing="12">
   <TextBlock x:Name="TargetName" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap"/>
   <TextBlock x:Name="RiskHint" TextWrapping="Wrap"/>
   <TextBlock x:Name="ReadOnlyNotice" x:Uid="VmPowerReadOnly" TextWrapping="Wrap"/>
   <ProgressRing x:Name="BusyIndicator" Width="30" Height="30" Visibility="Collapsed"/>
   <InfoBar x:Name="ErrorNotice" IsOpen="False" IsClosable="False" Severity="Error" AutomationProperties.LiveSetting="Polite"/>
   <InfoBar x:Name="FeedbackNotice" IsOpen="False" IsClosable="False" AutomationProperties.LiveSetting="Polite"/>
   <CheckBox x:Name="RiskAcknowledgement" x:Uid="VmPowerAcknowledgement" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Checked="Confirm_Changed" Unchecked="Confirm_Changed"/>
  </StackPanel>
 </ScrollViewer>
</UserControl>
