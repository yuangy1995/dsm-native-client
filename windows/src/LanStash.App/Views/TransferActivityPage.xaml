<Page
    x:Class="LanStash.App.Views.TransferActivityPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
    <Grid Padding="28,20,28,28" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Spacing="4">
            <TextBlock x:Uid="TransferActivityTitle" Style="{StaticResource TitleTextBlockStyle}" />
            <TextBlock
                x:Uid="TransferActivityDescription"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                TextWrapping="Wrap" />
        </StackPanel>

        <ListView
            x:Uid="TransferActivityList"
            x:Name="ActivityList"
            Grid.Row="1"
            SelectionMode="None">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Grid MinHeight="88" Padding="12" ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="6">
                            <TextBlock FontWeight="SemiBold" Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis" />
                            <TextBlock
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="{Binding DirectionText}" />
                            <ProgressBar
                                x:Uid="TransferActivityProgressBar"
                                Height="4"
                                IsIndeterminate="{Binding IsIndeterminate}"
                                Maximum="{Binding Maximum}"
                                Value="{Binding Value}" />
                            <TextBlock
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="{Binding StatusText}"
                                TextWrapping="Wrap" />
                        </StackPanel>
                        <Button
                            x:Uid="TransferActivityCancel"
                            Grid.Column="1"
                            MinHeight="44"
                            AutomationProperties.Name="{Binding CancelAutomationName}"
                            Click="Cancel_Click"
                            Tag="{Binding Activity}"
                            Visibility="{Binding CancelVisibility}" />
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <StackPanel
            x:Name="EmptyState"
            Grid.Row="1"
            MaxWidth="420"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Spacing="10">
            <FontIcon FontSize="38" Glyph="&#xE898;" />
            <TextBlock x:Uid="TransferActivityEmptyTitle" Style="{StaticResource SubtitleTextBlockStyle}" TextAlignment="Center" />
            <TextBlock x:Uid="TransferActivityEmptyMessage" TextAlignment="Center" TextWrapping="Wrap" />
        </StackPanel>
    </Grid>
</Page>
