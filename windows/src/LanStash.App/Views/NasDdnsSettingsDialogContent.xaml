<UserControl x:Class="LanStash.App.Views.NasDdnsSettingsDialogContent"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:LanStash.App.Views">
  <ScrollViewer MaxHeight="540" VerticalScrollBarVisibility="Auto">
  <StackPanel MinWidth="320" MaxWidth="520" Spacing="12">
    <ProgressRing x:Name="LoadingIndicator" Width="32" Height="32" IsActive="False" Visibility="Collapsed"/>
    <InfoBar x:Name="StatusNotice" IsOpen="False" IsClosable="False" Severity="Warning" AutomationProperties.LiveSetting="Polite"/>
    <InfoBar x:Name="FeedbackNotice" IsOpen="False" IsClosable="False" AutomationProperties.LiveSetting="Polite"/>
    <TextBlock x:Name="ReadOnlyNotice" x:Uid="NasServiceReadOnly" TextWrapping="Wrap"/>
    <StackPanel x:Name="ActionToolbar" Orientation="Horizontal" Spacing="6">
      <Button x:Name="CreateButton" x:Uid="NasDdnsCreate" Click="Create_Click"/>
      <Button x:Name="EditButton" x:Uid="NasDdnsEdit" Click="Edit_Click"/>
      <Button x:Name="DeleteButton" x:Uid="NasDdnsDelete" Click="Delete_Click"/>
      <Button x:Name="UpdateButton" x:Uid="NasDdnsUpdate" Click="Update_Click"/>
    </StackPanel>
    <Expander x:Uid="NasDdnsProviders" HorizontalAlignment="Stretch">
      <ScrollViewer MaxHeight="140">
        <ItemsControl x:Name="ProviderList"><ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding Name}" TextWrapping="Wrap"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
      </ScrollViewer>
    </Expander>
    <TextBlock x:Name="EmptyNotice" Visibility="Collapsed" TextWrapping="Wrap"/>
    <ListView x:Name="RecordList" SelectionMode="Single" MaxHeight="180" SelectionChanged="Record_Changed">
      <ListView.ItemContainerStyle><Style TargetType="ListViewItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/></Style></ListView.ItemContainerStyle>
      <ListView.ItemTemplate>
        <DataTemplate x:DataType="local:NasDdnsSettingsRow">
          <StackPanel Spacing="6" Padding="0,8">
            <TextBlock Text="{x:Bind Title}" FontWeight="SemiBold" TextWrapping="Wrap"/>
            <TextBlock Text="{x:Bind Details}" TextWrapping="Wrap"/>
            <TextBlock Text="{x:Bind State}" TextWrapping="Wrap"/>
          </StackPanel>
        </DataTemplate>
      </ListView.ItemTemplate>
    </ListView>
    <StackPanel x:Name="EditorPanel" Visibility="Collapsed" Spacing="8">
      <ComboBox x:Name="ProviderChoice" x:Uid="NasDdnsProvider" DisplayMemberPath="Name" HorizontalAlignment="Stretch" SelectionChanged="Provider_Changed"/>
      <TextBox x:Name="HostnameInput" x:Uid="NasDdnsHostname" TextChanged="Text_Changed"/>
      <TextBox x:Name="UsernameInput" x:Uid="NasDdnsUsername" TextChanged="Text_Changed"/>
      <PasswordBox x:Name="PasswordInput" x:Uid="NasDdnsPassword" PasswordChanged="Password_Changed"/>
      <TextBlock x:Name="PasswordNotice" x:Uid="NasDdnsPasswordNotice" TextWrapping="Wrap"/>
      <StackPanel Orientation="Horizontal" Spacing="16">
        <CheckBox x:Name="EnabledInput" x:Uid="NasDdnsEnabled" Checked="Fields_Changed" Unchecked="Fields_Changed"/>
        <CheckBox x:Name="HeartbeatInput" x:Uid="NasDdnsHeartbeat" Checked="Fields_Changed" Unchecked="Fields_Changed"/>
      </StackPanel>
      <StackPanel Orientation="Horizontal" Spacing="8">
        <Button x:Name="SaveChoiceButton" x:Uid="NasDdnsSaveChoice" Click="SaveChoice_Click"/>
        <Button x:Name="TestButton" x:Uid="NasDdnsTestChoice" Click="TestChoice_Click"/>
        <Button x:Name="CancelEditButton" x:Uid="NasDdnsCancelEdit" Click="CancelEdit_Click"/>
      </StackPanel>
    </StackPanel>
    <StackPanel x:Name="ConfirmationPanel" Visibility="Collapsed" Spacing="8">
      <TextBlock x:Name="ConfirmationText" TextWrapping="Wrap"/>
      <TextBlock x:Name="ValidationNotice" TextWrapping="Wrap" Visibility="Collapsed"/>
      <CheckBox x:Name="RiskAcknowledgement" x:Uid="NasDdnsConfirm" Checked="Risk_Changed" Unchecked="Risk_Changed"/>
      <Button x:Name="ActionButton" Click="Execute_Click"/>
    </StackPanel>
  </StackPanel>
  </ScrollViewer>
</UserControl>
