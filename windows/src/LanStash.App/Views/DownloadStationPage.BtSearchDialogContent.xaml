<UserControl
    x:Class="LanStash.App.Views.DownloadStationBtSearchDialogContent"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:desktop="using:LanStash.App.Presentation"
    xmlns:downloads="using:LanStash.App.Features.Downloads">
    <ScrollViewer
        HorizontalContentAlignment="Stretch"
        HorizontalScrollBarVisibility="Disabled"
        HorizontalScrollMode="Disabled"
        VerticalScrollBarVisibility="Auto"
        VerticalScrollMode="Auto">
        <Grid x:Name="DialogLayout" RowSpacing="12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <VisualStateManager.VisualStateGroups>
                <VisualStateGroup>
                    <VisualState x:Name="NarrowDialogLayout">
                        <VisualState.StateTriggers>
                            <AdaptiveTrigger MinWindowWidth="0" />
                        </VisualState.StateTriggers>
                    </VisualState>
                    <VisualState x:Name="WideDialogLayout">
                        <VisualState.StateTriggers>
                            <AdaptiveTrigger MinWindowWidth="900" />
                        </VisualState.StateTriggers>
                        <VisualState.Setters>
                            <Setter Target="KeywordBox.(Grid.ColumnSpan)" Value="1" />
                            <Setter Target="TitleFilterBox.(Grid.Row)" Value="0" />
                            <Setter Target="TitleFilterBox.(Grid.Column)" Value="1" />
                            <Setter Target="TitleFilterBox.(Grid.ColumnSpan)" Value="1" />
                            <Setter Target="ModuleScopePicker.(Grid.ColumnSpan)" Value="1" />
                            <Setter Target="CategoryPicker.(Grid.Row)" Value="0" />
                            <Setter Target="CategoryPicker.(Grid.Column)" Value="1" />
                            <Setter Target="CategoryPicker.(Grid.ColumnSpan)" Value="1" />
                            <Setter Target="SortPicker.(Grid.Row)" Value="1" />
                            <Setter Target="SortPicker.(Grid.ColumnSpan)" Value="1" />
                            <Setter Target="DirectionPicker.(Grid.Row)" Value="1" />
                            <Setter Target="DirectionPicker.(Grid.Column)" Value="1" />
                            <Setter Target="DirectionPicker.(Grid.ColumnSpan)" Value="1" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>

        <StackPanel Spacing="8">
            <Grid x:Name="SearchTextGrid" ColumnSpacing="12" RowSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBox
                    x:Uid="DownloadStationBtSearchKeyword" desktop:DesktopLocalization.Bindings="Description=DownloadStationBtSearchKeyword.Description;Header=DownloadStationBtSearchKeyword.Header;PlaceholderText=DownloadStationBtSearchKeyword.PlaceholderText;AutomationProperties.Name=DownloadStationBtSearchKeyword.[using:Microsoft.UI.Xaml.Automation]AutomationProperties.Name"
                    x:Name="KeywordBox"
                    Grid.ColumnSpan="2"
                    IsEnabled="{Binding CanEditBtSearchCriteria}"
                    MaxLength="200"
                    MinHeight="48"
                    TextWrapping="Wrap"
                    TextChanged="KeywordBox_TextChanged" />
                <TextBox
                    x:Uid="DownloadStationBtSearchTitleFilter" desktop:DesktopLocalization.Bindings="Description=DownloadStationBtSearchTitleFilter.Description;Header=DownloadStationBtSearchTitleFilter.Header;PlaceholderText=DownloadStationBtSearchTitleFilter.PlaceholderText;AutomationProperties.Name=DownloadStationBtSearchTitleFilter.[using:Microsoft.UI.Xaml.Automation]AutomationProperties.Name"
                    x:Name="TitleFilterBox"
                    Grid.Row="1"
                    Grid.ColumnSpan="2"
                    IsEnabled="{Binding CanEditBtSearchCriteria}"
                    MaxLength="200"
                    MinHeight="48"
                    TextWrapping="Wrap"
                    TextChanged="TitleFilterBox_TextChanged" />
            </Grid>
            <InfoBar
                x:Uid="DownloadStationBtSearchPrivacy" desktop:DesktopLocalization.Bindings="Message=DownloadStationBtSearchPrivacy.Message;Title=DownloadStationBtSearchPrivacy.Title"
                IsClosable="False"
                IsOpen="True"
                Severity="Informational" />
        </StackPanel>

        <StackPanel
            x:Name="FiltersPanel"
            Grid.Row="1"
            Spacing="8"
            Visibility="Collapsed">
            <Grid x:Name="FilterGrid" ColumnSpacing="12" RowSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <ComboBox
                    x:Uid="DownloadStationBtSearchModuleScope" desktop:DesktopLocalization.Bindings="Header=DownloadStationBtSearchModuleScope.Header;AutomationProperties.Name=DownloadStationBtSearchModuleScope.[using:Microsoft.UI.Xaml.Automation]AutomationProperties.Name"
                    x:Name="ModuleScopePicker"
                    Grid.ColumnSpan="2"
                    IsEnabled="{Binding CanEditBtSearchCriteria}"
                    MinHeight="48"
                    DisplayMemberPath="Title"
                    ItemsSource="{Binding BtSearchModuleScopeOptions}"
                    SelectionChanged="ModuleScopePicker_SelectionChanged" />
                <ComboBox
                    x:Uid="DownloadStationBtSearchCategory" desktop:DesktopLocalization.Bindings="Header=DownloadStationBtSearchCategory.Header;AutomationProperties.Name=DownloadStationBtSearchCategory.[using:Microsoft.UI.Xaml.Automation]AutomationProperties.Name"
                    x:Name="CategoryPicker"
                    Grid.Row="1"
                    Grid.ColumnSpan="2"
                    IsEnabled="{Binding CanEditBtSearchCriteria}"
                    MinHeight="48"
                    DisplayMemberPath="Title"
                    ItemsSource="{Binding BtSearchCategories}"
                    SelectionChanged="CategoryPicker_SelectionChanged" />
                <ComboBox
                    x:Uid="DownloadStationBtSearchSort" desktop:DesktopLocalization.Bindings="Header=DownloadStationBtSearchSort.Header;AutomationProperties.Name=DownloadStationBtSearchSort.[using:Microsoft.UI.Xaml.Automation]AutomationProperties.Name"
                    x:Name="SortPicker"
                    Grid.Row="2"
                    Grid.ColumnSpan="2"
                    IsEnabled="{Binding CanEditBtSearchCriteria}"
                    MinHeight="48"
                    DisplayMemberPath="Title"
                    ItemsSource="{Binding BtSearchSortOptions}"
                    SelectionChanged="SortPicker_SelectionChanged" />
                <ComboBox
                    x:Uid="DownloadStationBtSearchDirection" desktop:DesktopLocalization.Bindings="Header=DownloadStationBtSearchDirection.Header;AutomationProperties.Name=DownloadStationBtSearchDirection.[using:Microsoft.UI.Xaml.Automation]AutomationProperties.Name"
                    x:Name="DirectionPicker"
                    Grid.Row="3"
                    Grid.ColumnSpan="2"
                    IsEnabled="{Binding CanEditBtSearchCriteria}"
                    MinHeight="48"
                    DisplayMemberPath="Title"
                    ItemsSource="{Binding BtSearchDirectionOptions}"
                    SelectionChanged="DirectionPicker_SelectionChanged" />
            </Grid>

            <StackPanel x:Name="SelectedModulesPanel" Spacing="4" Visibility="Collapsed">
                <TextBlock
                    x:Uid="DownloadStationBtSearchSelectedModulesLabel" desktop:DesktopLocalization.Bindings="Text=DownloadStationBtSearchSelectedModulesLabel.Text"
                    FontWeight="SemiBold" />
                <ListView
                    x:Uid="DownloadStationBtSearchModuleList" desktop:DesktopLocalization.Bindings="AutomationProperties.Name=DownloadStationBtSearchModuleList.[using:Microsoft.UI.Xaml.Automation]AutomationProperties.Name"
                    x:Name="ModuleList"
                    MaxHeight="120"
                    IsEnabled="{Binding CanEditBtSearchCriteria}"
                    ItemsSource="{Binding BtSearchModules}"
                    SelectionChanged="ModuleList_SelectionChanged"
                    SelectionMode="Multiple">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="MinHeight" Value="48" />
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="downloads:DownloadBtSearchModuleOption">
                            <TextBlock Text="{x:Bind Title}" TextWrapping="Wrap" />
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
                <TextBlock
                    x:Uid="DownloadStationBtSearchModuleSelectionRequired" desktop:DesktopLocalization.Bindings="Text=DownloadStationBtSearchModuleSelectionRequired.Text"
                    x:Name="ModuleSelectionRequired"
                    AutomationProperties.LiveSetting="Polite"
                    Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                    TextWrapping="Wrap"
                    Visibility="Collapsed" />
            </StackPanel>
        </StackPanel>

        <Grid Grid.Row="2" MinHeight="240">
            <StackPanel
                x:Name="BtSearchLoadingState"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Spacing="12">
                <ProgressRing
                    x:Uid="DownloadStationBtSearchLoadingProgress" desktop:DesktopLocalization.Bindings="AutomationProperties.Name=DownloadStationBtSearchLoadingProgress.[using:Microsoft.UI.Xaml.Automation]AutomationProperties.Name"
                    Width="40"
                    Height="40"
                    IsActive="True" />
                <TextBlock
                    x:Uid="DownloadStationBtSearchLoading" desktop:DesktopLocalization.Bindings="Text=DownloadStationBtSearchLoading.Text"
                    AutomationProperties.LiveSetting="Polite"
                    TextAlignment="Center"
                    TextWrapping="Wrap" />
                <Button
                    x:Uid="DownloadStationBtSearchCancel" desktop:DesktopLocalization.Bindings="Content=DownloadStationBtSearchCancel.Content;AutomationProperties.Name=DownloadStationBtSearchCancel.[using:Microsoft.UI.Xaml.Automation]AutomationProperties.Name"
                    MinHeight="48"
                    Click="CancelSearch_Click" />
            </StackPanel>

            <StackPanel
                x:Name="BtSearchReadyState"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                MaxWidth="440"
                Spacing="8"
                Visibility="Collapsed">
                <FontIcon Glyph="&#xE721;" FontSize="40" />
                <TextBlock
                    x:Uid="DownloadStationBtSearchReadyTitle" desktop:DesktopLocalization.Bindings="Text=DownloadStationBtSearchReadyTitle.Text"
                    AutomationProperties.HeadingLevel="Level2"
                    Style="{ThemeResource SubtitleTextBlockStyle}"
                    TextAlignment="Center" />
                <TextBlock
                    x:Uid="DownloadStationBtSearchReadyMessage" desktop:DesktopLocalization.Bindings="Text=DownloadStationBtSearchReadyMessage.Text"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    TextAlignment="Center"
                    TextWrapping="Wrap" />
            </StackPanel>

            <StackPanel
                x:Name="BtSearchEmptyState"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                MaxWidth="440"
                Spacing="8"
                Visibility="Collapsed">
                <TextBlock
                    x:Uid="DownloadStationBtSearchEmptyTitle" desktop:DesktopLocalization.Bindings="Text=DownloadStationBtSearchEmptyTitle.Text"
                    AutomationProperties.LiveSetting="Polite"
                    Style="{ThemeResource SubtitleTextBlockStyle}"
                    TextAlignment="Center" />
                <TextBlock
                    x:Uid="DownloadStationBtSearchEmptyMessage" desktop:DesktopLocalization.Bindings="Text=DownloadStationBtSearchEmptyMessage.Text"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    TextAlignment="Center"
                    TextWrapping="Wrap" />
            </StackPanel>

            <StackPanel
                x:Name="BtSearchNoProvidersState"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                MaxWidth="440"
                Spacing="8"
                Visibility="Collapsed">
                <TextBlock
                    x:Uid="DownloadStationBtSearchNoProvidersTitle" desktop:DesktopLocalization.Bindings="Text=DownloadStationBtSearchNoProvidersTitle.Text"
                    AutomationProperties.HeadingLevel="Level2"
                    AutomationProperties.LiveSetting="Polite"
                    Style="{ThemeResource SubtitleTextBlockStyle}"
                    TextAlignment="Center" />
                <TextBlock
                    x:Uid="DownloadStationBtSearchNoProvidersMessage" desktop:DesktopLocalization.Bindings="Text=DownloadStationBtSearchNoProvidersMessage.Text"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    TextAlignment="Center"
                    TextWrapping="Wrap" />
                <Button
                    x:Uid="DownloadStationBtSearchReloadProviders" desktop:DesktopLocalization.Bindings="Content=DownloadStationBtSearchReloadProviders.Content;AutomationProperties.Name=DownloadStationBtSearchReloadProviders.[using:Microsoft.UI.Xaml.Automation]AutomationProperties.Name"
                    MinHeight="48"
                    Click="Retry_Click" />
            </StackPanel>

            <StackPanel
                x:Name="BtSearchFilteredEmptyState"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                MaxWidth="440"
                Spacing="8"
                Visibility="Collapsed">
                <TextBlock
                    x:Uid="DownloadStationBtSearchFilteredEmptyTitle" desktop:DesktopLocalization.Bindings="Text=DownloadStationBtSearchFilteredEmptyTitle.Text"
                    AutomationProperties.LiveSetting="Polite"
                    Style="{ThemeResource SubtitleTextBlockStyle}"
                    TextAlignment="Center" />
                <TextBlock
                    x:Uid="DownloadStationBtSearchFilteredEmptyMessage" desktop:DesktopLocalization.Bindings="Text=DownloadStationBtSearchFilteredEmptyMessage.Text"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    TextAlignment="Center"
                    TextWrapping="Wrap" />
            </StackPanel>

            <StackPanel
                x:Name="BtSearchErrorState"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                MaxWidth="440"
                Spacing="8"
                Visibility="Collapsed">
                <TextBlock
                    x:Uid="DownloadStationBtSearchErrorTitle" desktop:DesktopLocalization.Bindings="Text=DownloadStationBtSearchErrorTitle.Text"
                    AutomationProperties.LiveSetting="Assertive"
                    Style="{ThemeResource SubtitleTextBlockStyle}"
                    TextAlignment="Center" />
                <TextBlock
                    x:Uid="DownloadStationBtSearchErrorMessage" desktop:DesktopLocalization.Bindings="Text=DownloadStationBtSearchErrorMessage.Text"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    TextAlignment="Center"
                    TextWrapping="Wrap" />
                <Button
                    x:Uid="DownloadStationBtSearchRetry" desktop:DesktopLocalization.Bindings="Content=DownloadStationBtSearchRetry.Content;AutomationProperties.Name=DownloadStationBtSearchRetry.[using:Microsoft.UI.Xaml.Automation]AutomationProperties.Name"
                    MinHeight="48"
                    Click="Retry_Click" />
            </StackPanel>

            <Grid x:Name="BtSearchContentState" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TextBlock
                    x:Uid="DownloadStationBtSearchResultsTitle" desktop:DesktopLocalization.Bindings="Text=DownloadStationBtSearchResultsTitle.Text"
                    AutomationProperties.HeadingLevel="Level2"
                    FontWeight="SemiBold" />
                <ListView
                    x:Uid="DownloadStationBtSearchResultList" desktop:DesktopLocalization.Bindings="AutomationProperties.Name=DownloadStationBtSearchResultList.[using:Microsoft.UI.Xaml.Automation]AutomationProperties.Name"
                    x:Name="ResultList"
                    Grid.Row="1"
                    MaxHeight="360"
                    ItemsSource="{Binding BtSearchResults}"
                    SelectionChanged="ResultList_SelectionChanged"
                    SelectionMode="Single">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="MinHeight" Value="72" />
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="downloads:DownloadBtSearchResultItem">
                            <StackPanel
                                Padding="4,8"
                                Spacing="4"
                                AutomationProperties.Name="{x:Bind AutomationName}">
                                <TextBlock
                                    FontWeight="SemiBold"
                                    MaxLines="2"
                                    Text="{x:Bind Title}"
                                    TextTrimming="CharacterEllipsis"
                                    TextWrapping="Wrap" />
                                <TextBlock
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Text="{x:Bind MetadataText}"
                                    TextWrapping="Wrap" />
                            </StackPanel>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>
            </Grid>
        </Grid>
    </ScrollViewer>
</UserControl>
