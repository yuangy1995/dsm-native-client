<Page xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:domain="using:LanStash.Domain" x:Class="LanStash.App.Views.LoginPage" SizeChanged="LoginPage_SizeChanged" Loaded="LoginPage_Loaded" Unloaded="LoginPage_Unloaded" Background="{ThemeResource WorkspaceBackgroundBrush}">
  <Grid Padding="0,0,12,12">
    <Grid.ColumnDefinitions>
      <ColumnDefinition x:Name="DeviceColumn" Width="241"/>
      <ColumnDefinition Width="8"/>
      <ColumnDefinition Width="*"/>
    </Grid.ColumnDefinitions>
    <Grid Padding="14,18,14,0">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>
      <TextBlock x:Uid="WorkspaceSavedDevices" Margin="6,0,0,18" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
      <ListView x:Uid="SavedNasList" x:Name="ProfileList" ItemsSource="{Binding Profiles}" SelectionChanged="ProfileList_SelectionChanged" Grid.Row="1">
        <ListView.ItemTemplate>
          <DataTemplate x:DataType="domain:NasProfile">
            <Border CornerRadius="12" Background="{ThemeResource SubtleFillColorSecondaryBrush}" Margin="0,4" MinHeight="70">
              <Grid Padding="8,14">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="40"/>
                  <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <FontIcon VerticalAlignment="Center" FontSize="20" Glyph=""/>
                <StackPanel Grid.Column="1">
                  <TextBlock FontWeight="SemiBold" Text="{x:Bind DisplayName}" FontSize="16"/>
                  <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{x:Bind Host}"/>
                </StackPanel>
              </Grid>
            </Border>
          </DataTemplate>
        </ListView.ItemTemplate>
      </ListView>
      <StackPanel Grid.Row="2" Spacing="10" Padding="0,12">
        <Button x:Uid="AddNasButton" x:Name="AddNasButton" HorizontalAlignment="Stretch" Click="NewProfile_Click"/>
        <StackPanel Spacing="6">
          <TextBlock x:Name="LanguageLabel" FontWeight="SemiBold" Visibility="Collapsed"/>
          <ComboBox x:Name="LanguageSelector" HorizontalAlignment="Stretch" DisplayMemberPath="DisplayName" SelectionChanged="LanguageSelector_SelectionChanged"/>
          <TextBlock x:Name="LanguageNote" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" Visibility="Collapsed"/>
        </StackPanel>
      </StackPanel>
    </Grid>
    <Border Grid.Column="2" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Padding="24" Background="{ThemeResource WorkspaceSurfaceBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="16">
      <Grid x:Name="LoginForm" MaxWidth="560" HorizontalAlignment="Stretch" VerticalAlignment="Top" Margin="12,8" RowSpacing="16">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <StackPanel Orientation="Horizontal" Spacing="14">
            <Image Width="48" Height="48" AutomationProperties.AccessibilityView="Raw" Source="ms-appx:///Assets/AppIcon.png" Stretch="UniformToFill"/>
            <StackPanel VerticalAlignment="Center">
              <TextBlock x:Uid="BrandTitle" FontSize="28"/>
              <TextBlock x:Uid="BrandSubtitle" Margin="0,4,0,0" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Visibility="Collapsed"/>
            </StackPanel>
          </StackPanel>
          <ScrollViewer x:Name="FieldsScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalContentAlignment="Stretch">
          <Border Padding="14" VerticalAlignment="Top" CornerRadius="10" BorderThickness="1" BorderBrush="{ThemeResource WorkspaceEdgeBrush}" Background="{ThemeResource SubtleFillColorSecondaryBrush}">
            <StackPanel x:Name="ConnectionFields" Spacing="8">
              <TextBox x:Uid="ProfileNameInput" Text="{Binding DisplayName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" MinHeight="36" CornerRadius="10"/>
              <TextBox x:Uid="NasAddressInput" Text="{Binding Host, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" MinHeight="36" CornerRadius="10"/>
              <TextBox x:Uid="UsernameInput" Text="{Binding Username, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" MinHeight="36" CornerRadius="10"/>
              <PasswordBox x:Uid="PasswordInput" x:Name="PasswordInput" PasswordChanged="PasswordInput_Changed" PasswordRevealMode="Peek" MinHeight="36" CornerRadius="10"/>
              <StackPanel Orientation="Horizontal" Spacing="18">
                <CheckBox x:Uid="RememberPasswordCheckBox" IsChecked="{Binding RememberPassword, Mode=TwoWay}"/>
                <CheckBox x:Uid="AutoLoginCheckBox" IsChecked="{Binding AutoLogin, Mode=TwoWay}"/>
              </StackPanel>
              <TextBlock x:Uid="PasswordProtectionNote" Margin="28,-14,0,0" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" Visibility="Collapsed"/>
              <TextBlock x:Uid="AutoLoginNote" Margin="28,-14,0,0" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" Visibility="Collapsed"/>
              <Expander x:Uid="AdvancedConnectionExpander" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                <StackPanel Padding="0,10,0,0" Spacing="6">
              <PasswordBox x:Uid="OtpInput" x:Name="OtpInput" PasswordRevealMode="Peek" MinHeight="36" CornerRadius="10"/>
                  <TextBox x:Uid="CustomPortInput" InputScope="Number" Text="{Binding Port, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                  <TextBlock x:Uid="CustomPortNote" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/>
                </StackPanel>
              </Expander>
            </StackPanel>
          </Border>
          </ScrollViewer>
          <StackPanel x:Name="LoginActions" Grid.Row="2" Spacing="12">
          <InfoBar x:Name="ErrorBar" IsClosable="False" IsOpen="False" Message="{Binding ErrorMessage}" Severity="Error" Visibility="Collapsed"/>
          <InfoBar x:Name="StatusBar" IsClosable="False" IsOpen="False" Message="{Binding ConnectionStatus}" Severity="Informational" Visibility="Collapsed"/>
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <ProgressRing x:Name="BusyIndicator" Grid.Column="1" HorizontalAlignment="Left" Margin="12,0" Width="24" Height="24" VerticalAlignment="Center" IsActive="False"/>
            <Button x:Uid="CancelConnectButton" x:Name="CancelConnectButton" Grid.Column="1" MinWidth="96" MinHeight="44" Margin="12,0" HorizontalAlignment="Right" Click="CancelConnect_Click" Visibility="Collapsed"/>
            <Button x:Uid="ConnectButton" x:Name="ConnectButton" Grid.Column="0" MinWidth="140" MinHeight="44" HorizontalAlignment="Left" Click="Connect_Click" Style="{StaticResource AccentButtonStyle}" Background="{ThemeResource WorkspaceAccentBrush}" Foreground="{ThemeResource WorkspaceOnAccentBrush}"/>
          </Grid>
          </StackPanel>
      </Grid>
    </Border>
    <ContentDialog x:Name="CertificateTrustDialog" Grid.ColumnSpan="3" DefaultButton="Close" PrimaryButtonClick="CertificateTrustDialog_PrimaryButtonClick" Closing="CertificateTrustDialog_Closing">
      <ScrollViewer MaxHeight="560" VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="620" Spacing="16">
          <InfoBar x:Name="CertificateWarningBar" IsClosable="False" IsOpen="True" Severity="Warning" AutomationProperties.LiveSetting="Polite"/>
          <TextBlock x:Name="CertificateExplanation" TextWrapping="WrapWholeWords"/>
          <Grid ColumnSpacing="16" RowSpacing="10">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <TextBlock x:Name="CertificateNasLabel" FontWeight="SemiBold"/>
            <TextBlock x:Name="CertificateNasValue" Grid.Column="1" TextWrapping="WrapWholeWords"/>
            <TextBlock x:Name="CertificateAddressLabel" Grid.Row="1" FontWeight="SemiBold"/>
            <TextBlock x:Name="CertificateAddressValue" Grid.Row="1" Grid.Column="1" TextWrapping="WrapWholeWords"/>
            <TextBlock x:Name="CertificateConnectionLabel" Grid.Row="2" FontWeight="SemiBold"/>
            <TextBlock x:Name="CertificateConnectionValue" Grid.Row="2" Grid.Column="1" TextWrapping="WrapWholeWords"/>
          </Grid>
          <StackPanel x:Name="PreviousFingerprintPanel" Spacing="6">
            <TextBlock x:Name="PreviousFingerprintLabel" FontWeight="SemiBold"/>
            <TextBox x:Name="PreviousFingerprintValue" MinHeight="48" IsReadOnly="True" FontFamily="Consolas" TextWrapping="Wrap" AutomationProperties.AccessibilityView="Content"/>
          </StackPanel>
          <StackPanel Spacing="6">
            <TextBlock x:Name="PresentedFingerprintLabel" FontWeight="SemiBold"/>
            <TextBox x:Name="PresentedFingerprintValue" MinHeight="48" IsReadOnly="True" FontFamily="Consolas" TextWrapping="Wrap" AutomationProperties.AccessibilityView="Content"/>
          </StackPanel>
          <TextBlock x:Name="CertificateNextStep" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="WrapWholeWords"/>
        </StackPanel>
      </ScrollViewer>
    </ContentDialog>
  </Grid>
</Page>
