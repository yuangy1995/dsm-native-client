<UserControl x:Class="LanStash.App.Views.NasPackageSettingsDialogContent"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:LanStash.App.Views">
  <ScrollViewer MaxHeight="560">
    <StackPanel MinWidth="340" MaxWidth="560" Spacing="12">
      <ProgressRing x:Name="LoadingIndicator" Width="32" Height="32" Visibility="Collapsed" IsActive="False"/>
      <InfoBar x:Name="ErrorNotice" IsOpen="False" IsClosable="False" Severity="Error" AutomationProperties.LiveSetting="Polite"/>
      <InfoBar x:Name="FeedbackNotice" IsOpen="False" IsClosable="False" AutomationProperties.LiveSetting="Polite"/>
      <InfoBar x:Name="PendingNotice" IsOpen="False" IsClosable="False" Severity="Warning" AutomationProperties.LiveSetting="Polite"/>
      <TextBlock x:Name="ReadOnlyNotice" x:Uid="NasServiceReadOnly" TextWrapping="Wrap"/>
      <TextBox x:Name="SearchInput" x:Uid="NasPackageSearch" TextChanged="Search_Changed"/>
      <TextBlock x:Name="EmptyNotice" Visibility="Collapsed" TextWrapping="Wrap"/>
      <ListView x:Name="PackageList" SelectionMode="Single" MaxHeight="300" SelectionChanged="Selection_Changed">
        <ListView.ItemContainerStyle><Style TargetType="ListViewItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/></Style></ListView.ItemContainerStyle>
        <ListView.ItemTemplate><DataTemplate x:DataType="local:NasPackageSettingsRow">
          <StackPanel Padding="0,8" Spacing="4" AutomationProperties.Name="{x:Bind AutomationName}">
            <TextBlock Text="{x:Bind Package.Name}" FontWeight="SemiBold" TextWrapping="Wrap"/>
            <TextBlock Text="{x:Bind Detail}" TextWrapping="Wrap"/>
            <TextBlock Text="{x:Bind Status}" TextWrapping="Wrap"/>
          </StackPanel>
        </DataTemplate></ListView.ItemTemplate>
      </ListView>
      <TextBlock x:Name="UpgradeNotice" x:Uid="NasPackageUpgradeNotice" Visibility="Collapsed" TextWrapping="Wrap"/>
      <StackPanel Orientation="Horizontal" Spacing="8">
        <Button x:Name="StartButton" x:Uid="NasPackageStart" Click="Start_Click"/>
        <Button x:Name="StopButton" x:Uid="NasPackageStop" Click="Stop_Click"/>
        <Button x:Name="UninstallButton" x:Uid="NasPackageUninstall" Click="Uninstall_Click"/>
      </StackPanel>
      <StackPanel x:Name="ConfirmationPanel" Visibility="Collapsed" Spacing="8">
        <TextBlock x:Name="ConfirmationText" TextWrapping="Wrap"/>
        <CheckBox x:Name="RiskAcknowledgement" x:Uid="NasPackageConfirm" Checked="Risk_Changed" Unchecked="Risk_Changed"/>
        <Button x:Name="ExecuteButton" Click="Execute_Click"/>
      </StackPanel>
    </StackPanel>
  </ScrollViewer>
</UserControl>
