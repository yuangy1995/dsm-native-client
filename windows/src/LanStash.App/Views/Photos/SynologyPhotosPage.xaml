<Page
    x:Class="LanStash.App.Views.Photos.SynologyPhotosPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:photos="using:LanStash.App.Views.Photos">
    <Page.Resources>
        <CollectionViewSource x:Name="PhotosSource" IsSourceGrouped="True" />
        <DataTemplate x:Key="PhotoTemplate">
            <Grid Width="152" Height="152" Padding="4" ToolTipService.ToolTip="{Binding Title}">
                <Grid.RowDefinitions><RowDefinition Height="112"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="6">
                    <Grid>
                        <SymbolIcon Symbol="Pictures" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        <Image x:Name="Thumbnail" Stretch="UniformToFill" />
                        <Border Background="{ThemeResource LayerFillColorDefaultBrush}" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="4" CornerRadius="4" Padding="4,1">
                            <TextBlock Text="{Binding MediaLabel}" Style="{StaticResource CaptionTextBlockStyle}" />
                        </Border>
                    </Grid>
                </Border>
                <TextBlock Grid.Row="1" Text="{Binding Title}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
            </Grid>
        </DataTemplate>
        <DataTemplate x:Key="CollectionTemplate">
            <Border Width="152" Height="152" Margin="4" Padding="12" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="6" ToolTipService.ToolTip="{Binding Title}">
                <StackPanel Spacing="8" VerticalAlignment="Center">
                    <SymbolIcon Symbol="Folder" />
                    <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" HorizontalAlignment="Center" />
                    <TextBlock Text="{Binding Subtitle}" Style="{StaticResource CaptionTextBlockStyle}" HorizontalAlignment="Center" />
                </StackPanel>
            </Border>
        </DataTemplate>
        <DataTemplate x:Key="SharedTemplate">
            <Border Width="220" Height="152" Margin="4" Padding="12" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="6">
                <StackPanel Spacing="6">
                    <SymbolIcon Symbol="Share" HorizontalAlignment="Left" />
                    <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
                    <Button Content="{Binding CopyLinkTitle}" Visibility="{Binding LinkVisibility}" Tag="{Binding Shared}" Click="CopyLink_Click" MinHeight="36" />
                </StackPanel>
            </Border>
        </DataTemplate>
        <photos:SynologyPhotoTemplateSelector x:Key="PhotoTemplates"
            PhotoTemplate="{StaticResource PhotoTemplate}" CollectionTemplate="{StaticResource CollectionTemplate}" SharedTemplate="{StaticResource SharedTemplate}" />
    </Page.Resources>
    <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid x:Name="LibraryRoot" Padding="20,12,12,12" RowSpacing="8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/><RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock x:Name="PageTitle" Style="{StaticResource TitleTextBlockStyle}" AutomationProperties.HeadingLevel="Level1" />
                    <TextBlock x:Name="SpaceTitle" Style="{StaticResource CaptionTextBlockStyle}" />
                </StackPanel>
                <Button x:Name="RefreshButton" Grid.Column="1" Click="Refresh_Click" MinWidth="44" MinHeight="44"><SymbolIcon Symbol="Refresh" /></Button>
            </Grid>
            <Pivot x:Name="Sections" Grid.Row="1" SelectionChanged="Sections_SelectionChanged" Height="52">
                <PivotItem x:Name="TimelineTab"/><PivotItem x:Name="FoldersTab"/><PivotItem x:Name="AlbumsTab"/><PivotItem x:Name="SharingTab"/>
            </Pivot>
            <Grid Grid.Row="2" ColumnSpacing="8">
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <Button x:Name="BackButton" Click="Back_Click" MinHeight="40" MinWidth="40"><SymbolIcon Symbol="Back"/></Button>
                <AutoSuggestBox x:Name="SearchBox" Grid.Column="1" QueryIcon="Find" QuerySubmitted="Search_QuerySubmitted" MinWidth="100" />
                <ComboBox x:Name="MonthPicker" Grid.Column="2" SelectionChanged="Month_SelectionChanged" MinWidth="110" MaxWidth="190" />
                <Button x:Name="FiltersButton" Grid.Column="3" Click="Filters_Click" MinWidth="40" MinHeight="40"><SymbolIcon Symbol="Filter"/></Button>
            </Grid>
            <StackPanel Grid.Row="3" Spacing="4">
                <TextBlock x:Name="LocationTitle" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" AutomationProperties.HeadingLevel="Level2" />
                <ItemsControl x:Name="CategoryButtons">
                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><ItemsWrapGrid Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate><DataTemplate><Button Content="{Binding Title}" Tag="{Binding Category}" Click="Category_Click" Margin="0,0,8,4" MinHeight="40"/></DataTemplate></ItemsControl.ItemTemplate>
                </ItemsControl>
                <ComboBox x:Name="ShareScopePicker" SelectionChanged="ShareScope_SelectionChanged" MinWidth="220" />
            </StackPanel>
            <StackPanel Grid.Row="4" Spacing="4">
                <InfoBar x:Name="ErrorBar" IsClosable="False" Severity="Error"><InfoBar.ActionButton><Button x:Name="RetryButton" Click="Retry_Click"/></InfoBar.ActionButton></InfoBar>
                <InfoBar x:Name="DeletionBar" IsClosable="False" Severity="Warning"><InfoBar.ActionButton><Button x:Name="ReviewButton" Click="Review_Click"/></InfoBar.ActionButton></InfoBar>
                <InfoBar x:Name="SaveBar" IsClosable="True" Severity="Informational"><InfoBar.ActionButton><Button x:Name="CancelSaveButton" Click="CancelSave_Click"/></InfoBar.ActionButton></InfoBar>
            </StackPanel>
            <StackPanel Grid.Row="5" Orientation="Horizontal" Spacing="8">
                <Button x:Name="NewerButton" Click="Newer_Click" />
                <ProgressRing x:Name="PreviousProgress" Width="20" Height="20" />
                <TextBlock x:Name="PreviousError" TextWrapping="Wrap" VerticalAlignment="Center" />
            </StackPanel>
            <Grid Grid.Row="6">
                <GridView x:Name="LibraryGrid" IsItemClickEnabled="True" ItemClick="Library_ItemClick" SelectionMode="Single"
                    ItemTemplateSelector="{StaticResource PhotoTemplates}" ContainerContentChanging="Library_ContainerContentChanging"
                    ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto"
                    ScrollViewer.HorizontalScrollMode="Disabled" ScrollViewer.VerticalScrollMode="Enabled">
                    <GridView.ItemsPanel><ItemsPanelTemplate><ItemsWrapGrid Orientation="Horizontal" GroupPadding="0,0,0,12"/></ItemsPanelTemplate></GridView.ItemsPanel>
                    <GridView.GroupStyle><GroupStyle><GroupStyle.HeaderTemplate><DataTemplate><TextBlock Text="{Binding Title}" Style="{StaticResource SubtitleTextBlockStyle}" Margin="4,8,0,8"/></DataTemplate></GroupStyle.HeaderTemplate></GroupStyle></GridView.GroupStyle>
                </GridView>
                <StackPanel x:Name="EmptyPanel" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12" MaxWidth="440" Padding="24">
                    <ProgressRing x:Name="LoadingProgress" Width="32" Height="32" HorizontalAlignment="Center" />
                    <TextBlock x:Name="EmptyTitle" Style="{StaticResource SubtitleTextBlockStyle}" TextAlignment="Center" TextWrapping="Wrap" />
                    <TextBlock x:Name="EmptyMessage" TextAlignment="Center" TextWrapping="Wrap" />
                </StackPanel>
            </Grid>
            <Grid Grid.Row="7">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBlock x:Name="CountText" VerticalAlignment="Center" Style="{StaticResource CaptionTextBlockStyle}" />
                <ProgressRing x:Name="NextProgress" Grid.Column="1" Width="24" Height="24" Margin="8,0" />
                <Button x:Name="OlderButton" Grid.Column="2" Click="Older_Click" />
            </Grid>
        </Grid>
        <Grid x:Name="PreviewRoot" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}" Visibility="Collapsed" Padding="12" RowSpacing="8">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <CommandBar DefaultLabelPosition="Collapsed" IsDynamicOverflowEnabled="True">
                <CommandBar.Content><TextBlock x:Name="PreviewTitle" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" MaxWidth="260" VerticalAlignment="Center"/></CommandBar.Content>
                <AppBarButton x:Name="PreviousPhotoButton" Icon="Back" Click="PreviousPhoto_Click" />
                <AppBarButton x:Name="NextPhotoButton" Icon="Forward" Click="NextPhoto_Click" />
                <AppBarButton x:Name="MotionButton" Icon="Play" Click="Motion_Click" />
                <AppBarButton x:Name="SaveButton" Icon="Save" Click="Save_Click" />
                <AppBarButton x:Name="DeleteButton" Icon="Delete" Click="Delete_Click" />
                <AppBarButton x:Name="DetailsButton" Icon="More" Click="Details_Click" />
                <AppBarButton x:Name="ClosePreviewButton" Icon="Cancel" Click="ClosePreview_Click" />
            </CommandBar>
            <StackPanel Grid.Row="1" Spacing="4">
                <InfoBar x:Name="PreviewErrorBar" Severity="Error" IsClosable="False">
                    <InfoBar.ActionButton><Button x:Name="PreviewRetryButton" Click="PreviewRetry_Click"/></InfoBar.ActionButton>
                </InfoBar>
                <InfoBar x:Name="PreviewSaveBar" IsClosable="True" Severity="Informational">
                    <InfoBar.ActionButton><Button x:Name="PreviewCancelSaveButton" Click="CancelSave_Click"/></InfoBar.ActionButton>
                </InfoBar>
                <InfoBar x:Name="PreviewDeletionBar" IsClosable="False" Severity="Warning">
                    <InfoBar.ActionButton><Button x:Name="PreviewReviewButton" Click="Review_Click"/></InfoBar.ActionButton>
                </InfoBar>
            </StackPanel>
            <Grid Grid.Row="2">
                <ScrollViewer x:Name="ImageScroll" ZoomMode="Enabled" MinZoomFactor="0.25" MaxZoomFactor="8" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" SizeChanged="ImageScroll_SizeChanged">
                    <Image x:Name="PreviewImage" Stretch="Uniform" />
                </ScrollViewer>
                <MediaPlayerElement x:Name="PlayerElement" AreTransportControlsEnabled="True" Stretch="Uniform" Visibility="Collapsed" />
                <ProgressRing x:Name="PreviewProgress" Width="40" Height="40" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Grid>
        </Grid>
    </Grid>
</Page>
