<Page
    x:Class="LanStash.App.Views.AppSettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
    <ScrollViewer>
        <StackPanel
            MaxWidth="760"
            Margin="32,24,32,40"
            HorizontalAlignment="Left"
            Spacing="20">
            <StackPanel Spacing="6">
                <TextBlock
                    x:Uid="Settings.PageTitle"
                    AutomationProperties.HeadingLevel="Level1"
                    Style="{StaticResource TitleTextBlockStyle}" />
                <TextBlock
                    x:Uid="Settings.PageDescription"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    TextWrapping="Wrap" />
            </StackPanel>

            <Border
                Padding="20"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8">
                <StackPanel Spacing="12">
                    <TextBlock
                        x:Uid="Settings.LanguageSectionTitle"
                        AutomationProperties.HeadingLevel="Level2"
                        Style="{StaticResource SubtitleTextBlockStyle}" />
                    <ComboBox
                        x:Uid="Settings.Language"
                        x:Name="LanguageSelector"
                        DisplayMemberPath="DisplayName"
                        MinHeight="44"
                        HorizontalAlignment="Stretch"
                        SelectionChanged="LanguageSelector_SelectionChanged" />
                    <TextBlock
                        x:Uid="Settings.LanguageDescription"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <Border
                Padding="20"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8">
                <StackPanel Spacing="12">
                    <TextBlock
                        x:Uid="Settings.AppearanceSectionTitle"
                        AutomationProperties.HeadingLevel="Level2"
                        Style="{StaticResource SubtitleTextBlockStyle}" />
                    <ComboBox
                        x:Uid="Settings.Theme"
                        x:Name="ThemeSelector"
                        DisplayMemberPath="DisplayName"
                        MinHeight="44"
                        HorizontalAlignment="Stretch"
                        SelectionChanged="ThemeSelector_SelectionChanged" />
                </StackPanel>
            </Border>

            <Border
                Padding="20"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8">
                <StackPanel Spacing="12">
                    <TextBlock
                        x:Uid="Settings.ModulesSectionTitle"
                        AutomationProperties.HeadingLevel="Level2"
                        Style="{StaticResource SubtitleTextBlockStyle}" />
                    <TextBlock
                        x:Uid="Settings.ModulesDescription"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        TextWrapping="Wrap" />
                    <ToggleSwitch
                        x:Uid="Settings.DownloadsModule"
                        x:Name="DownloadsToggle"
                        MinHeight="44"
                        Toggled="ModuleToggle_Toggled"
                        Tag="Downloads" />
                    <ToggleSwitch
                        x:Uid="Settings.ContainersModule"
                        x:Name="ContainersToggle"
                        MinHeight="44"
                        Toggled="ModuleToggle_Toggled"
                        Tag="Containers" />
                    <ToggleSwitch
                        x:Uid="Settings.VirtualMachinesModule"
                        x:Name="VirtualMachinesToggle"
                        MinHeight="44"
                        Toggled="ModuleToggle_Toggled"
                        Tag="VirtualMachines" />
                    <ToggleSwitch
                        x:Uid="Settings.NasHealthModule"
                        x:Name="NasHealthToggle"
                        MinHeight="44"
                        Toggled="ModuleToggle_Toggled"
                        Tag="NasSettings" />
                </StackPanel>
            </Border>

            <Border
                Padding="20"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8">
                <StackPanel Spacing="12">
                    <TextBlock
                        x:Uid="Settings.CacheSectionTitle"
                        AutomationProperties.HeadingLevel="Level2"
                        Style="{StaticResource SubtitleTextBlockStyle}" />
                    <TextBlock
                        x:Uid="Settings.CacheDescription"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        TextWrapping="Wrap" />
                    <TextBlock
                        x:Name="CacheSummaryText"
                        AutomationProperties.LiveSetting="Polite"
                        TextWrapping="Wrap" />
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <Button
                            x:Uid="Settings.ClearCache"
                            x:Name="ClearCacheButton"
                            MinHeight="44"
                            Click="ClearCacheButton_Click" />
                        <ProgressRing
                            x:Name="ClearCacheProgress"
                            Width="24"
                            Height="24"
                            IsActive="False"
                            Visibility="Collapsed" />
                    </StackPanel>
                    <InfoBar
                        x:Name="CacheFeedback"
                        AutomationProperties.LiveSetting="Polite"
                        IsClosable="True"
                        IsOpen="False" />
                </StackPanel>
            </Border>

            <InfoBar
                x:Uid="Settings.Privacy"
                IsClosable="False"
                IsOpen="True"
                Severity="Informational" />
        </StackPanel>
    </ScrollViewer>
</Page>
