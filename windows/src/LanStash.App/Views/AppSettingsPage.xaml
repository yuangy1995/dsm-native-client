<Page
    x:Class="LanStash.App.Views.AppSettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:desktop="using:LanStash.App.Presentation"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
    <ScrollViewer>
        <StackPanel
            MaxWidth="760"
            Margin="32,24,32,40"
            HorizontalAlignment="Left"
            Spacing="20">
            <StackPanel Spacing="6">
                <TextBlock
                    x:Uid="Settings.PageTitle" desktop:DesktopLocalization.Bindings="Text=Settings.PageTitle.Text"
                    AutomationProperties.HeadingLevel="Level1"
                    Style="{StaticResource TitleTextBlockStyle}" />
                <TextBlock
                    x:Uid="Settings.PageDescription" desktop:DesktopLocalization.Bindings="Text=Settings.PageDescription.Text"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    TextWrapping="Wrap" />
            </StackPanel>

            <Border
                Padding="20"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8">
                <StackPanel Spacing="12">
                    <TextBlock
                        x:Uid="Settings.LanguageSectionTitle" desktop:DesktopLocalization.Bindings="Text=Settings.LanguageSectionTitle.Text"
                        AutomationProperties.HeadingLevel="Level2"
                        Style="{StaticResource SubtitleTextBlockStyle}" />
                    <ComboBox
                        x:Uid="Settings.Language" desktop:DesktopLocalization.Bindings="AutomationProperties.Name=Settings.Language.AutomationProperties.Name;Header=Settings.Language.Header"
                        x:Name="LanguageSelector"
                        DisplayMemberPath="DisplayName"
                        MinHeight="44"
                        HorizontalAlignment="Stretch"
                        SelectionChanged="LanguageSelector_SelectionChanged" />
                    <TextBlock
                        x:Uid="Settings.LanguageDescription" desktop:DesktopLocalization.Bindings="Text=Settings.LanguageDescription.Text"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <Border
                Padding="20"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8">
                <StackPanel Spacing="12">
                    <TextBlock
                        x:Uid="Settings.AppearanceSectionTitle" desktop:DesktopLocalization.Bindings="Text=Settings.AppearanceSectionTitle.Text"
                        AutomationProperties.HeadingLevel="Level2"
                        Style="{StaticResource SubtitleTextBlockStyle}" />
                    <ComboBox
                        x:Uid="Settings.Theme" desktop:DesktopLocalization.Bindings="AutomationProperties.Name=Settings.Theme.AutomationProperties.Name;Header=Settings.Theme.Header"
                        x:Name="ThemeSelector"
                        DisplayMemberPath="DisplayName"
                        MinHeight="44"
                        HorizontalAlignment="Stretch"
                        SelectionChanged="ThemeSelector_SelectionChanged" />
                </StackPanel>
            </Border>

            <Border
                Padding="20"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8">
                <StackPanel Spacing="12">
                    <TextBlock
                        x:Uid="Settings.ModulesSectionTitle" desktop:DesktopLocalization.Bindings="Text=Settings.ModulesSectionTitle.Text"
                        AutomationProperties.HeadingLevel="Level2"
                        Style="{StaticResource SubtitleTextBlockStyle}" />
                    <TextBlock
                        x:Uid="Settings.ModulesDescription" desktop:DesktopLocalization.Bindings="Text=Settings.ModulesDescription.Text"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        TextWrapping="Wrap" />
                    <ToggleSwitch
                        x:Uid="Settings.DownloadsModule" desktop:DesktopLocalization.Bindings="AutomationProperties.Name=Settings.DownloadsModule.AutomationProperties.Name;Header=Settings.DownloadsModule.Header;OffContent=Settings.DownloadsModule.OffContent;OnContent=Settings.DownloadsModule.OnContent"
                        x:Name="DownloadsToggle"
                        MinHeight="44"
                        Toggled="ModuleToggle_Toggled"
                        Tag="Downloads" />
                    <ToggleSwitch
                        x:Uid="Settings.ContainersModule" desktop:DesktopLocalization.Bindings="AutomationProperties.Name=Settings.ContainersModule.AutomationProperties.Name;Header=Settings.ContainersModule.Header;OffContent=Settings.ContainersModule.OffContent;OnContent=Settings.ContainersModule.OnContent"
                        x:Name="ContainersToggle"
                        MinHeight="44"
                        Toggled="ModuleToggle_Toggled"
                        Tag="Containers" />
                    <ToggleSwitch
                        x:Uid="Settings.VirtualMachinesModule" desktop:DesktopLocalization.Bindings="AutomationProperties.Name=Settings.VirtualMachinesModule.AutomationProperties.Name;Header=Settings.VirtualMachinesModule.Header;OffContent=Settings.VirtualMachinesModule.OffContent;OnContent=Settings.VirtualMachinesModule.OnContent"
                        x:Name="VirtualMachinesToggle"
                        MinHeight="44"
                        Toggled="ModuleToggle_Toggled"
                        Tag="VirtualMachines" />
                    <ToggleSwitch
                        x:Uid="Settings.NasHealthModule" desktop:DesktopLocalization.Bindings="AutomationProperties.Name=Settings.NasHealthModule.AutomationProperties.Name;Header=Settings.NasHealthModule.Header;OffContent=Settings.NasHealthModule.OffContent;OnContent=Settings.NasHealthModule.OnContent"
                        x:Name="NasHealthToggle"
                        MinHeight="44"
                        Toggled="ModuleToggle_Toggled"
                        Tag="NasSettings" />
                </StackPanel>
            </Border>

            <Border
                Padding="20"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8">
                <StackPanel Spacing="12">
                    <TextBlock
                        x:Uid="Settings.CacheSectionTitle" desktop:DesktopLocalization.Bindings="Text=Settings.CacheSectionTitle.Text"
                        AutomationProperties.HeadingLevel="Level2"
                        Style="{StaticResource SubtitleTextBlockStyle}" />
                    <TextBlock
                        x:Uid="Settings.CacheDescription" desktop:DesktopLocalization.Bindings="Text=Settings.CacheDescription.Text"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        TextWrapping="Wrap" />
                    <TextBlock
                        x:Name="CacheSummaryText"
                        AutomationProperties.LiveSetting="Polite"
                        TextWrapping="Wrap" />
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <Button
                            x:Uid="Settings.ClearCache" desktop:DesktopLocalization.Bindings="AutomationProperties.Name=Settings.ClearCache.AutomationProperties.Name;Content=Settings.ClearCache.Content"
                            x:Name="ClearCacheButton"
                            MinHeight="44"
                            Click="ClearCacheButton_Click" />
                        <ProgressRing
                            x:Name="ClearCacheProgress"
                            Width="24"
                            Height="24"
                            IsActive="False"
                            Visibility="Collapsed" />
                    </StackPanel>
                    <InfoBar
                        x:Name="CacheFeedback"
                        AutomationProperties.LiveSetting="Polite"
                        IsClosable="True"
                        IsOpen="False" />
                </StackPanel>
            </Border>

            <InfoBar
                x:Uid="Settings.Privacy" desktop:DesktopLocalization.Bindings="Message=Settings.Privacy.Message;Title=Settings.Privacy.Title"
                IsClosable="False"
                IsOpen="True"
                Severity="Informational" />
        </StackPanel>
    </ScrollViewer>
</Page>
