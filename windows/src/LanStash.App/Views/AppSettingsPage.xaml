<Page
    x:Class="LanStash.App.Views.AppSettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{ThemeResource WorkspaceSurfaceBrush}">
    <ScrollViewer HorizontalScrollBarVisibility="Disabled" HorizontalScrollMode="Disabled"
                  HorizontalContentAlignment="Left">
        <StackPanel MaxWidth="900" Margin="28,24,28,32" Spacing="24"
                    HorizontalAlignment="Left" VerticalAlignment="Top">
            <TextBlock x:Uid="SettingsPageTitle"
                       AutomationProperties.HeadingLevel="Level1"
                       Style="{StaticResource WorkspaceTitleStyle}" />

            <StackPanel Spacing="10">
                <TextBlock x:Uid="SettingsGeneralSectionTitle"
                           AutomationProperties.HeadingLevel="Level2"
                           Style="{StaticResource SubtitleTextBlockStyle}" />
                <Border Padding="20,8" CornerRadius="8" BorderThickness="1"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                    <StackPanel>
                        <Grid MinHeight="60" ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Uid="SettingsLanguageLabel" VerticalAlignment="Center" TextWrapping="Wrap" />
                            <ComboBox x:Uid="SettingsLanguage" x:Name="LanguageSelector" Grid.Column="1"
                                      DisplayMemberPath="DisplayName" Width="210" MinHeight="44"
                                      VerticalAlignment="Center" SelectionChanged="LanguageSelector_SelectionChanged" />
                        </Grid>
                        <Border Height="1" Background="{ThemeResource CardStrokeColorDefaultBrush}" />
                        <Grid MinHeight="60" ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Uid="SettingsThemeLabel" VerticalAlignment="Center" TextWrapping="Wrap" />
                            <ComboBox x:Uid="SettingsTheme" x:Name="ThemeSelector" Grid.Column="1"
                                      DisplayMemberPath="DisplayName" Width="210" MinHeight="44"
                                      VerticalAlignment="Center" SelectionChanged="ThemeSelector_SelectionChanged" />
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>

            <Expander HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                <Expander.Header>
                    <TextBlock x:Uid="SettingsModulesSectionTitle"
                               AutomationProperties.HeadingLevel="Level2"
                               Style="{StaticResource BodyStrongTextBlockStyle}" />
                </Expander.Header>
                <StackPanel Spacing="4" Margin="0,0,0,4">
                    <Grid MinHeight="52" ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Uid="SettingsDownloadsModuleLabel" VerticalAlignment="Center" TextWrapping="Wrap" />
                        <ToggleSwitch x:Uid="SettingsDownloadsModule" x:Name="DownloadsToggle" Grid.Column="1"
                                      MinHeight="44" VerticalAlignment="Center" Toggled="ModuleToggle_Toggled" Tag="Downloads" />
                    </Grid>
                    <Grid MinHeight="52" ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Uid="SettingsContainersModuleLabel" VerticalAlignment="Center" TextWrapping="Wrap" />
                        <ToggleSwitch x:Uid="SettingsContainersModule" x:Name="ContainersToggle" Grid.Column="1"
                                      MinHeight="44" VerticalAlignment="Center" Toggled="ModuleToggle_Toggled" Tag="Containers" />
                    </Grid>
                    <Grid MinHeight="52" ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Uid="SettingsVirtualMachinesModuleLabel" VerticalAlignment="Center" TextWrapping="Wrap" />
                        <ToggleSwitch x:Uid="SettingsVirtualMachinesModule" x:Name="VirtualMachinesToggle" Grid.Column="1"
                                      MinHeight="44" VerticalAlignment="Center" Toggled="ModuleToggle_Toggled" Tag="VirtualMachines" />
                    </Grid>
                    <Grid MinHeight="52" ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Uid="SettingsNasHealthModuleLabel" VerticalAlignment="Center" TextWrapping="Wrap" />
                        <ToggleSwitch x:Uid="SettingsNasHealthModule" x:Name="NasHealthToggle" Grid.Column="1"
                                      MinHeight="44" VerticalAlignment="Center" Toggled="ModuleToggle_Toggled" Tag="NasSettings" />
                    </Grid>
                </StackPanel>
            </Expander>

            <StackPanel Spacing="10">
                <TextBlock x:Uid="SettingsStorageSectionTitle"
                           AutomationProperties.HeadingLevel="Level2"
                           Style="{StaticResource SubtitleTextBlockStyle}" />
                <Border Padding="20,16" CornerRadius="8" BorderThickness="1"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                    <StackPanel Spacing="12">
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="4" VerticalAlignment="Center">
                                <TextBlock x:Uid="SettingsCacheSectionTitle" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                <TextBlock x:Name="CacheSummaryText" AutomationProperties.LiveSetting="Polite"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                                <ProgressRing x:Name="ClearCacheProgress" Width="24" Height="24"
                                              IsActive="False" Visibility="Collapsed" />
                                <Button x:Uid="SettingsClearCache" x:Name="ClearCacheButton"
                                        MinHeight="44" Click="ClearCacheButton_Click" />
                            </StackPanel>
                        </Grid>
                        <TextBlock x:Uid="SettingsCacheDescription"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
                <Button x:Name="CloudDriveButton" x:Uid="SettingsCloudDrive" MinHeight="52"
                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="20,12"
                        Click="CloudDriveButton_Click" />
                <Button x:Name="SavedRecordingsButton" x:Uid="ChatSavedRecordingsButton" MinHeight="52"
                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="20,12"
                        Click="SavedRecordingsButton_Click" />
            </StackPanel>

            <InfoBar x:Name="CacheFeedback" AutomationProperties.LiveSetting="Polite"
                     IsClosable="True" IsOpen="False" />
        </StackPanel>
    </ScrollViewer>
</Page>
