<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <DefaultLanguage>en-US</DefaultLanguage>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <RootNamespace>LanStash.App</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\AppIcon.ico</ApplicationIcon>
    <Platforms>x64;arm64</Platforms>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>false</WindowsAppSDKSelfContained>
    <PublishProfile>win-$(Platform).pubxml</PublishProfile>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\LanStash.Application\LanStash.Application.csproj" />
    <ProjectReference Include="..\LanStash.Domain\LanStash.Domain.csproj" />
    <ProjectReference Include="..\LanStash.Infrastructure\LanStash.Infrastructure.csproj" />
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.3.1" />
    <InternalsVisibleTo Include="LanStash.Tests" />
  </ItemGroup>
  <ItemGroup>
    <Compile Remove="CloudDrive\**\*.cs" />
    <Compile Remove="Features\Chat\**\*.cs" />
    <Compile Remove="Features\Containers\**\*.cs" />
    <Compile Remove="Features\Downloads\**\*.cs" />
    <Compile Remove="Features\Files\**\*.cs" />
    <Compile Remove="Features\Photos\**\*.cs" />
    <Compile Remove="Features\Settings\**\*.cs" />
    <Compile Remove="Features\Transfers\ForegroundTransfer*.cs" />
    <Compile Remove="Features\Transfers\SafeFileDownloadService.cs" />
    <Compile Remove="Features\Transfers\WindowsTransactionalDownloadDestination.cs" />
    <Compile Remove="Features\VirtualMachines\**\*.cs" />
    <Compile Remove="Localization\*.cs" />
    <Compile Remove="ViewModels\ConnectionAttemptState.cs" />
    <Compile Remove="ViewModels\ObservableObject.cs" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="Assets\AppIcon.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Assets\AppIcon.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>
  <ItemGroup>
    <PRIResource Include="Strings\**\*.resw" />
  </ItemGroup>
</Project>
